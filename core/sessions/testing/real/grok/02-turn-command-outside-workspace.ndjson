"<ACCOUNT_HOME>/.grok/bundled/skills/long-running-background-tasks/SKILL.md","bareName":"long-running-background-tasks","qualifiedName":"bundled:long-running-background-tasks"}},{"name":"pr-babysit","description":"Monitor PRs, fix CI failures, address review comments (human and bot/automated), resolve merge conflicts, and restack stacks. Supports independent PRs, Graphite stacks, and GitHub stacked PRs (gh-stack). Optional ship lands a ready PR bottom-up when every job has passed and no comments remain open.","input":{"hint":"add [--ship] <number> | remove <number> | list | check | ship [on|off] [number...]"},"_meta":{"scope":"bundled","path":"<ACCOUNT_HOME>/.grok/bundled/skills/pr-babysit/SKILL.md","bareName":"pr-babysit","qualifiedName":"bundled:pr-babysit"}},{"name":"resume-claude","description":"Continue from a recent Claude Code session","input":{"hint":"[words describing the session | session id]"},"_meta":{"scope":"bundled","path":"<ACCOUNT_HOME>/.grok/bundled/skills/resume-claude/SKILL.md","bareName":"resume-claude","qualifiedName":"bundled:resume-claude"}},{"name":"resume-codex","description":"Continue from a recent Codex session","input":{"hint":"[words describing the session | session id]"},"_meta":{"scope":"bundled","path":"<ACCOUNT_HOME>/.grok/bundled/skills/resume-codex/SKILL.md","bareName":"resume-codex","qualifiedName":"bundled:resume-codex"}},{"name":"resume-cursor","description":"Continue from a recent Cursor session","input":{"hint":"[words describing the session | session id]"},"_meta":{"scope":"bundled","path":"<ACCOUNT_HOME>/.grok/bundled/skills/resume-cursor/SKILL.md","bareName":"resume-cursor","qualifiedName":"bundled:resume-cursor"}},{"name":"review","description":"Run a reviewer subagent against your whole branch vs main, your uncommitted working state, a named branch, a single GitHub PR, or an entire Graphite/stacked-PR stack (one reviewer subagent per PR). A bare /review defaults to reviewing your uncommitted working state when the tree i