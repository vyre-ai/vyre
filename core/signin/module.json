{
  "name": "signin",
  "version": "0.1.0",
  "description": "`vyre signin`, the daemon half: the command line asks, the paired phone approves with Face ID, and the terminal gets a person session made for exactly that terminal.",
  "roles": [
    "box",
    "local"
  ],
  "requires": [],
  "needs": {
    "kernel": {
      "actions": [],
      "presence": true
    },
    "daemon": [
      "personSessions"
    ]
  },
  "does": {
    "tools": [
      {
        "name": "signin.ask", "effect": "write",
        "reach": "person"
      },
      {
        "name": "signin.pending", "effect": "read",
        "reach": "person"
      },
      {
        "name": "signin.answer", "effect": "write",
        "reach": "person"
      },
      {
        "name": "signin.status", "effect": "read",
        "reach": "person"
      },
      {
        "name": "signin.out", "effect": "write",
        "reach": "person"
      }
    ]
  },
  "watches": {
    "emits": []
  },
  "shows": {
    "cli": []
  },
  "teaches": {
    "tips": []
  },
  "settings": []
}
