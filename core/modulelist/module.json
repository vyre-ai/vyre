{
  "name": "modules",
  "version": "0.1.0",
  "description": "The owner's reset of the accepted first-party module list, for a deliberate downgrade (rollback to an older release): one presence-gated tool over the kernel's own reset.",
  "roles": ["box", "local"],
  "requires": [],
  "needs": { "kernel": { "actions": [] }, "daemon": ["modulesListReset", "modulesListResetPayload"] },
  "does": { "tools": [{ "name": "modules.list.reset", "reach": "person", "effect": "write" }, { "name": "modules.list.reset.ask", "reach": "person", "effect": "write" }, { "name": "modules.list.reset.pending", "reach": "person", "effect": "read" }, { "name": "modules.list.reset.answer", "reach": "person", "effect": "write" }, { "name": "modules.list.reset.status", "reach": "person", "effect": "write" }] },
  "watches": { "emits": [] },
  "shows": { "cli": [] },
  "teaches": { "tips": [] },
  "settings": []
}
