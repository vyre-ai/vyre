{
  "name": "publish",
  "version": "0.1.0",
  "description": "Put a site or app on the internet from your space: build a private preview, approve it, publish it, go back to the last version, connect your own domain. Each site runs on its own, apart from your space's data.",
  "roles": [
    "box"
  ],
  "requires": [],
  "does": {
    "reads": [
      "publish.domain.verify",
      "publish.list",
      "publish.preview",
      "publish.status"
    ],
    "tools": [
      {
        "name": "publish.create",
        "reach": "anyone",
        "effect": "write",
        "projectArg": "project"
      },
      {
        "name": "publish.preview",
        "outward": true,
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "publish.plan",
        "reach": "anyone",
        "effect": "read"
      },
      {
        "name": "publish.status",
        "reach": "anyone",
        "effect": "read"
      },
      {
        "name": "publish.list",
        "reach": "anyone",
        "effect": "read"
      },
      {
        "name": "publish.approve",
        "asks": true,
        "outward": true,
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "publish.publish",
        "asks": true,
        "outward": true,
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "publish.go",
        "asks": true,
        "outward": true,
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "publish.quick",
        "asks": true,
        "outward": true,
        "reach": "anyone",
        "effect": "write",
        "projectArg": "project"
      },
      {
        "name": "publish.rollback",
        "asks": true,
        "outward": true,
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "publish.domain.add",
        "outward": true,
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "publish.domain.verify",
        "outward": true,
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "publish.secret.grant",
        "asks": true,
        "outward": true,
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "publish.secret.revoke",
        "outward": true,
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "publish.edge",
        "outward": true,
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "publish.edge.up",
        "outward": true,
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "publish.edge.down",
        "outward": true,
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "publish.flow",
        "reach": "anyone",
        "effect": "read"
      },
      {
        "name": "publish.decide",
        "outward": true,
        "reach": "person",
        "effect": "write"
      },
      {
        "name": "publish.retire",
        "outward": true,
        "reach": "person",
        "effect": "write"
      },
      {
        "name": "publish.domain.remove",
        "outward": true,
        "reach": "person",
        "effect": "write"
      }
    ]
  },
  "watches": {
    "emits": [
      "deployment.built",
      "deployment.previewed",
      "deployment.approved",
      "deployment.published",
      "deployment.restarted",
      "deployment.rolled-back",
      "deployment.retired"
    ]
  },
  "shows": {
    "deck": [],
    "capsule": [],
    "cli": []
  },
  "needs": {
    "vault": [
      "per-deployment"
    ],
    "kernel": {
      "mints": [
        {
          "prefix": "credential/*",
          "actions": [
            "vault.run"
          ]
        }
      ]
    }
  },
  "teaches": {},
  "settings": [
    {"key": "publish.servers", "group": "publish", "label": "Publish apps that run their own server", "help": "Off in this test release. On lets Publish build a folder with a Dockerfile and run it as a server. It stays off until the server's build network and its Space-and-name keying have been reviewed.", "type": "bool", "default": false, "levels": ["account"], "apply": "live", "store": {"config": "publish.servers"}}
  ]
}
