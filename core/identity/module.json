{
  "name": "identity",
  "version": "0.5.3",
  "description": "The username, the master password and the recovery key.",
  "roles": ["box", "local"],
  "requires": [],
  "does": {
    "tools": [
      { "name": "identity.create", "effect": "write", "reach": "person", "outward": true },
      { "name": "identity.unlock", "effect": "write", "reach": "person", "outward": true },
      { "name": "identity.vault.install", "effect": "write", "reach": "person", "outward": true },
      { "name": "identity.lock", "effect": "write", "reach": "person" },
      { "name": "identity.status", "effect": "read", "reach": "person" },
      { "name": "identity.migrate", "effect": "write", "reach": "person", "outward": true },
      { "name": "identity.github.link", "effect": "write", "reach": "person", "outward": true },
      { "name": "identity.discover", "effect": "write", "reach": "person", "outward": true },
      { "name": "identity.card", "effect": "read", "reach": "person" },
      { "name": "identity.signins.pending", "effect": "read", "reach": "person" },
      { "name": "identity.signin.revoke", "effect": "write", "reach": "person" },
      { "name": "identity.signin.ack", "effect": "write", "reach": "person" },
      { "name": "identity.signins.serve", "summary": "a team member's own new-device sign-ins waiting on them, on the team's server, as that member in that Space (the daemon's member door only)", "effect": "read", "reach": "modules", "crossSpace": "records.read" },
      { "name": "identity.signins.serve-write", "summary": "a team member's own act on a new-device sign-in (sign it out, or say it was them), on the team's server, as that member in that Space (the daemon's member door only)", "effect": "write", "reach": "modules", "crossSpace": "records.create" }
    ]
  },
  "watches": { "emits": ["signin.new-device", "signin.revoked", "signin.acknowledged"] },
  "shows": { "cli": [] },
  "needs": { "tools": ["spaces.identity.create", "spaces.identity.self", "spaces.identity.device", "spaces.identity.published-key", "vault.master.install"] },
  "teaches": {}
}
