{
  "name": "network",
  "version": "0.1.0",
  "description": "The built-in network as the person sees it: whether this machine is signed in, per space whether the link is up (direct or through the relay), and joining or leaving a space. The work is the Wink module's; this module holds the public names (network.wink.*).",
  "roles": [
    "box"
  ],
  "requires": [],
  "does": {
    "reads": [
      "network.wink.status"
    ],
    "tools": [
      {
        "name": "network.wink.status",
        "effect": "read",
        "reach": "anyone"
      },
      {
        "name": "network.wink.whois",
        "effect": "read",
        "reach": "anyone"
      },
      {
        "name": "network.wink.join",
        "effect": "write",
        "reach": "person"
      },
      {
        "name": "network.wink.leave",
        "effect": "write",
        "reach": "person"
      }
    ]
  },
  "watches": {
    "emits": []
  },
  "shows": {
    "deck": [],
    "capsule": [],
    "cli": []
  },
  "needs": {},
  "teaches": {
    "tips": []
  }
}
