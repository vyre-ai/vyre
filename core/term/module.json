{
  "name": "term",
  "version": "0.1.0",
  "roles": ["box", "local"],
  "requires": [],
  "does": { "tools": [{ "name": "term.open", "reach": "person" }, { "name": "term.attach", "reach": "person" }, { "name": "term.list", "reach": "person" }, { "name": "term.close", "reach": "person" }] },
  "watches": { "emits": ["term.opened", "term.closed"] },
  "shows": { "streams": ["pty"] },
  "needs": {},
  "teaches": {
    "tips": [
      {"id": "open-in-folder", "text": "In Chat, press Folders, go to a folder and press Open in terminal for a shell on the server, right in the Deck.", "surfaces": ["chat", "deck"], "level": "first-use", "trigger": "on-use", "since": "0.1.0", "docs": "using/chat.md#open-a-terminal-on-the-box"},
      {"id": "survives-drop", "text": "Close the tab or lose the network and the shell keeps running. Come back and it picks up where it was.", "surfaces": ["chat", "deck"], "level": "first-use", "trigger": "on-use", "since": "0.1.0", "docs": "using/chat.md#open-a-terminal-on-the-box"},
      {"id": "keep-hours", "text": "A terminal nobody looks at is kept for 12 hours, then ended. Change it with `term.keep_hours` in config.json.", "surfaces": ["chat", "deck"], "level": "power", "trigger": "on-use", "since": "0.1.0", "key": "term.keep_hours", "docs": "using/chat.md#open-a-terminal-on-the-box"},
      {"id": "survives-restart", "text": "On a server, the shell outlives a vyred restart. Updating the server is what ends it, and the terminal tells you so.", "surfaces": ["chat", "deck"], "level": "power", "trigger": "on-use", "since": "0.1.0", "docs": "using/chat.md#open-a-terminal-on-the-box"},
      {"id": "max-open", "text": "At most 8 terminals are open at once. Type `exit` in one you are done with, or raise `term.max` in config.json.", "surfaces": ["chat", "deck"], "level": "power", "trigger": "on-use", "since": "0.1.0", "key": "term.max", "docs": "using/chat.md#open-a-terminal-on-the-box"},
      {"id": "shell-choice", "text": "Set `term.shell` in config.json to run another shell in new terminals instead of your login shell.", "surfaces": ["chat", "deck"], "level": "power", "trigger": "on-use", "since": "0.1.0", "key": "term.shell", "docs": "using/chat.md#open-a-terminal-on-the-box"},
      {"id": "no-ssh-needed", "text": "Need a shell on the server without SSH? Chat's Folders view opens one in any folder, and it asks for no passkey.", "surfaces": ["chat", "deck"], "level": "discovery", "trigger": "never-used", "since": "0.1.0", "docs": "using/chat.md#open-a-terminal-on-the-box"},
      {"id": "own-screen", "text": "A terminal belongs to the screen that opened it, so another device cannot pick it up. Open a new one there instead.", "surfaces": ["chat", "deck"], "level": "first-use", "trigger": "idle", "since": "0.1.0", "docs": "using/chat.md#open-a-terminal-on-the-box"}
    ]
  },
  "settings": [
    {"key": "term.keep_hours", "group": "files", "label": "Keep closed terminals for (hours)", "type": "int", "min": 0, "max": 168, "default": 12, "levels": ["account"], "apply": "restart", "store": {"config": "term.keep_hours"}},
    {"key": "term.max", "group": "files", "label": "Terminals open at once", "type": "int", "min": 1, "max": 64, "default": 8, "levels": ["account"], "apply": "restart", "store": {"config": "term.max"}}
  ]
}
