{
  "name": "memory",
  "version": "0.1.0",
  "roles": ["box", "local"],
  "requires": [],
  "does": { "tools": ["memory.graph", "memory.facts", "memory.relevant", "memory.why", "memory.pin", "memory.mute", "memory.teach", "memory.curate", "memory.stats",
    "memory.correct", "memory.corrections", "memory.uncorrect", "memory.merge", "memory.split", "memory.me", "memory.answer", "memory.profile", "memory.remember"] },
  "watches": { "emits": ["memory.curated", "memory.corrected", "memory.merged", "memory.split", "memory.remembered"] },
  "shows": { "deck": ["panel:memory"], "capsule": ["answer:memory.relevant"], "cli": ["memory", "why"] },
  "needs": {},
  "teaches": {},
  "settings": [
    {"key": "memory.model", "group": "memory", "label": "Use a model to learn facts", "type": "bool", "default": true, "levels": ["account"], "apply": "restart", "store": {"config": "memory.model.on"}},
    {"key": "memory.daily_usd", "group": "memory", "label": "Memory spend per day (USD)", "type": "number", "min": 0, "default": 0.05, "levels": ["account"], "apply": "restart", "store": {"config": "memory.model.dailyUsd"}}
  ]
}
