{
  "name": "documents",
  "version": "0.1.0",
  "apiVersion": 1,
  "description": "Make documents from Word templates and your records, deterministic, and file them. A value that is missing stops the document and names itself.",
  "roles": [
    "box"
  ],
  "requires": [],
  "does": {
    "tools": [
      {
        "name": "documents.template.add",
        "effect": "write",
        "reach": "anyone"
      },
      {
        "name": "documents.template.list",
        "effect": "read",
        "reach": "anyone"
      },
      {
        "name": "documents.template.get",
        "effect": "read",
        "reach": "anyone"
      },
      {
        "name": "documents.generate",
        "effect": "write",
        "reach": "anyone",
        "projectArg": "project"
      },
      {
        "name": "documents.signing.flow",
        "effect": "read",
        "reach": "anyone"
      },
      {
        "name": "documents.signed-link",
        "outward": true,
        "effect": "write",
        "reach": "anyone"
      },
      {
        "name": "documents.send",
        "outward": true,
        "covers": ["comms.send", "mail.send"],
        "effect": "write",
        "reach": "anyone"
      },
      {
        "name": "documents.send-signed",
        "outward": true,
        "covers": ["comms.send", "mail.send"],
        "effect": "write",
        "reach": "anyone"
      }
    ]
  },
  "watches": {
    "emits": [
      "documents.generated",
      "documents.sent",
      "documents.copy-sent"
    ]
  },
  "shows": {},
  "needs": {},
  "teaches": {},
  "flow": {
    "steps": [
      {
        "name": "documents.generate",
        "label": "Make a document from a template",
        "inputs": {
          "template": "string",
          "values": "object",
          "records": "object",
          "name": "string",
          "project": "string",
          "contact": "string",
          "format": "string"
        },
        "outputs": {
          "path": "string",
          "size": "number",
          "sha256": "string",
          "format": "string",
          "record": "string"
        }
      },
      {
        "name": "documents.signed-link",
        "label": "Make a 30-day link to the signed copy",
        "outward": true,
        "inputs": {
          "slug": "string",
          "days": "number"
        },
        "outputs": {
          "url": "string",
          "expires": "number"
        }
      },
      {
        "name": "documents.send",
        "label": "Send a document for signature",
        "outward": true,
        "inputs": {
          "template_id": "number",
          "email": "string",
          "signer": "string",
          "subject": "string",
          "note": "string"
        },
        "outputs": {
          "submission": "number",
          "slug": "string",
          "url": "string"
        }
      },
      {
        "name": "documents.send-signed",
        "label": "Email the signer their signed copy",
        "outward": true,
        "inputs": {
          "slug": "string",
          "email": "string",
          "days": "number"
        },
        "outputs": {
          "url": "string",
          "expires": "number"
        }
      }
    ]
  },
  "settings": [
    {
      "key": "documents.pdf",
      "group": "documents",
      "label": "Address of the PDF converter",
      "help": "On a server with Records the converter (Gotenberg) runs beside Vyre by default and nothing needs setting. Give another address here (such as http://127.0.0.1:3000) to use your own. With none, a PDF is refused in plain words and the Word file is still made.",
      "type": "string",
      "levels": [
        "account"
      ],
      "apply": "restart",
      "store": {
        "config": "documents.pdf"
      }
    }
  ]
}
