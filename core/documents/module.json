{
  "name": "documents",
  "version": "0.1.0",
  "apiVersion": 1,
  "description": "Make documents from Word templates and your records, deterministic, and file them. A value that is missing stops the document and names itself.",
  "roles": [
    "box"
  ],
  "requires": [],
  "does": {
    "tools": [
      {
        "name": "documents.template.add",
        "effect": "write",
        "reach": "anyone"
      },
      {
        "name": "documents.template.list",
        "effect": "read",
        "reach": "anyone"
      },
      {
        "name": "documents.template.get",
        "effect": "read",
        "reach": "anyone"
      },
      {
        "name": "documents.generate",
        "effect": "write",
        "reach": "anyone",
        "projectArg": "project"
      },
      {
        "name": "documents.signing.flow",
        "effect": "read",
        "reach": "anyone"
      },
      {
        "name": "documents.signed-link",
        "outward": true,
        "effect": "write",
        "reach": "anyone"
      },
      {
        "name": "documents.signed-link.revoke",
        "effect": "write",
        "reach": "anyone"
      },
      {
        "name": "documents.signing.waiting",
        "effect": "read",
        "reach": "anyone"
      },
      {
        "name": "documents.signing.remind",
        "outward": true,
        "covers": ["comms.send", "mail.send", "google.mail.send", "mcp.call"],
        "effect": "write",
        "reach": "anyone"
      },
      {
        "name": "documents.send",
        "outward": true,
        "covers": ["comms.send", "mail.send", "google.mail.send", "mcp.call"],
        "effect": "write",
        "reach": "anyone"
      },
      {
        "name": "documents.send-signed",
        "outward": true,
        "covers": ["comms.send", "mail.send", "google.mail.send", "mcp.call"],
        "effect": "write",
        "reach": "anyone"
      }
    ]
  },
  "watches": {
    "emits": [
      "documents.generated",
      "documents.sent",
      "documents.copy-sent",
      "documents.reminded"
    ]
  },
  "shows": {},
  "needs": {},
  "teaches": {
    "tips": [
      {
        "id": "send-for-signature",
        "text": "Ask your assistant to send a template for signature. It makes the request and e-mails the signer their link, and you say yes once.",
        "surfaces": ["cli", "deck"],
        "level": "first-use",
        "trigger": "on-use",
        "since": "0.3.3",
        "docs": "using/documents.md#send-for-signature"
      },
      {
        "id": "sign-from-a-stage",
        "text": "Make a matter sign itself: ask for the signing Flow. The letter goes out at the stage you name and the matter moves on when it is signed.",
        "surfaces": ["cli", "deck"],
        "level": "power",
        "trigger": "on-use",
        "since": "0.3.3",
        "docs": "using/documents.md#sign-from-a-stage"
      }
    ]
  },
  "flow": {
    "steps": [
      {
        "name": "documents.generate",
        "label": "Make a document from a template",
        "inputs": {
          "template": "string",
          "values": "object",
          "records": "object",
          "name": "string",
          "project": "string",
          "contact": "string",
          "format": "string"
        },
        "outputs": {
          "path": "string",
          "size": "number",
          "sha256": "string",
          "format": "string",
          "record": "string"
        }
      },
      {
        "name": "documents.signed-link",
        "label": "Make a link to the signed copy",
        "outward": true,
        "inputs": {
          "slug": "string",
          "days": "number"
        },
        "outputs": {
          "url": "string",
          "expires": "number"
        }
      },
      {
        "name": "documents.send",
        "label": "Send a document for signature",
        "outward": true,
        "recipients": ["email"],
        "inputs": {
          "template_id": "number",
          "email": "string",
          "signer": "string",
          "subject": "string",
          "note": "string"
        },
        "outputs": {
          "submission": "number",
          "slug": "string",
          "url": "string"
        }
      },
      {
        "name": "documents.send-signed",
        "label": "Email the signer their signed copy",
        "outward": true,
        "recipients": ["email"],
        "inputs": {
          "slug": "string",
          "email": "string",
          "days": "number"
        },
        "outputs": {
          "url": "string",
          "expires": "number"
        }
      }
    ]
  },
  "settings": [
    {
      "key": "documents.signed_link_days",
      "group": "documents",
      "label": "Links to signed copies expire after (days)",
      "help": "0 means they never expire, so a client can open their signed contract from the email years later. Give a number of days to make new links expire. A link already sent keeps the end it was made with; ask the assistant to end every link and they all stop.",
      "type": "int",
      "min": 0,
      "max": 3650,
      "default": 0,
      "levels": [
        "account"
      ],
      "apply": "live",
      "store": {
        "config": "documents.signed_link_days"
      }
    },
    {
      "key": "documents.pdf",
      "group": "documents",
      "label": "Address of the PDF converter",
      "help": "On a server with Records the converter (Gotenberg) runs beside Vyre by default and nothing needs setting. Give another address here (such as http://127.0.0.1:3000) to use your own. With none, a PDF is refused in plain words and the Word file is still made.",
      "type": "string",
      "levels": [
        "account"
      ],
      "apply": "restart",
      "store": {
        "config": "documents.pdf"
      }
    }
  ]
}
