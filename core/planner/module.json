{
  "name": "planner",
  "version": "0.1.0",
  "description": "Alarms, timers, reminders, todos, notes and a calendar, kept on the box so something rings when the Mac is shut.",
  "roles": ["box", "local"],
  "requires": [],
  "does": { "tools": ["planner.add", "planner.list", "planner.get", "planner.ringing", "planner.update", "planner.done", "planner.snooze", "planner.dismiss",
    "planner.delete", "planner.agenda", "planner.upcoming", "planner.parse", "planner.settings", "planner.calendar.sync", "planner.calendar.create"] },
  "watches": { "emits": ["planner.added", "planner.changed", "planner.removed", "planner.fired", "planner.acked", "planner.schedule"] },
  "shows": { "deck": ["panel:planner"], "capsule": [], "cli": ["alarm", "remind", "todo", "notes", "agenda"] },
  "needs": {},
  "teaches": {},
  "settings": [
    {"key": "planner.escalate_after", "group": "planner", "label": "Ring again after (minutes)", "type": "int", "min": 1, "max": 120, "default": 5, "levels": ["account"], "apply": "live", "store": {"tool": {"get": {"tool": "planner.settings", "input": {}, "read": "escalate_after"}, "set": {"tool": "planner.settings", "input": {"escalate_after": "$value"}}}}},
    {"key": "planner.escalate_max", "group": "planner", "label": "Rings after the first", "type": "int", "min": 0, "max": 10, "default": 3, "levels": ["account"], "apply": "live", "store": {"tool": {"get": {"tool": "planner.settings", "input": {}, "read": "escalate_max"}, "set": {"tool": "planner.settings", "input": {"escalate_max": "$value"}}}}},
    {"key": "planner.event_lead", "group": "planner", "label": "Warn before an event (minutes)", "type": "int", "min": 0, "max": 1440, "default": 10, "levels": ["account"], "apply": "live", "store": {"tool": {"get": {"tool": "planner.settings", "input": {}, "read": "event_lead"}, "set": {"tool": "planner.settings", "input": {"event_lead": "$value"}}}}}
  ]
}
