{
  "name": "planner",
  "version": "0.1.0",
  "description": "Alarms, timers, reminders, todos, notes and a calendar, kept on the box so something rings when the Mac is shut. Its data is the Space's records: Reminder and Note records, to-dos as Tasks, the calendar as Event records.",
  "roles": ["box", "local"],
  "requires": [],
  "does": { "tools": [
    {"name": "planner.add", "effect": "write", "projectArg": "project", "reach": "anyone"},
    {"name": "planner.list", "effect": "read", "projectArg": "project", "reach": "anyone"},
    {"name": "planner.get", "effect": "read", "reach": "anyone"},
    {"name": "planner.ringing", "effect": "read", "reach": "anyone"},
    {"name": "planner.update", "effect": "write", "projectArg": "project", "reach": "anyone"},
    {"name": "planner.done", "effect": "write", "reach": "anyone"},
    {"name": "planner.snooze", "effect": "write", "reach": "anyone"},
    {"name": "planner.dismiss", "effect": "write", "reach": "anyone"},
    {"name": "planner.delete", "effect": "write", "reach": "anyone"},
    {"name": "planner.agenda", "effect": "read", "reach": "anyone"},
    {"name": "planner.upcoming", "effect": "read", "reach": "anyone"},
    {"name": "planner.parse", "effect": "read", "reach": "anyone"},
    {"name": "planner.settings", "effect": "write", "reach": "person"},
    {"name": "planner.calendar.sync", "effect": "write", "reach": "anyone"},
    {"name": "planner.calendar.create", "effect": "write", "projectArg": "project", "reach": "anyone"}
  ] },
  "watches": { "emits": ["planner.added", "planner.changed", "planner.removed", "planner.fired", "planner.acked", "planner.schedule", "planner.task-run"] },
  "shows": { "deck": ["panel:planner"], "capsule": [], "cli": ["alarm", "remind", "todo", "notes", "agenda"] },
  "needs": {
    "kernel": {
      "actions": [
        "records.read",
        "records.create",
        "records.update",
        "records.remove",
        "events.read",
        "tasks.request",
        "tasks.read",
        "tasks.work"
      ],
      "prefixes": [
        "reminder/*",
        "note/*",
        "planner_firing/*",
        "planner_state/*",
        "event/*",
        "task/*"
      ],
      "types": [
        {
          "name": "reminder",
          "label": "Reminder",
          "icon": "IconBell",
          "fields": [
            {
              "name": "title",
              "kind": "text",
              "label": "Title",
              "required": true
            },
            {
              "name": "kind",
              "kind": "choice",
              "label": "Kind",
              "options": [
                "alarm",
                "timer",
                "reminder",
                "task"
              ],
              "required": true
            },
            {
              "name": "state",
              "kind": "choice",
              "label": "State",
              "options": [
                "open",
                "done",
                "cancelled"
              ],
              "required": true
            },
            {
              "name": "at",
              "kind": "datetime",
              "label": "Rings at"
            },
            {
              "name": "tz",
              "kind": "text",
              "label": "Time zone"
            },
            {
              "name": "floating",
              "kind": "boolean",
              "label": "Follows the planner's zone"
            },
            {
              "name": "wall",
              "kind": "text",
              "label": "Time of day (HH:MM)"
            },
            {
              "name": "date",
              "kind": "text",
              "label": "Date (YYYY-MM-DD)"
            },
            {
              "name": "repeat",
              "kind": "text",
              "label": "Repeat rule (JSON)"
            },
            {
              "name": "duration_ms",
              "kind": "number",
              "label": "Timer length (ms)"
            },
            {
              "name": "snooze_until",
              "kind": "datetime",
              "label": "Snoozed until"
            },
            {
              "name": "next_fire",
              "kind": "number",
              "label": "Next ring (ms, the planner's own)"
            },
            {
              "name": "body",
              "kind": "rich_text",
              "label": "Notes or the instruction a task runs"
            },
            {
              "name": "list",
              "kind": "text",
              "label": "List"
            },
            {
              "name": "priority",
              "kind": "number",
              "label": "Priority (0 to 3)"
            },
            {
              "name": "pinned",
              "kind": "boolean",
              "label": "Pinned"
            },
            {
              "name": "tags",
              "kind": "text",
              "label": "Tags (a JSON list)"
            },
            {
              "name": "project",
              "kind": "text",
              "label": "Project"
            },
            {
              "name": "thread",
              "kind": "text",
              "label": "Thread"
            },
            {
              "name": "source",
              "kind": "text",
              "label": "Added by (caller)"
            },
            {
              "name": "added_by",
              "kind": "text",
              "label": "Added by (agent)"
            },
            {
              "name": "created",
              "kind": "number",
              "label": "Created (ms)"
            },
            {
              "name": "updated",
              "kind": "number",
              "label": "Updated (ms)"
            },
            {
              "name": "deleted_at",
              "kind": "datetime",
              "label": "Deleted"
            },
            {
              "name": "done_at",
              "kind": "datetime",
              "label": "Done"
            },
            {
              "name": "waits_on",
              "kind": "text",
              "label": "Runs when this item is done"
            },
            {
              "name": "run_count",
              "kind": "number",
              "label": "Times run"
            },
            {
              "name": "last_result",
              "kind": "text",
              "label": "Last result"
            },
            {
              "name": "paused",
              "kind": "boolean",
              "label": "Paused"
            },
            {
              "name": "waits_on_fired",
              "kind": "number",
              "label": "Last completion it ran for"
            }
          ]
        },
        {
          "name": "note",
          "label": "Note",
          "icon": "IconNote",
          "fields": [
            {
              "name": "title",
              "kind": "text",
              "label": "Title",
              "required": true
            },
            {
              "name": "state",
              "kind": "choice",
              "label": "State",
              "options": [
                "open",
                "done",
                "cancelled"
              ],
              "required": true
            },
            {
              "name": "body",
              "kind": "rich_text",
              "label": "Note"
            },
            {
              "name": "list",
              "kind": "text",
              "label": "List"
            },
            {
              "name": "priority",
              "kind": "number",
              "label": "Priority (0 to 3)"
            },
            {
              "name": "pinned",
              "kind": "boolean",
              "label": "Pinned"
            },
            {
              "name": "tags",
              "kind": "text",
              "label": "Tags (a JSON list)"
            },
            {
              "name": "project",
              "kind": "text",
              "label": "Project"
            },
            {
              "name": "thread",
              "kind": "text",
              "label": "Thread"
            },
            {
              "name": "source",
              "kind": "text",
              "label": "Added by (caller)"
            },
            {
              "name": "added_by",
              "kind": "text",
              "label": "Added by (agent)"
            },
            {
              "name": "created",
              "kind": "number",
              "label": "Created (ms)"
            },
            {
              "name": "updated",
              "kind": "number",
              "label": "Updated (ms)"
            },
            {
              "name": "deleted_at",
              "kind": "datetime",
              "label": "Deleted"
            },
            {
              "name": "done_at",
              "kind": "datetime",
              "label": "Done"
            }
          ]
        },
        {
          "name": "planner_firing",
          "label": "Ring",
          "icon": "IconBellRinging",
          "fields": [
            {
              "name": "fid",
              "kind": "text",
              "label": "Ring id",
              "required": true,
              "unique": true
            },
            {
              "name": "item",
              "kind": "text",
              "label": "Item",
              "required": true
            },
            {
              "name": "kind",
              "kind": "text",
              "label": "Kind",
              "required": true
            },
            {
              "name": "due",
              "kind": "number",
              "label": "Due (ms)",
              "required": true
            },
            {
              "name": "ring",
              "kind": "number",
              "label": "Ring number"
            },
            {
              "name": "missed",
              "kind": "boolean",
              "label": "Missed"
            },
            {
              "name": "state",
              "kind": "text",
              "label": "State",
              "required": true
            },
            {
              "name": "fired_at",
              "kind": "number",
              "label": "Fired (ms)"
            },
            {
              "name": "next_ring",
              "kind": "number",
              "label": "Next ring (ms)"
            },
            {
              "name": "acked_at",
              "kind": "number",
              "label": "Answered (ms)"
            },
            {
              "name": "action",
              "kind": "text",
              "label": "Answer"
            },
            {
              "name": "by",
              "kind": "text",
              "label": "Answered by"
            },
            {
              "name": "until",
              "kind": "number",
              "label": "Snoozed until (ms)"
            }
          ]
        },
        {
          "name": "planner_state",
          "label": "Planner setting",
          "icon": "IconSettings",
          "fields": [
            {
              "name": "key",
              "kind": "text",
              "label": "Key",
              "required": true,
              "unique": true
            },
            {
              "name": "value",
              "kind": "text",
              "label": "Value (JSON)",
              "required": true
            }
          ]
        }
      ]
    }
  },
  "teaches": {
    "tips": [
      {"id": "remind-words", "text": "Type `vyre remind \"call juno\" at 6` and it rings on every device with push on, and as a banner in the Deck.", "surfaces": ["cli"], "level": "first-use", "trigger": "on-use", "since": "0.1.0", "command": "vyre remind <what> at <when>", "docs": "using/planner.md#set-an-alarm-a-timer-or-a-reminder-from-the-terminal"},
      {"id": "timer-label", "text": "`vyre timer 25m bread` starts a labelled timer that rings on every device, even when your Mac is shut.", "surfaces": ["cli"], "level": "first-use", "trigger": "on-use", "since": "0.1.0", "command": "vyre timer <length> [label]", "docs": "using/planner.md#set-an-alarm-a-timer-or-a-reminder-from-the-terminal"},
      {"id": "answer-once", "text": "Answer a ring once, anywhere. Done or Snooze in the Deck closes the notification on your other devices.", "surfaces": ["deck", "phone"], "level": "first-use", "trigger": "on-use", "since": "0.1.0", "docs": "using/planner.md#answer-something-that-is-ringing"},
      {"id": "todo-priority", "text": "End a todo with `!high`, `!!` or `!low` to set its priority: `vyre todo add send the Northwind Bakery invoice by friday !high`.", "surfaces": ["cli"], "level": "power", "trigger": "on-use", "since": "0.1.0", "key": "!high", "docs": "using/planner.md#keep-todos-and-notes"},
      {"id": "snooze-minutes", "text": "`vyre snooze <id> 15` rings again in 15 minutes. Leave out the number and it waits 9.", "surfaces": ["cli"], "level": "power", "trigger": "on-use", "since": "0.1.0", "command": "vyre snooze <id> [minutes]", "docs": "using/planner.md#answer-something-that-is-ringing"},
      {"id": "escalate", "text": "An alarm nobody answers rings again every 5 minutes, 3 more times. Change both with `vyre call planner.settings`.", "surfaces": ["cli"], "level": "power", "trigger": "on-use", "since": "0.1.0", "command": "vyre call planner.settings", "docs": "using/planner.md#settings"},
      {"id": "lock-screen-label", "text": "Want \"Call kit\" on the lock screen, not just \"Reminder\"? Run `vyre call push.settings '{\"planner_label\": true}'`.", "surfaces": ["cli"], "level": "discovery", "trigger": "never-used", "since": "0.1.0", "command": "vyre call push.settings", "docs": "using/planner.md#show-the-words-on-your-lock-screen"},
      {"id": "assistant-adds", "text": "Ask juno to remind you of something and juno adds the reminder itself, with no prompt and no Touch ID.", "surfaces": ["chat", "capsule"], "level": "discovery", "trigger": "never-used", "since": "0.1.0", "docs": "using/planner.md#let-your-agents-use-it"},
      {"id": "agenda-today", "text": "Run `vyre agenda` for today's alarms, reminders and calendar events, then the todos due, overdue ones included.", "surfaces": ["cli", "deck"], "level": "first-use", "trigger": "idle", "since": "0.1.0", "command": "vyre agenda", "docs": "using/planner.md#see-your-day"}
    ]
  },
  "settings": [
    {"key": "planner.escalate_after", "group": "planner", "label": "Ring again after (minutes)", "type": "int", "min": 1, "max": 120, "default": 5, "levels": ["account"], "apply": "live", "store": {"tool": {"get": {"tool": "planner.settings", "input": {}, "read": "escalate_after"}, "set": {"tool": "planner.settings", "input": {"escalate_after": "$value"}}}}},
    {"key": "planner.escalate_max", "group": "planner", "label": "Rings after the first", "type": "int", "min": 0, "max": 10, "default": 3, "levels": ["account"], "apply": "live", "store": {"tool": {"get": {"tool": "planner.settings", "input": {}, "read": "escalate_max"}, "set": {"tool": "planner.settings", "input": {"escalate_max": "$value"}}}}},
    {"key": "planner.event_lead", "group": "planner", "label": "Warn before an event (minutes)", "type": "int", "min": 0, "max": 1440, "default": 10, "levels": ["account"], "apply": "live", "store": {"tool": {"get": {"tool": "planner.settings", "input": {}, "read": "event_lead"}, "set": {"tool": "planner.settings", "input": {"event_lead": "$value"}}}}}
  ]
}
