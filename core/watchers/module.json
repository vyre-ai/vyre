{
  "name": "watchers",
  "version": "0.1.0",
  "roles": ["box", "local"],
  "requires": [],
  "does": {
    "tools": [
      { "name": "watchers.list", "reach": "anyone" },
      { "name": "watchers.test", "reach": "anyone" },
      { "name": "watchers.card", "reach": "anyone" },
      { "name": "watchers.logs", "reach": "anyone" },
      { "name": "watchers.items", "reach": "anyone", "projectArg": "project" },
      { "name": "watchers.create", "reach": "asked", "target": "watchers.act.target" },
      { "name": "watchers.act.target", "reach": "modules" },
      { "name": "watchers.preset", "reach": "asked", "target": "watchers.act.target" },
      { "name": "watchers.pause", "reach": "anyone" },
      { "name": "watchers.resume", "reach": "person" },
      { "name": "watchers.delete", "reach": "person" },
      { "name": "watchers.run", "reach": "person" },
      { "name": "watchers.hook", "reach": "hook" },
      { "name": "watchers.duty.create", "reach": "modules" },
      { "name": "watchers.duty.update", "reach": "modules" },
      { "name": "watchers.duty.delete", "reach": "modules" },
      { "name": "watchers.duty.run", "reach": "modules" },
      { "name": "watchers.duty.resume", "reach": "modules" }
    ]
  },
  "watches": { "emits": ["watcher.created", "watcher.fired", "watcher.failed", "watcher.paused", "watcher.resumed", "watcher.deleted"] },
  "shows": { "deck": ["panel:watchers"], "capsule": [], "cli": ["watchers"] },
  "needs": { "vault": ["per-watcher"] },
  "teaches": {
    "memory": ["watcher.item"],
    "tips": [
      {"id": "list", "text": "Run `vyre watchers` to see each watcher's state, project, schedule, items filed and next run.", "surfaces": ["cli"], "level": "first-use", "trigger": "on-use", "since": "0.1.0", "command": "vyre watchers", "docs": "using/watchers.md#look-after-running-watchers"},
      {"id": "dry-run", "text": "`vyre watchers test harlow-invoices` dry-runs a watcher now and lists up to ten items. It files nothing.", "surfaces": ["cli"], "level": "first-use", "trigger": "on-use", "since": "0.1.0", "command": "vyre watchers test <name>", "docs": "using/watchers.md#look-after-running-watchers"},
      {"id": "own-grant", "text": "Each watcher needs its own grant: `vyre vault grant billing-inbox watchers --watcher harlow-invoices`.", "surfaces": ["cli"], "level": "first-use", "trigger": "on-use", "since": "0.1.0", "command": "vyre vault grant <item> watchers --watcher <name>", "docs": "using/watchers.md#give-a-watcher-a-credential"},
      {"id": "changed-state", "text": "A watcher shows `changed` after its files are edited. Run `vyre watchers test`, check the items, then `vyre watchers create`.", "surfaces": ["cli"], "level": "power", "trigger": "on-use", "since": "0.1.0", "command": "vyre watchers create <name>", "docs": "using/watchers.md#look-after-running-watchers"},
      {"id": "auto-pause", "text": "Three failed runs in a row pause a watcher. Read `vyre watchers logs <name>`, fix the cause, then `vyre watchers resume <name>`.", "surfaces": ["cli"], "level": "power", "trigger": "on-use", "since": "0.1.0", "command": "vyre watchers logs <name>", "docs": "using/watchers.md#look-after-running-watchers"},
      {"id": "cron-schedule", "text": "`schedule` takes five-field cron in local time, like `*/15 * * * *`, or `@hourly` and `@daily`.", "surfaces": ["cli"], "level": "power", "trigger": "on-use", "since": "0.1.0", "key": "schedule", "docs": "using/watchers.md#what-a-watcher-is-made-of"},
      {"id": "ask-claude", "text": "Ask Claude to watch a source: \"watch the billing inbox for invoices and file them into Harlow Legal\". It dry-runs before it turns on.", "surfaces": ["chat", "cli"], "level": "discovery", "trigger": "never-used", "since": "0.1.0", "docs": "using/watchers.md#ask-for-a-watcher"},
      {"id": "webhook-schedule", "text": "For a source that pushes, set `\"schedule\": \"webhook\"`. `vyre watchers create` then prints the route, header and token.", "surfaces": ["cli"], "level": "discovery", "trigger": "never-used", "since": "0.1.0", "docs": "using/watchers.md#look-after-running-watchers"},
      {"id": "items-filed", "text": "Run `vyre watchers items` to see what every watcher filed, or add a project slug for that project's items.", "surfaces": ["cli"], "level": "first-use", "trigger": "idle", "since": "0.1.0", "command": "vyre watchers items", "docs": "using/watchers.md#look-after-running-watchers"},
      {"id": "board-switch", "text": "An agent's board in the Deck, `/agents/<name>`, lists its watchers, each with a switch to pause it and turn it back on.", "surfaces": ["deck"], "level": "power", "trigger": "idle", "since": "0.1.0", "docs": "using/watchers.md#look-after-running-watchers"}
    ]
  }
}
