{
  "name": "connectors",
  "version": "0.2.0",
  "roles": [
    "box",
    "local"
  ],
  "requires": [
    "vault",
    "mcp"
  ],
  "does": {
    "tools": [
      "connectors.catalog",
      "connectors.list",
      "connectors.connect",
      "connectors.connect.finish",
      "connectors.connect.cancel",
      "connectors.disconnect",
      "connectors.mention.search",
      "connectors.mention.resolve",
      "connectors.persist"
    ]
  },
  "watches": {
    "emits": [
      "connectors.connected",
      "connectors.connect-failed",
      "connectors.disconnected"
    ]
  },
  "shows": {
    "deck": [
      "settings:connections"
    ],
    "cli": [
      "connect"
    ]
  },
  "needs": {
    "vault": [
      "per-connection"
    ]
  },
  "mentions": [
    {
      "kind": "connector",
      "label": "Connectors",
      "icon": "plug",
      "search": "connectors.mention.search",
      "resolve": "connectors.mention.resolve"
    }
  ]
}