{
  "name": "connectors",
  "version": "0.2.0",
  "roles": [
    "box",
    "local"
  ],
  "requires": [
    "vault",
    "mcp"
  ],
  "does": {
    "reads": ["connectors.list"],
    "tools": [
      "connectors.catalog",
      "connectors.list",
      "connectors.connect",
      "connectors.connect.finish",
      "connectors.connect.cancel",
      { "name": "connectors.declared", "reach": "person", "effect": "read" },
      { "name": "connectors.logging", "reach": "person", "effect": "read", "projectArg": "project" },
      { "name": "connectors.declare", "reach": "person", "effect": "write" },
      { "name": "connectors.connection.create", "reach": "person", "effect": "write" },
      { "name": "connectors.connection.update", "reach": "person", "effect": "write" },
      { "name": "connectors.connection.check", "effect": "read" },
      { "name": "connectors.connection.list", "effect": "read" },
      { "name": "connectors.connection.get", "effect": "read" },
      { "name": "connectors.connection.export", "effect": "read" },
      { "name": "connectors.connection.import", "effect": "read" },
      { "name": "connectors.connection.propose", "effect": "write" },
      { "name": "connectors.connection.proposals", "reach": "person", "effect": "read" },
      { "name": "connectors.connection.approve", "reach": "person", "effect": "write" },
      { "name": "connectors.connection.decline", "reach": "person", "effect": "write" },
      { "name": "connectors.connection.rebuild", "reach": "person", "effect": "write" },
      { "name": "connectors.connection.delete", "reach": "person", "effect": "write" },
      "connectors.disconnect", { "name": "connectors.scope", "reach": "person", "effect": "write" },
      "connectors.calendar.today",
      "connectors.mention.search",
      "connectors.mention.resolve",
      "connectors.persist"
    ]
  },
  "watches": {
    "emits": [
      "connectors.connected",
      "connectors.connect-failed",
      "connectors.disconnected",
      "connectors.scope-changed",
      "connectors.connection-created",
      "connectors.connection-updated",
      "connectors.connection-checked",
      "connectors.connection-deleted",
      "connectors.connection-received",
      "connectors.connection-proposed"
    ]
  },
  "shows": {
    "deck": [
      "settings:connections"
    ],
    "cli": [
      "connect"
    ],
    "capsule": {
      "view:next": {
        "title": "Next meeting",
        "keywords": [
          "calendar",
          "agenda",
          "meeting",
          "join"
        ],
        "icon": "calendar",
        "root": true,
        "list": {
          "tool": "connectors.calendar.today",
          "input": {
            "limit": 3
          },
          "map": {
            "rows": "events",
            "id": "id",
            "title": "title",
            "subtitle": "when",
            "accessory": "account",
            "url": "link"
          },
          "actions": [
            {
              "id": "open",
              "title": "Open",
              "do": {
                "open": "{url}"
              }
            }
          ]
        }
      }
    }
  },
  "needs": {
    "vault": [
      "per-connection"
    ]
  },
  "mentions": [
    {
      "kind": "connector",
      "label": "Connectors",
      "icon": "plug",
      "search": "connectors.mention.search",
      "resolve": "connectors.mention.resolve"
    }
  ]
}