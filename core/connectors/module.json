{
  "name": "connectors",
  "version": "0.2.0",
  "roles": [
    "box",
    "local"
  ],
  "requires": [
    "vault",
    "mcp"
  ],
  "does": {
    "reads": ["connectors.list"],
    "tools": [
      "connectors.catalog",
      "connectors.list",
      "connectors.connect",
      "connectors.connect.finish",
      "connectors.connect.cancel",
      { "name": "connectors.declared", "reach": "person", "effect": "read" },
      { "name": "connectors.logging", "reach": "person", "effect": "read", "projectArg": "project" },
      { "name": "connectors.declare", "reach": "person", "effect": "write" },
      { "name": "connectors.connection.create", "reach": "person", "effect": "write" },
      { "name": "connectors.connection.update", "reach": "person", "effect": "write" },
      { "name": "connectors.connection.check", "reach": "anyone", "effect": "read" },
      { "name": "connectors.operation.run", "reach": "anyone", "effect": "write" },
      { "name": "connectors.connection.list", "reach": "anyone", "effect": "read" },
      { "name": "connectors.connection.get", "reach": "anyone", "effect": "read" },
      { "name": "connectors.connection.export", "reach": "anyone", "effect": "read" },
      { "name": "connectors.connection.import", "reach": "anyone", "effect": "read" },
      { "name": "connectors.connection.propose", "reach": "anyone", "effect": "write" },
      { "name": "connectors.connection.proposals", "reach": "person", "effect": "read" },
      { "name": "connectors.connection.approve", "reach": "person", "effect": "write" },
      { "name": "connectors.connection.decline", "reach": "person", "effect": "write" },
      { "name": "connectors.connection.rebuild", "reach": "person", "effect": "write" },
      { "name": "connectors.connection.delete", "reach": "person", "effect": "write" },
      "connectors.disconnect", { "name": "connectors.scope", "reach": "person", "effect": "write" },
      "connectors.calendar.today",
      "connectors.mention.search",
      "connectors.mention.resolve",
      "connectors.persist",
      { "name": "connectors.site.connect", "reach": "person", "effect": "write" },
      { "name": "connectors.site.propose", "reach": "anyone", "effect": "write" },
      { "name": "connectors.site.sync", "reach": "person", "effect": "write" },
      { "name": "connectors.site.operations", "reach": "anyone", "effect": "read" },
      { "name": "connectors.site.list", "reach": "anyone", "effect": "read" },
      { "name": "connectors.site.rows", "reach": "anyone", "effect": "read" },
      { "name": "connectors.site.rollback", "reach": "person", "effect": "write" },
      { "name": "connectors.site.run", "reach": "modules", "effect": "write" }
    ]
  },
  "watches": {
    "emits": [
      "connectors.connected",
      "connectors.connect-failed",
      "connectors.disconnected",
      "connectors.scope-changed",
      "connectors.connection-created",
      "connectors.connection-updated",
      "connectors.connection-checked",
      "connectors.connection-deleted",
      "connectors.connection-received",
      "connectors.connection-proposed",
      "connectors.site-needs-signin",
      "connectors.site-ran",
      "connectors.site-needs-browser"
    ]
  },
  "shows": {
    "deck": [
      "settings:connections"
    ],
    "cli": [
      "connect"
    ],
    "capsule": {
      "view:sites": {
        "title": "Websites",
        "keywords": ["website", "websites", "linkedin", "signed in", "login", "operations", "browser"],
        "icon": "globe",
        "root": true,
        "list": {
          "tool": "connectors.site.list",
          "input": {},
          "map": { "rows": "sites", "id": "id", "title": "title", "subtitle": "subtitle", "accessory": "light", "url": "site" },
          "detail": { "tool": "connectors.site.operations", "input": { "id": "{id}" }, "map": { "title": "id", "fields": [{ "label": "Site", "path": "site" }, { "label": "Light", "path": "light" }, { "label": "Says", "path": "reason" }] } },
          "actions": [
            { "id": "open", "title": "Open the site (to sign in)", "do": { "open": "{url}" } },
            { "id": "check", "title": "Check it now", "tool": "connectors.connection.check", "input": { "id": "{id}" } },
            { "id": "sync", "title": "Bring up to date with what was learned", "tool": "connectors.site.sync", "input": { "id": "{id}" } }
          ],
          "empty": "No website is connected yet. Teach an operation with chrome_op, then connect the site."
        }
      },
      "view:site-operations": {
        "title": "Website operations",
        "keywords": ["operations", "versions", "rollback", "learned", "heal", "repair"],
        "icon": "history",
        "list": {
          "tool": "connectors.site.rows",
          "input": {},
          "map": { "rows": "rows", "id": "id", "title": "title", "subtitle": "subtitle", "accessory": "accessory", "url": "site" },
          "actions": [
            { "id": "rollback", "title": "Roll back to the version before", "tool": "connectors.site.rollback", "input": { "row": "{id}" } },
            { "id": "open", "title": "Open the site (to sign in again)", "do": { "open": "{url}" } }
          ],
          "empty": "No website operations yet."
        }
      },
      "view:next": {
        "title": "Next meeting",
        "keywords": [
          "calendar",
          "agenda",
          "meeting",
          "join"
        ],
        "icon": "calendar",
        "root": true,
        "list": {
          "tool": "connectors.calendar.today",
          "input": {
            "limit": 3
          },
          "map": {
            "rows": "events",
            "id": "id",
            "title": "title",
            "subtitle": "when",
            "accessory": "account",
            "url": "link"
          },
          "actions": [
            {
              "id": "open",
              "title": "Open",
              "do": {
                "open": "{url}"
              }
            }
          ]
        }
      }
    }
  },
  "needs": {
    "vault": [
      "per-connection"
    ]
  },
  "mentions": [
    {
      "kind": "connector",
      "label": "Connectors",
      "icon": "plug",
      "search": "connectors.mention.search",
      "resolve": "connectors.mention.resolve"
    }
  ]
}