{
  "name": "connectors",
  "version": "0.2.0",
  "roles": [
    "box",
    "local"
  ],
  "requires": [
    "vault",
    "mcp"
  ],
  "does": {
    "tools": [
      {
        "name": "connectors.catalog",
        "reach": "anyone"
      },
      {
        "name": "connectors.list",
        "reach": "anyone"
      },
      {
        "name": "connectors.connect",
        "reach": "person"
      },
      {
        "name": "connectors.connect.finish",
        "reach": "person"
      },
      {
        "name": "connectors.connect.cancel",
        "reach": "person"
      },
      {
        "name": "connectors.disconnect",
        "reach": "person"
      },
      {
        "name": "connectors.scope",
        "reach": "person"
      },
      {
        "name": "connectors.calendar.today",
        "reach": "person"
      },
      {
        "name": "connectors.mention.search",
        "reach": "person"
      },
      {
        "name": "connectors.mention.resolve",
        "reach": "modules"
      },
      {
        "name": "connectors.persist",
        "reach": "modules"
      }
    ]
  },
  "watches": {
    "emits": [
      "connectors.connected",
      "connectors.connect-failed",
      "connectors.disconnected",
      "connectors.scope-changed"
    ]
  },
  "shows": {
    "deck": [
      "settings:connections"
    ],
    "cli": [
      "connect"
    ],
    "capsule": {
      "view:next": {
        "title": "Next meeting",
        "keywords": [
          "calendar",
          "agenda",
          "meeting",
          "join"
        ],
        "icon": "calendar",
        "root": true,
        "list": {
          "tool": "connectors.calendar.today",
          "input": {
            "limit": 3
          },
          "map": {
            "rows": "events",
            "id": "id",
            "title": "title",
            "subtitle": "when",
            "accessory": "account",
            "url": "link"
          },
          "actions": [
            {
              "id": "open",
              "title": "Open",
              "do": {
                "open": "{url}"
              }
            }
          ]
        }
      }
    }
  },
  "needs": {
    "vault": [
      "per-connection"
    ]
  },
  "mentions": [
    {
      "kind": "connector",
      "label": "Connectors",
      "icon": "plug",
      "search": "connectors.mention.search",
      "resolve": "connectors.mention.resolve"
    }
  ]
}
