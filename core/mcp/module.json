{
  "name": "mcp",
  "version": "0.1.0",
  "roles": ["box", "local"],
  "requires": ["vault", "gate"],
  "does": { "tools": ["mcp.servers", "mcp.add", "mcp.update", "mcp.remove", "mcp.test", "mcp.restart", "mcp.tools", "mcp.call", "mcp.release"] },
  "watches": { "emits": ["mcp.added", "mcp.updated", "mcp.removed", "mcp.started", "mcp.stopped", "mcp.failed", "mcp.refreshed", "mcp.called", "mcp.held"] },
  "shows": { "deck": ["settings:connections"], "cli": ["connect"] },
  "needs": { "vault": ["per-connection"] },
  "teaches": {},
  "settings": [
    {"key": "mcp.idle", "group": "tools", "label": "Stop an unused MCP server after (minutes)", "type": "int", "min": 1, "max": 1440, "default": 10, "levels": ["account"], "apply": "restart", "store": {"config": "mcp.idle"}}
  ]
}
