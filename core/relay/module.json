{
  "name": "relay",
  "version": "0.1.0",
  "description": "A second way to reach the box besides Tailscale: the box dials out to a relay, and devices paired by QR code reach it over an end-to-end encrypted channel.",
  "roles": ["box"],
  "requires": [],
  "does": { "tools": ["relay.status", "relay.enable", "relay.disable", "relay.pair.start", "relay.pair.first", "relay.devices.list", "relay.devices.rename", "relay.devices.remove", "relay.devices.trust", "relay.devices.path", "relay.device.presence", "relay.web.release", "relay.web.pin"] },
  "watches": { "emits": ["relay.connected", "relay.disconnected", "device.paired", "device.removed", "device.moved"] },
  "shows": { "deck": [], "capsule": [], "cli": [] },
  "needs": {},
  "teaches": {},
  "settings": [
    {"key": "relay.web_expiry_days", "group": "devices", "label": "Web links through the relay last (days)", "type": "int", "min": 1, "max": 365, "default": 30, "levels": ["account"], "apply": "live", "store": {"config": "relay.web_expiry_days"}}
  ]
}
