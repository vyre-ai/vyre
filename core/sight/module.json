{
  "name": "sight",
  "version": "0.1.0",
  "description": "One screen service for the user's Mac and every agent's computer: what is on it, what was just done on it, and the frame stream where one may leave the machine.",
  "roles": [
    "box",
    "local"
  ],
  "requires": [],
  "does": {
    "tools": [
      { "name": "sight.targets", "reach": "anyone", "effect": "read" },
      { "name": "sight.now", "reach": "anyone", "effect": "read" },
      { "name": "sight.watch", "reach": "anyone", "effect": "write" },
      { "name": "sight.frame", "reach": "anyone", "effect": "read" },
      { "name": "sight.steps", "reach": "anyone", "effect": "read" }
    ]
  },
  "watches": {
    "emits": [
      "sight.stepped"
    ]
  },
  "shows": {},
  "needs": {},
  "teaches": {}
}
