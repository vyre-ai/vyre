{
  "name": "mail",
  "version": "0.1.0",
  "roles": [
    "box",
    "local"
  ],
  "requires": [
    "vault",
    "gate"
  ],
  "does": {
    "tools": [
      "mail.accounts",
      "mail.map",
      "mail.test",
      "mail.send",
      "mail.search",
      "mail.read",
      "mail.find",
      "mail.compose",
      "mail.release"
    ]
  },
  "watches": {
    "emits": [
      "mail.mapped",
      "mail.held",
      "mail.sent",
      "mail.needs-credential"
    ]
  },
  "shows": {
    "deck": [
      "settings:connections"
    ],
    "capsule": {
      "results:mail.find": {
        "title": "Mail"
      },
      "action:mail.compose": {
        "title": "Write it"
      }
    }
  },
  "needs": {
    "vault": [
      "per-connection"
    ]
  },
  "teaches": {}
}
