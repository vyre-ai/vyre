{
  "name": "records",
  "version": "0.1.0",
  "description": "The app's way into a Space's records: one tool per Store call over the kernel's gateway, each under the caller's own chain in the Space it names. Nothing here decides; the kernel does.",
  "roles": ["box", "local"],
  "requires": [],
  "needs": { "kernel": { "actions": [] }, "daemon": ["devStandIn"] },
  "does": {
    "tools": [
      { "name": "records.workspace.create", "reach": "modules" },
      { "name": "records.workspace.delete", "reach": "modules" },
      { "name": "records.me", "reach": "person", "effect": "read" },
      { "name": "records.actors", "reach": "person", "effect": "read" },
      { "name": "records.types", "reach": "person", "effect": "read" },
      { "name": "records.define", "reach": "person", "effect": "write" },
      { "name": "records.list", "reach": "person", "effect": "read" },
      { "name": "records.get", "reach": "person", "effect": "read" },
      { "name": "records.create", "reach": "person", "effect": "write" },
      { "name": "records.update", "reach": "person", "effect": "write" },
      { "name": "records.seal-put", "reach": "person", "effect": "write" },
      { "name": "records.reveal", "reach": "person", "effect": "write" },
      { "name": "records.sees-as", "reach": "person", "effect": "write" },
      { "name": "records.events", "reach": "person", "effect": "read" },
      { "name": "records.dev-seed", "reach": "person", "effect": "write" }
    ]
  },
  "watches": { "emits": [] },
  "shows": { "cli": [] },
  "teaches": { "tips": [] },
  "settings": []
}
