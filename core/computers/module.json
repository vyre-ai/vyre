{
  "name": "computers",
  "version": "0.1.0",
  "roles": ["box"],
  "requires": [],
  "does": {
    "tools": [
      {"name": "computers.list", "effect": "read", "reach": "anyone"},
      {"name": "computers.rename", "effect": "write", "reach": "person"},
      {"name": "computers.get", "effect": "read", "reach": "anyone"},
      {"name": "computers.checkout", "effect": "write", "reach": "anyone"},
      {"name": "computers.release", "effect": "write", "reach": "anyone"},
      {"name": "computers.stop", "effect": "write", "reach": "anyone"},
      {"name": "computers.restart", "effect": "write", "reach": "anyone"},
      {"name": "computers.limits", "effect": "write", "reach": "anyone"},
      {"name": "computers.stats", "reach": "modules"},
      {"name": "computers.pause", "effect": "write", "reach": "anyone"},
      {"name": "computers.resume", "effect": "write", "reach": "person"},
      {"name": "computers.takeover", "effect": "write", "reach": "anyone"},
      {"name": "computers.giveback", "effect": "write", "reach": "anyone"},
      {"name": "computers.watch", "effect": "write", "reach": "anyone"},
      {"name": "computers.endpoint", "reach": "modules"},
      {"name": "computers.may-act", "reach": "modules"},
      {"name": "computers.helper", "reach": "modules"},
      {"name": "computers.shield", "reach": "modules"},
      {"name": "computers.egress.status", "effect": "read", "reach": "person"},
      {"name": "computers.egress.set", "effect": "write", "reach": "person"},
      {"name": "computers.tailnet.status", "effect": "read", "reach": "person"},
      {"name": "computers.tailnet.set", "effect": "write", "reach": "person"},
      {"name": "computers.node.agent", "reach": "modules"},
      {"name": "computers.handback.status", "effect": "read", "reach": "person"},
      {"name": "computers.handback.set", "effect": "write", "reach": "person"},
      {"name": "computers.fill.begin", "reach": "modules"},
      {"name": "computers.fill.end", "reach": "modules"},
      {"name": "computers.member.add", "effect": "write", "reach": "person"},
      {"name": "computers.member.remove", "effect": "write", "reach": "person"},
      {"name": "computers.member.rotate", "effect": "write", "reach": "person"},
      {"name": "computers.member.dispose", "effect": "write", "reach": "person"}
    ]
  },
  "watches": {
    "emits": ["device.renamed", 
      "computer.created", "computer.checked-out", "computer.released", "computer.frozen", "computer.thawed",
      "computer.stopped", "computer.paused", "computer.resumed", "computer.taken-over", "computer.handed-back", "computer.idle-warning", "computer.fill-began", "computer.fill-ended",
      "computer.shielded", "computer.unshielded", "computer.joined", "computer.left",
      "computer.member-added", "computer.member-removed", "computer.member-rotated"
    ]
  },
  "shows": { "streams": ["glass"], "cli": ["computers"], "deck": ["panel:glass"] },
  "needs": { "vault": ["tailscale-agent-authkey", "vyre-shared-computer-member-key"] },
  "teaches": {},
  "settings": [
    {"key": "computers.handback_minutes", "group": "devices", "label": "Hand a computer back after (minutes idle)", "help": "0 is never.", "type": "int", "choices": [0, 2, 5, 15], "default": 5, "levels": ["account"], "apply": "live", "store": {"config": "computers.handbackIdleMin"}}
  ]
}
