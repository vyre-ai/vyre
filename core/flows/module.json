{
  "name": "flows",
  "version": "0.1.0",
  "description": "Flows and Kits: write, approve and run a Flow, with its triggers, waits and tasks. The assembly lives in the daemon (core/daemon/flows-host.js); this module registers the tools over it, each running under the caller's own chain.",
  "roles": ["box", "local"],
  "requires": [],
  "needs": { "daemon": ["flowsHost"], "kernel": { "actions": ["records.read", "records.create", "records.update", "records.remove", "tasks.request", "tasks.read", "tasks.work"], "prefixes": ["*"] } },
  "does": {
    "tools": [
      { "name": "flows.define", "reach": "anyone" },
      { "name": "flows.approve", "reach": "person" },
      { "name": "flows.propose", "reach": "anyone" },
      { "name": "flows.card", "reach": "anyone" },
      { "name": "flows.get", "reach": "anyone" },
      { "name": "flows.list", "reach": "anyone" },
      { "name": "flows.code", "reach": "anyone" },
      { "name": "flows.compile-text", "reach": "anyone" },
      { "name": "flows.graph", "reach": "anyone" },
      { "name": "flows.simulate", "reach": "anyone" },
      { "name": "flows.start", "reach": "anyone" },
      { "name": "flows.pause", "reach": "person" },
      { "name": "flows.resume", "reach": "person" },
      { "name": "flows.runs", "reach": "anyone" },
      { "name": "flows.run", "reach": "anyone" },
      { "name": "flows.retry", "reach": "anyone" },
      { "name": "flows.kit.card", "reach": "anyone" },
      { "name": "flows.kit.propose", "reach": "anyone" },
      { "name": "flows.kit.remove", "reach": "person" },
      { "name": "flows.kit.list", "reach": "anyone" }
    ]
  }
}
