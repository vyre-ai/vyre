{
  "name": "flows",
  "version": "0.1.0",
  "description": "Flows and Kits: write, approve and run a Flow, with its triggers, waits and tasks. The assembly lives in the daemon (core/daemon/flows-host.js); this module registers the tools over it, each running under the caller's own chain.",
  "roles": ["box", "local"],
  "requires": [],
  "needs": { "daemon": ["flowsHost"], "kernel": { "actions": ["records.read", "records.create", "records.update", "records.remove", "tasks.request", "tasks.read", "tasks.work"], "prefixes": ["*"], "mints": [{ "prefix": "flow-act", "actions": ["flows.act-standing"] }] } },
  "does": {
    "tools": [
      { "name": "flows.define", "effect": "write", "reach": "anyone" },
      { "name": "flows.approve", "effect": "write", "reach": "person" },
      { "name": "flows.propose", "effect": "write", "reach": "anyone" },
      { "name": "flows.card", "effect": "read", "reach": "anyone" },
      { "name": "flows.get", "effect": "read", "reach": "anyone" },
      { "name": "flows.list", "effect": "read", "reach": "anyone" },
      { "name": "flows.code", "effect": "read", "reach": "anyone" },
      { "name": "flows.compile-text", "effect": "read", "reach": "anyone" },
      { "name": "flows.graph", "effect": "read", "reach": "anyone" },
      { "name": "flows.simulate", "effect": "read", "reach": "anyone" },
      { "name": "flows.start", "effect": "write", "reach": "anyone" },
      { "name": "flows.pause", "effect": "write", "reach": "person" },
      { "name": "flows.resume", "effect": "write", "reach": "person" },
      { "name": "flows.runs", "effect": "read", "reach": "anyone" },
      { "name": "flows.run", "effect": "read", "reach": "anyone" },
      { "name": "flows.budget", "effect": "write", "reach": "anyone" },
      { "name": "flows.retry", "effect": "write", "reach": "anyone" },
      { "name": "flows.cancel", "effect": "write", "reach": "anyone" },
      { "name": "flows.control", "effect": "read", "reach": "anyone" },
      { "name": "flows.health", "effect": "read", "reach": "anyone" },
      { "name": "flows.timeline", "effect": "read", "reach": "anyone" },
      { "name": "flows.cheatsheet", "effect": "read", "reach": "anyone" },
      { "name": "flows.from-chat", "effect": "write", "reach": "anyone" },
      { "name": "flows.connections", "effect": "read", "reach": "anyone" },
      { "name": "flows.attention", "effect": "read", "reach": "anyone" },
      { "name": "flows.settle", "effect": "write", "reach": "person" },
      { "name": "flows.advance", "effect": "write", "reach": "person" },
      { "name": "flows.patch", "effect": "write", "reach": "anyone" },
      { "name": "flows.test.save", "effect": "write", "reach": "anyone" },
      { "name": "flows.test.run", "effect": "read", "reach": "anyone" },
      { "name": "flows.test.list", "effect": "read", "reach": "anyone" },
      { "name": "flows.test.remove", "effect": "write", "reach": "person" },
      { "name": "flows.diff", "effect": "read", "reach": "anyone" },
      { "name": "flows.rollback", "effect": "write", "reach": "person" },
      { "name": "flows.describe", "effect": "read", "reach": "anyone" },
      { "name": "flows.kit.card", "effect": "read", "reach": "anyone" },
      { "name": "flows.kit.propose", "effect": "write", "reach": "anyone" },
      { "name": "flows.kit.credentials", "effect": "read", "reach": "modules" },
      { "name": "flows.kit.remove", "effect": "write", "reach": "person" },
      { "name": "flows.kit.list", "effect": "read", "reach": "anyone" },
      { "name": "flows.kit.diff", "effect": "read", "reach": "anyone" },
      { "name": "flows.kit.test", "effect": "read", "reach": "anyone" },
      { "name": "flows.kit.library", "effect": "read", "reach": "anyone" },
      { "name": "flows.kit.library.get", "effect": "read", "reach": "anyone" }
    ]
  },
  "settings": [
    { "key": "flows.concurrency", "group": "flows", "label": "Runs of one Flow at once", "help": "The most runs of a single Flow that execute at the same moment. The rest are held, in order, and start as places free. A Flow can set its own.", "type": "int", "min": 1, "max": 32, "default": 8, "levels": ["account"], "apply": "live" },
    { "key": "flows.concurrency_box", "group": "flows", "label": "Runs at once, all Flows", "help": "The most runs that execute at the same moment across every Flow on this server.", "type": "int", "min": 1, "max": 256, "default": 32, "levels": ["account"], "apply": "live" },
    { "key": "flows.stuck_minutes", "group": "flows", "label": "A run that has not moved is stuck after (minutes)", "help": "A running run with no progress for this long is run once more and, if it still does not move, flagged as stuck.", "type": "int", "min": 1, "max": 1440, "default": 5, "levels": ["account"], "apply": "live" },
    { "key": "flows.stale_days", "group": "flows", "label": "A run waiting on a person is stale after (days)", "help": "A run that has waited this long for a person to answer is flagged, and kept waiting.", "type": "int", "min": 1, "max": 365, "default": 3, "levels": ["account"], "apply": "live" },
    { "key": "flows.backlog_cap", "group": "flows", "label": "Most triggers held while Flows are paused", "help": "While a Flow, or all of them, are paused, what arrives is held in order and runs on resume. Past this many held for one Flow, an event is dropped and counted.", "type": "int", "min": 1, "max": 5000, "default": 200, "levels": ["account"], "apply": "live" },
    { "key": "flows.runs_keep_days", "group": "flows", "label": "Keep the details of a finished run for (days)", "help": "After this many days a finished run keeps one line (the Flow, the record, how it ended, when) and its step-by-step details go. Runs still going, and failed runs that need a person, are never shortened. The log of what happened stays.", "type": "int", "min": 1, "max": 3650, "default": 90, "levels": ["account"], "apply": "live" },
    { "key": "flows.holidays", "group": "flows", "label": "Holidays for schedules with business hours", "help": "Dates a schedule with business hours never runs on: a full date like 2026-12-25, or 12-25 for every year. Separate them with commas or spaces.", "type": "string", "default": "", "levels": ["account"], "apply": "live" },
    { "key": "flows.retry_attempts", "group": "flows", "label": "Most tries a step gets by default", "help": "A step that says nothing of its own retries up to this many tries (the first counts) when its kind retries at all. 1 turns the default retries off. A step's own retry is never capped.", "type": "int", "min": 1, "max": 8, "default": 8, "levels": ["account"], "apply": "live" }
  ]
}
