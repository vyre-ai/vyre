{
  "name": "outside",
  "version": "0.1.0",
  "apiVersion": 1,
  "description": "Outside agents: Dots, Muse, Hermes, ChatGPT or your own Claude Code elsewhere reach the records, memory and files you choose through one address, hold only what you give, ask before they change anything, and stop the moment you end them.",
  "roles": ["box"],
  "requires": [],
  "does": {
    "tools": [
      { "name": "outside.register", "effect": "write", "reach": "person" },
      { "name": "outside.token", "effect": "write", "reach": "person" },
      { "name": "outside.grant", "effect": "write", "reach": "person" },
      { "name": "outside.ungrant", "effect": "write", "reach": "person" },
      { "name": "outside.list", "effect": "read", "reach": "person" },
      { "name": "outside.revoke", "effect": "write", "reach": "person" },
      { "name": "outside.release", "reach": "modules" },
      { "name": "outside.mcp.status", "reach": "modules" },
      { "name": "outside.mcp.base", "reach": "modules" }
    ]
  },
  "watches": {
    "emits": ["outside.registered", "outside.granted", "outside.used", "outside.held", "outside.revoked", "outside.refused"]
  },
  "shows": {},
  "needs": {
    "kernel": {
      "outside": true,
      "actions": [],
      "mints": [
        { "prefix": "*", "actions": ["records.read", "records.create", "records.update"] },
        { "prefix": "memory", "actions": ["memory.read"] },
        { "prefix": "project/*", "actions": ["project.reach"] },
        { "prefix": "file/*", "actions": ["drive.read"] }
      ]
    }
  },
  "teaches": {}
}
