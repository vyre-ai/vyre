{
  "name": "names",
  "version": "0.1.0",
  "roles": [
    "box"
  ],
  "requires": [],
  "does": {
    "reads": [
      "names.check",
      "names.status"
    ],
    "tools": [
      {
        "name": "names.status",
        "reach": "anyone"
      },
      {
        "name": "names.check",
        "reach": "anyone"
      },
      {
        "name": "names.claim",
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "names.domain.check",
        "reach": "person",
        "effect": "read"
      },
      {
        "name": "names.release",
        "reach": "person",
        "effect": "write"
      }
    ]
  },
  "watches": {
    "emits": [
      "name.claimed",
      "name.moved",
      "name.released"
    ]
  },
  "shows": {
    "cli": [
      "name"
    ]
  },
  "needs": {},
  "teaches": {
    "tips": [
      {
        "id": "check-name",
        "text": "Run `vyre name check alex` to see whether alex.vyre.run is free before you claim it.",
        "surfaces": [
          "cli"
        ],
        "level": "discovery",
        "trigger": "never-used",
        "since": "0.1.0",
        "command": "vyre name check <name>"
      },
      {
        "id": "address",
        "text": "Run `vyre name` to print the name your server holds.",
        "surfaces": [
          "cli"
        ],
        "level": "first-use",
        "trigger": "on-use",
        "since": "0.1.0",
        "command": "vyre name"
      }
    ]
  }
}
