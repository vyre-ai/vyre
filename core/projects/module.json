{
  "name": "projects",
  "version": "0.1.0",
  "roles": ["box", "local"],
  "requires": [],
  "does": {
    "tools": [
      "projects.list", "projects.create", "projects.add-threads", "projects.remove-threads",
      "projects.catalog", "projects.of", "projects.threads", "projects.context", "projects.move"
    ]
  },
  "watches": { "emits": ["project.created", "project.changed", "thread.picked", "thread.unpicked", "projects.moved"] },
  "shows": { "cli": ["projects", "new", "open", "resume", "start", "context", "threads", "pick", "unpick"] },
  "needs": {},
  "teaches": {},
  "settings": [
    {"key": "projects.folder", "group": "files", "label": "Where new projects go", "type": "string", "levels": ["account"], "apply": "restart", "store": {"config": "projectsDir"}}
  ]
}
