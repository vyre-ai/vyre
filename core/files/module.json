{
  "name": "files",
  "version": "0.1.0",
  "description": "Find, look at and bring over files on this machine and the box, inside the folders the user chose and never anywhere secret.",
  "roles": ["box", "local"],
  "requires": [],
  "does": { "reads": ["files.drive.list", "files.drive.read", "files.drive.search", "files.drive.status"], "tools": [
    {"name": "files.search", "effect": "read", "reach": "anyone"},
    {"name": "files.stat", "effect": "read", "reach": "anyone"},
    {"name": "files.dirs", "effect": "read", "reach": "anyone"},
    {"name": "files.recent", "effect": "read", "reach": "anyone"},
    {"name": "files.preview", "effect": "read", "reach": "anyone"},
    {"name": "files.fetch", "effect": "write", "reach": "anyone"},
    {"name": "files.send", "effect": "write", "reach": "person"},
    {"name": "files.deliver", "outward": true, "effect": "write", "reach": "person"},
    {"name": "files.receive", "effect": "write", "reach": "person"},
    {"name": "files.drop.register", "effect": "write", "reach": "person"},
    {"name": "files.drop.unregister", "effect": "write", "reach": "person"},
    {"name": "files.drop.targets", "effect": "read", "reach": "person"},
    {"name": "files.drop.begin", "effect": "write", "reach": "person"},
    {"name": "files.drop.put", "effect": "write", "reach": "person"},
    {"name": "files.drop.finish", "effect": "write", "reach": "person"},
    {"name": "files.drop.cancel", "effect": "write", "reach": "person"},
    {"name": "files.drop.pending", "effect": "read", "reach": "person"},
    {"name": "files.drop.meta", "effect": "read", "reach": "person"},
    {"name": "files.drop.get", "effect": "read", "reach": "person"},
    {"name": "files.drop.ack", "effect": "write", "reach": "person"},
    {"name": "files.drop.push", "reach": "modules"},
    {"name": "files.drop.offered", "reach": "modules"},
    {"name": "files.drive.status", "reach": "anyone"},
    {"name": "files.drive.upload", "outward": true, "effect": "write", "reach": "person"},
    {"name": "files.drive.versions", "effect": "read", "reach": "person"},
    {"name": "files.drive.restore", "effect": "write", "reach": "person"},
    {"name": "files.drive.space.list", "effect": "read", "reach": "person"},
    {"name": "files.drive.space.read", "effect": "read", "reach": "person"},
    {"name": "files.drive.share", "outward": true, "effect": "write", "reach": "person"},
    {"name": "files.drive.unshare", "effect": "write", "reach": "person"},
    {"name": "files.drive.access", "effect": "write", "reach": "person"},
    {"name": "files.drive.audit", "effect": "read", "reach": "anyone"},
    {"name": "files.drive.search", "reach": "anyone"},
    {"name": "files.drive.address", "effect": "read", "reach": "person"},
    {"name": "files.mentions.search", "effect": "read", "reach": "person"},
    {"name": "files.mentions.resolve", "reach": "modules"},
    {"name": "files.drive.list", "reach": "anyone"},
    {"name": "files.drive.read", "reach": "anyone"},
    {"name": "files.drive.candidates", "effect": "read", "reach": "anyone"},
    {"name": "files.drive.measure", "effect": "read", "reach": "anyone"},
    {"name": "files.drive.offer", "outward": true, "effect": "write", "reach": "person"},
    {"name": "files.drive.url", "outward": true, "effect": "read", "reach": "person"},
    {"name": "files.drive.mount", "effect": "write", "reach": "person"},
    {"name": "files.drive.unmount", "effect": "write", "reach": "person"},
    {"name": "files.drive.open", "effect": "write", "reach": "person"},
    {"name": "files.drive.local", "effect": "read", "reach": "anyone"}
  ] },
  "mentions": [{"kind": "drive", "label": "Files", "icon": "file", "search": "files.mentions.search", "resolve": "files.mentions.resolve"}],
  "watches": { "emits": ["files.sent", "files.received", "drive.exposed"] },
  "shows": { "deck": [], "capsule": [], "cli": ["files", "send"] },
  "needs": {},
  "teaches": {
    "tips": [
      {"id": "send-taildrop", "text": "`vyre send report.pdf` sends a file to another of your computers. If it is asleep, the file waits on your server.", "surfaces": ["cli"], "level": "first-use", "trigger": "on-use", "since": "0.1.0", "command": "vyre send <file>", "docs": "reference/cli.md#vyre-send"},
      {"id": "deliver-taildrop", "text": "`files.deliver` sends a server file to one of your computers once it turns files.receive on.", "surfaces": ["cli"], "level": "power", "trigger": "on-use", "since": "0.1.0", "command": "vyre call files.deliver", "docs": "reference/tools.md#files"},
      {"id": "receive-config", "text": "A computer takes files only once you turn `files.receive` on. Off by default. Applies at once.", "surfaces": ["cli", "deck"], "level": "power", "trigger": "on-use", "since": "0.1.1", "command": "vyre call files.receive", "key": "files.receive", "docs": "reference/tools.md#files"},
      {"id": "capsule-search", "text": "Press Control twice and type a file's name. The Capsule searches your Mac with Spotlight, plus up to three files from your box.", "surfaces": ["capsule"], "level": "first-use", "trigger": "on-use", "since": "0.1.0", "key": "Control Control", "docs": "using/capsule.md"},
      {"id": "never-secrets", "text": "Files never shows secrets: `.env` files, key-like names, dot folders and `~/.ssh` stay out of every search and send.", "surfaces": ["capsule", "deck", "phone", "cli"], "level": "first-use", "trigger": "on-use", "since": "0.1.0", "docs": "reference/tools.md#files"},
      {"id": "send-many", "text": "`vyre send` takes several files at once. One refused file does not stop the rest, and the exit code says if any failed.", "surfaces": ["cli"], "level": "power", "trigger": "on-use", "since": "0.1.0", "command": "vyre send <file> [more files]", "docs": "reference/cli.md#vyre-send"},
      {"id": "roots", "text": "Files looks only in the folders you chose: `/work` on a box and your home on a Mac, until `files.roots` in config.json says otherwise.", "surfaces": ["cli"], "level": "power", "trigger": "on-use", "since": "0.1.0", "key": "files.roots", "docs": "reference/tools.md#files"},
      {"id": "inbox-config", "text": "Want Taildrop files somewhere else on the box? Set `files.inbox` in config.json to a folder inside one of your roots.", "surfaces": ["cli"], "level": "power", "trigger": "on-use", "since": "0.1.0", "key": "files.inbox", "docs": "reference/tools.md#files"},
      {"id": "find-one-box", "text": "Open Find in the Deck, `/find`, to search sessions, files, agents, memory and projects in one box. On the phone it is a tab.", "surfaces": ["deck", "phone"], "level": "discovery", "trigger": "never-used", "since": "0.1.0", "docs": "using/deck.md"},
      {"id": "drive-mount", "text": "Mount a shared box folder at `~/Vyre/Box/<share>` with `vyre call files.drive.mount` so Finder opens box files in place.", "surfaces": ["cli", "capsule"], "level": "discovery", "trigger": "never-used", "since": "0.1.0", "command": "vyre call files.drive.mount", "docs": "reference/tools.md#files"},
      {"id": "recent-folders", "text": "`vyre call files.recent` lists the folders your sessions worked in lately, newest first, with how many sessions ran in each.", "surfaces": ["cli"], "level": "power", "trigger": "idle", "since": "0.1.0", "command": "vyre call files.recent", "docs": "reference/tools.md#files"},
      {"id": "drive-pick", "text": "`files.drive.candidates` lists the folders on your server you could share, projects first. `files.drive.measure` sizes one first.", "surfaces": ["cli"], "level": "power", "trigger": "on-use", "since": "0.2.0", "command": "vyre call files.drive.candidates", "docs": "reference/tools.md#files"},
      {"id": "drive-search", "text": "`files.drive.search` finds a file on your server by its name or what's in it, across every folder you've shared.", "surfaces": ["cli"], "level": "power", "trigger": "on-use", "since": "0.1.0", "command": "vyre call files.drive.search", "docs": "reference/tools.md#files"}
    ]
  }
}
