{
  "name": "google",
  "version": "0.1.0",
  "roles": ["box", "local"],
  "requires": ["vault", "gate"],
  "does": {
    "reads": ["google.calendar.list", "google.calendar.search", "google.find", "google.mail.read", "google.mail.search"],
    "tools": [
      { "name": "google.accounts", "reach": "anyone", "effect": "read" }, { "name": "google.add", "reach": "anyone", "effect": "write" }, { "name": "google.remove", "reach": "anyone", "effect": "write" }, { "name": "google.test", "reach": "anyone", "effect": "write" },
      { "name": "google.connect", "reach": "anyone", "effect": "write" }, { "name": "google.connect.finish", "reach": "anyone", "effect": "write" }, { "name": "google.connect.cancel", "reach": "anyone", "effect": "write" },
      { "name": "google.calendar.next", "reach": "anyone", "effect": "read" }, { "name": "google.calendar.today", "reach": "anyone", "effect": "read" }, { "name": "google.calendar.list", "reach": "anyone", "effect": "read" }, { "name": "google.calendar.search", "reach": "anyone", "effect": "read" }, { "name": "google.calendar.create", "reach": "anyone", "effect": "write" }, { "name": "google.calendar.update", "reach": "anyone", "effect": "write" },
      { "name": "google.mail.search", "reach": "anyone", "effect": "read" }, { "name": "google.mail.read", "reach": "anyone", "effect": "read" }, { "name": "google.mail.draft", "reach": "anyone", "effect": "write" }, { "name": "google.mail.send", "reach": "anyone", "effect": "write" },
      { "name": "google.find", "reach": "anyone", "effect": "read" }, { "name": "google.open", "reach": "person", "effect": "write" }, { "name": "google.release", "reach": "modules" }
    ]
  },
  "watches": { "emits": ["google.added", "google.removed", "google.drafted", "google.scheduled", "google.sent", "google.connected", "google.connect-failed"] },
  "shows": {
    "deck": ["settings:connections"],
    "capsule": {
      "results:google.find": { "title": "Google" },
      "action:google.open": { "title": "Open" },
      "action:google.open#reply": { "title": "Draft a reply", "input": { "as": "reply" } }
    },
    "cli": ["connect"]
  },
  "needs": { "vault": ["per-connection"] },
  "teaches": {
    "tips": [
      {"id": "sign-in", "text": "Connect a Google account in a browser with `vyre connect add google home --sign-in`.", "surfaces": ["cli"], "level": "first-use", "trigger": "on-use", "since": "0.1.0", "command": "vyre connect add google home --sign-in", "docs": "using/connectors.md#connect-google-calendar-and-gmail"},
      {"id": "mail-held", "text": "Mail from `google.mail.send` always waits at the Gate. A draft goes straight to Gmail and sends nothing.", "surfaces": ["chat", "deck", "phone"], "level": "first-use", "trigger": "on-use", "since": "0.1.0", "docs": "using/connectors.md#connect-google-calendar-and-gmail"},
      {"id": "invite-held", "text": "An event with attendees waits at the Gate, since Calendar emails each an invite. One with none is written at once.", "surfaces": ["chat", "deck", "phone"], "level": "first-use", "trigger": "on-use", "since": "0.1.0", "docs": "using/connectors.md#connect-google-calendar-and-gmail"},
      {"id": "dwd", "text": "Act as alex@harlowlegal.com through a Workspace service account: add the account with `--dwd`.", "surfaces": ["cli"], "level": "power", "trigger": "on-use", "since": "0.1.0", "command": "vyre connect add google work --email alex@harlowlegal.com --item <sa> --dwd", "docs": "using/connectors.md#connect-google-calendar-and-gmail"},
      {"id": "test-scopes", "text": "Test lists the scopes Google refused, and for a service account, which to allow in the admin console.", "surfaces": ["deck", "cli"], "level": "power", "trigger": "on-use", "since": "0.1.0", "docs": "using/connectors.md#connect-google-calendar-and-gmail"},
      {"id": "capsule-reply", "text": "A Google row in the Capsule opens the event or mail, or puts an empty reply in Gmail's drafts.", "surfaces": ["capsule"], "level": "discovery", "trigger": "never-used", "since": "0.1.0", "docs": "using/connectors.md#connect-google-calendar-and-gmail"},
      {"id": "no-polling", "text": "Vyre reads your calendar and mail only when asked, with the narrowest scope. Nothing polls or syncs.", "surfaces": ["deck", "chat"], "level": "discovery", "trigger": "idle", "since": "0.1.0", "docs": "using/connectors.md#connect-google-calendar-and-gmail"},
      {"id": "sender-per-account", "text": "Each Google account is its own sender at the Gate, so a held email shows the address it leaves from.", "surfaces": ["deck", "phone", "capsule"], "level": "power", "trigger": "idle", "since": "0.1.0", "docs": "using/connectors.md#connect-google-calendar-and-gmail"}
    ]
  }
}
