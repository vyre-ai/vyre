{
  "name": "link",
  "version": "0.1.0",
  "description": "Makes the Mac and the box one system: pairing, box tools from the Mac, box events on the Mac, and the Mac's sessions read from the box.",
  "roles": ["box", "local"],
  "requires": [],
  "does": { "tools": ["link.status", "link.find", "link.pair", "link.unpair", "link.call", "link.remote",
    "link.pair.request", "link.pair.poll", "link.pair.approve", "link.pair.deny", "link.pending", "link.peers", "link.hello", "link.health",
    "link.serve", "link.reply", "link.macs", "link.macs.call", "link.events"] },
  "watches": { "emits": ["link.pair-requested", "link.paired", "link.unpaired", "link.connected", "link.lost",
    "thread.queued", "thread.sent", "thread.text", "thread.finished", "thread.stopped", "thread.contended", "thread.limit"] },
  "shows": { "deck": [], "capsule": [], "cli": ["link"] },
  "needs": { "callAs": ["link:box"] },
  "teaches": {}
}
