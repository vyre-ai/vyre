{
  "name": "link",
  "version": "0.1.0",
  "description": "The companion core's side on a server: pairing a Windows PC's local core under its desktop app device and verifying its signed calls.",
  "roles": [
    "box"
  ],
  "requires": [],
  "does": {
    "tools": [
      {
        "name": "link.companion.pair",
        "reach": "anyone"
      },
      {
        "name": "link.companion.hello",
        "reach": "anyone"
      },
      {
        "name": "link.companion.verify",
        "reach": "modules"
      },
      {
        "name": "link.companion.approve",
        "reach": "person"
      },
      {
        "name": "link.companion.remove",
        "reach": "person"
      },
      {
        "name": "link.companion.list",
        "reach": "person"
      }
    ]
  },
  "watches": {
    "emits": [
      "companion.paired",
      "companion.requested",
      "companion.refused",
      "companion.removed"
    ]
  },
  "shows": {
    "deck": [],
    "capsule": [],
    "cli": []
  },
  "needs": {},
  "teaches": {
    "tips": []
  }
}
