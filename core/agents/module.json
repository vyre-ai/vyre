{
  "name": "agents",
  "version": "0.1.0",
  "roles": [
    "box",
    "local"
  ],
  "requires": [
    "threads"
  ],
  "does": {
    "reads": [
      "agents.history",
      "agents.list",
      "agents.versions",
      "agents.docs.get",
      "agents.context.list",
      "agents.vault.list",
      "agents.used",
      "agents.access.get"
    ],
    "tools": [
      {
        "name": "agents.scope",
        "reach": "modules"
      },
      {
        "name": "agents.list",
        "reach": "anyone"
      },
      {
        "name": "agents.create",
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "agents.update",
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "agents.ask",
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "agents.rollover",
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "agents.job",
        "reach": "modules"
      },
      {
        "name": "agents.woken",
        "summary": "the task a wake job thread is for (the Flows host only)",
        "reach": "modules",
        "effect": "read"
      },
      {
        "name": "agents.wake-done",
        "summary": "mark a task's wake over so it stops counting as a running job (the Flows host only)",
        "reach": "modules",
        "effect": "write"
      },
      {
        "name": "agents.wake-failed",
        "summary": "mark a task's wake failed so one retry may start it (the Flows host only)",
        "reach": "modules",
        "effect": "write"
      },
      {
        "name": "agents.wake",
        "summary": "wake an agent for a task it was given (the Flows host only)",
        "reach": "modules",
        "effect": "write"
      },
      {
        "name": "agents.threads",
        "reach": "anyone",
        "effect": "read"
      },
      {
        "name": "agents.uid",
        "summary": "an agent's stable id for the grants made for it (the projects, plugin-agent and vault modules only)",
        "reach": "modules",
        "effect": "read"
      },
      {
        "name": "agents.credentials",
        "summary": "the sign-in picked for an agent, as a launch takes it (the team module's teammate turns only)",
        "reach": "modules",
        "effect": "read"
      },
      {
        "name": "agents.stop",
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "agents.resume",
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "agents.history",
        "reach": "anyone"
      },
      {
        "name": "agents.usage",
        "reach": "anyone",
        "effect": "read"
      },
      {
        "name": "agents.delete",
        "reach": "person",
        "effect": "write"
      },
      {
        "name": "agents.change.draft",
        "reach": "modules",
        "effect": "write"
      },
      {
        "name": "agents.change.title",
        "reach": "modules"
      },
      {
        "name": "agents.change.apply",
        "reach": "modules",
        "effect": "write"
      },
      {
        "name": "agents.versions",
        "reach": "anyone"
      },
      {
        "name": "agents.spawn",
        "projectArg": [
          "project"
        ],
        "reach": "anyone",
        "effect": "write"
      },
      {
        "name": "agents.mirror",
        "reach": "modules",
        "effect": "write"
      },
      {
        "name": "agents.maker",
        "summary": "who made an agent (the kernel's check of an agent approver)",
        "reach": "modules",
        "effect": "read"
      },
      {
        "name": "agents.instructions",
        "summary": "an agent's instructions text, for a session's system prompt",
        "reach": "modules",
        "effect": "read"
      },
      {
        "name": "agents.docs.get",
        "reach": "person",
        "effect": "read"
      },
      {
        "name": "agents.docs.set",
        "reach": "person",
        "effect": "write"
      },
      {
        "name": "agents.context.list",
        "reach": "person",
        "effect": "read"
      },
      {
        "name": "agents.context.add",
        "reach": "person",
        "effect": "write"
      },
      {
        "name": "agents.context.remove",
        "reach": "person",
        "effect": "write"
      },
      {
        "name": "agents.context.link",
        "reach": "person",
        "effect": "write"
      },
      {
        "name": "agents.context.unlink",
        "reach": "person",
        "effect": "write"
      },
      {
        "name": "agents.vault.list",
        "reach": "person",
        "effect": "read"
      },
      {
        "name": "agents.vault.assign",
        "reach": "person",
        "effect": "write"
      },
      {
        "name": "agents.vault.unassign",
        "reach": "person",
        "effect": "write"
      },
      {
        "name": "agents.used",
        "reach": "person",
        "effect": "read"
      },
      {
        "name": "agents.access.get",
        "reach": "person",
        "effect": "read"
      },
      {
        "name": "agents.access.set",
        "reach": "person",
        "effect": "write"
      }
    ]
  },
  "watches": {
    "emits": [
      "summon.queued",
      "summon.started",
      "summon.thread",
      "summon.finished"
    ]
  },
  "shows": {
    "cli": [
      "agents"
    ]
  },
  "needs": {
    "vault": [
      "per-agent"
    ],
    "daemon": [
      "credentials",
      "agentActor"
    ],
    "kernel": {
      "actions": [
        "records.read",
        "records.create",
        "records.update",
        "records.remove",
        "events.read"
      ],
      "types": [
        {
          "name": "agent",
          "label": "Agent",
          "icon": "IconRobot",
          "fields": [
            {
              "name": "name",
              "kind": "text",
              "label": "Name",
              "required": true
            },
            {
              "name": "uid",
              "kind": "text",
              "label": "Id",
              "unique": true,
              "hidden_from": [
                "member",
                "manager",
                "temp"
              ]
            },
            {
              "name": "kind",
              "kind": "choice",
              "label": "Kind",
              "options": [
                "assistant",
                "agent"
              ]
            },
            {
              "name": "owner",
              "kind": "text",
              "label": "Owner"
            },
            {
              "name": "builtin",
              "kind": "boolean",
              "label": "Built in"
            },
            {
              "name": "model",
              "kind": "text",
              "label": "Model"
            },
            {
              "name": "folder",
              "kind": "text",
              "label": "Folder"
            },
            {
              "name": "projects",
              "kind": "text",
              "label": "Projects"
            },
            {
              "name": "users",
              "kind": "text",
              "label": "Who may use it"
            },
            {
              "name": "tags",
              "kind": "text",
              "label": "Tags",
              "hidden_from": [
                "member",
                "manager",
                "temp"
              ]
            }
          ]
        }
      ],
      "membership": true,
      "mints": [
        {
          "prefix": "agent",
          "actions": [
            "agents.use",
            "agents.edit"
          ]
        }
      ]
    }
  },
  "teaches": {
    "tips": [
      {
        "id": "ask-cli",
        "text": "Ask an agent from the terminal: `vyre agents ask juno \"What changed in Harlow Legal this week?\"`.",
        "surfaces": [
          "cli"
        ],
        "level": "first-use",
        "trigger": "on-use",
        "since": "0.1.0",
        "command": "vyre agents ask juno \"What changed in Harlow Legal this week?\"",
        "docs": "using/agents.md#talk-to-the-assistant-or-an-agent"
      },
      {
        "id": "at-agent-capsule",
        "text": "Press Control twice and type `@kit` to send to kit instead of your assistant. Sends to shows where Enter goes.",
        "surfaces": [
          "capsule"
        ],
        "level": "first-use",
        "trigger": "on-use",
        "since": "0.1.0",
        "key": "Control Control",
        "docs": "using/agents.md#talk-to-the-assistant-or-an-agent"
      },
      {
        "id": "list",
        "text": "Run `vyre agents` for every agent, the assistant first, with what each is doing now.",
        "surfaces": [
          "cli"
        ],
        "level": "first-use",
        "trigger": "on-use",
        "since": "0.1.0",
        "command": "vyre agents",
        "docs": "using/agents.md#see-what-agents-are-doing-and-what-they-cost"
      },
      {
        "id": "usage",
        "text": "See turns, time, tokens and dollars against each budget with `vyre agents usage`.",
        "surfaces": [
          "cli"
        ],
        "level": "power",
        "trigger": "on-use",
        "since": "0.1.0",
        "command": "vyre agents usage",
        "docs": "using/agents.md#see-what-agents-are-doing-and-what-they-cost"
      },
      {
        "id": "scope-projects",
        "text": "Keep kit inside two clients: `vyre agents create kit --projects harlow-legal,northwind-bakery`.",
        "surfaces": [
          "cli"
        ],
        "level": "power",
        "trigger": "on-use",
        "since": "0.1.0",
        "command": "vyre agents create kit --projects harlow-legal,northwind-bakery",
        "docs": "using/agents.md#make-an-agent"
      },
      {
        "id": "budget",
        "text": "Cap kit's API spend with `vyre agents update kit --budget 20`. At 80% its thread is told; at 100% it stops.",
        "surfaces": [
          "cli"
        ],
        "level": "power",
        "trigger": "on-use",
        "since": "0.1.0",
        "command": "vyre agents update kit --budget 20",
        "docs": "using/agents.md#run-an-agent-on-your-own-quota"
      },
      {
        "id": "stop",
        "text": "`vyre agents stop kit` stops every running thread of kit. Its record and transcripts stay.",
        "surfaces": [
          "cli"
        ],
        "level": "power",
        "trigger": "on-use",
        "since": "0.1.0",
        "command": "vyre agents stop kit",
        "docs": "using/agents.md#see-what-agents-are-doing-and-what-they-cost"
      },
      {
        "id": "computer",
        "text": "Give an agent its own computer, with a desktop, Chrome and a terminal, from its board, then watch it in Glass.",
        "surfaces": [
          "deck",
          "glass"
        ],
        "level": "discovery",
        "trigger": "never-used",
        "since": "0.1.0",
        "docs": "using/agents.md#give-an-agent-a-computer"
      },
      {
        "id": "phone-at",
        "text": "On the phone, Find asks your assistant, and `@kit ...` there asks kit.",
        "surfaces": [
          "phone"
        ],
        "level": "discovery",
        "trigger": "idle",
        "since": "0.1.0",
        "docs": "using/agents.md#talk-to-the-assistant-or-an-agent"
      },
      {
        "id": "change-next-thread",
        "text": "A change to an agent applies from its next thread, so a running one finishes with what it had.",
        "surfaces": [
          "cli",
          "deck"
        ],
        "level": "power",
        "trigger": "idle",
        "since": "0.1.0",
        "docs": "using/agents.md#make-an-agent"
      }
    ]
  }
}
