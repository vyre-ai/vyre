{
  "name": "appmods",
  "version": "0.1.0",
  "description": "Apps from the open-source world as modules: a catalog of pinned apps (Documents first) that run on this server, with their screens, their API as a Connection and their events.",
  "roles": ["box"],
  "requires": ["vault"],
  "needs": { "daemon": ["flowsHost"], "vault": ["per-app"], "kernel": { "actions": ["drive.write", "drive.read"], "prefixes": ["file/Signed"] } },
  "does": {
    "tools": [
      { "name": "appmods.catalog", "effect": "read", "reach": "anyone" },
      { "name": "appmods.card", "effect": "read", "reach": "anyone" },
      { "name": "appmods.list", "effect": "read", "reach": "anyone" },
      { "name": "appmods.status", "effect": "read", "reach": "anyone" },
      { "name": "appmods.screens", "effect": "read", "reach": "anyone" },
      { "name": "appmods.open", "effect": "write", "reach": "person" },
      { "name": "appmods.hosts", "effect": "read", "reach": "anyone" },
      { "name": "appmods.front", "effect": "read", "reach": "modules" },
      { "name": "appmods.signed.link", "effect": "write", "reach": "modules" },
      { "name": "appmods.signing.request", "effect": "write", "reach": "modules" },
      { "name": "appmods.logs", "effect": "read", "reach": "person" },
      { "name": "appmods.install", "effect": "write", "reach": "person" },
      { "name": "appmods.start", "effect": "write", "reach": "person" },
      { "name": "appmods.stop", "effect": "write", "reach": "person" },
      { "name": "appmods.remove", "effect": "write", "reach": "person" },
      { "name": "appmods.hook", "effect": "write", "reach": "hook" },
      { "name": "appmods.origin", "effect": "read", "reach": "modules" },
      { "name": "appmods.ticket", "effect": "write", "reach": "modules" },
      { "name": "appmods.drop", "effect": "write", "reach": "modules" },
      { "name": "appmods.connection", "effect": "read", "reach": "anyone" }
    ]
  },
  "watches": { "emits": ["appmods.installed", "appmods.removed", "appmods.started", "appmods.stopped", "appmods.restarted", "documents.signed", "documents.form-completed"], "on": ["vault.item-changed"] },
  "shows": { "cli": [] },
  "views": {
    "documents-waiting": {
      "title": "Waiting for signature", "icon": "clock", "root": true, "keywords": ["sign", "signature", "documents", "contract", "nda"],
      "list": {
        "connection": "documents", "operation": "submissions.list", "input": { "query": { "status": "pending", "limit": 50 } },
        "map": { "rows": "body.data", "id": "id", "title": "template.name", "subtitle": "submitters.0.email", "accessory": "status" },
        "empty": "Nothing is waiting for a signature."
      }
    },
    "documents-send": {
      "title": "Send for signature", "icon": "paperplane", "root": true, "arg": { "name": "q", "placeholder": "Signer's e-mail" }, "keywords": ["sign", "signature", "documents", "contract", "nda", "send"],
      "list": {
        "connection": "documents", "operation": "templates.list", "input": { "query": { "limit": 50 } },
        "map": { "rows": "body.data", "id": "id", "title": "name", "subtitle": "folder_name" },
        "empty": "Make a template first: open Documents from the Apps screen.",
        "actions": [{ "id": "send", "title": "Send for signature", "form": "send" }]
      },
      "forms": {
        "send": {
          "title": "Send {title} for signature",
          "fields": [{ "name": "email", "label": "Signer's e-mail", "type": "text", "required": true, "default": "{q}" }, { "name": "name", "label": "Signer's name", "type": "text" }],
          "submit": { "title": "Send", "connection": "documents", "operation": "submissions.create", "input": { "body": { "template_id": "{id}", "send_email": false, "submitters": [{ "email": "{email}", "name": "{name}" }] } }, "outward": true }
        }
      }
    }
  },
  "teaches": {}
}
