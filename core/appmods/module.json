{
  "name": "appmods",
  "version": "0.1.0",
  "description": "Apps from the open-source world as modules: a catalog of pinned apps (DocuSeal first) that run on this server, with their screens, their API as a Connection and their events.",
  "roles": ["box"],
  "requires": ["vault"],
  "needs": { "daemon": ["flowsHost"], "vault": ["per-app"], "kernel": { "actions": ["drive.write", "drive.read"], "prefixes": ["file/Signed"] } },
  "does": {
    "tools": [
      { "name": "appmods.catalog", "effect": "read", "reach": "anyone" },
      { "name": "appmods.card", "effect": "read", "reach": "anyone" },
      { "name": "appmods.list", "effect": "read", "reach": "anyone" },
      { "name": "appmods.status", "effect": "read", "reach": "anyone" },
      { "name": "appmods.screens", "effect": "read", "reach": "anyone" },
      { "name": "appmods.open", "effect": "write", "reach": "person" },
      { "name": "appmods.hosts", "effect": "read", "reach": "anyone" },
      { "name": "appmods.logs", "effect": "read", "reach": "person" },
      { "name": "appmods.install", "effect": "write", "reach": "person" },
      { "name": "appmods.start", "effect": "write", "reach": "person" },
      { "name": "appmods.stop", "effect": "write", "reach": "person" },
      { "name": "appmods.remove", "effect": "write", "reach": "person" },
      { "name": "appmods.hook", "effect": "write", "reach": "hook" },
      { "name": "appmods.origin", "effect": "read", "reach": "modules" },
      { "name": "appmods.connection", "effect": "read", "reach": "anyone" }
    ]
  },
  "watches": { "emits": ["appmods.installed", "appmods.removed", "appmods.started", "appmods.stopped", "docuseal.signed", "docuseal.form-completed"] },
  "shows": { "cli": [] },
  "teaches": {}
}
