{
  "name": "vyre",
  "version": "0.2.2",
  "description": "Agents with their own computers, on your own box. Runs Claude Code on a machine you own and adds structure, memory, a vault and a private address.",
  "type": "module",
  "bin": {
    "vyre": "bin/vyre",
    "git-credential-vyre": "bin/git-credential-vyre"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "pretest": "node test/tmp-guard.mjs before",
    "test:windows": "node --test --test-timeout=120000 --test-reporter=spec core/config/palette.test.js core/config/theme.test.js core/config/config.test.js core/config/claude-home.test.js test/owner-only.test.js relay/client/nodecrypto.test.js core/cli/kit.test.js core/cli/commands/voice.test.js test/boundaries.test.js test/label-ancestry.test.js test/windows-sums-vector.test.js core/sessions/windows-no-shell.test.js test/docs-build.test.js test/docs-shots.test.js relay/client/channel.test.js relay/client/client.test.js relay/client/health.test.js relay/client/noise.test.js relay/client/paths.test.js relay/client/seedwords.test.js relay/client/setup.test.js relay/client/shellkey.test.js",
    "test": "node scripts/test-counts.mjs run",
    "test:counts": "node scripts/test-counts.mjs",
    "posttest": "node test/tmp-guard.mjs after",
    "perf-check": "node scripts/perf-check",
    "eval:memory": "node scripts/eval-memory.js",
    "eval:answer": "node scripts/eval-answer.js",
    "eval:said": "node scripts/eval-said.js",
    "eval:iq": "node scripts/eval-iq-prompt.js --live",
    "eval:bar": "node scripts/eval-bar.js",
    "docs:check": "node scripts/docs-check",
    "docs:build": "node scripts/build-docs",
    "docs:ref": "node scripts/gen-docs-reference",
    "golden:allow": "node scripts/gen-allow.mjs",
    "tokens": "node scripts/gen-tokens",
    "design:audit": "node scripts/design-audit",
    "docs:shots": "node scripts/docs-shots",
    "stress-drive": "nice -n 10 node scripts/stress-drive"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0"
  },
  "files": [
    "bin",
    "build.json",
    "core",
    "harness",
    "lib",
    "kernel",
    "names/worker/chain.js",
    "relay/client",
    "packages/module-sdk",
    "local",
    "deck",
    "modules",
    "names/worker/id-messages.js",
    "stores",
    "wink/forwarder",
    "!wink/forwarder/**/*_test.go",
    "records",
    "box",
    "apps/app/dist",
    "scripts/install-box.sh",
    "scripts/admin-wipe.mjs",
    "scripts/admin-anchor-reset.mjs",
    "scripts/postinstall.mjs",
    "scripts/dev-enrol-software-key.mjs",
    "scripts/dev-sign-proof.mjs",
    "docs",
    "!docs/work",
    "!docs/proposals",
    "!docs/design",
    "!docs/**/*.png",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "!**/*.test.js",
    "!scripts/boot-check.mjs",
    "!scripts/proof-box.mjs",
    "!**/fixtures/**",
    "!kernel/**/e2e/**",
    "!core/stream/e2e-*",
    "!core/stream/relay-perf.mjs",
    "!kernel/remote/run/**",
    "!stores/twenty/live/**",
    "!local/hands-chrome-mac/bench/**",
    "!local/hands-mac/bench/**",
    "!local/hands-chrome-mac/spike/**",
    "!local/hands-chrome-mac/standalone/harness/**",
    "!deck/test/**",
    "!deck/ui/lab/shots.mjs",
    "!**/node_modules/**",
    "!local/capsule/native/.build/**",
    "!local/capsule/bin/**",
    "!**/.build/**",
    "!**/*.app/**",
    "!**/DerivedData/**",
    "!local/capsule/native/Tests/**",
    "!local/capsule/native-win/**",
    "!**/.DS_Store",
    "!**/testing.js",
    "!**/testing/**",
    "packages/module-sdk/testing.js"
  ],
  "homepage": "https://vyre.run",
  "repository": {
    "type": "git",
    "url": "https://github.com/vyre-ai/vyre"
  },
  "license": "Apache-2.0",
  "keywords": [
    "claude-code",
    "agents",
    "tailscale",
    "self-hosted",
    "vault",
    "memory"
  ]
}
