{
  "name": "vyre",
  "version": "0.0.1",
  "description": "Agents with their own computers, on your own box. Runs Claude Code on a machine you own and adds structure, memory, a vault and a private address.",
  "type": "module",
  "bin": {
    "vyre": "bin/vyre",
    "git-credential-vyre": "bin/git-credential-vyre"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "pretest": "node test/tmp-guard.mjs before",
    "test": "node --test --test-reporter=spec \"core/**/*.test.js\" \"test/**/*.test.js\" \"deck/**/*.test.js\" \"modules/**/*.test.js\" \"local/*/*.test.js\" \"local/*/lib/*.test.js\" \"apps/test/*.test.js\"",
    "posttest": "node test/tmp-guard.mjs after",
    "perf-check": "node scripts/perf-check",
    "eval:memory": "node scripts/eval-memory.js"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.0"
  },
  "files": [
    "bin",
    "core",
    "harness",
    "local",
    "deck",
    "modules",
    "box",
    "scripts/install-box.sh",
    "docs/SPEC.md",
    "docs/MODULES.md",
    "docs/INSTALL.md",
    "docs/GETTING-STARTED.md",
    "docs/JOURNEY.md",
    "docs/adr",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "!**/*.test.js",
    "!**/fixtures/**",
    "!deck/test/**",
    "!**/node_modules/**",
    "!local/capsule/dist/**",
    "!local/capsule/bin/**",
    "!**/.DS_Store",
    "!**/testing.js",
    "!**/testing/**"
  ],
  "homepage": "https://vyre.run",
  "repository": {
    "type": "git",
    "url": "https://github.com/vyre-ai/vyre"
  },
  "license": "Apache-2.0",
  "keywords": [
    "claude-code",
    "agents",
    "tailscale",
    "self-hosted",
    "vault",
    "memory"
  ]
}
