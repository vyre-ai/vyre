        },
        {
          "read": "contact"
        },
        {
          "write": "contact"
        }
      ]
    }
  ],
  "flows": [],
  "views": [
    {
      "name": "leads_board",
      "type": "board",
      "of": "lead",
      "label": "Leads by stage",
      "groupBy": "stage",
      "columns": [
        "contact",
        "practice_area",
        "source"
      ]
    },
    {
      "name": "appointments_calendar",
      "type": "calendar",
      "of": "appointment",
      "label": "Appointments",
      "dateField": "starts",
      "filter": "stage != \"Cancelled\""
    },
    {
      "name": "clients_list",
      "type": "list",
      "of": "client",
      "label": "Clients",
