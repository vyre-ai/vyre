{
  "kind": "kit",
  "sdk": 1,
  "id": "law-firm",
  "version": 1,
  "label": "Law firm",
  "description": "For a law firm: practice area on leads, appointments, clients and projects, and a Project that follows its own stages by practice area (personal injury and estate planning to start), with the accident date, trust name and hearing date shown and required only where they apply. Install the base Kit first.",
  "types": [
    {
      "name": "lead",
      "label": "Lead",
      "icon": "IconUserPlus",
      "fields": [
        {
          "name": "contact",
          "kind": "link",
          "label": "Contact",
          "required": true,
          "to": "contact",
          "inverse": {
            "name": "leads",
            "label": "Leads"
          }
        },
        {
          "name": "practice_area",
          "kind": "choice",
          "label": "Practice area",
          "options": [
            "Personal Injury",
            "Estate Planning",
            "Family Law",
            "Immigration",
            "Business",
            "Criminal Defense",
            "Other"
          ]
        },
        {
          "name": "source",
          "kind": "choice",
          "label": "Source",
          "options": [
            "Website",
            "Referral",
            "Ad",
            "Event",
            "Phone",
            "Other"
          ]
        },
        {
          "name": "summary",
          "kind": "rich_text",
          "label": "What they need"
        },
        {
          "name": "lost_reason",
          "kind": "text",
          "label": "Why we lost them",
          "required_if": "stage == \"Lost\"",
          "visible_if": "stage == \"Lost\""
        },
        {
          "name": "stage",
          "kind": "stage",
          "label": "Stage",
          "options": [
            "New",
            "Contacted",
            "Meeting booked",
            "Qualified",
            "Converted",
            "Lost"
          ]
        }
      ],
      "stages": [
        {
          "name": "New",
          "owner": "role:attorney",
          "tasks": [
            {
              "title": "Call the lead back",
              "doer": "role:paralegal",
              "output": {
                "kind": "note"
              },
              "due_offset_ms": 86400000
            }
          ]
        },
        {
          "name": "Contacted",
          "owner": "role:attorney",
          "tasks": [
            {
              "title": "Book the consultation",
              "doer": "role:paralegal",
              "output": {
                "kind": "note"
              },
              "due_offset_ms": 172800000
            }
          ]
        },
        {
          "name": "Meeting booked",
          "owner": "role:attorney",
          "tasks": [
            {
              "title": "Prepare for the consultation",
              "doer": "role:paralegal",
              "output": {
                "kind": "note"
              },
              "due_offset_ms": 259200000
            }
          ]
        },
        {
          "name": "Qualified",
          "owner": "role:attorney",
          "tasks": [
            {
              "title": "Send the engagement letter",
              "doer": "role:attorney",
              "output": {
                "kind": "decision"
              },
              "due_offset_ms": 172800000
            }
          ]
        },
        {
          "name": "Converted"
        },
        {
          "name": "Lost"
        }
      ],
      "role": {
        "link": "contact",
        "ended": [
          "Converted",
          "Lost"
        ]
      }
    },
    {
      "name": "appointment",
      "label": "Appointment",
      "icon": "IconCalendarEvent",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "label": "Title",
          "required": true
        },
        {
          "name": "contact",
          "kind": "link",
          "label": "Contact",
          "required": true,
          "to": "contact",
          "inverse": {
            "name": "appointments",
            "label": "Appointments"
          }
        },
        {
          "name": "kind",
          "kind": "choice",
          "label": "Kind",
          "options": [
            "Consultation",
            "Meeting",
            "Follow-up",
            "Signing",
            "Call",
            "Other"
          ]
        },
        {
          "name": "practice_area",
          "kind": "choice",
          "label": "Practice area",
          "options": [
            "Personal Injury",
            "Estate Planning",
            "Family Law",
            "Immigration",
            "Business",
            "Criminal Defense",
            "Other"
          ]
        },
        {
          "name": "starts",
          "kind": "datetime",
          "label": "Starts",
          "required": true
        },
        {
          "name": "ends",
          "kind": "datetime",
          "label": "Ends"
        },
        {
          "name": "where",
          "kind": "text",
          "label": "Where or link"
        },
        {
          "name": "outcome",
          "kind": "text",
          "label": "Outcome",
          "visible_if": "stage == \"Completed\" or stage == \"No show\""
        },
        {
          "name": "stage",
          "kind": "stage",
          "label": "Status",
          "options": [
            "Scheduled",
            "Completed",
            "No show",
            "Cancelled"
          ]
        }
      ],
      "stages": [
        {
          "name": "Scheduled"
        },
        {
          "name": "Completed"
        },
        {
          "name": "No show"
        },
        {
          "name": "Cancelled"
        }
      ]
    },
    {
      "name": "client",
      "label": "Client",
      "icon": "IconUserCheck",
      "fields": [
        {
          "name": "contact",
          "kind": "link",
          "label": "Contact",
          "required": true,
          "to": "contact",
          "inverse": {
            "name": "clients",
            "label": "Clients"
          }
        },
        {
          "name": "practice_area",
          "kind": "choice",
          "label": "Practice area",
          "options": [
            "Personal Injury",
            "Estate Planning",
            "Family Law",
            "Immigration",
            "Business",
            "Criminal Defense",
            "Other"
          ]
        },
        {
          "name": "since",
          "kind": "date",
          "label": "Client since"
        },
        {
          "name": "stage",
          "kind": "stage",
          "label": "Stage",
          "options": [
            "Onboarding",
            "Active",
            "Closed"
          ]
        }
      ],
      "stages": [
        {
          "name": "Onboarding",
          "owner": "role:attorney",
          "tasks": [
            {
              "title": "Welcome the client and collect documents",
              "doer": "role:paralegal",
              "output": {
                "kind": "note"
              },
              "due_offset_ms": 259200000
            }
          ]
        },
        {
          "name": "Active"
        },
        {
          "name": "Closed"
        }
      ],
      "role": {
        "link": "contact",
        "ended": [
          "Closed"
        ]
      }
    },
    {
      "name": "project",
      "label": "Project",
      "icon": "IconFolder",
      "kind": "project",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "label": "Name",
          "required": true
        },
        {
          "name": "slug",
          "kind": "text",
          "label": "Short name used in addresses",
          "unique": true
        },
        {
          "name": "status",
          "kind": "choice",
          "label": "Status",
          "options": [
            "active",
            "archived",
            "moved"
          ]
        },
        {
          "name": "client",
          "kind": "link",
          "label": "Client",
          "to": "contact",
          "inverse": {
            "name": "projects",
            "label": "Projects"
          }
        },
        {
          "name": "owner",
          "kind": "actor",
          "label": "Owner"
        },
        {
          "name": "due",
          "kind": "date",
          "label": "Due"
        },
        {
          "name": "drive_path",
          "kind": "text",
          "label": "Drive folder"
        },
        {
          "name": "repo",
          "kind": "text",
          "label": "Repository"
        },
        {
          "name": "memory_scope",
          "kind": "text",
          "label": "Memory scope"
        },
        {
          "name": "archived_at",
          "kind": "datetime",
          "label": "Archived"
        },
        {
          "name": "moved_to",
          "kind": "text",
          "label": "Moved to (Space and project) when it left this Space"
        },
        {
          "name": "moved_from",
          "kind": "text",
          "label": "Moved from (Space and project) when it came from another"
        },
        {
          "name": "template",
          "kind": "text",
          "label": "Template it started from (blank when none)"
        },
        {
          "name": "template_version",
          "kind": "text",
          "label": "Template version it started from"
        },
        {
          "name": "lead",
          "kind": "text",
          "label": "Project lead (an agent of the Space; a template may name one)"
        },
        {
          "name": "personal_of",
          "kind": "text",
          "label": "The person whose private Personal project this is (blank for every other project)"
        },
        {
          "name": "tags",
          "kind": "text",
          "label": "Tags"
        },
        {
          "name": "practice_area",
          "kind": "choice",
          "label": "Practice area",
          "options": [
            "Personal Injury",
            "Estate Planning",
            "Family Law",
            "Immigration",
            "Business",
            "Criminal Defense",
            "Other"
          ]
        },
        {
          "name": "accident_date",
          "kind": "date",
          "label": "Accident date",
          "required_if": "practice_area == \"Personal Injury\"",
          "visible_if": "practice_area == \"Personal Injury\""
        },
        {
          "name": "trust_name",
          "kind": "text",
          "label": "Trust or plan name",
          "visible_if": "practice_area == \"Estate Planning\""
        },
        {
          "name": "hearing_date",
          "kind": "date",
          "label": "Next hearing",
          "visible_if": "practice_area == \"Family Law\" or practice_area == \"Criminal Defense\""
        },
        {
          "name": "stage",
          "kind": "stage",
          "label": "Stage",
          "options": [
            "New",
            "Active",
            "Review",
            "Done",
            "Intake",
            "Treating",
            "Demand",
            "Negotiation",
            "Settled",
            "Closed",
            "Drafting",
            "Signing",
            "Funding"
          ]
        }
      ],
      "stages": [
        {
          "name": "New",
          "owner": "role:attorney",
          "tasks": [
            {
              "title": "Scope the work and assign it",
              "doer": "role:attorney",
              "output": {
                "kind": "note"
              },
              "due_offset_ms": 172800000
            }
          ]
        },
        {
          "name": "Active"
        },
        {
          "name": "Review",
          "owner": "role:attorney",
          "tasks": [
            {
              "title": "Review the work",
              "doer": "role:attorney",
              "output": {
                "kind": "decision"
              },
              "due_offset_ms": 604800000
            }
          ]
        },
        {
          "name": "Done"
        }
      ],
      "stage_sets": [
        {
          "name": "personal_injury",
          "when": "practice_area == \"Personal Injury\"",
          "stages": [
            {
              "name": "Intake",
              "owner": "role:attorney",
              "tasks": [
                {
                  "title": "Collect intake and the signed retainer",
                  "doer": "role:paralegal",
                  "output": {
                    "kind": "note"
                  },
                  "due_offset_ms": 259200000
                }
              ]
            },
            {
              "name": "Treating",
              "owner": "role:attorney",
              "tasks": [
                {
                  "title": "Check in on treatment and collect records",
                  "doer": "role:paralegal",
                  "output": {
                    "kind": "note"
                  },
                  "due_offset_ms": 1209600000
                }
              ]
            },
            {
              "name": "Demand",
              "owner": "role:attorney",
              "tasks": [
                {
                  "title": "Draft the demand letter",
                  "doer": "role:attorney",
                  "output": {
                    "kind": "file"
                  },
                  "due_offset_ms": 1209600000
                }
              ]
            },
            {
              "name": "Negotiation",
              "owner": "role:attorney",
              "enter_if": "not empty(accident_date)",
              "tasks": [
                {
                  "title": "Negotiate with the adjuster",
                  "doer": "role:attorney",
                  "output": {
                    "kind": "note"
                  },
                  "due_offset_ms": 2419200000
                }
              ]
            },
            {
              "name": "Settled",
              "owner": "role:attorney",
              "tasks": [
                {
                  "title": "Disburse the settlement funds",
                  "doer": "role:attorney",
                  "output": {
                    "kind": "note"
                  },
                  "due_offset_ms": 1209600000
                }
              ]
            },
            {
              "name": "Closed"
            }
          ]
        },
        {
          "name": "estate_planning",
          "when": "practice_area == \"Estate Planning\"",
          "stages": [
            {
              "name": "Intake",
              "owner": "role:attorney",
              "tasks": [
                {
                  "title": "Collect family and asset details",
                  "doer": "role:paralegal",
                  "output": {
                    "kind": "note"
                  },
                  "due_offset_ms": 259200000
                }
              ]
            },
            {
              "name": "Drafting",
              "owner": "role:attorney",
              "tasks": [
                {
                  "title": "Draft the documents",
                  "doer": "role:attorney",
                  "output": {
                    "kind": "file"
                  },
                  "due_offset_ms": 604800000
                }
              ]
            },
            {
              "name": "Review",
              "owner": "role:attorney",
              "tasks": [
                {
                  "title": "Client review call",
                  "doer": "role:attorney",
                  "output": {
                    "kind": "note"
                  },
                  "due_offset_ms": 1209600000
                }
              ]
            },
            {
              "name": "Signing",
              "owner": "role:attorney",
              "enter_if": "not empty(trust_name)",
              "tasks": [
                {
                  "title": "Signing ceremony",
                  "doer": "role:attorney",
                  "output": {
                    "kind": "decision"
                  },
                  "due_offset_ms": 1814400000
                }
              ]
            },
            {
              "name": "Funding",
              "owner": "role:attorney",
              "tasks": [
                {
                  "title": "Fund the trust and retitle assets",
                  "doer": "role:attorney",
                  "output": {
                    "kind": "note"
                  },
                  "due_offset_ms": 3024000000,
                  "required": false
                }
              ]
            },
            {
              "name": "Closed"
            }
          ]
        }
      ]
    }
  ],
