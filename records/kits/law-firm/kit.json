{
  "kind": "kit",
  "sdk": 1,
  "id": "law-firm",
  "version": 1,
  "label": "Law firm",
  "description": "For a law firm: practice area on leads, appointments, clients and projects, and a Project that follows its own stages by practice area (personal injury and estate planning to start), with the accident date, trust name and hearing date shown and required only where they apply. Install the base Kit first.",
  "types": [
    {
      "name": "lead",
      "label": "Lead",
      "icon": "IconUserPlus",
      "fields": [
        {
          "name": "contact",
          "kind": "link",
          "label": "Contact",
          "required": true,
          "to": "contact"
        },
        {
          "name": "practice_area",
          "kind": "choice",
          "label": "Practice area",
          "options": [
            "Personal Injury",
            "Estate Planning",
            "Family Law",
            "Immigration",
            "Business",
            "Criminal Defense",
            "Other"
          ]
        },
        {
          "name": "source",
          "kind": "choice",
          "label": "Source",
          "options": [
            "Website",
            "Referral",
            "Ad",
            "Event",
            "Phone",
            "Other"
          ]
        },
        {
          "name": "summary",
          "kind": "rich_text",
          "label": "What they need"
        },
        {
          "name": "lost_reason",
          "kind": "text",
          "label": "Why we lost them",
          "required_if": "stage == \"Lost\"",
          "visible_if": "stage == \"Lost\""
        },
        {
          "name": "stage",
          "kind": "stage",
          "label": "Stage",
          "options": [
            "New",
            "Contacted",
            "Meeting booked",
            "Qualified",
            "Converted",
            "Lost"
          ]
        }
      ],
      "stages": [
        {
          "name": "New"
        },
        {
          "name": "Contacted"
        },
        {
          "name": "Meeting booked"
        },
        {
          "name": "Qualified"
        },
        {
          "name": "Converted"
        },
        {
          "name": "Lost"
        }
      ],
      "role": {
        "link": "contact",
        "ended": [
          "Converted",
          "Lost"
        ]
      }
    },
    {
      "name": "appointment",
      "label": "Appointment",
      "icon": "IconCalendarEvent",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "label": "Title",
          "required": true
        },
        {
          "name": "contact",
          "kind": "link",
          "label": "Contact",
          "required": true,
          "to": "contact"
        },
        {
          "name": "kind",
          "kind": "choice",
          "label": "Kind",
          "options": [
            "Consultation",
            "Meeting",
            "Follow-up",
            "Signing",
            "Call",
            "Other"
          ]
        },
        {
          "name": "practice_area",
          "kind": "choice",
          "label": "Practice area",
          "options": [
            "Personal Injury",
            "Estate Planning",
            "Family Law",
            "Immigration",
            "Business",
            "Criminal Defense",
            "Other"
          ]
        },
        {
          "name": "starts",
          "kind": "datetime",
          "label": "Starts",
          "required": true
        },
        {
          "name": "ends",
          "kind": "datetime",
          "label": "Ends"
        },
        {
          "name": "where",
          "kind": "text",
          "label": "Where or link"
        },
        {
          "name": "outcome",
          "kind": "text",
          "label": "Outcome",
          "visible_if": "stage == \"Completed\" or stage == \"No show\""
        },
        {
          "name": "stage",
          "kind": "stage",
          "label": "Status",
          "options": [
            "Scheduled",
            "Completed",
            "No show",
            "Cancelled"
          ]
        }
      ],
      "stages": [
        {
          "name": "Scheduled"
        },
        {
          "name": "Completed"
        },
        {
          "name": "No show"
        },
        {
          "name": "Cancelled"
        }
      ]
    },
    {
      "name": "client",
      "label": "Client",
      "icon": "IconUserCheck",
      "fields": [
        {
          "name": "contact",
          "kind": "link",
          "label": "Contact",
          "required": true,
          "to": "contact"
        },
        {
          "name": "practice_area",
          "kind": "choice",
          "label": "Practice area",
          "options": [
            "Personal Injury",
            "Estate Planning",
            "Family Law",
            "Immigration",
            "Business",
            "Criminal Defense",
            "Other"
          ]
        },
        {
          "name": "since",
          "kind": "date",
          "label": "Client since"
        },
        {
          "name": "stage",
          "kind": "stage",
          "label": "Stage",
          "options": [
            "Onboarding",
            "Active",
            "Closed"
          ]
        }
      ],
      "stages": [
        {
          "name": "Onboarding"
        },
        {
          "name": "Active"
        },
        {
          "name": "Closed"
        }
      ],
      "role": {
        "link": "contact",
        "ended": [
          "Closed"
        ]
      }
    },
    {
      "name": "project",
      "label": "Project",
      "icon": "IconFolder",
      "kind": "project",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "label": "Name",
          "required": true
        },
        {
          "name": "slug",
          "kind": "text",
          "label": "Short name used in addresses",
          "unique": true
        },
        {
          "name": "status",
          "kind": "choice",
          "label": "Status",
          "options": [
            "active",
            "archived",
            "moved"
          ]
        },
        {
          "name": "client",
          "kind": "link",
          "label": "Client",
          "to": "contact"
        },
        {
          "name": "owner",
          "kind": "actor",
          "label": "Owner"
        },
        {
          "name": "due",
          "kind": "date",
          "label": "Due"
        },
        {
          "name": "drive_path",
          "kind": "text",
          "label": "Drive folder"
        },
        {
          "name": "repo",
          "kind": "text",
          "label": "Repository"
        },
        {
          "name": "memory_scope",
          "kind": "text",
          "label": "Memory scope"
        },
        {
          "name": "archived_at",
          "kind": "datetime",
          "label": "Archived"
        },
        {
          "name": "moved_to",
          "kind": "text",
          "label": "Moved to (Space and project) when it left this Space"
        },
        {
          "name": "moved_from",
          "kind": "text",
          "label": "Moved from (Space and project) when it came from another"
        },
        {
          "name": "practice_area",
          "kind": "choice",
          "label": "Practice area",
          "options": [
            "Personal Injury",
            "Estate Planning",
            "Family Law",
            "Immigration",
            "Business",
            "Criminal Defense",
            "Other"
          ]
        },
        {
          "name": "accident_date",
          "kind": "date",
          "label": "Accident date",
          "required_if": "practice_area == \"Personal Injury\"",
          "visible_if": "practice_area == \"Personal Injury\""
        },
        {
          "name": "trust_name",
          "kind": "text",
          "label": "Trust or plan name",
          "visible_if": "practice_area == \"Estate Planning\""
        },
        {
          "name": "hearing_date",
          "kind": "date",
          "label": "Next hearing",
          "visible_if": "practice_area == \"Family Law\" or practice_area == \"Criminal Defense\""
        },
        {
          "name": "stage",
          "kind": "stage",
          "label": "Stage",
          "options": [
            "New",
            "Active",
            "Review",
            "Done",
            "Intake",
            "Treating",
            "Demand",
            "Negotiation",
            "Settled",
            "Closed",
            "Drafting",
            "Signing",
            "Funding"
          ]
        }
      ],
      "stages": [
        {
          "name": "New"
        },
        {
          "name": "Active"
        },
        {
          "name": "Review"
        },
        {
          "name": "Done"
        }
      ],
      "stage_sets": [
        {
          "name": "personal_injury",
          "when": "practice_area == \"Personal Injury\"",
          "stages": [
            {
              "name": "Intake"
            },
            {
              "name": "Treating"
            },
            {
              "name": "Demand"
            },
            {
              "name": "Negotiation",
              "enter_if": "not empty(accident_date)"
            },
            {
              "name": "Settled"
            },
            {
              "name": "Closed"
            }
          ]
        },
        {
          "name": "estate_planning",
          "when": "practice_area == \"Estate Planning\"",
          "stages": [
            {
              "name": "Intake"
            },
            {
              "name": "Drafting"
            },
            {
              "name": "Review"
            },
            {
              "name": "Signing",
              "enter_if": "not empty(trust_name)"
            },
            {
              "name": "Funding"
            },
            {
              "name": "Closed"
            }
          ]
        }
      ]
    }
  ],
  "templates": [],
  "roles": [],
  "flows": [],
  "views": [
    {
      "name": "leads_board",
      "type": "board",
      "of": "lead",
      "label": "Leads by stage",
      "groupBy": "stage",
      "columns": [
        "contact",
        "practice_area",
        "source"
      ]
    },
    {
      "name": "appointments_calendar",
      "type": "calendar",
      "of": "appointment",
      "label": "Appointments",
      "dateField": "starts",
      "filter": "stage != \"Cancelled\""
    },
    {
      "name": "clients_list",
      "type": "list",
      "of": "client",
      "label": "Clients",
      "columns": [
        "contact",
        "practice_area",
        "stage",
        "since"
      ],
      "sort": {
        "field": "since",
        "dir": "desc"
      }
    },
    {
      "name": "projects_board",
      "type": "board",
      "of": "project",
      "label": "Projects by stage",
      "groupBy": "stage",
      "columns": [
        "name",
        "client",
        "practice_area",
        "owner",
        "due"
      ]
    },
    {
      "name": "leads_by_area",
      "type": "board",
      "of": "lead",
      "label": "Leads by practice area",
      "groupBy": "practice_area",
      "columns": [
        "contact",
        "source"
      ]
    }
  ],
  "codeSteps": []
}
