{
  "kind": "kit",
  "sdk": 1,
  "id": "estate-planning",
  "version": 1,
  "label": "Estate planning matter",
  "description": "Contacts with a sealed Social Security number, matters that move through six stages made of tasks, a welcome email, research and intake teammates, and a flow that starts a matter when a payment arrives.",
  "types": [
    {
      "name": "contact",
      "label": "Contact",
      "icon": "IconUser",
      "fields": [
        {
          "name": "name",
          "kind": "text",
          "label": "Name",
          "required": true
        },
        {
          "name": "email",
          "kind": "text",
          "label": "Email",
          "unique": true
        },
        {
          "name": "phone",
          "kind": "text",
          "label": "Phone",
          "unique": true
        },
        {
          "name": "other_emails",
          "kind": "emails",
          "label": "Other emails"
        },
        {
          "name": "other_phones",
          "kind": "phones",
          "label": "Other phones"
        },
        {
          "name": "job_title",
          "kind": "text",
          "label": "Job title"
        },
        {
          "name": "time_zone",
          "kind": "text",
          "label": "Time zone"
        },
        {
          "name": "organization",
          "kind": "link",
          "label": "Organization",
          "to": "organization"
        },
        {
          "name": "address",
          "kind": "address",
          "label": "Address"
        },
        {
          "name": "notes",
          "kind": "rich_text",
          "label": "Notes"
        },
        {
          "name": "date_of_birth",
          "kind": "date",
          "label": "Date of birth"
        },
        {
          "name": "ssn",
          "kind": "sealed",
          "label": "Social Security number",
          "description": "Never shown to a model. A model sees only that a valid one is on file.",
          "seal": {
            "level": "ai",
            "class": "us-ssn"
          }
        },
        {
          "name": "stripe_customer",
          "kind": "text",
          "label": "Stripe customer"
        }
      ]
    },
    {
      "name": "matter",
      "label": "Matter",
      "icon": "IconBriefcase",
      "fields": [
        {
          "name": "title",
          "kind": "text",
          "label": "Title",
          "required": true
        },
        {
          "name": "client",
          "kind": "link",
          "label": "Client",
          "to": "contact"
        },
        {
          "name": "plan",
          "kind": "choice",
          "label": "Plan",
          "options": [
            "Will",
            "Trust",
            "Both"
          ]
        },
        {
          "name": "fee",
          "kind": "money",
          "label": "Fee"
        },
        {
          "name": "engagement_signed",
          "kind": "boolean",
          "label": "Engagement letter signed"
        },
        {
          "name": "practice_area",
          "kind": "text",
          "label": "Practice area"
        },
        {
          "name": "household_size",
          "kind": "number",
          "label": "Household size"
        },
        {
          "name": "decision_maker",
          "kind": "text",
          "label": "Decision maker"
        },
        {
          "name": "stripe_payment",
          "kind": "text",
          "label": "Stripe payment"
        },
        {
          "name": "stage",
          "kind": "stage",
          "label": "Stage",
          "options": [
            "Intake",
            "Engagement",
            "Drafting",
            "Signing",
            "Funding",
            "Closed"
          ]
        }
      ],
      "stages": [
        {
          "name": "Intake",
          "tasks": [
            {
              "title": "Research the client",
              "doer": "teammate:research",
              "output": {
                "kind": "fields",
                "target": [
                  "practice_area",
                  "household_size",
                  "decision_maker"
                ]
              },
              "how": "assistant",
              "due_offset_ms": 86400000
            },
            {
              "title": "Welcome email",
              "doer": "teammate:intake",
              "checker": "role:attorney",
              "output": {
                "kind": "sent",
                "target": "email"
              },
              "how": "tailor",
              "template": "welcome",
              "depends_on": [
                "Research the client"
              ],
              "due_offset_ms": 86400000
            }
          ]
        },
        {
          "name": "Engagement",
          "tasks": [
            {
              "title": "Engagement letter signed",
              "doer": "role:attorney",
              "output": {
                "kind": "decision"
              },
              "due_offset_ms": 259200000
            }
          ]
        },
        {
          "name": "Drafting",
          "tasks": [
            {
              "title": "Draft the documents",
              "doer": "role:attorney",
              "output": {
                "kind": "file"
              },
              "due_offset_ms": 604800000
            },
            {
              "title": "Client review call",
              "doer": "role:attorney",
              "output": {
                "kind": "note"
              },
              "depends_on": [
                "Draft the documents"
              ],
              "due_offset_ms": 1209600000
            }
          ]
        },
        {
          "name": "Signing",
          "tasks": [
            {
              "title": "Signing ceremony",
              "doer": "role:attorney",
              "output": {
                "kind": "decision"
              },
              "due_offset_ms": 1814400000
            }
          ]
        },
        {
          "name": "Funding",
          "tasks": [
            {
              "title": "Fund the trust and retitle assets",
              "doer": "role:attorney",
              "output": {
                "kind": "note"
              },
              "due_offset_ms": 3024000000,
              "required": false
            }
          ]
        },
        {
          "name": "Closed"
        }
      ],
      "rules": [
        {
          "name": "signed_before_drafting",
          "require": "stage < 'Drafting' or engagement_signed == true"
        }
      ]
    }
  ],
  "templates": [
    {
      "name": "welcome",
      "kind": "email",
      "subject": "Welcome to Juniper Studio",
      "body": "Dear {{client.name}},\n\nThank you for choosing Juniper Studio for your estate plan. Your matter reference is {{matter.id}}.\n\nWe will start with a short call to learn about your household. Please have your Social Security number ready; we will ask for it on a secure form and never by email. Your number will be filled in here by our system: {{sealed:client.ssn}}.\n\nWarm regards,\nThe Juniper Studio team"
    }
  ],
  "roles": [
    {
      "name": "research",
      "kind": "teammate",
      "label": "Research teammate",
      "description": "Looks up public information about a new client and fills the matter's research fields.",
      "instructions": "For a new matter, find public background on the client and their household. Fill practice_area, household_size and decision_maker only from sources you can name, and leave a note that cites each one. Never ask for or guess a Social Security number.",
      "grants": [
        {
          "read": "matter"
        },
        {
          "read": "contact.name"
        },
        {
          "read": "contact.email"
        },
        {
          "write": "matter.practice_area"
        },
        {
          "write": "matter.household_size"
        },
        {
          "write": "matter.decision_maker"
        },
        {
          "create": "note"
        }
      ]
    },
    {
      "name": "intake",
      "kind": "teammate",
      "label": "Intake teammate",
      "description": "Greets new clients, drafts the welcome email and keeps the contact record complete.",
      "instructions": "Tailor the welcome template to what the research note says about the household, keep it short and warm, and send nothing until the attorney approves the draft.",
      "grants": [
        {
          "read": "matter"
        },
        {
          "read": "contact"
        },
        {
          "write": "contact.phone"
        },
        {
          "write": "contact.address"
        },
        {
          "write": "matter.plan"
        },
        {
          "create": "note"
        }
      ]
    },
    {
      "name": "attorney",
      "kind": "role",
      "label": "Attorney",
      "description": "Reviews and approves work, signs off stages and handles the legal steps.",
      "grants": [
        {
          "read": "matter"
        },
        {
          "write": "matter"
        },
        {
          "create": "matter"
        },
        {
          "read": "contact"
        },
        {
          "write": "contact"
        },
        {
          "create": "contact"
        }
      ]
    }
  ],
  "flows": [
    {
      "format": 1,
      "authorship": "kit",
      "name": "on_payment",
      "label": "On payment",
      "description": "A Stripe payment starts a matter: find or create the contact, find or create the matter, then it begins at Intake.",
      "trigger": {
        "on": "event",
        "event": "payment.received"
      },
      "steps": [
        {
          "id": "client",
          "kind": "upsert",
          "type": "contact",
          "match": {
            "stripe_customer": {
              "expr": "trigger.customer"
            }
          },
          "set": {
            "name": {
              "expr": "trigger.display"
            },
            "email": {
              "expr": "trigger.email"
            }
          }
        },
        {
          "id": "matter",
          "kind": "upsert",
          "type": "matter",
          "match": {
            "stripe_payment": {
              "expr": "trigger.payment"
            }
          },
          "set": {
            "title": {
              "expr": "\"Estate plan for \" + trigger.display"
            },
            "client": {
              "urn": {
                "expr": "steps.client.record.urn"
              }
            },
            "fee": {
              "expr": "trigger.amount"
            },
            "stage": "Intake"
          }
        }
      ]
    }
  ],
  "views": [
    {
      "name": "matters_board",
      "type": "board",
      "of": "matter",
      "label": "Matters by stage",
      "groupBy": "stage",
      "columns": [
        "title",
        "client",
        "plan",
        "fee"
      ]
    }
  ],
  "codeSteps": []
}
