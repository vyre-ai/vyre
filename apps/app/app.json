{
  "expo": {
    "name": "Vyre",
    "slug": "vyre",
    "scheme": "vyre",
    "version": "0.0.1",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "sh.vyre.app",
      "supportsTablet": true
    },
    "android": {
      "package": "sh.vyre.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0D0C"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "Vyre",
      "shortName": "Vyre",
      "backgroundColor": "#0E0D0C",
      "themeColor": "#0E0D0C",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/instrument-sans/InstrumentSans-Regular.ttf",
            "./assets/fonts/instrument-sans/InstrumentSans-SemiBold.ttf",
            "./assets/fonts/jetbrains-mono/JetBrainsMono-Regular.ttf"
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "baseUrl": "/app",
      "typedRoutes": false
    },
    "icon": "./assets/icon.png"
  }
}
