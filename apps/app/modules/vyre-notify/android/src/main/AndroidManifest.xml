<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <!-- React Native holds a wake lock for the length of a headless task (HeadlessJsTaskService): without it the service crashes the app the moment it starts the notice loop -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <application>
    <service android:name="sh.vyre.notify.KeepAliveService" android:exported="false" android:foregroundServiceType="dataSync" />
  </application>
</manifest>
