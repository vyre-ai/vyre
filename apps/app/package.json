{
  "name": "@vyre/app",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "index.js",
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-camera"
        ]
      }
    }
  },
  "scripts": {
    "web": "expo start --web",
    "export:web": "node scripts/term-assets.mjs && expo export -p web && node scripts/precache.mjs",
    "export:web:root": "node scripts/term-assets.mjs && VYRE_APP_BASE=root EXPO_PUBLIC_VYRE_APP_BASE=root expo export -p web && node scripts/precache.mjs dist /",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-ui-icons.mjs",
    "test": "node --test \"perf/*.test.js\" \"scripts/*.test.js\" \"src/**/*.test.js\" \"ui/**/*.test.js\" \"screens/**/*.test.js\" \"modules/**/*.test.js\" \"vendor/**/*.test.js\"",
    "export:web:mock": "EXPO_PUBLIC_VYRE_MOCK=1 npm run export:web",
    "lint:ui": "node scripts/check-ui-imports.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "render:check": "node scripts/render-check.mjs --dist dist-mock"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@rn-primitives/dialog": "^1.2.0",
    "@rn-primitives/dropdown-menu": "^1.2.0",
    "@rn-primitives/portal": "^1.3.0",
    "@rn-primitives/slot": "^1.2.0",
    "@rn-primitives/switch": "^1.2.0",
    "@rn-primitives/tabs": "^1.2.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-camera": "~17.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "~14.0.7",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.7",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "^0.2.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "typescript": "~5.9.2"
  }
}
