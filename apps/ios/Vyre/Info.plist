	<string>Face ID approves what you send, answers sessions and opens the Vault on this phone.</string>
	<key>UIAppFonts</key>
	<array>
		<string>InstrumentSans.ttf</string>
		<string>JetBrainsMono.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
