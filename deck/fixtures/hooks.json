{
  "hooks.list": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 7310,
    "listening": true,
    "routes": [
      {
        "name": "northwind-payments",
        "path": "/hooks/northwind-payments",
        "verify": {
          "scheme": "stripe",
          "header": "stripe-signature",
          "secret": "northwind-stripe-webhook"
        },
        "opened": "$ago:3d",
        "deliveries": 4,
        "recent": [
          {
            "id": "d-0004",
            "at": "$ago:2h",
            "bytes": 1843
          }
        ],
        "funnel": {
          "open": "tailscale funnel --bg --https=8443 --set-path=/hooks/northwind-payments http://127.0.0.1:7310/hooks/northwind-payments",
          "close": "tailscale funnel --https=8443 --set-path=/hooks/northwind-payments off"
        }
      },
      {
        "name": "harlow-forms",
        "path": "/hooks/harlow-forms",
        "verify": {
          "scheme": "hmac-sha256",
          "header": "x-signature",
          "secret": "harlow-forms-secret"
        },
        "opened": "$ago:1h",
        "deliveries": 0,
        "recent": [],
        "funnel": {
          "open": "tailscale funnel --bg --https=8443 --set-path=/hooks/harlow-forms http://127.0.0.1:7310/hooks/harlow-forms",
          "close": "tailscale funnel --https=8443 --set-path=/hooks/harlow-forms off"
        }
      }
    ]
  },
  "hooks.status": {
    "routes": [
      {
        "name": "northwind-payments",
        "path": "/hooks/northwind-payments",
        "verify": {
          "scheme": "stripe",
          "header": "stripe-signature",
          "secret": "northwind-stripe-webhook"
        },
        "opened": "$ago:3d",
        "deliveries": 4,
        "recent": [
          {
            "id": "d-0004",
            "at": "$ago:2h",
            "bytes": 1843
          }
        ],
        "funnel": {
          "open": "tailscale funnel --bg --https=8443 --set-path=/hooks/northwind-payments http://127.0.0.1:7310/hooks/northwind-payments",
          "close": "tailscale funnel --https=8443 --set-path=/hooks/northwind-payments off"
        }
      },
      {
        "name": "harlow-forms",
        "path": "/hooks/harlow-forms",
        "verify": {
          "scheme": "hmac-sha256",
          "header": "x-signature",
          "secret": "harlow-forms-secret"
        },
        "opened": "$ago:1h",
        "deliveries": 0,
        "recent": [],
        "funnel": {
          "open": "tailscale funnel --bg --https=8443 --set-path=/hooks/harlow-forms http://127.0.0.1:7310/hooks/harlow-forms",
          "close": "tailscale funnel --https=8443 --set-path=/hooks/harlow-forms off"
        }
      }
    ],
    "node": {
      "dnsName": "alex-box.tail0000.ts.net",
      "funnel": true,
      "https": true,
      "ports": [
        443,
        8443,
        10000
      ]
    },
    "funnel": {
      "read": true,
      "serving": [
        {
          "host": "alex-box.tail0000.ts.net",
          "port": 8443,
          "path": "/hooks/northwind-payments",
          "kind": "proxy",
          "target": "http://127.0.0.1:7310/hooks/northwind-payments",
          "funnel": true
        }
      ]
    },
    "urls": {
      "northwind-payments": "https://alex-box.tail0000.ts.net:8443/hooks/northwind-payments"
    },
    "mismatches": [
      {
        "kind": "route-not-served",
        "route": "harlow-forms",
        "harmless": false,
        "message": "harlow-forms is open in Vyre but Funnel does not publish /hooks/harlow-forms, so no delivery can arrive",
        "fix": "tailscale funnel --bg --https=8443 --set-path=/hooks/harlow-forms http://127.0.0.1:7310/hooks/harlow-forms"
      },
      {
        "kind": "funnel-without-route",
        "route": "old-intake",
        "harmless": true,
        "message": "Funnel still forwards /hooks/old-intake, which Vyre has no open route for; vyred answers 404 there, so nothing gets in, but the path stays public until it is turned off",
        "fix": "tailscale funnel --https=8443 --set-path=/hooks/old-intake off"
      }
    ],
    "commands": {},
    "docker": null
  }
}
