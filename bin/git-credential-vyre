#!/usr/bin/env node
// git's credential helper: `git config credential.helper vyre` finds this on PATH as
// git-credential-vyre and runs it with get, store or erase. It is `vyre vault git-credential`.
const { main } = await import("../core/cli/index.js");
process.exitCode = await main(["vault", "git-credential", ...process.argv.slice(2)]);
