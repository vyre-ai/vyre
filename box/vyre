#!/bin/sh
# vyre on a Docker box: the host's `vyre` runs the CLI inside the box's container, so `vyre up`
# on the host is the same one command as on a Mac. Installed to /usr/local/bin/vyre by
# scripts/install-box.sh. The stack lives in VYRE_DIR (default /srv/vyre).
#
#   vyre up        start the stack if needed, then say whether this server is paired, and how to pair it
#   vyre up --print-link
#                  the same, but stdout is only VYRE_PAIRED=<space> or VYRE_PAIR=<command>, for a
#                  program to read (or VYRE_LINK_ONLY=1)
#   vyre update [--channel stable|beta] [--to <version>] [--allow-unsigned]
#                  bring the box to the newest release (ADR 0033, section 4). The release comes
#                  from GitHub Releases (repo vyre-ai/vyre; stable is the newest
#                  non-prerelease, beta the newest of any), or, when GitHub has no release yet, from
#                  https://vyre.run/box/. Every
#                  file is checked against the release's SHA256SUMS before anything changes, and the
#                  SHA256SUMS against its signature (SHA256SUMS.sig) from Vyre's release key: an unsigned or
#                  badly signed release is refused, and only --allow-unsigned (with a plain warning) installs
#                  one anyway. Then
#                  it backs up the database, tags the running image vyre:prev, keeps src.prev and
#                  box.prev, refreshes the box files and this wrapper (never .env), rebuilds or
#                  pulls, and waits for vyred. If vyred does not come up it puts everything back,
#                  the database too, and exits 1. After a healthy update it brings the phone app
#                  along when the release has one, and nothing restores the database any more.
#   vyre update --rollback [--restore-data [--yes]]
#                  put the previous release back (src.prev, vyre:prev, box.prev, android.json.prev)
#                  and keep the current database. --restore-data also puts back the database from
#                  before the update, after a typed confirm (or --yes off a terminal).
#   vyre updater install|status|remove
#                  the automatic path: a root-owned systemd path unit (vyre-update.path) that runs
#                  `vyre update-from-request` when vyred drops the one-line file $DIR/update/request.
#                  vyred has no socket to the host and passes no arguments: the unit picks the channel
#                  (VYRE_CHANNEL in $DIR/.env, else stable), installs only a release whose SHA256SUMS
#                  carries a valid signature from Vyre's pinned release key, never goes back a version,
#                  and writes its progress and result to $DIR/update-state/status.json, which vyred
#                  reads through a read-only mount. Set up by install-box.sh and by `vyre update`.
#   vyre uninstall [--delete-data | --keep-data] [--yes]
#                  stop Vyre and take it off this server. It lists every volume with what is in it and asks
#                  once whether to delete them too (default: keep); saying yes IS the approval, so there
#                  is no second confirm. --delete-data or --keep-data answer for a script. Your own
#                  Docker and this folder's .env are never touched.
#   vyre logs      follow vyred's output
#   vyre ...       anything else goes to the vyre CLI in the container

# The csh lines below are single-quoted on purpose: they expand in the container's shell.
# shellcheck disable=SC2016
set -eu

# >>> seams: every environment override this wrapper reads, in one place. The RELEASE build (scripts/strip-wrapper.mjs) replaces
# this whole block with constants, so an installed wrapper reads none of them: not the release key, not the cosign image, not where
# a release comes from, not where root's folders are. Tests run against this unstripped source.
DIR=${VYRE_DIR:-/srv/vyre}
UPD_ROOT=${VYRE_UPDATE_ROOT:-/var/lib/vyre-update}
RELEASE_KEY=${VYRE_RELEASE_KEY:-MCowBQYDK2VwAyEAKXSdujH7tO/gscXCJZmYCjB+Cv1sVlOfdgLNedMR7FU=}
COSIGN_IMAGE=${VYRE_COSIGN_IMAGE:-ghcr.io/sigstore/cosign/cosign@sha256:b03690aa52bfe94054187142fba24dc54137650682810633901767d8a3e15b31}
SITE=${VYRE_BOX_URL:-https://vyre.run/box/}
API=${VYRE_RELEASES_API:-https://api.github.com}
REPO=${VYRE_RELEASES_REPO:-vyre-ai/vyre}
USE_API=1
if [ -n "${VYRE_BOX_URL:-}" ] && [ -z "${VYRE_RELEASES_API:-}" ]; then USE_API=0; fi
WRAPPER=${VYRE_WRAPPER:-/usr/local/bin/vyre}
ROOT_UID=${VYRE_ROOT_UID:-0}
CHAIN_TOP=${VYRE_CHAIN_TOP:-/}
UPDATE_WAIT=${VYRE_UPDATE_WAIT:-60}
MIN_GAP=${VYRE_UPDATE_MIN_GAP:-600}
SYSTEMD_DIR=${VYRE_SYSTEMD_DIR:-/etc/systemd/system}
SYSTEMD_SEAM=${VYRE_SYSTEMD_DIR:+1}
UPDATER_NAME=${VYRE_UPDATER_NAME:-vyre-update}
CHOME_SEAM=${VYRE_CONTAINER_HOME:-}
SPACES_ROOT=${VYRE_SPACES_ROOT:-/var/lib/vyre-spaces}
SPACES_UNIT=${VYRE_SPACES_UNIT:-vyre-spaces}
CTR_NAME=${VYRE_CTR_NAME:-vyre-vyre-1}
DAEMON_UID=${VYRE_DAEMON_UID:-1000}
SPACES_CAP=${VYRE_SPACES_CAP:-16}
SPACES_UP_PER_MIN=${VYRE_SPACES_UP_PER_MIN:-6}
SPACES_SPOOL_CAP=${VYRE_SPACES_SPOOL_CAP:-64}
ADMIN_NOTTY=${VYRE_ADMIN_NO_TTY:-0}
SPACES_WATCH_ONCE=${VYRE_SPACES_WATCH_ONCE:-0}
root_guard() { :; }
# <<< seams
root_guard "${1:-}"
# `vyre updater install --dir <folder>`: a person's run hands root the stack folder as an ARGUMENT (sudo passes no environment), so a box that
# is not in /srv/vyre gets the right one.
if [ "${1:-}" = updater ] && [ "${2:-}" = install ] && [ "${3:-}" = --dir ]; then
  case "${4:-}" in /*) DIR=$4 ;; *) echo "vyre: updater install --dir needs the stack folder's absolute path" >&2; exit 1 ;; esac
fi
[ -f "$DIR/compose.yml" ] || { echo "vyre: no box in $DIR (set VYRE_DIR)" >&2; exit 1; }

# COMPOSE_FILE in $DIR/.env is relative, and compose resolves it against the working folder.
cd "$DIR"
# A person's run uses the stack folder's own files. A ROOT run (the path unit, `sudo vyre update`) never interprets a file the person can write
# as compose configuration: it runs from root's own copies under $UPD_PRIV/run (the verified compose.yml, a root-written env file, a filtered
# copy of vyre.env), with every file, the project name and the project folder given explicitly. A compose.override.yml, a COMPOSE_* setting or a
# .env that tries to change how compose runs is refused (prepare_run).
ROOT_RUN=0
BUILDF=0
RUN=$UPD_ROOT/private/run
BOXPREV=$DIR/box.prev
SRCDIR=$DIR/src
set_root_run() { ROOT_RUN=1; BOXPREV=$UPD_ROOT/private/box.prev; SRCDIR=$UPD_ROOT/private/src; }
# need_docker: a person who cannot reach Docker (not root, not in the docker group) is told to use sudo, never shown Docker's own permission error.
need_docker() {
  [ "$(id -u)" = 0 ] && return 0
  s=${DOCKER_HOST:-unix:///var/run/docker.sock}; s=${s#unix://}
  [ -S "$s" ] && [ ! -w "$s" ] && die "this needs Docker, which only root can reach here: run it with sudo: sudo vyre ${VYRE_VERB:-}"
  return 0
}
compose() {
  if [ "$ROOT_RUN" != 1 ]; then need_docker; docker compose "$@"; return; fi
  [ -f "$RUN/compose.yml" ] || die "root's copy of the compose file is missing; run: sudo vyre updater install"
  if [ "$BUILDF" = 1 ]; then docker compose --project-directory "$RUN" --project-name vyre --env-file "$RUN/compose.env" -f "$RUN/compose.yml" -f "$RUN/compose.build.yml" "$@"
  else docker compose --project-directory "$RUN" --project-name vyre --env-file "$RUN/compose.env" -f "$RUN/compose.yml" "$@"
  fi
}
# The update this run is (UPD_TRACK=1 under the path unit): where it has got to, for the card in the Deck.
#
# Everything root writes for an update lives under UPD_ROOT (/var/lib/vyre-update), a folder root owns whose parents root
# owns too, so the person's own account (or a model running as it) cannot rename it away or plant a link in it:
#   request/  vyred's alone (uid 1000, 0700), mounted read-write into the container: the one-line request
#   status/   root writes, mounted READ-ONLY into the container: status.json and `ready`
#   private/  root's only, never mounted: the floor, the last-run time, the lock, and the update's own backups and their keys
# The stack folder $DIR is the person's, so root never writes into it through an existing path: see put_file.
UPD_REQ="$UPD_ROOT/request"
UPD_STATE="$UPD_ROOT/status"
UPD_PRIV="$UPD_ROOT/private"
UPD_STAGE=start
UPD_END=failed
UPD_DONE=0
# Vyre's release key (Ed25519, SPKI DER, base64) and the cosign that checks the release's images are in the seams block above, pinned and never
# taken from a download; the cosign pins are the same as scripts/install-box.sh (a test keeps them equal). The identity is the release workflow
# of this repo on a version tag and GitHub's issuer: plain assignments, which the environment cannot override.
COSIGN_ID='^https://github\.com/vyre-ai/vyre/\.github/workflows/release\.yml@refs/tags/v[0-9]+\.[0-9]+\.[0-9]+(-[a-z]+\.[0-9]+)?$'
COSIGN_ISSUER=https://token.actions.githubusercontent.com
# state STATE STAGE [MESSAGE]: one small JSON file, written whole and renamed into place.
state() {
  [ "${UPD_TRACK:-0}" = 1 ] || return 0
  msg=$(printf '%s' "${3:-}" | tr -d '"\\\n\r' | cut -c1-200)
  printf '{"state":"%s","stage":"%s","message":"%s","from":"%s","to":"%s","at":%s}\n' "$1" "$2" "$msg" "${UPD_FROM:-}" "${UPD_TO:-}" "$(date +%s)" >"$UPD_STATE/status.json.new" || return 0
  mv -f "$UPD_STATE/status.json.new" "$UPD_STATE/status.json" || true
}
stage() { UPD_STAGE=$1; state running "$1"; }
# rename_over SRC DEST: rename(2), which never follows a link at DEST: the new file replaces the link itself. GNU mv does this
# with -T (probed once); elsewhere perl's rename does (perl is on the box image and on macOS). A plain `mv -f` would move
# SRC INTO a folder that DEST links to, if the person's account planted one between the check and the move.
rename_over() {
  if [ -z "${MV_T:-}" ]; then
    pt_=$(mktemp) || return 1
    if mv -fT "$pt_" "$pt_.probe" 2>/dev/null; then MV_T=1; rm -f "$pt_.probe"; else MV_T=0; rm -f "$pt_"; fi
  fi
  if [ "$MV_T" = 1 ]; then mv -fT "$1" "$2"; else perl -e 'rename($ARGV[0],$ARGV[1]) or exit 1' "$1" "$2"; fi
}
# put_clear DEST: the friendly early refusal: a link at DEST is removed (the link, never what it points at), and a folder
# there is refused. The safety itself is rename_over, which does not depend on what DEST is at the moment of the move.
put_clear() {
  if [ -L "$1" ]; then rm -f "$1"; fi
  if [ -d "$1" ]; then echo "vyre: $1 is a folder, not a file; left alone" >&2; return 1; fi
}
# put_file SRC DEST [MODE]: write DEST from SRC through a new file made in DEST's own folder (mktemp makes it exclusively, so a
# name someone planted is never reused) and a rename over DEST. The rename replaces a link at DEST rather than following it,
# and nothing is ever written through an existing path: this is how root puts files into the person's stack folder.
put_file() {
  put_clear "$2" || return 1
  pf=$(mktemp "$2.XXXXXX") || return 1
  if cat "$1" >"$pf" && chmod "${3:-0644}" "$pf" && rename_over "$pf" "$2"; then return 0; fi
  rm -f "$pf"; return 1
}
# put_text TEXT DEST [MODE]: the same, from a string.
put_text() {
  put_clear "$2" || return 1
  pt=$(mktemp "$2.XXXXXX") || return 1
  if printf '%s\n' "$1" >"$pt" && chmod "${3:-0644}" "$pt" && rename_over "$pt" "$2"; then return 0; fi
  rm -f "$pt"; return 1
}
# BK: where an update's backup and its key are kept: root's own folder under the path unit, the stack folder for a person.
bk_dir() { if [ "${UPD_TRACK:-0}" = 1 ]; then echo "$UPD_PRIV/backups"; else echo "$DIR/backups"; fi; }
die() {
  echo "vyre: $*" >&2
  if [ "${UPD_TRACK:-0}" = 1 ] && [ "$UPD_DONE" = 0 ]; then state "$UPD_END" "$UPD_STAGE" "$*"; fi
  exit 1
}
say() { echo "vyre: $*"; }

# GitHub Releases first and the site as the fallback (a test build can name its own folder in the seams block above).
case "$SITE" in */) ;; *) SITE="$SITE/" ;; esac
BASE=$SITE
MARK="vyre on a Docker box"
# The box files install-box.sh lays out beside .env, which is never among them.
BOXF="compose.yml compose.build.yml vyre.env.example Dockerfile dockerignore"
# vyred's home in the container: the vyre service's VYRE_HOME in compose.yml (on the vyre-home
# volume, so it outlives the image). Backups and the phone app's releases folder live under it.
CHOME=${CHOME_SEAM:-$(sed -n 's/^ *- VYRE_HOME=\(.*[^ ]\) *$/\1/p' "$DIR/compose.yml" | head -n 1)}
CHOME=${CHOME:-/home/vyre/.vyre}

# fetch_url URL DEST
fetch_url() {
  if command -v curl >/dev/null 2>&1; then curl -fsSL "$1" -o "$2"
  elif command -v wget >/dev/null 2>&1; then wget -qO "$2" "$1"
  else die "need curl or wget to download $1"
  fi
}
fetch() { fetch_url "$BASE$1" "$2"; }

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
  else die "need sha256sum or shasum to verify downloads"
  fi
}

# csh SCRIPT ARGS...: a shell in the container as uid vyre, the owner of CHOME. Root there has
# every capability dropped, so it could not write under /home/vyre. Paths go in as arguments.
csh() { s=$1; shift; compose exec -T -u vyre vyre sh -c "$s" sh "$@"; }

# older A B: true when version A is below B, by semver: the x.y.z first, then a release is above its own prereleases
# (0.2.0-rc.2 < 0.2.0), and two prereleases compare identifier by identifier (numbers by value, and below words).
older() {
  awk -v a="$1" -v b="$2" '
    function core(v) { i = index(v, "-"); return i ? substr(v, 1, i - 1) : v }
    function pre(v) { i = index(v, "-"); return i ? substr(v, i + 1) : "" }
    BEGIN {
      split(core(a), x, "."); split(core(b), y, ".")
      for (i = 1; i <= 3; i++) { if (x[i] + 0 < y[i] + 0) exit 0; if (x[i] + 0 > y[i] + 0) exit 1 }
      pa = pre(a); pb = pre(b)
      if (pa == pb || pa == "") exit 1
      if (pb == "") exit 0
      n = split(pa, p, "."); m = split(pb, q, ".")
      for (i = 1; i <= n && i <= m; i++) {
        pn = (p[i] ~ /^[0-9]+$/); qn = (q[i] ~ /^[0-9]+$/)
        if (pn && qn) { if (p[i] + 0 < q[i] + 0) exit 0; if (p[i] + 0 > q[i] + 0) exit 1 }
        else if (pn) exit 0
        else if (qn) exit 1
        else { if (p[i] < q[i]) exit 0; if (p[i] > q[i]) exit 1 }
      }
      exit (n < m) ? 0 : 1
    }'
}

# pick_release: set BASE to the release's download folder and TAG to its tag, from the GitHub
# Releases API. No jq on a plain box, and no node or python on the host to rely on, so this reads
# the four fields it needs with grep and awk: GitHub lists each release's tag_name, draft and
# prerelease before its assets, newest release first, and a quote inside the notes is escaped, so
# it never looks like a key. A release counts only with a SHA256SUMS asset, whose folder is where
# every other asset is. Returns 1 when there is no such release, or GitHub cannot be reached.
pick_release() {
  fetch_url "$API/repos/$REPO/releases?per_page=30" "$tmp/releases.json" 2>/dev/null || return 1
  pick=$(tr -d '\n' <"$tmp/releases.json" \
    | grep -oE '"(tag_name|draft|prerelease|browser_download_url)": *("[^"]*"|true|false)' \
    | sed 's/^"\([a-z_]*\)": *"\{0,1\}\([^"]*\)"\{0,1\}$/\1 \2/' \
    | awk -v ch="$CHANNEL" -v want="$TO" '
      function done_one() {
        if (tag != "" && !found && draft != "true" && sums != "" &&
            (want != "" ? (tag == want || tag == "v" want) : (ch == "beta" || pre == "false"))) {
          print tag, sums; found = 1
        }
      }
      $1 == "tag_name" { done_one(); tag = $2; draft = ""; pre = ""; sums = "" }
      $1 == "draft" { draft = $2 }
      $1 == "prerelease" { pre = $2 }
      $1 == "browser_download_url" && $2 ~ /\/SHA256SUMS$/ { sums = $2 }
      END { done_one() }') || return 1
  [ -n "$pick" ] || return 1
  TAG=${pick%% *}
  BASE=${pick#* }
  BASE=${BASE%SHA256SUMS}
}

# get_sums: SHA256SUMS first. A missing file on the site can come back as 200 and a web page, so
# every line must look like "<64 hex>  <path>" before anything in it is trusted.
get_sums() {
  fetch SHA256SUMS "$tmp/SHA256SUMS" || die "could not download $BASE""SHA256SUMS"
  if [ ! -s "$tmp/SHA256SUMS" ] || grep -vqE '^[0-9a-f]{64} [ *][^ ]+$' "$tmp/SHA256SUMS"; then
    die "$BASE""SHA256SUMS is not a checksum list; is this the release folder?"
  fi
}
listed() { awk -v p="$1" '$2 == p || $2 == "*" p { f = 1 } END { exit !f }' "$tmp/SHA256SUMS"; }

# get NAME: download a release file into tmp and check it against its line in SHA256SUMS.
get() {
  want=$(awk -v p="$1" '$2 == p || $2 == "*" p { print $1; exit }' "$tmp/SHA256SUMS")
  [ -n "$want" ] || die "SHA256SUMS has no line for $1"
  fetch "$1" "$tmp/$1" || die "could not download $BASE$1"
  got=$(sha256 "$tmp/$1")
  [ "$got" = "$want" ] || die "checksum mismatch for $BASE$1 (want $want, got $got)"
}

# verify_signature: the release's SHA256SUMS carries SHA256SUMS.sig, an Ed25519 signature over the line "vyre-release-sums"
# and then the exact bytes of SHA256SUMS (the prefix keeps a signature made for a checksum list from ever passing as one over
# something else the same key signs, such as vyre-core's manifests). The checksums vouch for every other file (release.json
# with the image digests, the wrapper, the compose file). It is checked with Node in the image that runs now, against
# RELEASE_KEY above, with no network, before anything on the box changes. An unsigned or badly signed release is refused;
# only a person running `vyre update --allow-unsigned` installs one, with a warning. An automatic update (UPD_SIGNED=1) never does.
# sig_ok SUMS SIG: whether SIG (base64) is a valid Ed25519 signature over the prefix and SUMS, by RELEASE_KEY. Checked on the HOST with
# openssl, no container and no image involved: nothing a person's .env (VYRE_IMAGE) or an image can say changes the answer, and the
# pinned key is the only thing that decides. OpenSSL 3 needs -rawin for a one-shot Ed25519 verify; 1.1.1 has no such option and does it by default.
sig_ok() {
  command -v openssl >/dev/null 2>&1 || die "openssl is needed to check a release's signature, and it is not installed; nothing was changed"
  kd=$(mktemp -d) || return 1
  { echo "-----BEGIN PUBLIC KEY-----"; printf '%s' "$RELEASE_KEY" | fold -w 64; echo; echo "-----END PUBLIC KEY-----"; } >"$kd/pub.pem"
  if ! tr -d ' \n\r' <"$2" | base64 -d >"$kd/sig" 2>/dev/null || [ "$(wc -c <"$kd/sig" | tr -d ' ')" != 64 ]; then rm -rf "$kd"; return 1; fi
  { printf 'vyre-release-sums\n'; cat "$1"; } >"$kd/msg"
  ok=1
  if openssl pkeyutl -verify -pubin -inkey "$kd/pub.pem" -rawin -in "$kd/msg" -sigfile "$kd/sig" >/dev/null 2>&1; then ok=0
  elif openssl pkeyutl -verify -pubin -inkey "$kd/pub.pem" -in "$kd/msg" -sigfile "$kd/sig" >/dev/null 2>&1; then ok=0
  fi
  rm -rf "$kd"
  return $ok
}

verify_signature() {
  stage verifying
  problem=""
  if fetch SHA256SUMS.sig "$tmp/SHA256SUMS.sig" 2>/dev/null && [ -s "$tmp/SHA256SUMS.sig" ]; then
    if sig_ok "$tmp/SHA256SUMS" "$tmp/SHA256SUMS.sig"; then say "signature checked against Vyre's release key"; return 0; fi
    problem="the release's signature does not match Vyre's release key"
  else
    problem="this release is not signed"
  fi
  if [ "${UPD_SIGNED:-0}" = 0 ] && [ "$ALLOW_UNSIGNED" = 1 ]; then
    echo "vyre: WARNING: $problem. Installing it anyway because you passed --allow-unsigned: nothing proves this release came from Vyre." >&2
    return 0
  fi
  if [ "${UPD_SIGNED:-0}" = 1 ]; then die "$problem, and an automatic update installs only signed releases; nothing was changed"; fi
  die "$problem; nothing was changed. To install it anyway: vyre update --allow-unsigned"
}

# Unpack the verified vyre.tgz into $SRCDIR.new. Nothing in $DIR/src changes yet.
unpack_src() {
  rm -rf "$SRCDIR.new"
  mkdir -p "$SRCDIR.new"
  tar -xzf "$tmp/vyre.tgz" -C "$SRCDIR.new" --strip-components=1
  # npm pack pins every mtime to 1985, and BuildKit skips a changed file whose size and mtime
  # match what it synced before, so the image would keep stale files: give them today's.
  find "$SRCDIR.new" -exec touch {} +
  [ -f "$SRCDIR.new/box/Dockerfile" ] || { rm -rf "$SRCDIR.new"; die "vyre.tgz has no box/Dockerfile"; }
  # npm pack leaves out .dockerignore, which keeps tests and scripts out of the image.
  if [ -f "$tmp/dockerignore" ]; then cp "$tmp/dockerignore" "$SRCDIR.new/.dockerignore"; fi
}

# Wait for vyred to answer on its socket, up to a minute (UPDATE_WAIT seconds).
ready() {
  i=0
  while [ $i -lt "$UPDATE_WAIT" ]; do
    compose exec -T vyre vyre status >/dev/null 2>&1 && return 0
    i=$((i + 1)); sleep 1
  done
  echo "vyre: Vyre did not start; see: vyre logs" >&2
  return 1
}

cli() {
  tty=-T
  if [ -t 0 ] && [ -t 1 ]; then tty=""; fi
  # The container's account is not the person's, so the ssh line needs the host's.
  # Through compose(): a root run (sudo) uses root's own copies, never the stack folder's files.
  # As the vyre user (uid 1000), the account vyred runs as: a call made as root inside the container carries an ancestry the daemon cannot read as a person's terminal (host `vyre call`
  # answered caller_unknown on a packaged box), and root there cannot read the vyre-owned home anyway. A terminal is passed through when there is one.
  compose exec $tty -u vyre \
    -e SSH_CONNECTION="${SSH_CONNECTION:-}" -e VYRE_HOST_USER="${SUDO_USER:-$(id -un)}" vyre vyre "$@"
  exit $?
}

# print_link: run the CLI's `vyre up`, and reduce what it prints to one machine-readable line. A server has no setup link (the kernel is always on):
# VYRE_PAIRED=<space> once it is paired, or VYRE_PAIR=<the command that shows the pairing code> while it is not. Only a `vyre up` that printed neither fails.
print_link() {
  esc=$(printf '\033')
  out=$(compose exec -T -e SSH_CONNECTION="${SSH_CONNECTION:-}" \
    -e VYRE_HOST_USER="${SUDO_USER:-$(id -un)}" vyre vyre up 2>&1 | sed "s/${esc}\[[0-9;]*m//g")
  paired=$(printf '%s\n' "$out" | sed -n 's|^ *paired to \([^ ·]*\).*|\1|p' | head -n 1)
  if [ -n "$paired" ]; then printf 'VYRE_PAIRED=%s\n' "$paired"; return 0; fi
  if printf '%s\n' "$out" | grep -q 'not paired yet'; then printf '%s\n' "VYRE_PAIR=vyre call wink.server.code '{\"qr\":true}'"; return 0; fi
  printf '%s\n' "$out" >&2; die "vyre up said neither paired nor how to pair"
}

# The image the vyre service runs: built here as vyre:local, or pulled.
image() {
  if [ "$BUILD" = 1 ]; then echo vyre:local; return; fi
  # A root run takes the image from root's own copy of the verified compose.yml, never from a .env.
  if [ "$ROOT_RUN" = 1 ]; then sed -n 's/^[[:space:]]*image:[[:space:]]*\(ghcr\.io\/vyre-ai\/vyre@sha256:[0-9a-f]\{64\}\)$/\1/p' "$RUN/compose.yml" | head -n 1; return; fi
  # A release's compose.yml names the box image by digest: that is the image this box runs, so it comes before any tag (a person's `vyre update` or
  # `vyre update --rollback` must tag and keep THAT image as vyre:prev, never a stale :latest that happens to be in the local image store).
  v=$(sed -n 's/^[[:space:]]*image:[[:space:]]*\(ghcr\.io\/vyre-ai\/vyre@sha256:[0-9a-f]\{64\}\)$/\1/p' "$DIR/compose.yml" 2>/dev/null | head -n 1)
  [ -n "$v" ] || v=$(sed -n 's/^VYRE_IMAGE=//p' "$DIR/.env" 2>/dev/null | tail -n 1)
  echo "${v:-${VYRE_IMAGE:-ghcr.io/vyre-ai/vyre:latest}}"
}

# backup_db VERSION: the CLI's own backup, in the container, into CHOME/backups/pre-VERSION.tar.gz
# on the vyre-home volume, and a copy in $DIR/backups for the host. $DIR/backups/last names it,
# for a failed update and for --rollback --restore-data.
backup_db() {
  f="$CHOME/backups/pre-$1.tar.gz"
  BK=$(bk_dir)
  csh 'mkdir -p "$1" && rm -f "$2"' "$CHOME/backups" "$f" \
    || die "could not reach Vyre's data in the container to back up; is the box up? (vyre up)"
  mkdir -p "$BK"
  chmod 700 "$BK"
  # The backup is always sealed under a passphrase (R8). An update's own backup is unattended, so it gets a random one, kept
  # beside the file as pre-<version>.key (0600, root, the same trust as the folder), and is data only: the project files and
  # transcripts are not in it. Piped on stdin, never in argv or the environment.
  pass=$(head -c 24 /dev/urandom | base64 | tr -d '=+/\n' | cut -c1-24)
  [ "${#pass}" -ge 16 ] || die "could not make a passphrase for the backup; nothing changed"
  (umask 077; put_text "$pass" "$BK/pre-$1.key" 0600)
  printf '%s\n%s\n' "$pass" "$pass" | compose exec -T -e VYRE_BACKUP_SKIP_PROJECTS=1 -e VYRE_BACKUP_SKIP_TRANSCRIPTS=1 vyre vyre backup "$f" >/dev/null \
    || die "the backup before the update failed; nothing changed"
  # It holds the sealed vault: only this account reads the host copy.
  if hb=$(mktemp "$BK/.pre-$1.XXXXXX") && chmod 600 "$hb" && csh 'cat "$1"' "$f" >"$hb"; then mv -f "$hb" "$BK/pre-$1.tar.gz"; else rm -f "${hb:-}"; fi
  put_text "$f" "$BK/last" 0600
  say "backed up the database to $f (and $BK/pre-$1.tar.gz)"
}

# restore_db: put the pre-update backup back. restore wants vyred stopped, so the vyre container
# stops and a one-off container of the same (already rolled back) image runs the restore.
restore_db() {
  BK=$(bk_dir)
  f=$(cat "$BK/last" 2>/dev/null || true)
  [ -n "$f" ] || { echo "vyre: no pre-update backup is recorded in $BK/last" >&2; return 1; }
  compose stop vyre
  k="$BK/$(basename "$f" .tar.gz).key"
  # A backup this wrapper made has its passphrase beside it. One made by an older release's updater (0.1.x) has none: it is plain, and
  # the release rolled back to is the one that made it, so its own restore reads it without a passphrase.
  if [ -f "$k" ]; then kin=$k; else kin=/dev/null; fi
  compose run --rm --no-deps -T vyre vyre restore "$f" --force <"$kin" || { echo "vyre: could not restore $f" >&2; return 1; }
  say "restored the database from $f"
}

# swap_dirs A B: exchange two folders (either may be missing).
swap_dirs() {
  rm -rf "$1.swap"
  if [ -e "$1" ]; then mv "$1" "$1.swap"; fi
  if [ -e "$2" ]; then mv "$2" "$1"; fi
  if [ -e "$1.swap" ]; then mv "$1.swap" "$2"; fi
}

# save_box: the box files and this wrapper as they are now, into $DIR/box.prev.
save_box() {
  rm -rf "$BOXPREV"
  mkdir -p "$BOXPREV"
  # Only regular files, never a link that points somewhere else.
  for f in $BOXF VERSION; do if [ -f "$DIR/$f" ] && [ ! -L "$DIR/$f" ]; then cp -p "$DIR/$f" "$BOXPREV/$f"; fi; done
  # A root run keeps root's own copy of the compose files too, the ones it runs from.
  if [ "$ROOT_RUN" = 1 ]; then for f in compose.yml compose.build.yml compose.env vyre.env; do if [ -f "$RUN/$f" ]; then cp -p "$RUN/$f" "$BOXPREV/run-$f" || true; fi; done; fi
  if [ -f "$WRAPPER" ] && [ ! -L "$WRAPPER" ]; then cp -p "$WRAPPER" "$BOXPREV/vyre"; fi
}

# put_box FROM [exact]: install the box files found in folder FROM into $DIR. With exact (putting
# box.prev back), a file FROM does not have is removed, so $DIR matches it; compose.yml always stays.
put_box() {
  for f in $BOXF VERSION; do
    if [ -f "$1/$f" ]; then put_file "$1/$f" "$DIR/$f" 0644
    elif [ "${2:-}" = exact ] && [ "$f" != compose.yml ]; then rm -f "$DIR/$f"
    fi
  done
  if [ "$ROOT_RUN" = 1 ]; then sync_run "$1"; fi
}

# sync_run FROM: root's own copies of the compose files, from a release folder that was just verified (compose.yml, compose.build.yml) or
# from what save_box kept (run-compose.yml, run-compose.build.yml). These, not the stack folder's files, are what a root run starts.
# sha256_of FILE: the file's sha256 (GNU or BSD tool).
sha256_of() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1; else shasum -a 256 "$1" | cut -d' ' -f1; fi; }
sync_run() {
  if ! { mkdir -p "$RUN" && chmod 700 "$RUN"; }; then die "could not make root's compose folder $RUN"; fi
  for f in compose.yml compose.build.yml; do
    src="$1/run-$f"; [ -f "$src" ] || src="$1/$f"
    if [ -f "$src" ] && [ ! -L "$src" ]; then put_file "$src" "$RUN/$f" 0644; fi
  done
  # What root has verified: the next `updater install` from a folder whose compose.yml differs is refused (see updater install).
  if [ "$ROOT_RUN" = 1 ] && [ -f "$RUN/compose.yml" ]; then printf '%s\n' "$(sha256_of "$RUN/compose.yml")" >"$UPD_ROOT/compose.sha256" || true; fi
}

# prepare_run: before a root run touches compose. Refuses what a person (or a model running as one) could have planted to change how compose
# runs: an override file, a COMPOSE_* setting in the environment or in .env other than the two values install writes. Reads the build mode from
# root's own record. Writes root's env file (only the few settings the compose file reads, each checked for its own shape, plus the paths root
# decides) and a filtered copy of vyre.env (lines of KEY=value with no interpolation).
prepare_run() {
  for f in compose.override.yml compose.override.yaml docker-compose.override.yml docker-compose.override.yaml; do
    [ ! -e "$DIR/$f" ] || die "$DIR/$f exists, and a root run does not read override files; remove it (or run compose yourself); nothing was changed"
  done
  bad=$(env | sed -n 's/^\(COMPOSE_[A-Za-z0-9_]*\)=.*/\1/p' | head -n 1)
  [ -z "$bad" ] || die "$bad is set in the environment, and a root run reads no compose setting from it; nothing was changed"
  if [ -f "$DIR/.env" ]; then
    bad=$(sed -n 's/^\(COMPOSE_[A-Za-z0-9_]*\)=\(.*\)$/\1=\2/p' "$DIR/.env" | grep -Evx 'COMPOSE_PROJECT_NAME=vyre|COMPOSE_FILE=compose\.yml(:compose\.build\.yml)?' | head -n 1 || true)
    [ -z "$bad" ] || die "${bad%%=*} is set in $DIR/.env, and a root run reads no compose setting from there; nothing was changed"
  fi
  mode=$(readf "$UPD_ROOT/mode")
  case "$mode" in
    pull) BUILD=0; BUILDF=0 ;;
    build) BUILD=1; BUILDF=1 ;;
    external) die "this box builds from a checkout of your own, and an automatic update never builds from a folder you can write; update it with git" ;;
    *) die "root has no record of how this box is built; run: sudo vyre updater install" ;;
  esac
  [ -f "$RUN/compose.yml" ] || die "root's copy of the compose file is missing; run: sudo vyre updater install"
  [ "$BUILDF" = 0 ] || [ -f "$RUN/compose.build.yml" ] || die "root's copy of compose.build.yml is missing; run: sudo vyre updater install"
  # (VYRE_SEAL_DEV and VYRE_SEAL_SOFTWARE are passed on because a release-kind build ignores them: kernel/seal devSwitch is false there, so they only matter on a development-kind install, where a walk needs them in the admin one-off runs.)
  # root's env file: only these, each in the shape it must have; anything else in .env (an image, a path, a capability list) is not passed on.
  # Own temp files: two root runs at once (the update path unit and a `sudo vyre name status`) shared one fixed name, and the second rename found it gone ("mv: cannot stat ... compose.env.new").
  ce=$(mktemp "$RUN/compose.env.XXXXXX") || die "root's run folder cannot be written"
  # (the key is spelled in two parts so the release build, which must not name any test override, stays checkable by grep)
  k=VYRE_UPDATE; { echo "${k}_ROOT=$UPD_ROOT"; [ "$BUILDF" = 0 ] || echo "VYRE_SOURCE=$SRCDIR"
    if [ -f "$DIR/.env" ]; then
      sed -n 's/^DOCKER_GID=\([0-9][0-9]*\)$/DOCKER_GID=\1/p' "$DIR/.env"
    fi; } >"$ce"
  chmod 600 "$ce"; rename_over "$ce" "$RUN/compose.env"
  ve=$(mktemp "$RUN/vyre.env.XXXXXX") || die "root's run folder cannot be written"
  if [ -f "$DIR/vyre.env" ] && [ ! -L "$DIR/vyre.env" ]; then grep -E '^(CLOUDFLARE_[A-Z0-9_]+|VYRE_SETUP_CODE|VYRE_SETUP_CODE_AT|VYRE_KERNEL|VYRE_STORE|VYRE_SEAL_DEV|VYRE_SEAL_SOFTWARE)=[^$`]*$' "$DIR/vyre.env" >"$ve" || true
  else : >"$ve"; fi
  chmod 600 "$ve"; rename_over "$ve" "$RUN/vyre.env"
  # Nothing is dropped silently: the names (never the values) of what a root run did not pass on.
  skipped=$( { sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$DIR/.env" 2>/dev/null | grep -Evx 'DOCKER_GID|COMPOSE_PROJECT_NAME|COMPOSE_FILE|VYRE_SOURCE|VYRE_CHANNEL|VYRE_SETUP_CODE|VYRE_SETUP_CODE_AT' || true
    sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$DIR/vyre.env" 2>/dev/null | grep -Evx 'CLOUDFLARE_[A-Z0-9_]+|VYRE_SETUP_CODE|VYRE_SETUP_CODE_AT|VYRE_KERNEL|VYRE_STORE|VYRE_SEAL_DEV|VYRE_SEAL_SOFTWARE' || true; } | sort -u | head -n 12 | tr '\n' ' ')
  [ -z "$skipped" ] || echo "vyre: an update run by root ignores these settings from $DIR/.env and vyre.env (root passes on only the few it checks; start the stack yourself with them set, or see vyre.env.example): $skipped" >&2
}

# put_wrapper FILE: replace this wrapper with FILE, through a temp name in the same folder and a
# rename, so the shell running this script keeps reading the old file. Only a file that is the box
# wrapper and parses replaces it, and only the box wrapper is ever replaced. Call it last.
put_wrapper() {
  [ -f "$1" ] && [ -f "$WRAPPER" ] || return 0
  grep -q "$MARK" "$WRAPPER" 2>/dev/null || return 0
  cmp -s "$1" "$WRAPPER" && return 0
  if ! grep -q "$MARK" "$1" || ! sh -n "$1"; then echo "vyre: the release's wrapper does not look right; kept $WRAPPER" >&2; return 0; fi
  if cp "$1" "$WRAPPER.new.$$" 2>/dev/null && chmod 0755 "$WRAPPER.new.$$" && mv "$WRAPPER.new.$$" "$WRAPPER"; then
    say "replaced $WRAPPER"
  else
    rm -f "$WRAPPER.new.$$" 2>/dev/null || true
    echo "vyre: could not replace $WRAPPER (needs root); run: sudo install -m 0755 $1 $WRAPPER" >&2
  fi
}

# android: bring the release's phone app into the container's releases folder, APK first and
# android.json last through a temp name and a rename, the old manifest kept as android.json.prev.
# Then releases.sign signs it with the owner's key. Its refusal is reported, never fatal.
# publish_release SRC: the release's SHA256SUMS, its signature, shell.json and modules.json (the signed list of first-party modules,
# kernel/modules/release-list.js) go into root's status/release folder, which the vyre container mounts read-only at /opt/vyre/web/release.
# The folder is replaced as a whole by rename, never file by file, so a running vyred keeps the one consistent release it was started with and the
# next one sees the next. The list's counter only ever goes up: a modules.json whose counter is below the one already published (a rollback, or an old
# signed release shown again) is refused and nothing changes.
publish_release() {
  src=$1
  # A release that carries a signed module list (modules.json), or a box that already has one published, must publish one (so a release that drops the list cannot publish best-effort over it): for that release every refusal below is fatal (non-zero), so the update stops
  # and the old image and the old list stay (L-1). A release without one (0.2.x, a development source) keeps the old best-effort behaviour.
  FATAL=0; if [ -f "$src/modules.json" ] || [ -f "$UPD_STATE/release/modules.json" ]; then FATAL=1; fi
  if [ "$(id -u)" != "$ROOT_UID" ]; then
    sudo -n "$WRAPPER" publish-release "$src" >/dev/null 2>&1 && return 0
    echo "vyre: could not put the release's signature files where Vyre serves them (that needs sudo); the phone's shell check stays off until an update runs as root" >&2
    return "$FATAL"
  fi
  if ! unit_dirs_ok; then echo "vyre: $UPD_ROOT is not root's alone; the release's signature files were not published" >&2; return "$FATAL"; fi
  reconcile_release
  # The caller's folder is not trusted, even when root was asked by name: each file is copied WITHOUT following a link into a folder
  # only root can use, and everything after this looks only at the copies. Nothing is published unless SHA256SUMS.sig verifies
  # over the copied SHA256SUMS (so an unsigned release publishes nothing), and shell.json is the file that SHA256SUMS lists.
  rt=$(mktemp -d) || return "$FATAL"
  for f in SHA256SUMS SHA256SUMS.sig shell.json modules.json appbuild.json; do cp -P "$src/$f" "$rt/$f" 2>/dev/null || true; done
  if [ -f "$rt/SHA256SUMS" ] && [ ! -L "$rt/SHA256SUMS" ] && [ -f "$rt/SHA256SUMS.sig" ] && [ ! -L "$rt/SHA256SUMS.sig" ] && sig_ok "$rt/SHA256SUMS" "$rt/SHA256SUMS.sig"; then
    if [ -f "$rt/shell.json" ] && [ ! -L "$rt/shell.json" ]; then
      want=$(awk '$2 == "shell.json" || $2 == "*shell.json" { print $1; exit }' "$rt/SHA256SUMS")
      if [ -z "$want" ] || [ "$want" != "$(sha256 "$rt/shell.json")" ]; then echo "vyre: shell.json is not the file the signed SHA256SUMS lists; it was not published" >&2; rm -f "$rt/shell.json"; fi
    fi
    if [ -f "$rt/modules.json" ] && [ ! -L "$rt/modules.json" ]; then
      want=$(awk '$2 == "modules.json" || $2 == "*modules.json" { print $1; exit }' "$rt/SHA256SUMS")
      # Fail closed: a release whose module list is not the signed one publishes nothing, so the folder never holds a release without its list.
      if [ -z "$want" ] || [ "$want" != "$(sha256 "$rt/modules.json")" ]; then echo "vyre: modules.json is not the file the signed SHA256SUMS lists; nothing was published" >&2; rm -rf "$rt"; return 1; fi
    elif [ "$FATAL" = 1 ]; then echo "vyre: this release's modules.json is not a plain file; nothing was published" >&2; rm -rf "$rt"; return 1
    fi
    # The web app's signed file list (lib/app-build.js), when the release has one: it must be the file the signed SHA256SUMS lists, or nothing is published. A release that drops it
    # over a box that already has one is refused, like a dropped module list (the daemon would serve a build no list covers).
    if [ -f "$rt/appbuild.json" ] && [ ! -L "$rt/appbuild.json" ]; then
      want=$(awk '$2 == "appbuild.json" || $2 == "*appbuild.json" { print $1; exit }' "$rt/SHA256SUMS")
      if [ -z "$want" ] || [ "$want" != "$(sha256 "$rt/appbuild.json")" ]; then echo "vyre: appbuild.json is not the file the signed SHA256SUMS lists; nothing was published" >&2; rm -rf "$rt"; return 1; fi
    elif [ -f "$UPD_STATE/release/appbuild.json" ]; then echo "vyre: this release has no signed list of the app's files, and this box has one; nothing was published" >&2; rm -rf "$rt"; return 1
    fi
    # The counter only goes up (a signed older release must not roll the module list back). The list is written by scripts/modules-manifest.mjs with one space of
    # indent, so the top-level counter is the one line `^ "counter": N,$`, and exactly one such line must be there (a module entry cannot spoof it: those sit deeper).
    newc=$(counter_of "$rt/modules.json")
    oldc=$(counter_of "$UPD_STATE/release/modules.json")
    if [ -f "$rt/modules.json" ] && [ -z "$newc" ]; then echo "vyre: this release's module list has no readable counter; nothing was published" >&2; rm -rf "$rt"; return 1; fi
    if [ -n "$newc" ] && [ -n "$oldc" ] && [ "$newc" -lt "$oldc" ]; then
      echo "vyre: this release's module list is older (counter $newc) than the one already published (counter $oldc); nothing was published" >&2
      rm -rf "$rt"; return 1
    fi
    if mkdir -p "$UPD_STATE" && new=$(mktemp -d "$UPD_STATE/release.new.XXXXXX") && chmod 755 "$new"; then
      for f in SHA256SUMS SHA256SUMS.sig shell.json modules.json appbuild.json; do
        if [ -f "$rt/$f" ] && [ ! -L "$rt/$f" ]; then put_file "$rt/$f" "$new/$f" 0644 || { echo "vyre: could not publish $f" >&2; rm -rf "$new" "$rt"; return "$FATAL"; }; fi
      done
      # The whole folder by rename: the old one is set aside and the new one takes its name, so no reader sees half of each release.
      # The old folder is kept in root's private folder as release.prev (not under the mounted status folder), so a rollback puts back the list its image was signed with.
      [ -d "$UPD_PRIV" ] || { mkdir "$UPD_PRIV" && chmod 700 "$UPD_PRIV"; } 2>/dev/null || true
      rm -rf "$UPD_PRIV/release.prev"
      if [ -d "$UPD_STATE/release" ]; then mv "$UPD_STATE/release" "$UPD_PRIV/release.prev" || { echo "vyre: could not replace the published release" >&2; rm -rf "$new" "$rt"; return "$FATAL"; }; fi
      mv "$new" "$UPD_STATE/release" || { echo "vyre: could not publish the release folder" >&2; reconcile_release; rm -rf "$rt"; return "$FATAL"; }
      : >"$UPD_PRIV/release.swapped"
    fi
  else
    echo "vyre: the release's SHA256SUMS.sig is missing or does not verify; nothing was published" >&2
    rm -rf "$rt"; return "$FATAL"
  fi
  rm -rf "$rt"
  return 0
}
# counter_of FILE: the list's top-level counter as digits, or nothing (see publish_release).
counter_of() {
  [ -f "$1" ] || return 0
  [ "$(grep -c '^ "counter": [0-9][0-9]*,$' "$1" 2>/dev/null)" = 1 ] || return 0
  sed -n 's/^ "counter": \([0-9][0-9]*\),$/\1/p' "$1"
}
# reconcile_release: an interrupted swap leaves no `release` folder with the old one set aside, or temp folders behind; put it right before anything reads it (L-4).
reconcile_release() {
  rm -rf "$UPD_STATE"/release.new.* 2>/dev/null || true
  if [ ! -d "$UPD_STATE/release" ] && [ -d "$UPD_PRIV/release.prev" ]; then mv "$UPD_PRIV/release.prev" "$UPD_STATE/release" 2>/dev/null || true; fi
}
# modules_ok: after an update starts the new container, every module the published signed list names must have started (L-1). A listed module that FAILED is a
# release that bricks the box: the update rolls back by itself. Off by default is not failed. Waits a little, since modules start after the socket answers.
modules_ok() {
  [ -f "$UPD_STATE/release/modules.json" ] || return 0
  names=$(sed -n 's/^  "\([^"]*\)": {$/\1/p' "$UPD_STATE/release/modules.json")
  i=0; bad=""
  while [ $i -lt "${MODULES_WAIT:-30}" ]; do
    out=$(compose exec -T vyre vyre modules 2>/dev/null || true)
    bad=""
    # Every listed module must be reported running or off (off by default is a choice, not a failure); one reported failed, or not reported at all, is a box with fewer modules than the list.
    for n in $names; do
      st=$(printf '%s\n' "$out" | awk -v n="$n" '$1 == n { print $3; exit }')
      case "$st" in running|off) ;; *) bad="$bad $n" ;; esac
    done
    [ -z "$bad" ] && [ -n "$out" ] && return 0
    i=$((i + 1)); sleep 1
  done
  echo "vyre: these signed modules did not start:${bad:- (the module list could not be read)}" >&2
  return 1
}

android() {
  listed android.json || return 0
  get android.json
  apk=$(tr -d '\n' <"$tmp/android.json" | sed -n 's/.*"file": *"\([^"]*\)".*/\1/p')
  case "$apk" in ""|*/*|.*|*[!A-Za-z0-9._-]*) echo "vyre: android.json names no usable file; the phone app stays as it was" >&2; return 0 ;; esac
  get "$apk"
  want=$(tr -d '\n' <"$tmp/android.json" | sed -n 's/.*"sha256": *"\([0-9a-f]*\)".*/\1/p')
  if [ -n "$want" ] && [ "$want" != "$(sha256 "$tmp/$apk")" ]; then
    echo "vyre: $apk does not match android.json's sha256; the phone app stays as it was" >&2; return 0
  fi
  rdir="$CHOME/releases/android"
  csh 'mkdir -p "$1" && cat >"$1/.$2.partial" && mv "$1/.$2.partial" "$1/$2"' "$rdir" "$apk" <"$tmp/$apk" \
    || { echo "vyre: could not copy $apk into the container" >&2; return 0; }
  csh 'cat >"$1/.android.json.tmp" && { [ ! -f "$1/android.json" ] || cp "$1/android.json" "$1/android.json.prev"; } && mv "$1/.android.json.tmp" "$1/android.json"' "$rdir" <"$tmp/android.json" \
    || { echo "vyre: could not copy android.json into the container" >&2; return 0; }
  say "phone app $apk is in $rdir"
  if s=$(compose exec -T vyre vyre call releases.sign 2>&1); then say "phone app signed"
  else echo "vyre: releases.sign did not sign the phone app: $(printf '%s\n' "$s" | sed '/^ *$/d' | head -n 2 | tr '\n' ' ')" >&2
  fi
}

# roll_back: undo a failed update: src, image, box files, then the database from the backup.
# restore_release: the folder publish_release set aside goes back (an update that did not come up healthy). After a healthy update it stays as release.prev,
# the previous release's signed files, which `vyre update --rollback` swaps back with the previous image (and a second --rollback swaps forward again).
restore_release() {
  # Only a swap this very update made is undone: a release.prev left by an earlier update is not this one's to put back.
  [ -f "$UPD_PRIV/release.swapped" ] || return 0
  rm -f "$UPD_PRIV/release.swapped"
  [ -d "$UPD_PRIV/release.prev" ] || return 0
  rm -rf "$UPD_PRIV/release.bad"
  [ ! -d "$UPD_STATE/release" ] || mv "$UPD_STATE/release" "$UPD_PRIV/release.bad" || return 0
  mv "$UPD_PRIV/release.prev" "$UPD_STATE/release" && rm -rf "$UPD_PRIV/release.bad"
}
roll_back() {
  echo "vyre: the update did not come up healthy; rolling back" >&2
  UPD_END=rolled_back
  state running rolling-back
  if [ "$BUILD_SRC" = 1 ] && [ -d "$SRCDIR.prev" ]; then rm -rf "$SRCDIR"; mv "$SRCDIR.prev" "$SRCDIR"; fi
  if [ "$TAGGED" = 1 ]; then docker image tag vyre:prev "$IMG"; fi
  put_box "$BOXPREV" exact
  restore_release
  compose up -d || true
  restore_db || true
  compose up -d || true
  ready || true
  die "rolled back to the release before; the database is as it was before the update"
}

# verify_release_images: a box that pulls its image (no build) pulls only what the signed release names. The release's release.json names the
# images by digest, the released compose.yml must pin exactly those (and nothing by a moving tag), and each is checked with cosign against
# the release workflow's identity before anything on this box changes. A pull that cannot be checked is refused, never skipped.
verify_release_images() {
  if [ ! -f "$tmp/release.json" ]; then
    die "this release has no release.json, so the image it pulls cannot be verified; nothing was changed. (A box that builds from source updates without it.)"
  fi
  rj=$(tr -d '\n' <"$tmp/release.json")
  box_ref=$(printf '%s' "$rj" | sed -n 's/.*"box": *{[^}]*"ref": *"\([^"]*\)".*/\1/p')
  computer_ref=$(printf '%s' "$rj" | sed -n 's/.*"computer": *{[^}]*"ref": *"\([^"]*\)".*/\1/p')
  [ -n "$box_ref" ] || die "release.json names no image digest for the box, so it cannot be verified; nothing was changed"
  # Every image line is exactly `image: <name>@sha256:<64 hex>`: no variable a .env can replace, no comment trick, no tag. The box's
  # ref (and the computer's, when named) is one of those lines, whole.
  imgs=$(grep -E '^[[:space:]]*image:' "$tmp/compose.yml" || true)
  badimg=$(printf '%s\n' "$imgs" | grep -Ev '^[[:space:]]*image: [A-Za-z0-9._/-]+(:[A-Za-z0-9._-]+)?@sha256:[0-9a-f]{64}$' | grep -v '^$' || true)
  [ -z "$badimg" ] || die "the release's compose.yml starts an image that is not pinned exactly by digest ($(printf '%s' "$badimg" | head -n 1 | sed 's/^[[:space:]]*//')); nothing was changed"
  for ref in $box_ref $computer_ref; do
    printf '%s' "$ref" | grep -Eq '^ghcr\.io/vyre-ai/[a-z-]+@sha256:[0-9a-f]{64}$' || die "release.json names an image that is not a ghcr.io/vyre-ai digest; nothing was changed"
  done
  # The box's ref is one of the image lines, whole. The computer image is not a service of this stack: compose.yml hands its ref to vyred and
  # the Docker proxy as the default of VYRE_COMPUTERS_IMAGE (a root run never passes that setting on, so the default stands); it must be there,
  # on a line that is not a comment.
  printf '%s\n' "$imgs" | awk -v r="$box_ref" '{ sub(/^[ \t]*image:[ \t]*/, ""); if ($0 == r) f = 1 } END { exit !f }' || die "the release's compose.yml does not pin $box_ref as an image line, which release.json names; nothing was changed"
  if [ -n "$computer_ref" ]; then
    cdef=$(grep -v '^[[:space:]]*#' "$tmp/compose.yml" | sed -n 's/.*VYRE_COMPUTERS_IMAGE:-\([^}[:space:]]*\)}.*/\1/p')
    if [ -z "$cdef" ] || printf '%s\n' "$cdef" | grep -qvxF "$computer_ref"; then die "every default of VYRE_COMPUTERS_IMAGE in the release's compose.yml must be $computer_ref, which release.json names; nothing was changed"; fi
  fi
  # Every ghcr.io/vyre-ai image line of the released compose.yml is checked, not only the two release.json names (a third-party image
  # added to the compose file later rests on the signed digest of the release that pins it).
  all_refs=$( { printf '%s\n' "$imgs" | sed -n 's/^[[:space:]]*image:[[:space:]]*\(ghcr\.io\/vyre-ai\/[^[:space:]]*\)$/\1/p'; printf '%s\n' "$box_ref" "$computer_ref"; } | grep -v '^$' | sort -u)
  stage verifying-images
  for ref in $all_refs; do
    if ! docker run --rm "$COSIGN_IMAGE" verify --certificate-identity-regexp "$COSIGN_ID" --certificate-oidc-issuer "$COSIGN_ISSUER" "$ref" >/dev/null 2>"$tmp/cosign.err"; then
      sed 's/^/  /' "$tmp/cosign.err" >&2
      die "cosign could not verify $ref against Vyre's release workflow; nothing was changed"
    fi
  done
  say "images checked against Vyre's release workflow"
}

update() {
  CHANNEL=${VYRE_CHANNEL:-stable}
  TO=""
  ALLOW_UNSIGNED=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --channel) [ $# -ge 2 ] || die "--channel needs stable or beta"; CHANNEL=$2; shift ;;
      --channel=*) CHANNEL=${1#--channel=} ;;
      --to) [ $# -ge 2 ] || die "--to needs a version"; TO=$2; shift ;;
      --to=*) TO=${1#--to=} ;;
      --allow-unsigned) ALLOW_UNSIGNED=1 ;;
      *) die "vyre update: unknown option $1" ;;
    esac
    shift
  done
  case "$CHANNEL" in stable|beta) ;; *) die "the channel is stable or beta, not $CHANNEL" ;; esac
  UPD_FROM=$(compose exec -T vyre vyre version 2>/dev/null | tr -d ' \r\n' || true)
  stage checking

  # A box built from a checkout the person keeps themselves (VYRE_SOURCE is not $DIR/src) is
  # updated with git, not from a release: nothing is downloaded, and the source is left alone.
  if [ "$BUILD" = 1 ] && [ "$ROOT_RUN" = 0 ]; then
    src=$(sed -n 's/^VYRE_SOURCE=//p' "$DIR/.env" | tail -n 1)
    if [ "${src%/}" != "${DIR%/}/src" ]; then
      say "this box builds from $src: update it with git; rebuilding from it now"
      compose build --pull
      compose up -d
      ready
      compose exec -T vyre vyre up --keep-link || true
      exit 0
    fi
  fi

  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  TAG=""
  if [ "$USE_API" = 1 ]; then
    if pick_release; then say "release $TAG ($CHANNEL) from GitHub"
    elif [ -n "$TO" ]; then die "GitHub has no release $TO"
    else say "no $CHANNEL release on GitHub yet; using $SITE"; BASE=$SITE
    fi
  fi

  # Everything is downloaded and checked before anything on the box changes.
  stage downloading
  get_sums
  verify_signature
  BUILD_SRC=0
  if [ "$BUILD" = 1 ]; then
    src=$(sed -n 's/^VYRE_SOURCE=//p' "$DIR/.env" | tail -n 1)
    # A root run builds from its own copy of the verified source and takes the mode from root's record, never from this .env.
    if [ "$ROOT_RUN" = 1 ] || [ "${src%/}" = "${DIR%/}/src" ]; then BUILD_SRC=1; get vyre.tgz; fi
  fi
  for f in $BOXF VERSION vyre release.json shell.json modules.json appbuild.json; do if listed "$f"; then get "$f"; fi; done
  VERSION=$(tr -d ' \n' 2>/dev/null <"$tmp/VERSION" || true)
  VERSION=${VERSION:-${TAG#v}}
  VERSION=${VERSION:-$(date -u +%Y%m%d%H%M%S)}
  UPD_TO=$VERSION
  # An automatic update never goes back: a signed old release is still an old release.
  # The floor is the newest version the host has installed, kept in a file only root writes; what the container says it runs
  # is not trusted for this, since a compromised vyred could claim to be older.
  floor=$(readf "$UPD_PRIV/floor")
  if [ "${UPD_SIGNED:-0}" = 1 ]; then
    if [ -n "$floor" ] && older "$VERSION" "$floor"; then die "the newest release is $VERSION and the newest this server has had is $floor; an automatic update never goes back"; fi
    if [ -n "$UPD_FROM" ] && older "$VERSION" "$UPD_FROM"; then die "the newest release is $VERSION and this box runs $UPD_FROM; an automatic update never goes back"; fi
  fi
  if [ "${UPD_SIGNED:-0}" = 1 ] && [ -n "$UPD_FROM" ] && [ "$VERSION" = "$UPD_FROM" ]; then UPD_DONE=1; state ok none "already on $VERSION"; say "already on $VERSION"; exit 0; fi
  if [ -f "$tmp/release.json" ]; then
    min=$(tr -d '\n' <"$tmp/release.json" | sed -n 's/.*"min_from": *"\([^"]*\)".*/\1/p')
    cur=$(compose exec -T vyre vyre version 2>/dev/null | tr -d ' \r\n' || true)
    if [ -n "$min" ] && [ -n "$cur" ] && older "$cur" "$min"; then
      die "this box runs $cur, and $VERSION updates from $min or newer: run vyre update --to $min first"
    fi
  fi
  if [ "$BUILD" = 0 ]; then verify_release_images; fi
  if [ "$BUILD_SRC" = 1 ]; then unpack_src; fi

  # Now the box changes: back up, keep what runs, then swap in the new files.
  stage backing-up
  backup_db "$VERSION"
  IMG=$(image)
  TAGGED=0
  if docker image inspect "$IMG" >/dev/null 2>&1; then docker image tag "$IMG" vyre:prev; TAGGED=1; fi
  save_box
  put_box "$tmp"
  if [ "$BUILD_SRC" = 1 ]; then
    rm -rf "$SRCDIR.prev"
    if [ -d "$SRCDIR" ]; then mv "$SRCDIR" "$SRCDIR.prev"; fi
    mv "$SRCDIR.new" "$SRCDIR"
  fi

  stage installing
  updater_dirs
  if [ "$BUILD" = 1 ]; then ok=0; compose build --pull && ok=1
  else ok=0; compose pull && ok=1
  fi
  if [ "$ok" = 0 ]; then
    # Nothing new ran, so the database is untouched: put the files back only.
    if [ "$BUILD_SRC" = 1 ] && [ -d "$SRCDIR.prev" ]; then rm -rf "$SRCDIR"; mv "$SRCDIR.prev" "$SRCDIR"; fi
    put_box "$BOXPREV" exact
    die "the new image did not build; the box files are back as they were and Vyre was not restarted"
  fi
  stage restarting
  # The daemon is stopped, the signed release files are replaced as a folder, and only then the new container starts: a running vyred never sees
  # the new module list against the old tree (or the reverse), and a restart verifies one consistent release.
  compose stop vyre >/dev/null 2>&1 || true
  # (an update the person runs does not own this folder: root's publish_release, asked through sudo, clears the mark itself)
  rm -f "$UPD_PRIV/release.swapped" 2>/dev/null || true
  publish_release "$tmp" || roll_back
  compose up -d || roll_back
  ready || roll_back
  modules_ok || roll_back
  # The Space helper (when installed): the new container has none of the old one's network joins or firewall rules, and the image the helper regenerates from changed.
  if [ -s "$SP_PRIV/images" ]; then space_helper_record && space_helper_reattach || echo "vyre: the Space helper could not be brought up to date after the update" >&2; fi
  # The watcher is a long-running process of the OLD wrapper's text: left alone it would keep re-walling with the old code after the next restart of the vyre container (found on a real box: it knew no apps).
  if [ -f "$SYSTEMD_DIR/$SPACES_UNIT-watch.service" ] && command -v systemctl >/dev/null 2>&1; then systemctl try-restart "$SPACES_UNIT-watch.service" >/dev/null 2>&1 || true; fi
  put_text "$VERSION" "$DIR/VERSION"
  UPD_DONE=1
  # Raise the floor (never lower it): the host's own record of the newest version this server has had.
  fl=$(readf "$UPD_PRIV/floor")
  if [ -d "$UPD_PRIV" ] && { [ -z "$fl" ] || older "$fl" "$VERSION"; }; then put_text "$VERSION" "$UPD_PRIV/floor" 0600 || true; fi
  state ok finished "updated to $VERSION"
  say "updated to $VERSION"

  android
  # Report only: a fresh link would void the one the user was sent and has not opened yet.
  compose exec -T vyre vyre up --keep-link || true
  put_wrapper "$tmp/vyre"
  # The new wrapper brings its own updater units along: an older install gains the automatic path here.
  # (Not with a wrapper somewhere else, which is a test: nothing is written to systemd for one.)
  # (Not for a root run: the mode and the stack folder root recorded at install are not rewritten from a .env by an update.)
  if [ "$WRAPPER" = /usr/local/bin/vyre ] && [ "$ROOT_RUN" = 0 ]; then "$WRAPPER" updater install --dir "$DIR" >/dev/null 2>&1 || true; fi
  exit 0
}

# updater_dirs: the two folders the automatic path uses, made before compose mounts them (a missing bind source is
# made by Docker as a root-owned folder vyred cannot write). update/ is vyred's alone (uid 1000, 0700): it drops the
# request there, and nothing else in the container (Vyre-owned sessions run as uid 1001) can. update-state/ is root's,
# mounted read-only, so vyred can only read what the update says about itself.
updater_dirs() {
  sp_dirs
  mkdir -p "$UPD_ROOT" "$UPD_REQ" "$UPD_STATE" "$UPD_STATE/release" "$UPD_PRIV" 2>/dev/null || return 0
  chmod 755 "$UPD_ROOT" "$UPD_STATE" "$UPD_STATE/release" 2>/dev/null || true
  chmod 700 "$UPD_PRIV" 2>/dev/null || true
  chown 1000:1000 "$UPD_REQ" 2>/dev/null || true
  chmod 700 "$UPD_REQ" 2>/dev/null || true
}

# readf FILE: the file's text without blanks and newlines, or nothing when there is no such file (and no shell complaint).
readf() { if [ -f "$1" ]; then tr -d ' \n\r' <"$1" 2>/dev/null || true; fi; }

# unit_dirs_ok: before root reads or writes anything for an update, UPD_ROOT and every folder above it must be root's and not
# writable by group or others, and request/, status/ and private/ must be real folders (never links), so nobody can have
# moved them or planted a link in their place. ROOT_UID and CHAIN_TOP (where the walk up stops) are test seams: constants in the release build.
unit_dirs_ok() {
  ru=$ROOT_UID
  d=$UPD_ROOT
  top=$CHAIN_TOP
  while :; do
    [ -d "$d" ] && [ ! -L "$d" ] && own_ok "$d" "$ru" strict || return 1
    if [ "$d" = "$top" ] || [ "$d" = / ] || [ "$d" = . ]; then break; fi
    d=$(dirname "$d")
  done
  for d in "$UPD_STATE" "$UPD_PRIV"; do [ -d "$d" ] && [ ! -L "$d" ] && own_ok "$d" "$ru" strict || return 1; done
  [ -d "$UPD_REQ" ] && [ ! -L "$UPD_REQ" ]
}

# update_from_request: what the path unit runs, as root. The request is data, never arguments: it is dropped whatever it
# holds, and only the exact word `update` starts anything. It is a file in a folder vyred writes to, so it is looked at
# without following links and its content is only ever compared.
update_from_request() {
  if ! unit_dirs_ok; then echo "vyre: $UPD_ROOT (or a folder above it) is not root's alone, or a folder in it is missing or a link; no update was started" >&2; exit 0; fi
  set_root_run
  req="$UPD_REQ/request"
  if [ -L "$req" ] || [ ! -f "$req" ]; then rm -f "$req" 2>/dev/null || true; exit 0; fi
  line=$(head -c 16 "$req" 2>/dev/null | tr -d '\n\r' || true)
  rm -f "$req"
  [ "$line" = update ] || { echo "vyre: an update request that says anything else was dropped" >&2; exit 0; }
  # Two updates at once would swap the same files: the second waits for the next request. A lock left by a crash goes after two hours.
  if [ -d "$UPD_PRIV/lock" ] && [ -n "$(find "$UPD_PRIV/lock" -maxdepth 0 -mmin +120 2>/dev/null)" ]; then rmdir "$UPD_PRIV/lock" 2>/dev/null || true; fi
  mkdir "$UPD_PRIV/lock" 2>/dev/null || { echo "vyre: an update is already running" >&2; exit 0; }
  # At least 600 seconds between updates, so a request that keeps coming cannot keep the box restarting.
  last=$(readf "$UPD_PRIV/last")
  now=$(date +%s)
  case "$last" in ""|*[!0-9]*) last=0 ;; esac
  if [ $((now - last)) -lt "$MIN_GAP" ]; then
    rmdir "$UPD_PRIV/lock" 2>/dev/null || true
    echo "vyre: an update ran a moment ago; this request waits for the next" >&2
    UPD_TRACK=1; state failed too-soon "an update ran a moment ago; ask again in a few minutes"
    exit 0
  fi
  # From here root starts compose: from its own copies, after refusing anything a person planted (prepare_run).
  if ! perr=$( ( UPD_TRACK=1; prepare_run ) 2>&1 ); then rmdir "$UPD_PRIV/lock" 2>/dev/null || true; echo "$perr" >&2; exit 1; fi
  prepare_run
  # The minimum gap counts runs that got as far as starting something: a refusal above (an override file, a COMPOSE_* setting) does not use it up.
  put_text "$now" "$UPD_PRIV/last" 0600
  ch=$(sed -n 's/^VYRE_CHANNEL=//p' "$DIR/.env" 2>/dev/null | tail -n 1 | tr -d ' \r')
  case "$ch" in stable|beta|"") ;; *) echo "vyre: VYRE_CHANNEL in $DIR/.env is \"$ch\", not stable or beta; using stable" >&2; ch=stable ;; esac
  rc=0
  ( UPD_TRACK=1; UPD_SIGNED=1; mkdir -p "$UPD_PRIV/backups"; [ -z "$ch" ] || VYRE_CHANNEL=$ch; export VYRE_CHANNEL; update ) || rc=$?
  rmdir "$UPD_PRIV/lock" 2>/dev/null || true
  exit "$rc"
}

# own_ok PATH ROOT_UID strict|loose: not writable by group or others, and, when strict, owned by ROOT_UID.
own_ok() {
  m=$(stat -c '%A %u' "$1" 2>/dev/null || stat -f '%Sp %u' "$1" 2>/dev/null) || return 1
  perms=${m%% *}; uid=${m##* }
  case "$perms" in ?????w*|????????w*) return 1 ;; esac
  [ "$3" != strict ] || [ "$uid" = "$2" ]
}

# updater install|status|remove: the systemd path unit that makes vyred's request run update_from_request.
updater() {
  units=$SYSTEMD_DIR
  # The unit's name is fixed; a test seam changes it for a rehearsal on a machine that already has the real one.
  un=$UPDATER_NAME
  case "$un" in *[!A-Za-z0-9._-]*|"") die "the updater unit name is a plain unit name" ;; esac
  case "${1:-status}" in
    install)
      if ! command -v systemctl >/dev/null 2>&1 || { [ ! -d /run/systemd/system ] && [ -z "$SYSTEMD_SEAM" ]; }; then
        echo "vyre: this server has no systemd, so an update is the vyre update command only"; return 0
      fi
      if [ "$(id -u)" != 0 ] && [ -z "$SYSTEMD_SEAM" ]; then exec sudo -n "$WRAPPER" updater install --dir "$DIR"; fi
      # The unit runs the wrapper as root, so neither it nor the folder it works in may be writable by anyone else.
      root_uid=$ROOT_UID
      for f in "$WRAPPER" "$DIR"; do
        if ! own_ok "$f" "$root_uid" "$( [ "$f" = "$WRAPPER" ] && echo strict || echo loose )"; then
          die "$f must not be writable by its group or others (and $WRAPPER must be owned by root): the update unit would run it as root. Fix that, then run vyre updater install"
        fi
      done
      updater_dirs
      # The compose.yml this root call is copying: the first install records its hash; a later install from a folder whose file differs is refused,
      # so choosing --dir cannot make root copy and run a compose file nobody verified (a root update refreshes the record from its verified release).
      if [ ! -f "$DIR/compose.yml" ] || [ -L "$DIR/compose.yml" ]; then die "$DIR/compose.yml is not a regular file"; fi
      want=$(sha256_of "$DIR/compose.yml")
      have=$(readf "$UPD_ROOT/compose.sha256")
      if [ -n "$have" ] && [ "$have" != "$want" ]; then
        die "root recorded another compose.yml for this box than the one in $DIR; nothing was changed. If you changed it on purpose: sudo vyre updater remove, then install again"
      fi
      # Where this install's stack folder is, written by root, so a later root run (the path unit, the sudo of a hand-run update) never takes
      # the stack folder from an environment or a file the person can write.
      printf '%s\n' "$DIR" >"$UPD_ROOT/stack.new" && chmod 644 "$UPD_ROOT/stack.new" && rename_over "$UPD_ROOT/stack.new" "$UPD_ROOT/stack" || echo "vyre: could not record the stack folder for root" >&2
      # How this box is built, as it is now and as root records it: pull, build (from the tgz source in $DIR/src) or external (a checkout of the
      # person's own). A root run reads the mode only from here, so a .env cannot turn a release box into one root builds from a tree a person writes.
      m=pull
      if grep -q '^COMPOSE_FILE=.*compose\.build\.yml' "$DIR/.env" 2>/dev/null; then
        m=external; src=$(sed -n 's/^VYRE_SOURCE=//p' "$DIR/.env" | tail -n 1)
        if [ "${src%/}" = "${DIR%/}/src" ]; then m=build; fi
      fi
      printf '%s\n' "$m" >"$UPD_ROOT/mode.new" && chmod 644 "$UPD_ROOT/mode.new" && rename_over "$UPD_ROOT/mode.new" "$UPD_ROOT/mode" || echo "vyre: could not record the build mode for root" >&2
      # And root's own copies of the compose files it will run from (the installer has just laid these down; later ones come from verified releases).
      mkdir -p "$RUN" && chmod 700 "$RUN" && sync_run "$DIR" || echo "vyre: could not copy the compose files for root" >&2
      if printf '%s\n' "$want" >"$UPD_ROOT/compose.sha256.new" && chmod 644 "$UPD_ROOT/compose.sha256.new" && rename_over "$UPD_ROOT/compose.sha256.new" "$UPD_ROOT/compose.sha256"; then :; fi
      svc="$units/$un.service"
      { printf '[Unit]\nDescription=Vyre update, asked for by vyred\n\n[Service]\nType=oneshot\nEnvironment=VYRE_DIR=%s\nExecStart=%s update-from-request\nTimeoutStartSec=3600\n' "$DIR" "$WRAPPER"; } >"$svc.new" && mv "$svc.new" "$svc"
      { printf '[Unit]\nDescription=Vyre update requests\n\n[Path]\nPathExists=%s/request\nUnit=%s.service\n\n[Install]\nWantedBy=multi-user.target\n' "$UPD_REQ" "$un"; } >"$units/$un.path.new" && mv "$units/$un.path.new" "$units/$un.path"
      systemctl daemon-reload
      systemctl enable --now "$un.path" >/dev/null 2>&1 || systemctl enable "$un.path"
      # Vyre reads this (through the read-only mount) to know a unit will act on a request.
      printf '1\n' >"$UPD_STATE/ready"
      say "updates can be asked for from Vyre: $un.path watches $UPD_REQ/request"
      ;;
    remove)
      # The units and the ready file are root's: a person's uninstall asks for root, as install does, and says so when it cannot.
      if [ "$(id -u)" != 0 ] && [ ! -w "$units" ]; then
        { [ -f "$units/$un.path" ] || [ -f "$units/$un.service" ]; } || return 0
        # Root runs the wrapper only when it is root's and nobody else can write it (a test can point the wrapper anywhere).
        if own_ok "$WRAPPER" "$ROOT_UID" strict; then
          if [ -t 0 ]; then sudo "$WRAPPER" updater remove; else sudo -n "$WRAPPER" updater remove; fi && return 0
        fi
        echo "vyre: the update units $un.path and $un.service are still on this server; remove them with: sudo $WRAPPER updater remove" >&2
        return 1
      fi
      rm -f "$UPD_STATE/ready" "$UPD_ROOT/stack" "$UPD_ROOT/mode" "$UPD_ROOT/compose.sha256"
      systemctl disable --now "$un.path" >/dev/null 2>&1 || true
      rm -f "$units/$un.path" "$units/$un.service"
      systemctl daemon-reload 2>/dev/null || true
      say "the update path unit is removed"
      ;;
    status)
      if [ -f "$units/$un.path" ]; then echo "installed: $units/$un.path"; else echo "not installed"; fi
      ;;
    *) die "vyre updater install|status|remove" ;;
  esac
}

# rollback: the previous release back by hand. The database stays unless --restore-data.
rollback() {
  DATA=0
  YES=0
  for a in "$@"; do
    case "$a" in
      --rollback) ;;
      --restore-data) DATA=1 ;;
      --yes|-y) YES=1 ;;
      --proof-file=*) ;; # the approval comes from the owner's phone now (ask and status); the flag is accepted and ignored
      *) die "vyre update --rollback: unknown option $a" ;;
    esac
  done
  IMG=$(image)
  have_img=0
  if docker image inspect vyre:prev >/dev/null 2>&1; then have_img=1; fi
  [ -d "$SRCDIR.prev" ] || [ -d "$DIR/box.prev" ] || [ "$have_img" = 1 ] || die "there is no previous release to roll back to"
  if [ "$DATA" = 1 ]; then
    f=$(cat "$DIR/backups/last" 2>/dev/null || true)
    [ -n "$f" ] || die "no pre-update backup is recorded in $DIR/backups/last"
    echo "vyre: --restore-data puts back the database from $f, and drops everything written since"
    echo "  (threads, notes, settings and vault changes made after that update)."
    if [ "$YES" = 0 ]; then
      [ -t 0 ] || die "--restore-data drops data; on a terminal type the confirm line, or pass --yes"
      printf 'type restore to go on: '
      read -r answer || answer=""
      [ "$answer" = restore ] || die "left the database alone"
    fi
  fi
  # The previous release's signed module list has a LOWER counter than the one the kernel last accepted, so its image would run no modules until the owner resets the
  # list. Ask the still-running daemon for that reset (a presence-gated tool of the owner's: modules.list.reset) BEFORE anything is swapped, and refuse without it: a rollback
  # never silently produces a box with no modules (L-2). A previous release with no list (an older line) needs none.
  if [ -f "$UPD_PRIV/release.prev/modules.json" ]; then
    curc=$(counter_of "$UPD_STATE/release/modules.json"); prevc=$(counter_of "$UPD_PRIV/release.prev/modules.json")
    if [ -n "$curc" ] && [ -n "$prevc" ] && [ "$prevc" -lt "$curc" ]; then
      echo "vyre: the release before has an older module list (counter $prevc, this one is $curc); the owner has to approve going back, once." >&2
      # The owner's approval comes from the owner's phone through the running daemon: ask (one new ask per 10 minutes, a second call returns the same id), print where to approve,
      # then poll the status about every 2 s until it is answered or the ask runs out. Approved swaps; refused, none, a rate limit or no answer refuses and changes nothing.
      ask=$(compose exec -T vyre vyre call modules.list.reset.ask '{}' 2>&1) || { printf '%s\n' "$ask" | head -n 3 >&2; die "not rolled back: the owner could not be asked to approve (is Vyre running?). Nothing was changed."; }
      rid=$(printf '%s' "$ask" | tr -d '\n' | sed -n 's/.*"id": *"\([A-Za-z0-9_-]\{1,80\}\)".*/\1/p')
      ttl=$(printf '%s' "$ask" | tr -d '\n' | sed -n 's/.*"expires_in_s": *\([0-9]\{1,5\}\).*/\1/p')
      [ -n "$rid" ] || die "not rolled back: the answer to the approval request was not understood. Nothing was changed."
      case "$ttl" in ""|*[!0-9]*) ttl=300 ;; esac
      echo "vyre: approve going back on your phone (Vyre asks you to confirm). Waiting up to $ttl seconds."
      end=$(( $(date +%s) + ttl )); verdict=""
      while [ "$(date +%s)" -lt "$end" ]; do
        stt=$(compose exec -T vyre vyre call modules.list.reset.status "{\"id\":\"$rid\"}" 2>&1 | tr -d '\n') || true
        case "$stt" in *'"approved"'*) verdict=approved; break ;; *'"refused"'*) verdict=refused; break ;; *'"none"'*) verdict=none; break ;; esac
        sleep "${VYRE_ROLLBACK_POLL:-2}"
      done
      case "$verdict" in
        approved) ;;
        refused) die "not rolled back: you refused on your phone. Nothing was changed." ;;
        none) die "not rolled back: the approval request is gone (it ran out or was answered elsewhere). Run this again to ask again. Nothing was changed." ;;
        *) die "not rolled back: nobody approved in time. Run this again to ask again. Nothing was changed." ;;
      esac
    fi
  fi
  # A swap, so a second --rollback goes forward again.
  if [ -d "$SRCDIR.prev" ]; then swap_dirs "$SRCDIR" "$SRCDIR.prev"; fi
  # The signed release files go with the image: stop the daemon, swap the folder whole, and let the container below start on the pair it was signed with.
  if [ -d "$UPD_PRIV/release.prev" ]; then compose stop vyre >/dev/null 2>&1 || true; swap_dirs "$UPD_STATE/release" "$UPD_PRIV/release.prev"; fi
  if [ "$have_img" = 1 ]; then
    if docker image inspect "$IMG" >/dev/null 2>&1; then docker image tag "$IMG" vyre:next; fi
    docker image tag vyre:prev "$IMG"
    if docker image inspect vyre:next >/dev/null 2>&1; then docker image tag vyre:next vyre:prev; docker image rm vyre:next >/dev/null; fi
  fi
  if [ -d "$DIR/box.prev" ]; then
    rm -rf "$DIR/box.cur"
    mkdir -p "$DIR/box.cur"
    for f in $BOXF VERSION; do if [ -f "$DIR/$f" ]; then cp -p "$DIR/$f" "$DIR/box.cur/$f"; fi; done
    if [ -f "$WRAPPER" ]; then cp -p "$WRAPPER" "$DIR/box.cur/vyre"; fi
    put_box "$BOXPREV" exact
    rm -f "$DIR/.vyre.back"
    if [ -f "$DIR/box.prev/vyre" ]; then cp -p "$DIR/box.prev/vyre" "$DIR/.vyre.back"; fi
    rm -rf "$DIR/box.prev"
    mv "$DIR/box.cur" "$DIR/box.prev"
  fi
  compose up -d
  ready || true
  csh 'd=$1; [ -f "$d/android.json.prev" ] || exit 0; mv "$d/android.json.prev" "$d/.android.json.swap"; { [ ! -f "$d/android.json" ] || mv "$d/android.json" "$d/android.json.prev"; }; mv "$d/.android.json.swap" "$d/android.json"' \
    "$CHOME/releases/android" || echo "vyre: could not put android.json.prev back" >&2
  if [ "$DATA" = 1 ]; then
    restore_db || die "rolled back the release, but the database restore failed"
    compose up -d
    ready || true
  fi
  if [ "$DATA" = 1 ]; then say "rolled back, with the database from before the update"
  else say "rolled back; the database is the current one"
  fi
  # The previous wrapper goes back last, the same way an update replaces it.
  if [ -f "$DIR/.vyre.back" ]; then put_wrapper "$DIR/.vyre.back"; rm -f "$DIR/.vyre.back"; fi
  exit 0
}

# What is in each volume, in the words a person would use. Unknown ones (a future volume) still
# get listed by name, so the screen never hides one.
vol_says() {
  case "$1" in
    *vyre-home) echo "your vault, memory, settings, artifacts and this server's sign-ins" ;;
    *vyre-work) echo "your projects and files (/work)" ;;
    *vyre-agent-home) echo "your agents' own sign-in state and transcripts" ;;
    *vyre-accounts) echo "each AI account's sign-in" ;;
    *vyre-sessions) echo "the temp folders of running sessions" ;;
    *docker-api-bearer) echo "internal, nothing of yours" ;;
    *) echo "Vyre data" ;;
  esac
}

# uninstall: complete and easy. Containers, agents' computers and the network always go, and so does
# this wrapper. The volumes go only when the person says so. It never removes their Docker, their
# Claude, Codex and Gemini installs on any device.
uninstall() {
  choice=ask
  yes=0
  for a in "$@"; do
    case "$a" in
      --delete-data) choice=delete ;;
      --keep-data) choice=keep ;;
      --yes|-y) yes=1 ;;
      *) die "unknown option $a (vyre uninstall [--delete-data | --keep-data] [--yes])" ;;
    esac
  done
  vols=$(docker volume ls -q --filter label=run.vyre=1 --filter label=com.docker.compose.project=vyre)
  if [ "$choice" = ask ]; then
    if [ -n "$vols" ]; then
      echo "Vyre will stop and come off this server. These hold your data:"
      for v in $vols; do printf '  %s: %s\n' "$v" "$(vol_says "$v")"; done
      echo "Before deleting them you can save everything with: vyre backup"
    fi
    choice=keep
    if [ -n "$vols" ] && [ "$yes" = 0 ] && (: </dev/tty) 2>/dev/null; then
      printf 'Delete this data too? Saying yes deletes it for good. [y/N] ' >/dev/tty
      read -r answer </dev/tty || answer=n
      case "$answer" in y|Y|yes|YES|Yes) choice=delete ;; esac
    fi
  fi
  # Agents' computers are containers on the computers network, made by vyred, not by compose.
  comp=$(docker ps -aq --filter network=vyre-computers 2>/dev/null || true)
  # shellcheck disable=SC2086 # one container id per word
  [ -z "$comp" ] || docker rm -f $comp >/dev/null
  compose --profile computers down --remove-orphans
  # Vyre's own images (the box and the computers, and the one kept for a rollback) are not data: a
  # gigabyte of layers with no use once Vyre is gone. Docker itself stays.
  imgs=$(docker image ls -q --filter 'reference=ghcr.io/vyre-ai/*' --filter 'reference=vyre:*' 2>/dev/null | sort -u || true)
  # shellcheck disable=SC2086 # one image id per word
  [ -z "$imgs" ] || docker image rm -f $imgs >/dev/null 2>&1 || true
  if [ "$choice" = delete ]; then
    # shellcheck disable=SC2086 # one volume name per word
    [ -z "$vols" ] || docker volume rm $vols >/dev/null
    say "your data is deleted"
  else
    say "your data is kept: a fresh install picks up where this left off"
  fi
  updater remove || say "The update units are still on this server (see above); the wrapper stays so you can remove them with: sudo $WRAPPER updater remove"
  # The Space helper's units run this wrapper: left behind they would keep starting a command that is gone. In a subshell, because removing them as non-root re-runs the wrapper under sudo.
  if [ -f "$SYSTEMD_DIR/$SPACES_UNIT.path" ] || [ -f "$SYSTEMD_DIR/$SPACES_UNIT-watch.service" ]; then
    ( space_helper remove ) || say "The Space helper units are still on this server; the wrapper stays so you can remove them with: sudo $WRAPPER space-helper remove"
  fi
  if [ -e "$WRAPPER" ] && [ ! -f "$SYSTEMD_DIR/$UPDATER_NAME.path" ] && [ ! -f "$SYSTEMD_DIR/$SPACES_UNIT.path" ] && grep -q "$MARK" "$WRAPPER" 2>/dev/null; then rm -f "$WRAPPER" 2>/dev/null || sudo rm -f "$WRAPPER"; fi
  say "Vyre is off this server. $DIR stays with its .env; remove it with: sudo rm -rf $DIR"
}

# expire_code: the setup code install-box.sh left in vyre.env (VYRE_SETUP_CODE, with the time it was written)
# is good for an hour and the box reads it once at start; past the hour both lines go, so a restart never
# arms an old code again.
expire_code() {
  f="$DIR/vyre.env"
  [ -f "$f" ] || return 0
  at=$(sed -n 's/^VYRE_SETUP_CODE_AT=\([0-9][0-9]*\)$/\1/p' "$f" 2>/dev/null | head -n 1)
  [ -n "$at" ] || return 0
  [ $(( $(date +%s) - at )) -gt 3600 ] || return 0
  grep -v -e '^VYRE_SETUP_CODE=' -e '^VYRE_SETUP_CODE_AT=' "$f" >"$f.new" || true
  cat "$f.new" >"$f"
  rm -f "$f.new"
}

BUILD=0
if grep -q '^COMPOSE_FILE=.*compose.build.yml' "$DIR/.env" 2>/dev/null; then BUILD=1; fi

# Any other root verb that starts compose (sudo vyre up, logs, the CLI, uninstall) also runs from root's own copies once the updater has recorded
# them; a host with no updater (no systemd) keeps the stack folder's files, as the installer laid them down.
if [ "$(id -u)" = 0 ] && [ -f "$UPD_ROOT/mode" ]; then
  case "${1:-}" in updater|publish-release|update-from-request|update) ;; *) set_root_run; prepare_run ;; esac
fi
# ---------------------------------------------------------------------------------------------------------------------------------------------
# The Space helper: the root side of a Space's Twenty store (team/archive/work-journals/space-helper.md, Revision 2). Linux only.
#
# vyred (uid DAEMON_UID in its container) drops one file `req-<32 hex>` holding `<verb> <space>` into SP_SPOOL, a folder it alone can write; a root path unit
# runs `space-helper-run`. The request is data: it is CLAIMED by rename into a root-only folder, looked at with stat, parsed whole against one anchored
# pattern, and only then acted on, from root's own regenerated copy of the Space's compose file. Five verbs: up, stop, down, firewall-add, firewall-del.
# `purge` and `fscrypt-enable` are not verbs: they are `sudo vyre admin ...` (RH-2). No request carries a secret, a path, an image, a subnet or a flag.
#   spool/    vyred's alone (DAEMON_UID, 0700), mounted read-write into the container
#   status/   root writes `status-<id>`, mounted read-only into the container
#   private/  root's only: claim/, spaces/<name>/{record,secrets.env,compose.yml,empty-front/}, image, images, memory, log, rate-*, lock-*
# ---------------------------------------------------------------------------------------------------------------------------------------------
SP_SPOOL=$SPACES_ROOT/spool
SP_STATE=$SPACES_ROOT/status
SP_PRIV=$SPACES_ROOT/private
SP_NAME_RE='[a-z][a-z0-9-]{0,30}'
SPACES_PUBLISH_MAX_KB=${VYRE_PUBLISH_MAX_KB:-524288}
SPACES_PUBLISH_TIMEOUT=${VYRE_PUBLISH_TIMEOUT:-120}

# sp_lend_base: where the runner keeps lent workspaces, as ROOT finds it: the host folder behind the vyre container's home mount, read from Docker, never from a file or
# a request the daemon can write. A volume's folder or a bind: both are a Source path on the host. Printed only when it is an absolute path.
sp_lend_base() {
  m=$(hdock inspect -f '{{range .Mounts}}{{.Destination}}|{{.Source}}{{"\n"}}{{end}}' "$CTR_NAME" 2>/dev/null)
  b=$(printf '%s\n' "$m" | sed -n 's#^/home/vyre/\.vyre|\(/.*\)$#\1#p' | head -n 1)
  # The installer mounts the whole home (/home/vyre) and the daemon's folder is .vyre inside it; a mount of .vyre itself is the other shape.
  [ -n "$b" ] || { b=$(printf '%s\n' "$m" | sed -n 's#^/home/vyre|\(/.*\)$#\1#p' | head -n 1); [ -n "$b" ] && b=$b/.vyre; }
  case "$b" in /*) printf '%s\n' "$b" ;; *) return 1 ;; esac
}
# sp_dirs: the three folders, made before compose mounts them (a missing bind source becomes a root-owned folder vyred cannot write).
sp_dirs() {
  mkdir -p "$SPACES_ROOT" "$SP_SPOOL" "$SP_STATE" "$SP_PRIV" 2>/dev/null || return 0
  chmod 755 "$SPACES_ROOT" "$SP_STATE" 2>/dev/null || true
  chmod 700 "$SP_PRIV" 2>/dev/null || true
  chown "$DAEMON_UID:$DAEMON_UID" "$SP_SPOOL" 2>/dev/null || true
  chmod 700 "$SP_SPOOL" 2>/dev/null || true
}
# sp_dirs_ok: every folder from SPACES_ROOT up is root's and not writable by others, status and private are real root folders, the spool is a real folder
# vyred owns and nobody else can write. Nothing is read or written otherwise.
sp_dirs_ok() {
  d=$SPACES_ROOT
  while :; do
    [ -d "$d" ] && [ ! -L "$d" ] && own_ok "$d" "$ROOT_UID" strict || return 1
    if [ "$d" = "$CHAIN_TOP" ] || [ "$d" = / ] || [ "$d" = . ]; then break; fi
    d=$(dirname "$d")
  done
  for d in "$SP_STATE" "$SP_PRIV"; do [ -d "$d" ] && [ ! -L "$d" ] && own_ok "$d" "$ROOT_UID" strict || return 1; done
  [ -d "$SP_SPOOL" ] && [ ! -L "$SP_SPOOL" ] && own_ok "$SP_SPOOL" "$DAEMON_UID" strict
}
# sp_log TEXT: one capped line, no path, no secret: only characters a reason needs.
sp_log() {
  l=$(printf '%s' "$*" | LC_ALL=C tr -c 'A-Za-z0-9 :._,=+-' '?' | cut -c1-160)
  f=$SP_PRIV/log
  if [ -f "$f" ] && [ "$(wc -c <"$f")" -gt 262144 ]; then mv -f "$f" "$f.1"; fi
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$l" >>"$f" 2>/dev/null || true
}
# sp_status ID STATE MESSAGE: status/status-<id>, written whole and renamed; the daemon reads only its own id.
sp_status() {
  m=$(printf '%s' "$3" | LC_ALL=C tr -c 'A-Za-z0-9 :._,=+-' '?' | cut -c1-120)
  t=$SP_STATE/.tmp-$1
  # shellcheck disable=SC2015 # A && B || C on purpose: C is the refusal
  printf '{"id":"%s","state":"%s","message":"%s","at":%s}\n' "$1" "$2" "$m" "$(date +%s)" >"$t" && chmod 644 "$t" && rename_over "$t" "$SP_STATE/status-$1" || true
}
# hdock ARGS: docker, from a clean environment, with a root-owned config folder: nothing a caller or a shell hands down reaches it.
hdock() { env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker "$@"; }
# sp_dc NAME ARGS: compose for one Space, only on root's own copy, the project name fixed from the validated name.
sp_dc() {
  n=$1; shift
  sp_name_ok "$n" || return 1
  d=$SP_PRIV/spaces/$n
  # 40 minutes: a first start migrates an empty database (compose waits for the server through its 15 minute start period, see composeFile), which a slow server can need most of
  timeout 2400 env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker compose --project-directory "$d" --project-name "vyre-$n-twenty" \
    --env-file "$d/secrets.env" -f "$d/compose.yml" "$@"
}
sp_known() { sp_name_ok "$1" && [ -f "$SP_PRIV/spaces/$1/record" ] && [ ! -L "$SP_PRIV/spaces/$1/record" ]; }
sp_running() { [ -n "$(hdock ps -q --filter "label=com.docker.compose.project=vyre-$1-twenty" 2>/dev/null || true)" ]; }
# sp_pid: the vyre container's pid, taken fresh on every call (a recreated container has a new one and a new, empty network namespace).
sp_pid() {
  p=$(hdock inspect -f '{{.State.Pid}}' "$CTR_NAME" 2>/dev/null || true)
  case "$p" in ""|*[!0-9]*|0) return 1 ;; esac
  printf '%s\n' "$p"
}
sp_net_subnets() { sp_net_subnets_of "vyre-$1-twenty_store"; }
sp_net_subnets_of() { hdock network inspect -f '{{range .IPAM.Config}}{{.Subnet}} {{end}}' "$1" 2>/dev/null | tr -d '\r'; }
sp_subnet_ok() { printf '%s\n' "$1" | grep -Eqx '([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}|[0-9a-f:]+/[0-9]{1,3}'; }
sp_ipt() { case "$1" in *:*) echo ip6tables ;; *) echo iptables ;; esac; }
# sp_fw_each FAMILY PID ARGS: one iptables call inside the vyre container's own network namespace, where the agents' sockets are local.
sp_fw_each() {
  fam=$1; pid=$2; shift 2
  timeout 20 nsenter -t "$pid" -n "$fam" -w "$@"
}
# sp_ranges: the two uid ranges either side of the daemon's uid, one rule each. A single negated owner match (`! --uid-owner D`) also matches the kernel's own REJECT reply, which
# has no socket owner and goes to the container's address inside the store subnet, so the reply is dropped and every refused connect times out instead of being refused (reviewer-3,
# on real iptables). Two positive ranges never match an ownerless packet.
sp_ranges() { printf '0-%s\n%s-4294967294\n' $((DAEMON_UID - 1)) $((DAEMON_UID + 1)); }
# sp_fw_apply NAME: every subnet of the Space's store network gets the two rules (reviewer-3's shape): -C first, then inserted at position 1, then verified with -C.
# It is sp_fw_apply_net with the Space's own network and comment; an app module's network and comment (vyre-app:<module>) go through the same function.
sp_fw_apply() { sp_fw_apply_net "$1" "vyre-$1-twenty_store" "vyre:$1" "$1"; }
# sp_fw_apply_net NAME NET TAG KEY: NAME is the word in the messages; the rules carry the comment TAG; KEY is the name the subnet is listed under in status/subnets.
sp_fw_apply_net() {
  n=$1; net=$2; tag=$3; key=$4
  pid=$(sp_pid) || { MSG="the vyre container is not running"; return 1; }
  subs=$(sp_net_subnets_of "$net")
  [ -n "$subs" ] || { MSG="the Space's network does not exist"; return 1; }
  for s in $subs; do
    sp_subnet_ok "$s" || { MSG="a subnet of the Space's network is not one the helper accepts"; return 1; }
    fam=$(sp_ipt "$s")
    for rg in $(sp_ranges); do
      if ! sp_fw_each "$fam" "$pid" -C OUTPUT -d "$s" -m owner --uid-owner "$rg" -m comment --comment "$tag" -j REJECT >/dev/null 2>&1; then
        sp_fw_each "$fam" "$pid" -I OUTPUT 1 -d "$s" -m owner --uid-owner "$rg" -m comment --comment "$tag" -j REJECT >/dev/null 2>&1 || { MSG="the firewall rule could not be added"; return 1; }
      fi
      sp_fw_each "$fam" "$pid" -C OUTPUT -d "$s" -m owner --uid-owner "$rg" -m comment --comment "$tag" -j REJECT >/dev/null 2>&1 || { MSG="the firewall rule is not there after it was added"; return 1; }
    done
    sp_sub_set "$key" "$s" || { MSG="the list of firewalled subnets could not be written"; return 1; }
  done
}
# sp_probe NAME: the rule is proved, not assumed. In the vyre container's namespace a connect to the store's address as an agent uid must be REFUSED at once
# (exit 1: not a timeout, which a dead store or a dropped packet also gives), and as the daemon's uid must go through (the control), for each address family the store has.
# It is sp_probe_to with the Space's own project, service, network and port; an app module's go through the same function.
sp_probe() { sp_probe_to "$1" "vyre-$1-twenty" server "vyre-$1-twenty_store" 3000 "the Space's server"; }
# sp_probe_to NAME PROJECT SERVICE NET PORT WHO: WHO is the words the messages use for the container being proved.
sp_probe_to() {
  n=$1; project=$2; service=$3; net=$4; port=$5; who=$6
  pid=$(sp_pid) || { MSG="the vyre container is not running"; return 1; }
  sid=$(hdock ps -q --filter "label=com.docker.compose.project=$project" --filter "label=com.docker.compose.service=$service" 2>/dev/null | head -n 1 || true)
  [ -n "$sid" ] || { MSG="$who is not running, so the firewall could not be proved"; return 1; }
  ip4=$(hdock inspect -f "{{with index .NetworkSettings.Networks \"$net\"}}{{.IPAddress}}{{end}}" "$sid" 2>/dev/null || true)
  ip6=$(hdock inspect -f "{{with index .NetworkSettings.Networks \"$net\"}}{{.GlobalIPv6Address}}{{end}}" "$sid" 2>/dev/null || true)
  # Docker prints "invalid IP" (or nothing) for a family the network does not have: keep only values that are addresses.
  printf '%s\n' "$ip4" | grep -Eqx '([0-9]{1,3}\.){3}[0-9]{1,3}' || ip4=""
  printf '%s\n' "$ip6" | grep -Eqx '[0-9a-f]*:[0-9a-f:]*' || ip6=""
  [ -n "$ip4$ip6" ] || { MSG="$who has no address on its network"; return 1; }
  for ip in $ip4 $ip6; do
    printf '%s\n' "$ip" | grep -Eqx '[0-9a-f:.]+' || { MSG="an address the helper does not accept"; return 1; }
    if ! timeout 8 nsenter -t "$pid" -n setpriv --reuid="$DAEMON_UID" --regid="$DAEMON_UID" --clear-groups -- timeout 4 bash -c "exec 3<>/dev/tcp/$ip/$port" >/dev/null 2>&1; then
      MSG="the control connect (the daemon's uid) did not reach the store, so the firewall could not be proved"; return 1
    fi
    # Every uid but the daemon's is refused: root (0), an agent's (2000) and a Vyre session's (the daemon's uid plus one), so nothing else can reach Twenty's first-user signup (RH-6).
    for ou in 0 2000 $((DAEMON_UID + 1)); do
      prc=0
      timeout 8 nsenter -t "$pid" -n setpriv --reuid="$ou" --regid="$ou" --clear-groups -- timeout 4 bash -c "exec 3<>/dev/tcp/$ip/$port" >/dev/null 2>&1 || prc=$?
      [ "$prc" = 1 ] || { MSG="uid $ou can reach the store (or the answer was not a refusal)"; return 1; }
    done
  done
}
# sp_attach NAME: the vyre container joins the Space's network (with the alias the store calls it by), then the rule goes in. Both live in that container's
# namespace and are lost when it is recreated, so this runs at every `up` and after every update.
sp_attach() { sp_attach_net "$1" "vyre-$1-twenty_store" "vyre-$1" && sp_fw_apply "$1"; }
# sp_attach_net NAME NET ALIAS: the join only (the caller puts the rules in): the vyre container joins NET with the alias ALIAS.
sp_attach_net() {
  n=$1; net=$2; alias=$3
  # The container must mount the helper's state folder (where the entry reads the marker): a recreate without it would start with no wall to wait for (SH-5).
  hdock inspect -f '{{range .Mounts}}{{.Destination}} {{end}}' "$CTR_NAME" 2>/dev/null | tr ' ' '\n' | grep -qx '/run/vyre-spaces-state' || { MSG="the vyre container does not mount the helper state folder, so run: vyre up"; return 1; }
  hdock network inspect "$net" >/dev/null 2>&1 || { MSG="the Space's network does not exist"; return 1; }
  if ! hdock inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' "$CTR_NAME" 2>/dev/null | tr ' ' '\n' | grep -qx "$net"; then
    hdock network connect --alias "$alias" "$net" "$CTR_NAME" >/dev/null 2>&1 || { MSG="the vyre container could not join the Space's network"; return 1; }
  fi
}
# sp_fw_del NAME: only while no container of the project runs; removes exactly the rules carrying vyre:<name>, found by listing the chain, in the namespace of the pid current now.
# iptables prints the comment quoted (--comment "vyre:n") on some versions and bare on others: both are read, the quotes are stripped before -D, and success is reported
# only after a second listing shows no line that names the Space at all (a form this function does not know is a failure, never a silent success).
sp_fw_del() {
  n=$1
  if sp_running "$n"; then MSG="the Space is running; stop or down it first"; return 1; fi
  pid=$(sp_pid) || { MSG="nothing to remove: the vyre container is not running"; sp_sub_del "$n"; return 0; }
  for fam in iptables ip6tables; do
    lines=$(timeout 20 nsenter -t "$pid" -n "$fam" -w -S OUTPUT 2>/dev/null | grep -E -- "vyre:$n([^a-z0-9-]|\$)" || true)
    [ -n "$lines" ] || continue
    printf '%s\n' "$lines" | while IFS= read -r l; do
      printf '%s\n' "$l" | grep -Eqx -- "-A OUTPUT -d [0-9a-f:./]+ -m owner --uid-owner [0-9]+-[0-9]+ -m comment --comment \"?vyre:$n\"? -j REJECT( --reject-with [a-z0-9-]+)?" || continue
      rest=$(printf '%s' "${l#-A OUTPUT }" | tr -d '"')
      set -f
      # shellcheck disable=SC2086 # the words of a line that matched the strict pattern above, quotes removed
      timeout 20 nsenter -t "$pid" -n "$fam" -w -D OUTPUT $rest >/dev/null 2>&1 || true
      set +f
    done
    if timeout 20 nsenter -t "$pid" -n "$fam" -w -S OUTPUT 2>/dev/null | grep -qE -- "vyre:$n([^a-z0-9-]|\$)"; then MSG="a firewall rule for this Space is still there (removed none, or one in a form the helper does not know)"; return 1; fi
  done
  sp_sub_del "$n"
}
# The subnets the helper has a rule for, one `<name> <subnet>` line each, in status/subnets (read-only in the container): core/spawner/space-wall.sh reads it at every
# start of the vyre container and puts the rules in BEFORE the daemon runs (SH-1), so a plain `docker restart` never leaves a store reachable.
sp_sub_set() {
  f=$SP_STATE/subnets
  { grep -vxF -- "$1 $2" "$f" 2>/dev/null || true; printf '%s %s\n' "$1" "$2"; } >"$f.new" || return 1
  chmod 644 "$f.new" && rename_over "$f.new" "$f"
}
sp_sub_del() {
  f=$SP_STATE/subnets
  [ -f "$f" ] || return 0
  # shellcheck disable=SC2015 # A && B || C on purpose: C is "carry on"
  { grep -v -- "^$1 " "$f" 2>/dev/null || true; } >"$f.new" && chmod 644 "$f.new" && rename_over "$f.new" "$f" || true
}
# sp_secrets NAME: made once, by root, kept 0600 in root's folder; the daemon never reads them (RH-1).
sp_secrets() {
  f=$SP_PRIV/spaces/$1/secrets.env
  [ -f "$f" ] && [ ! -L "$f" ] && return 0
  t=$(mktemp "$f.XXXXXX") || return 1
  # shellcheck disable=SC2015 # A && B || C on purpose: C is the refusal
  printf 'PG_PASSWORD=%s\nREDIS_PASSWORD=%s\nAPP_SECRET=%s\nENCRYPTION_KEY=%s\n' "$(sp_rnd)" "$(sp_rnd)" "$(sp_rnd)" "$(sp_rnd)" >"$t" && chmod 600 "$t" && rename_over "$t" "$f" || { rm -f "$t"; return 1; }
}
sp_rnd() { head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'; }
# sp_golden NAME: a NEW Space starts from the saved database the vyre image carries (stores/twenty/golden, one dump per pinned Twenty image) when there is one: about a minute to a working Space,
# not thirteen. Root takes the dump out of the image once per image (docker create + cp, never a mount) into private/golden/, read-only, and every Space's restore step reads it from there
# (GOLDEN_DUMP in its secrets.env, the one mount sp_lint allows). Root makes the Space's admin password, puts it in the Space's secrets (ADMIN_PASSWORD, for the restore step) and in
# status/admin-NAME (0600, the daemon's uid, removed after ten minutes) for the one sign-in vyred does to make the Space's key. No golden, or any failure here, is the slow path: nothing else changes.
sp_golden() {
  n=$1; d=$SP_PRIV/spaces/$n; gd=$SP_PRIV/golden
  img=$(head -n 1 "$SP_PRIV/image" 2>/dev/null || true)
  printf '%s\n' "$img" | grep -Eqx 'sha256:[0-9a-f]{64}' || return 1
  if [ "$(cat "$gd/image-id" 2>/dev/null || true)" != "$img" ] || [ ! -s "$gd/golden.dump" ]; then
    mkdir -p "$gd" && chmod 755 "$gd" && rm -f "$gd/image-id" "$gd/golden.dump" || return 1
    # shellcheck disable=SC2016 # the script is node's, not the shell's
    p=$(timeout 60 env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker run --rm --network none --read-only --cap-drop ALL --security-opt no-new-privileges --user 65534:65534 --pids-limit 64 --memory 128m \
      --entrypoint node "$img" -e 'import("/opt/vyre/stores/twenty/provision.js").then(m=>{const g=m.findGolden({image:m.TWENTY_TESTED_REF});if(g)process.stdout.write(g.dump)})' 2>/dev/null || true)
    case "$p" in /*.dump) ;; *) return 1 ;; esac
    case "$p" in *..*|*[!A-Za-z0-9._/-]*) return 1 ;; esac
    cid=$(timeout 120 env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker create --network none "$img" 2>/dev/null || true)
    [ -n "$cid" ] || return 1
    timeout 120 env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker cp "$cid:$p" "$gd/golden.dump.new" >/dev/null 2>&1; cprc=$?
    timeout 60 env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker rm -f "$cid" >/dev/null 2>&1 || true
    if [ "$cprc" != 0 ] || [ ! -s "$gd/golden.dump.new" ]; then rm -f "$gd/golden.dump.new"; return 1; fi
    chmod 444 "$gd/golden.dump.new" && mv -f "$gd/golden.dump.new" "$gd/golden.dump" && printf '%s\n' "$img" >"$gd/image-id" || return 1
  fi
  pw=$(sp_rnd)
  printf 'GOLDEN_DUMP=%s\nADMIN_PASSWORD=%s\n' "$gd/golden.dump" "$pw" >>"$d/secrets.env" || return 1
  t=$(mktemp "$SP_STATE/admin-$n.XXXXXX") && printf '%s\n' "$pw" >"$t" && chmod 600 "$t" && chown "$DAEMON_UID:$DAEMON_UID" "$t" 2>/dev/null; mv -f "$t" "$SP_STATE/admin-$n" 2>/dev/null || return 1
  : >"$d/golden"
}
# sp_lint FILE NAME: a closed check of the regenerated compose: only the keys the generator uses, only the Space's own named volumes and the one empty folder,
# only the images root recorded, the network internal. Anything else is a refusal, so a bug in the generator cannot become host access.
sp_lint() {
  awk -v name="$2" '
  function bad(m) { print "lint: " m; ok = 0 }
  BEGIN { ok = 1; split("image restart mem_limit memswap_limit networks volumes environment depends_on healthcheck command entrypoint", a, " "); for (i in a) allowed[a[i]] = 1
    vol["      - server-data:/app/packages/twenty-server/.local-storage"] = 1; vol["      - ./empty-front:/app/packages/twenty-server/dist/front:ro"] = 1; vol["      - db-data:/var/lib/postgresql/data"] = 1; vol["      - ${GOLDEN_DUMP:-./golden.dump}:/golden.dump:ro"] = 1
    split("server worker db redis restore", s, " "); for (i in s) svc["  " s[i] ":"] = 1 }
  NR == FNR { img[$2] = 1; next }
  /^#/ || /^$/ { next }
  /^[a-z]/ { k = $1; sub(/:.*/, "", k); if (k != "name" && k != "services" && k != "networks" && k != "volumes") bad("top-level key " k)
    if (k == "name" && $0 != "name: vyre-" name "-twenty") bad("the project name"); top = k; key = ""; next }
  top == "services" && /^  [a-z]/ { if (!($0 in svc)) bad("service " $0); next }
  top == "services" && /^    [a-z_]+:/ { k = $1; sub(/:.*/, "", k); if (!(k in allowed)) bad("service key " k); key = k
    if (k == "restart" && $0 != "    restart: \"no\"") bad("a restart policy")
    if (k == "image") { v = $0; sub(/^    image: /, "", v); if (!(v in img)) bad("an image root did not record") } next }
  top == "services" && /^      / { if (key == "volumes" && !($0 in vol)) bad("a volume entry"); next }
  top == "networks" { if ($0 != "  store:" && $0 != "    internal: true") bad("the networks block"); next }
  top == "volumes" { if ($0 != "  db-data:" && $0 != "  server-data:" && $0 != "    name: vyre-" name "-twenty_db-data" && $0 != "    name: vyre-" name "-twenty_server-data") bad("the volumes block"); next }
  { bad("a line outside every block") }
  END { exit ok ? 0 : 1 }' "$SP_PRIV/images" "$1"
}
# sp_run_gen NAME OUT: the generator, inside the image root recorded (by id): unprivileged, read-only, no network, no mounts, stdout only, capped at 64 KB.
# sp_run_gen NAME OUT [golden|migrated]: the third word says the Space starts from the saved database (golden: the restore step, once) or already did (migrated: the server skips its migration steps).
sp_run_gen() {
  img=$(head -n 1 "$SP_PRIV/image" 2>/dev/null || true)
  printf '%s\n' "$img" | grep -Eqx 'sha256:[0-9a-f]{64}' || return 1
  mem=$(head -n 1 "$SP_PRIV/memory" 2>/dev/null || true)
  # the default is "auto": tiny under about 6 GB of host memory, small above (the person never picks it). The host's memory is read here, as root, and handed in as a number.
  case "$mem" in small|standard|tiny|auto) ;; *) mem=auto ;; esac
  tot=$(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || true)
  case "$tot" in ""|*[!0-9]*) tot=0 ;; esac
  # shellcheck disable=SC2016 # the script is node's, not the shell's
  { timeout 60 env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker run --rm --network none --read-only --cap-drop ALL --security-opt no-new-privileges --user 65534:65534 --pids-limit 64 --memory 128m \
      --entrypoint node "$img" -e 'import("/opt/vyre/stores/twenty/provision.js").then(m=>process.stdout.write(m.composeFile({space:process.argv[1],memory:process.argv[2],totalMb:Number(process.argv[3])||undefined,golden:process.argv[4]==="golden",migrated:process.argv[4]==="migrated"})))' "$1" "$mem" "$tot" "${3:-}" 2>/dev/null || true; } | head -c 65537 >"$2"
  sz=$(wc -c <"$2")
  [ "$sz" -ge 200 ] && [ "$sz" -le 65536 ] && head -n 1 "$2" | grep -q '^# Generated by Vyre'
}
sp_gen() {
  n=$1; d=$SP_PRIV/spaces/$n
  [ -s "$SP_PRIV/images" ] || { MSG="root has no recorded image for the helper; run sudo vyre space-helper install"; return 1; }
  t=$(mktemp "$d/compose.XXXXXX") || return 1
  fl=""; if [ -f "$d/golden" ]; then fl=golden; elif [ -f "$d/migrated" ]; then fl=migrated; fi
  if ! sp_run_gen "$n" "$t" "$fl"; then rm -f "$t"; MSG="the compose file could not be regenerated"; return 1; fi
  # RH-7: a store never starts by itself. A restart policy would bring it up after a reboot or a Docker restart with no rule in the (new) vyre container; only `up` starts a Space.
  sed 's/^    restart: unless-stopped$/    restart: "no"/' "$t" >"$t.r" && mv "$t.r" "$t"
  # Images by DIGEST, from root's own record (made at install and at every update, from a pull): a tag the registry moves later cannot change what `up` runs.
  awk 'NR == FNR { map[$1] = $2; next } /^    image: / { v = $0; sub(/^    image: /, "", v); if (v in map) $0 = "    image: " map[v] } { print }' "$SP_PRIV/images" "$t" >"$t.r" && mv "$t.r" "$t"
  if ! l=$(sp_lint "$t" "$n"); then rm -f "$t"; MSG="the regenerated compose file was refused: $(printf '%s' "$l" | head -n 1)"; return 1; fi
  chmod 600 "$t"; mkdir -p "$d/empty-front"; chmod 755 "$d/empty-front"
  rename_over "$t" "$d/compose.yml"
}
# space_helper_record: the image the helper regenerates from is the one the vyre container runs now (an update has verified it), recorded by id, and the
# image names the generator may put in a compose file are recorded with it. Run at install and after every healthy update.
space_helper_record() {
  id=$(hdock inspect -f '{{.Image}}' "$CTR_NAME" 2>/dev/null || true)
  printf '%s\n' "$id" | grep -Eqx 'sha256:[0-9a-f]{64}' || { echo "vyre: the vyre container's image id could not be read" >&2; return 1; }
  t=$(mktemp "$SP_PRIV/probe.XXXXXX") || return 1
  printf '%s\n' "$id" >"$SP_PRIV/image.new" && rename_over "$SP_PRIV/image.new" "$SP_PRIV/image"
  if ! sp_run_gen imgprobe "$t"; then rm -f "$t"; echo "vyre: the compose generator did not run in the image" >&2; return 1; fi
  # Every image the generator names is pulled and its digest recorded: `<name as written> <name@sha256:...>`. A name that cannot be resolved to a digest is a failure.
  : >"$SP_PRIV/images.new"
  # shellcheck disable=SC2013 # image references have no spaces
  for im in $(grep '^    image: ' "$t" | sed 's/^    image: //' | sort -u); do
    # A compose default (`${TWENTY_IMAGE:-twentycrm/twenty:v2...@sha256:...}`, `${TWENTY_TAG:-...}`) is pulled as its default: root never takes the value from an env file.
    pl=$(printf '%s' "$im" | sed 's/\${[A-Z_][A-Z0-9_]*:-\([^}]*\)}/\1/g')
    case "$pl" in *'${'*) rm -f "$t" "$SP_PRIV/images.new"; echo "vyre: the image name $im has a variable with no default, so it cannot be pulled" >&2; return 1 ;; esac
    if ! why=$(timeout 900 env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker pull -q "$pl" 2>&1 >/dev/null); then
      rm -f "$t" "$SP_PRIV/images.new"
      echo "vyre: could not pull $pl: $(printf '%s' "${why:-no answer from the registry}" | tail -n 1 | cut -c1-200)" >&2; return 1
    fi
    dg=$(hdock image inspect -f '{{index .RepoDigests 0}}' "$pl" 2>/dev/null || true)
    printf '%s\n' "$dg" | grep -Eqx '[a-z0-9./_-]+@sha256:[0-9a-f]{64}' || { rm -f "$t" "$SP_PRIV/images.new"; echo "vyre: no digest for $pl" >&2; return 1; }
    printf '%s %s\n' "$im" "$dg" >>"$SP_PRIV/images.new"
  done
  rename_over "$SP_PRIV/images.new" "$SP_PRIV/images"
  rm -f "$t"
  # The app modules' catalog is recorded from the same image at the same moments; it never makes this function fail (see sp_app_record).
  sp_app_record
}
# sp_swap: a Linux server under 6 GB of memory with no swap gets ENCRYPTED swap (the tiny profile's containers may spill into it), or none. Swap writes memory to disk, and a server holds lent keys and
# session leases in memory, so the swap is a dm-crypt plain mapping keyed from /dev/urandom at every boot: no key is kept anywhere, and nothing in it survives a reboot. With no cryptsetup or no
# losetup there is NO swap (the capped run held without it). Root only, one fixed file and size that no request can change, never touches a server that already has swap, and a failure only logs: the Space
# still starts without it. The paths and the memory file are variables only so a test can point them at a temp folder.
SP_SWAPFILE=${SP_SWAPFILE:-/var/lib/vyre-swapfile}
SP_SWAP_MAP=${SP_SWAP_MAP:-vyre-swap}
SP_DM=${SP_DM:-/dev/mapper}
SP_MEMINFO=${SP_MEMINFO:-/proc/meminfo}
SP_CRYPTTAB=${SP_CRYPTTAB:-/etc/crypttab}
SP_FSTAB=${SP_FSTAB:-/etc/fstab}
sp_swap_undo() { cryptsetup close "$SP_SWAP_MAP" >/dev/null 2>&1 || true; [ -z "$1" ] || losetup -d "$1" >/dev/null 2>&1 || true; }
sp_swap() {
  [ "$(uname -s)" = Linux ] || return 0
  mt=$(awk '/^MemTotal:/ {print int($2/1024)}' "$SP_MEMINFO" 2>/dev/null || true)
  case "$mt" in ""|*[!0-9]*) return 0 ;; esac
  [ "$mt" -gt 0 ] && [ "$mt" -lt 6144 ] || return 0
  if [ -n "$(swapon --noheadings --show=NAME 2>/dev/null)" ]; then return 0; fi
  if ! command -v cryptsetup >/dev/null 2>&1 || ! command -v losetup >/dev/null 2>&1; then
    sp_log "swap: no cryptsetup here, so no swap (plain swap would write memory, keys included, to the disk in the clear)"; return 0
  fi
  if [ ! -f "$SP_SWAPFILE" ]; then
    ( umask 077; fallocate -l 2G "$SP_SWAPFILE" 2>/dev/null || dd if=/dev/zero of="$SP_SWAPFILE" bs=1M count=2048 2>/dev/null ) || { sp_log "swap: could not make $SP_SWAPFILE"; rm -f "$SP_SWAPFILE"; return 0; }
    chmod 600 "$SP_SWAPFILE" || { rm -f "$SP_SWAPFILE"; return 0; }
  fi
  # the file is used only if it is what this function makes: a regular file owned by the user running it (root), mode 600
  { [ -f "$SP_SWAPFILE" ] && [ ! -L "$SP_SWAPFILE" ] && [ "$(stat -c '%U|%a' "$SP_SWAPFILE" 2>/dev/null)" = "$(id -un)|600" ]; } || { sp_log "swap: $SP_SWAPFILE is not a 0600 file of this user; left alone"; return 0; }
  loop=$(losetup -j "$SP_SWAPFILE" 2>/dev/null | head -n 1 | cut -d: -f1)
  [ -n "$loop" ] || loop=$(losetup -f --show "$SP_SWAPFILE" 2>/dev/null) || { sp_log "swap: no loop device"; return 0; }
  # a fresh random key now (and at every boot through crypttab): never stored, so the contents die with the mapping
  if [ ! -e "$SP_DM/$SP_SWAP_MAP" ]; then
    cryptsetup open --type plain --cipher aes-xts-plain64 --key-size 512 --key-file /dev/urandom --keyfile-size 64 "$loop" "$SP_SWAP_MAP" >/dev/null 2>&1 || { sp_log "swap: cryptsetup failed"; sp_swap_undo "$loop"; return 0; }
  fi
  if ! { mkswap "$SP_DM/$SP_SWAP_MAP" >/dev/null 2>&1 && swapon "$SP_DM/$SP_SWAP_MAP" 2>/dev/null; }; then sp_log "swap: mkswap or swapon failed"; sp_swap_undo "$loop"; return 0; fi
  grep -qF "$SP_SWAP_MAP" "$SP_CRYPTTAB" 2>/dev/null || printf '%s %s /dev/urandom swap,cipher=aes-xts-plain64,size=512\n' "$SP_SWAP_MAP" "$SP_SWAPFILE" >>"$SP_CRYPTTAB" 2>/dev/null || true
  grep -qF "$SP_DM/$SP_SWAP_MAP" "$SP_FSTAB" 2>/dev/null || printf '%s none swap sw 0 0\n' "$SP_DM/$SP_SWAP_MAP" >>"$SP_FSTAB" 2>/dev/null || true
  sp_log "swap: turned on 2 GB of encrypted swap (a random key every boot) at $SP_SWAPFILE (this server has ${mt} MB of memory and had no swap)"
}
sp_up() {
  n=$1
  sp_name_ok "$n" || { MSG="not a Space name"; return 1; }
  fresh=0
  if ! sp_known "$n"; then
    fresh=1
    [ "$(find "$SP_PRIV/spaces" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)" -lt "$SPACES_CAP" ] || { MSG="too many Spaces on this server"; return 1; }
    # shellcheck disable=SC2015 # A && B || C on purpose: C is the refusal
    mkdir -p "$SP_PRIV/spaces/$n" && chmod 700 "$SP_PRIV/spaces/$n" && : >"$SP_PRIV/spaces/$n/record" || { MSG="could not make the Space's folder"; return 1; }
  fi
  sp_swap || true
  sp_secrets "$n" || { MSG="could not make the Space's secrets"; return 1; }
  [ "$fresh" = 0 ] || sp_golden "$n" || true
  sp_gen "$n" || return 1
  sp_dc "$n" create >/dev/null 2>&1 || { MSG="the Space's containers could not be created"; return 1; }
  # Joined and firewalled BEFORE the store starts, so it never runs unfirewalled; proved after, and stopped again if the proof fails.
  sp_attach "$n" || return 1
  sp_repair "$n" || return 1
  sp_dc "$n" up -d --wait >/dev/null 2>&1 || { MSG="the Space's store did not become healthy"; return 1; }
  if ! sp_probe "$n"; then sp_dc "$n" stop >/dev/null 2>&1 || true; return 1; fi
  # the saved database has been restored: from here the compose file has no restore step, and the server skips its migration steps
  if [ -f "$SP_PRIV/spaces/$n/golden" ]; then
    mv -f "$SP_PRIV/spaces/$n/golden" "$SP_PRIV/spaces/$n/migrated"; sp_gen "$n" || true
    # the restore step is over: the admin password and the dump path leave root's copy of the Space's secrets (the daemon has the password; the compose file no longer names either)
    t=$(mktemp "$SP_PRIV/spaces/$n/secrets.XXXXXX") || t=""
    if [ -n "$t" ]; then
      if grep -v -e '^ADMIN_PASSWORD=' -e '^GOLDEN_DUMP=' "$SP_PRIV/spaces/$n/secrets.env" >"$t" && chmod 600 "$t"; then mv -f "$t" "$SP_PRIV/spaces/$n/secrets.env"; else rm -f "$t"; fi
    fi
  fi
  # The first start is over and the database has its schema: the Space gets its mark, and sp_repair never touches it again.
  if t=$(sp_schema "$n") && [ -n "$t" ]; then : >"$SP_PRIV/spaces/$n/ready"; fi
  MSG="the store is up and the agents are firewalled from it"
}
# sp_schema NAME: the name of the Space's core user table, or nothing when the database has none. Run after the Space's database is up.
# It fails (nothing printed) when the database cannot be asked, which is not the same as an empty answer.
sp_schema() { o=$(sp_dc "$1" exec -T db psql -U postgres -d default -tAc 'select to_regclass($$core."user"$$)' 2>/dev/null) || return 1; printf '%s' "$o" | tr -d ' \r\n'; }
# sp_repair NAME: a first start cut off by a restart leaves a database with an empty `core` schema: Twenty's own start finds the schema, skips its migrations and reports healthy, and nothing repaired it
# (issue 90). A Space with no `ready` mark whose database already exists is looked at once, here, before the store starts: a database with no core user table holds nothing, so its volumes are removed and
# it starts again from the beginning (from the saved database when there is one). A Space with the mark, or whose database has the table, is never touched, and a Space that cannot be looked at is left as it is.
sp_repair() {
  n=$1; d=$SP_PRIV/spaces/$n
  [ ! -f "$d/ready" ] || return 0
  hdock volume inspect "vyre-$n-twenty_db-data" >/dev/null 2>&1 || return 0
  sp_dc "$n" up -d --wait db >/dev/null 2>&1 || return 0
  t=$(sp_schema "$n") || return 0
  [ -z "$t" ] || return 0
  sp_log "repair: empty core schema from a cut off first start, removed and made again"
  hdock network disconnect -f "vyre-$n-twenty_store" "$CTR_NAME" >/dev/null 2>&1 || true
  sp_dc "$n" down -v >/dev/null 2>&1 || { MSG="the Space's empty database could not be removed"; return 1; }
  if type sp_golden >/dev/null 2>&1; then sp_golden "$n" || true; fi
  sp_gen "$n" || return 1
  sp_dc "$n" create >/dev/null 2>&1 || { MSG="the Space's containers could not be created"; return 1; }
  sp_attach "$n" || return 1
}
sp_stop() { sp_dc "$1" stop >/dev/null 2>&1 || { MSG="stop failed"; return 1; }; MSG=stopped; }
sp_down() {
  hdock network disconnect -f "vyre-$1-twenty_store" "$CTR_NAME" >/dev/null 2>&1 || true
  sp_dc "$1" down >/dev/null 2>&1 || { MSG="down failed"; return 1; }
  MSG="removed; the data is kept (purge is a command on the server)"
}
sp_fw_add() {
  sp_attach "$1" || return 1
  if sp_running "$1"; then sp_probe "$1" || return 1; fi
  MSG="the firewall is in place"
}
# ---------------------------------------------------------------------------------------------------------------------------------------------
# App modules (spec 0.3.0 part 8, team/0.3/DESIGN-appmods-helper.md): a third-party app (DocuSeal first) started from a pinned image, walled off the way a Space's store is. The daemon asks
# `app-up|app-stop|app-down <module>` and nothing else: the image, the limits, the port, the volumes and the setup step all come from the catalog line root recorded out of the vyre image
# (`private/app-modules`, written by sp_app_record at install and at every update). Root's copies live in private/apps/<module>/ (secrets.env, compose.yml, fw, bootstrapped).
#   network   vyre-app-<module>_net, internal; the vyre container joins it with the alias vyre-daemon; the app is `vyre-app-<module>` on it
#   OUTPUT    in the vyre container's namespace: only the daemon's uid reaches the app (sp_fw_apply_net, comment vyre-app:<module>, subnet listed as `app:<module>`)
#   INPUT     in the same namespace, on the app network's interface: tcp to the hook port from the app's subnet and the answers to what the daemon asked, and DROP for everything else (sp_in_apply)
# The app's keys are made here, by root, and never sent to the daemon; the setup step's outputs reach the daemon once, in a 0400 file it owns (status/app-<module>-secrets).
# ---------------------------------------------------------------------------------------------------------------------------------------------
SP_APPS=$SP_PRIV/apps
APP_ALIAS=vyre-daemon
# sp_fld PATTERN VALUE: the whole value matches the pattern (one line, nothing around it).
sp_fld() { printf '%s\n' "$2" | grep -Eqx -- "$1"; }
# sp_int_in VALUE LOW HIGH: a plain decimal whole number in the range (no sign, no leading zero, at most five digits).
sp_int_in() {
  case "$1" in ""|*[!0-9]*|0[0-9]*) return 1 ;; esac
  [ "${#1}" -le 5 ] && [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]
}
sp_app_name_ok() { sp_name_ok "$1" && [ "${#1}" -ge 2 ]; }
# sp_app_line MODULE: the recorded catalog line of that module, or nothing.
sp_app_line() {
  sp_app_name_ok "$1" || return 1
  [ -f "$SP_PRIV/app-modules" ] && [ ! -L "$SP_PRIV/app-modules" ] || return 1
  awk -v n="$1" '$1 == n { print; exit }' "$SP_PRIV/app-modules"
}
# sp_app_line_ok LINE: `name image port memoryMb cpus pids hookPort script exec outputs healthPath healthOk startS`, every field from its own anchored pattern. `-` is an empty field.
sp_app_line_ok() {
  # The line is split into its fields on purpose, with globbing off.
  # shellcheck disable=SC2086
  set -f
  # shellcheck disable=SC2086 # split on whitespace on purpose, globbing off
  set -- $1
  set +f
  [ $# = 13 ] || return 1
  sp_fld '[a-z][a-z0-9-]{1,30}' "$1" || return 1
  [ "${#2}" -le 200 ] && sp_fld '[a-z0-9][a-z0-9./_-]*(:[A-Za-z0-9_][A-Za-z0-9_.-]*)?@sha256:[0-9a-f]{64}' "$2" || return 1
  sp_int_in "$3" 1 65535 && sp_int_in "$4" 64 8192 && sp_int_in "$6" 32 4096 && sp_int_in "$7" 43000 43999 && sp_int_in "${13}" 1 600 || return 1
  sp_fld '[0-9](\.[0-9]{1,2})?' "$5" && awk -v c="$5" 'BEGIN { exit !(c + 0 >= 0.1 && c + 0 <= 8) }' || return 1
  case "$8|$9|${10}" in
    "-|-|-") ;;
    *) sp_fld '[a-z0-9][a-z0-9._-]{0,60}' "$8" && sp_fld '[A-Za-z0-9._/][A-Za-z0-9._/-]*(\+[A-Za-z0-9._/][A-Za-z0-9._/-]*){0,7}' "$9" && sp_fld '[a-z][a-z0-9_]*(\+[a-z][a-z0-9_]*){0,5}' "${10}" || return 1 ;;
  esac
  sp_fld '/[A-Za-z0-9_./-]{0,80}' "${11}" && sp_fld '[0-9]{3}(\+[0-9]{3}){0,5}' "${12}"
}
# sp_pub_load_name NAME: a published server's record into A_*, found by the marker pub-up leaves in its folder.
sp_pub_load_name() {
  _pf=$SP_APPS/$1/pubdep
  { [ -f "$_pf" ] && [ ! -L "$_pf" ]; } || return 1
  _pd=$(head -n 1 "$_pf" 2>/dev/null || true)
  sp_pub_dep_ok "$_pd" || return 1
  sp_pub_rec_load "$_pd" && [ "$A_NAME" = "$1" ]
}
# sp_app_load MODULE: the recorded line's fields in A_*, or failure when the module is not recorded.
sp_app_load() {
  # no recorded catalog at all (no app was ever installed here) is no line, not a failure: a published server is found below
  sp_app_name_ok "$1" || return 1
  l=$(sp_app_line "$1") || l=""
  # a published server (pub-up) is not in the recorded catalog: its own record, found by the deployment its folder names, stands in (no hook port, no setup)
  [ -n "$l" ] || { sp_pub_load_name "$1"; return; }
  # shellcheck disable=SC2034 # the A_* variables are read by the callers
  read -r A_NAME A_IMAGE A_PORT A_MEM A_CPUS A_PIDS A_HOOK A_SCRIPT A_EXEC A_OUTS A_HPATH A_HOK A_HSTART <<APPL
$l
APPL
  [ "$A_NAME" = "$1" ]
}
# sp_run_hostplan OUT ARGS: the plan printer (core/appmods/host-plan.js), inside the image root recorded by id: unprivileged, read-only, no network, no mounts, stdout only, capped at 64 KB.
sp_run_hostplan() {
  img=$(head -n 1 "$SP_PRIV/image" 2>/dev/null || true)
  printf '%s\n' "$img" | grep -Eqx 'sha256:[0-9a-f]{64}' || return 1
  out_=$1; shift
  # shellcheck disable=SC2016 # the script is node's, not the shell's
  { timeout 60 env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker run --rm --network none --read-only --cap-drop ALL --security-opt no-new-privileges --user 65534:65534 --pids-limit 64 --memory 128m \
      --entrypoint node "$img" -e 'import("/opt/vyre/core/appmods/host-plan.js").then(m=>process.stdout.write(process.argv[1]==="list"?m.listLines().join("\n")+"\n":m.composeFile(process.argv[2])))' "$@" 2>/dev/null || true; } | head -c 65537 >"$out_"
}
# sp_listen_ports: the TCP ports the vyre container listens on, one per line, read in its own network namespace (nothing when it is not running).
sp_listen_ports() {
  pid=$(sp_pid) || return 0
  timeout 20 nsenter -t "$pid" -n cat /proc/net/tcp /proc/net/tcp6 2>/dev/null | awk '$4 == "0A" { n = split($2, a, ":"); print a[n] }' | while IFS= read -r hx; do
    case "$hx" in ""|*[!0-9A-Fa-f]*) continue ;; esac
    printf '%d\n' "0x$hx"
  done | sort -un
}
# sp_app_record: the catalog out of the recorded vyre image, checked field by field, written to private/app-modules. Names must be unique, hook ports must be unique and must not be a port the vyre
# container listens on now. The images are NOT pulled here (a server that never installs an app should not carry 800 MB of one); `app-up` pulls the pinned digest when it is not there. A catalog that fails any of that records NO app: a failure here never
# stops the Space helper's install or an update (Twenty does not wait on an app), and `app-up` says the app is not recorded.
sp_app_record() {
  t=$(mktemp "$SP_PRIV/applist.XXXXXX") || return 0
  new=$SP_PRIV/app-modules.new; : >"$new"
  why=""
  if sp_run_hostplan "$t" list; then
    if [ "$(wc -c <"$t")" -gt 65536 ]; then why="the app list is too long"; else
      used=$(sp_listen_ports)
      while IFS= read -r l; do
        [ -n "$l" ] || continue
        sp_app_line_ok "$l" || { why="a catalog line was refused: $(printf '%s' "$l" | cut -c1-30)"; break; }
        set -f
        # shellcheck disable=SC2086 # split on whitespace on purpose, globbing off
        set -- $l
        set +f
        nm=$1; hk=$7
        if awk -v n="$nm" '$1 == n { f = 1 } END { exit !f }' "$new"; then why="the app name $nm is listed twice"; break; fi
        if awk -v h="$hk" '$7 == h { f = 1 } END { exit !f }' "$new"; then why="the hook port $hk is used by two apps"; break; fi
        if printf '%s\n' "$used" | grep -qx "$hk"; then why="the hook port $hk is a port the vyre container already uses"; break; fi
        printf '%s\n' "$l" >>"$new"
      done <"$t"
    fi
  fi
  rm -f "$t"
  if [ -n "$why" ]; then
    : >"$new"; echo "vyre: no app modules were recorded: $why" >&2; sp_log "app record: $why"
  fi
  chmod 600 "$new" && rename_over "$new" "$SP_PRIV/app-modules"
  return 0
}
# sp_app_image_ok: the vyre container still runs the image root recorded. An update that root has not recorded yet (space-helper install) means the catalog line may not be the one the container carries.
sp_app_image_ok() {
  cur=$(hdock inspect -f '{{.Image}}' "$CTR_NAME" 2>/dev/null || true)
  # shellcheck disable=SC2015 # every way the test fails reports the same message
  [ -n "$cur" ] && [ "$cur" = "$(head -n 1 "$SP_PRIV/image" 2>/dev/null || true)" ] || { MSG="the vyre image is not the one the helper recorded; run: sudo vyre space-helper install"; return 1; }
}
# sp_app_lint FILE MODULE: a closed check of the generated compose against the recorded line (A_*): one service called app, only the keys the generator uses, the recorded image and limits, no
# capability, no port, no host path, named volumes the file declares, one internal network, environment values from a short alphabet or the app's own secret by name.
sp_app_lint() {
  awk -v mod="$2" -v pub="${3:-0}" -v image="$A_IMAGE" -v mem="$A_MEM" -v cpus="$A_CPUS" -v pids="$A_PIDS" '
  function bad(m) { print "lint: " m; ok = 0 }
  BEGIN { ok = 1 }
  /^#/ || /^$/ { next }
  /^[a-z]/ { k = $1; sub(/:.*/, "", k); if (k != "name" && k != "services" && k != "networks" && k != "volumes") bad("top-level key " k)
    if (k == "name" && $0 != "name: vyre-app-" mod) bad("the project name"); top = k; key = ""; next }
  top == "services" && /^  [a-z]/ { if ($0 != "  app:") bad("service " $0); next }
  top == "services" && /^    [a-z_]+:/ { k = $1; sub(/:.*/, "", k); key = k; if (seen[k]++) bad("a repeated key " k)
    if (k == "image") { if ($0 != "    image: " image) bad("an image root did not record") }
    else if (k == "container_name") { if ($0 != "    container_name: vyre-app-" mod) bad("the container name") }
    else if (k == "restart") { if ($0 != "    restart: \"no\"") bad("a restart policy") }
    else if (k == "mem_limit" || k == "memswap_limit") { if ($0 != "    " k ": " mem "m") bad(k) }
    else if (k == "cpus") { if ($0 != "    cpus: " cpus) bad("cpus") }
    else if (k == "pids_limit") { if ($0 != "    pids_limit: " pids) bad("pids_limit") }
    else if (k == "init") { if ($0 != "    init: true") bad("init") }
    else if (k == "read_only") { if (pub != 1 || $0 != "    read_only: true") bad("read_only") }
    else if (k == "tmpfs") { if (pub != 1 || $0 != "    tmpfs:") bad("tmpfs") }
    else if (k == "cap_drop" || k == "security_opt" || k == "networks" || k == "volumes" || k == "environment") { if ($0 != "    " k ":") bad(k " with a value on its line") }
    else bad("service key " k)
    next }
  top == "services" && /^      / {
    if (key == "cap_drop") { if ($0 != "      - ALL") bad("cap_drop") }
    else if (key == "tmpfs") { if ($0 != "      - /tmp:rw,size=64m,mode=1777") bad("tmpfs entry") }
    else if (key == "security_opt") { if ($0 != "      - no-new-privileges:true") bad("security_opt") }
    else if (key == "networks") { if ($0 != "      - net") bad("the service networks") }
    else if (key == "volumes") {
      line = $0; sub(/^      - /, "", line)
      if (line == $0 || line !~ /^[a-z][a-z0-9-]*:\/[A-Za-z0-9_.\/-]*$/) { bad("a volume entry"); next }
      v = line; sub(/:.*/, "", v); p = line; sub(/^[^:]*:/, "", p)
      if (p ~ /\.\./ || p == "/" || p ~ /^\/(etc|proc|sys|dev|run|var\/run)(\/|$)/) bad("a volume path")
      used[v] = 1 }
    else if (key == "environment") {
      line = $0; sub(/^      /, "", line)
      if (line !~ /^[A-Z][A-Z0-9_]*: /) { bad("an environment entry"); next }
      e = line; sub(/:.*/, "", e); val = line; sub(/^[^:]*: /, "", val)
      if (val ~ /^"[A-Za-z0-9_.\/:@+= -]*"$/) next
      if (val == "${" e "}") next
      bad("the environment value of " e) }
    else bad("a line under " key)
    next }
  top == "networks" { if ($0 != "  net:" && $0 != "    internal: true") bad("the networks block"); next }
  top == "volumes" {
    if ($0 ~ /^  [a-z][a-z0-9-]*:$/) { v = $0; sub(/^  /, "", v); sub(/:$/, "", v); decl[v] = 1; last = v; next }
    if (last != "" && $0 == "    name: vyre-app-" mod "_" last) next
    bad("the volumes block"); next }
  { bad("a line outside every block") }
  END { for (v in used) if (!(v in decl)) bad("a volume that is not declared")
    if (pub == 1 && (!("read_only" in seen) || !("tmpfs" in seen))) bad("a published server must keep its root read-only with the one tmpfs")
    exit ok ? 0 : 1 }' "$1"
}
# sp_app_public MODULE: the address outside people reach the app at, https://<module>.<name>.vyre.run:<port>, or nothing. The box's name and the public gate's port are read by the vyre container's own node from its config
# (the one place they live), and root keeps only what fits the shape: a name of letters, digits and dashes, a port of up to five digits, under vyre.run. Whatever else the config says is never used. A box
# with no name on vyre.run has no public address and the app keeps its internal one.
sp_app_public() {
  # shellcheck disable=SC2016 # the script is node's, not the shell's
  o=$(timeout 20 env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker exec "$CTR_NAME" node -e 'try{const c=JSON.parse(require("fs").readFileSync("/home/vyre/.vyre/config.json","utf8"));if(typeof c.name==="string"&&c.network&&c.network.via==="vyre.run")process.stdout.write(c.name+" "+String((c.wink&&c.wink.publicPort)||7443))}catch{}' 2>/dev/null | head -c 80 || true)
  sp_fld '[a-z][a-z0-9-]{1,30} [0-9]{2,5}' "$o" || return 0
  sp_int_in "${o#* }" 1 65535 || return 0
  printf 'https://%s.%s.vyre.run:%s\n' "$1" "${o% *}" "${o#* }"
}
# sp_app_gen MODULE: root's copy of the compose file, regenerated from the image at every `up`, linted against the recorded line, never taken from the daemon.
sp_app_gen() {
  m=$1; d=$SP_APPS/$m
  t=$(mktemp "$d/compose.XXXXXX") || return 1
  if ! sp_run_hostplan "$t" compose "$m"; then rm -f "$t"; MSG="the compose file could not be regenerated"; return 1; fi
  sz=$(wc -c <"$t")
  if [ "$sz" -lt 100 ] || [ "$sz" -gt 65536 ] || ! head -n 1 "$t" | grep -q '^# Generated by Vyre'; then rm -f "$t"; MSG="the compose file could not be regenerated"; return 1; fi
  if ! l=$(sp_app_lint "$t" "$m"); then rm -f "$t"; MSG="the regenerated compose file was refused: $(printf '%s' "$l" | head -n 1)"; return 1; fi
  # APP_URL is the public address when the box has one (the app builds the links it hands out from it); the internal address otherwise. The substituted line is checked by the same lint again.
  pub=$(sp_app_public "$m")
  if [ -n "$pub" ] && grep -q "^      APP_URL: \"http://vyre-app-$m:$A_PORT\"\$" "$t"; then
    sed "s#^      APP_URL: \"http://vyre-app-$m:$A_PORT\"\$#      APP_URL: \"$pub\"#" "$t" >"$t.p" && mv "$t.p" "$t"
    if ! l=$(sp_app_lint "$t" "$m"); then rm -f "$t"; MSG="the compose file with the public address was refused: $(printf '%s' "$l" | head -n 1)"; return 1; fi
  fi
  chmod 600 "$t"; rename_over "$t" "$d/compose.yml"
}
# sp_secrets_app MODULE: the keys the compose file names as `KEY: ${KEY}` are made once by root (64 hex characters each), kept 0600 in root's folder; the daemon never reads them.
sp_secrets_app() {
  m=$1; d=$SP_APPS/$m; f=$d/secrets.env
  keys=$(sed -n 's/^      \([A-Z][A-Z0-9_]*\): \${\1}$/\1/p' "$d/compose.yml")
  t=$(mktemp "$f.XXXXXX") || return 1
  if [ -f "$f" ] && [ ! -L "$f" ]; then cat "$f" >"$t" || { rm -f "$t"; return 1; }; fi
  for k in $keys; do grep -q "^$k=" "$t" || printf '%s=%s\n' "$k" "$(sp_rnd)" >>"$t"; done
  # shellcheck disable=SC2015 # a failed chmod or rename both remove the temp file and fail
  chmod 600 "$t" && rename_over "$t" "$f" || { rm -f "$t"; return 1; }
}
# sp_app_dc MODULE ARGS: compose for one app, only on root's own copy, the project name fixed from the validated name.
sp_app_dc() {
  m=$1; shift
  sp_app_name_ok "$m" || return 1
  d=$SP_APPS/$m
  timeout 1200 env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker compose --project-directory "$d" --project-name "vyre-app-$m" \
    --env-file "$d/secrets.env" -f "$d/compose.yml" "$@"
}
sp_app_running() { [ -n "$(hdock ps -q --filter "label=com.docker.compose.project=vyre-app-$1" 2>/dev/null || true)" ]; }
# sp_app_try NET IP PORT: one throwaway container on the app's network (the vyre image, unprivileged, no capabilities) connects to IP:PORT and says `open`, `refused` or `timeout`. It stands where the
# app stands: same network, same subnet, the same interface of the vyre container receives its packets.
sp_app_try() {
  img=$(head -n 1 "$SP_PRIV/image" 2>/dev/null || true)
  printf '%s\n' "$img" | grep -Eqx 'sha256:[0-9a-f]{64}' || return 1
  # shellcheck disable=SC2016 # the script is node's, not the shell's
  timeout 40 env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker run --rm --network "$1" --read-only --cap-drop ALL --security-opt no-new-privileges --user 65534:65534 --pids-limit 32 --memory 128m \
    --entrypoint node "$img" -e 'const s=require("net").connect({host:process.argv[1],port:Number(process.argv[2])});const t=setTimeout(()=>{process.stdout.write("timeout");process.exit()},3000);s.on("connect",()=>{process.stdout.write("open");process.exit()});s.on("error",()=>{process.stdout.write("refused");process.exit()})' "$2" "$3" 2>/dev/null | head -c 16 || true
}
# sp_app_wait MODULE: the app answers its health path with one of the catalog's codes before its start time (and a minute) is over.
sp_app_wait() {
  img=$(head -n 1 "$SP_PRIV/image" 2>/dev/null || true)
  printf '%s\n' "$img" | grep -Eqx 'sha256:[0-9a-f]{64}' || return 1
  # shellcheck disable=SC2016 # the script is node's, not the shell's
  r=$(timeout $((A_HSTART + 60)) env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker run --rm --network "vyre-app-${1}_net" --read-only --cap-drop ALL --security-opt no-new-privileges --user 65534:65534 --pids-limit 32 --memory 128m \
    --entrypoint node "$img" -e 'const u=process.argv[1],ok=process.argv[2].split("+"),end=Date.now()+Number(process.argv[3])*1000;(async()=>{while(Date.now()<end){try{const r=await fetch(u,{redirect:"manual",signal:AbortSignal.timeout(3000)});if(ok.includes(String(r.status))){process.stdout.write("ok");return}}catch{}await new Promise(r=>setTimeout(r,2000))}process.stdout.write("timeout")})()' \
    "http://vyre-app-$1:$A_PORT$A_HPATH" "$A_HOK" "$A_HSTART" 2>/dev/null | head -c 16 || true)
  [ "$r" = ok ]
}
# sp_in_rule FAM PID IF SUBNET HOOK TAG: the three INPUT rules for one subnet, in the vyre container's namespace, in this order: the answers to what the daemon asked (ESTABLISHED,RELATED, accepted), tcp to
# the hook port from the app's subnet (accepted), and everything else that arrives on the app network's interface (dropped). Each is checked with -C, put in at position 1 and checked again.
# The drop goes in first, and when it is missing the other two are removed first, so a half-made set can never leave an accept below a drop that is not there.
sp_in_rule() {
  fam=$1; pid=$2; ifn=$3; sn=$4; hk=$5; tg=$6
  if ! sp_fw_each "$fam" "$pid" -C INPUT -i "$ifn" -m comment --comment "$tg" -j DROP >/dev/null 2>&1; then
    sp_fw_each "$fam" "$pid" -D INPUT -i "$ifn" -m conntrack --ctstate ESTABLISHED,RELATED -m comment --comment "$tg" -j ACCEPT >/dev/null 2>&1 || true
    [ "$hk" = 0 ] || sp_fw_each "$fam" "$pid" -D INPUT -i "$ifn" -s "$sn" -p tcp --dport "$hk" -m comment --comment "$tg" -j ACCEPT >/dev/null 2>&1 || true
    sp_fw_each "$fam" "$pid" -I INPUT 1 -i "$ifn" -m comment --comment "$tg" -j DROP >/dev/null 2>&1 || { MSG="the firewall rule could not be added"; return 1; }
  fi
  # a server Publish made has no door in (hook 0): the answers to what the daemon asked, and a drop for everything else
  # and no door left over from before: a tag that once had a hook port (a catalog app of that name) loses every hook ACCEPT it still has
  if [ "$hk" = 0 ]; then
    stale=$(sp_fw_each "$fam" "$pid" -S INPUT 2>/dev/null | grep -F -e "--comment $tg " -e "--comment \"$tg\" " | grep -F -e "--dport" | grep -F -e "-j ACCEPT" | sed 's/"//g; s/^-A /-D /' || true)
    printf '%s\n' "$stale" | while IFS= read -r old; do
      [ -n "$old" ] || continue
      set -f
      # shellcheck disable=SC2086 # the words of a rule iptables itself listed, quotes removed
      sp_fw_each "$fam" "$pid" $old >/dev/null 2>&1 || true
      set +f
    done
  fi
  [ "$hk" = 0 ] || sp_fw_each "$fam" "$pid" -C INPUT -i "$ifn" -s "$sn" -p tcp --dport "$hk" -m comment --comment "$tg" -j ACCEPT >/dev/null 2>&1 \
    || [ "$hk" = 0 ] || sp_fw_each "$fam" "$pid" -I INPUT 1 -i "$ifn" -s "$sn" -p tcp --dport "$hk" -m comment --comment "$tg" -j ACCEPT >/dev/null 2>&1 || { MSG="the firewall rule could not be added"; return 1; }
  sp_fw_each "$fam" "$pid" -C INPUT -i "$ifn" -m conntrack --ctstate ESTABLISHED,RELATED -m comment --comment "$tg" -j ACCEPT >/dev/null 2>&1 \
    || sp_fw_each "$fam" "$pid" -I INPUT 1 -i "$ifn" -m conntrack --ctstate ESTABLISHED,RELATED -m comment --comment "$tg" -j ACCEPT >/dev/null 2>&1 || { MSG="the firewall rule could not be added"; return 1; }
  for w in "-i $ifn -m comment --comment $tg -j DROP" "-i $ifn -s $sn -p tcp --dport $hk -m comment --comment $tg -j ACCEPT" "-i $ifn -m conntrack --ctstate ESTABLISHED,RELATED -m comment --comment $tg -j ACCEPT"; do
    [ "$hk" != 0 ] || case "$w" in *"--dport 0 "*) continue ;; esac
    set -f
    # shellcheck disable=SC2086 # the words of a rule this function just built from checked values
    sp_fw_each "$fam" "$pid" -C INPUT $w >/dev/null 2>&1 || { set +f; MSG="the firewall rule is not there after it was added"; return 1; }
    set +f
  done
}
# sp_in_apply MODULE: the inbound rules for every subnet of the app's network, on the interface the vyre container has on it (found by its address there). The list of what was put in goes to private/apps/<module>/fw,
# so `app-down` removes exactly those.
sp_in_apply() {
  m=$1; hk=$2; tg="vyre-app:$1"; netw="vyre-app-${1}_net"
  pid=$(sp_pid) || { MSG="the vyre container is not running"; return 1; }
  vip=$(hdock inspect -f "{{with index .NetworkSettings.Networks \"$netw\"}}{{.IPAddress}}{{end}}" "$CTR_NAME" 2>/dev/null || true)
  sp_fld '([0-9]{1,3}\.){3}[0-9]{1,3}' "$vip" || { MSG="the vyre container has no address on the app's network"; return 1; }
  ifn=$(timeout 20 nsenter -t "$pid" -n ip -o -4 addr show 2>/dev/null | awk -v ip="$vip" '{ split($4, a, "/"); if (a[1] == ip) { print $2; exit } }')
  sp_fld '[a-z][a-z0-9]{0,14}' "$ifn" || { MSG="the app network's interface in the vyre container could not be found"; return 1; }
  subs=$(sp_net_subnets_of "$netw")
  [ -n "$subs" ] || { MSG="the app's network does not exist"; return 1; }
  : >"$SP_APPS/$m/fw.new"
  for sn in $subs; do
    sp_subnet_ok "$sn" || { MSG="a subnet of the app's network is not one the helper accepts"; return 1; }
    fam=$(sp_ipt "$sn")
    sp_in_rule "$fam" "$pid" "$ifn" "$sn" "$hk" "$tg" || return 1
    printf '%s %s %s %s\n' "$fam" "$sn" "$ifn" "$hk" >>"$SP_APPS/$m/fw.new"
  done
  rename_over "$SP_APPS/$m/fw.new" "$SP_APPS/$m/fw"
}
# sp_in_probe MODULE HOOK: the inbound rules are proved, not assumed. From the app's network, a connect to the vyre container's address there on any port but the hook port must TIME OUT (dropped; a
# listener that is not there would answer at once, so a refusal is as much a failure as a connection), on each port the vyre container listens on and on a few well known ones; the hook port must NOT
# time out (open, or refused when the daemon has no listener yet).
sp_in_probe() {
  m=$1; hk=$2; netw="vyre-app-${1}_net"
  vip=$(hdock inspect -f "{{with index .NetworkSettings.Networks \"$netw\"}}{{.IPAddress}}{{end}}" "$CTR_NAME" 2>/dev/null || true)
  sp_fld '([0-9]{1,3}\.){3}[0-9]{1,3}' "$vip" || { MSG="the vyre container has no address on the app's network"; return 1; }
  ports=$( { sp_listen_ports; printf '1\n22\n80\n443\n'; } | grep -vx "$hk" | sort -un | head -n 12)
  for p in $ports; do
    sp_int_in "$p" 1 65535 || continue
    r=$(sp_app_try "$netw" "$vip" "$p") || r=""
    [ "$r" = timeout ] || { MSG="the app's network can reach port $p of the vyre container, answer ${r:-none}"; return 1; }
  done
  [ "$hk" != 0 ] || return 0
  r=$(sp_app_try "$netw" "$vip" "$hk") || r=""
  case "$r" in open|refused) ;; *) MSG="the hook port of the vyre container is not reachable from the app's network"; return 1 ;; esac
}
# sp_app_handoff MODULE TEXT: status/app-<module>-secrets, a file only the daemon's uid can read (0400), written whole and renamed; the daemon reads it once and the helper sweeps it after ten minutes.
sp_app_handoff() {
  t=$(mktemp "$SP_STATE/.app-$1.XXXXXX") || return 1
  printf '%s' "$2" >"$t" && chmod 400 "$t" && chown "$DAEMON_UID:$DAEMON_UID" "$t" 2>/dev/null; rename_over "$t" "$SP_STATE/app-$1-secrets" || { rm -f "$t"; return 1; }
}
# sp_app_bootstrap MODULE: the one-time setup, on the first `up` only. The script is read out of the recorded image (a file name root checked) and run with the command the catalog line names, given on
# the command's STDIN (`<command> -`, which ruby, python, node and sh all read as "the program is on stdin"): root never writes into the app's filesystem, so a third-party container cannot
# turn a copy into a symlink race (the docker cp class of bug). Its environment travels in a root-only file (docker exec --env-file), never on a command line. What it prints is read for the
# names the line lists, each value from a short alphabet.
sp_app_bootstrap() {
  m=$1; d=$SP_APPS/$m
  [ ! -f "$d/bootstrapped" ] || return 0
  if [ "$A_SCRIPT" = - ]; then : >"$d/bootstrapped"; return 0; fi
  img=$(head -n 1 "$SP_PRIV/image" 2>/dev/null || true)
  printf '%s\n' "$img" | grep -Eqx 'sha256:[0-9a-f]{64}' || { MSG="the setup script could not be read"; return 1; }
  sc=$(mktemp "$d/script.XXXXXX") || { MSG="the setup script could not be read"; return 1; }
  if ! { timeout 60 env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker run --rm --network none --read-only --cap-drop ALL --security-opt no-new-privileges --user 65534:65534 --pids-limit 32 --memory 64m \
      --entrypoint cat "$img" "/opt/vyre/core/appmods/catalog/$A_SCRIPT" 2>/dev/null | head -c 262145 >"$sc"; } || [ ! -s "$sc" ] || [ "$(wc -c <"$sc")" -gt 262144 ]; then
    rm -f "$sc"; MSG="the setup script could not be read"; return 1
  fi
  hook=$(sp_rnd)
  vip=$(hdock inspect -f "{{with index .NetworkSettings.Networks \"vyre-app-${m}_net\"}}{{.IPAddress}}{{end}}" "$CTR_NAME" 2>/dev/null || true)
  sp_fld '([0-9]{1,3}\.){3}[0-9]{1,3}' "$vip" || { rm -f "$sc"; MSG="the vyre container has no address on the app's network"; return 1; }
  ev=$d/setup.env
  pub=$(sp_app_public "$m")
  ( umask 077; printf 'APP_URL=%s\nVYRE_LOGIN_EMAIL=vyre+%s@vyre.invalid\nVYRE_HOOK_URL=http://%s:%s/hook\nVYRE_HOOK_TOKEN=%s\n' "${pub:-http://vyre-app-$m:$A_PORT}" "$m" "$vip" "$A_HOOK" "$hook" >"$ev" ) || { MSG="the setup environment could not be written"; return 1; }
  of=$d/setup.out
  set -f
  # shellcheck disable=SC2086 # the words of the catalog line's command, each checked against a short alphabet; split on + only
  oldifs=$IFS; IFS=+
  # shellcheck disable=SC2086 # split on '+' on purpose (IFS is set for it)
  set -- $A_EXEC
  IFS=$oldifs
  set +f
  brc=0
  timeout 600 env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker exec -i --env-file "$ev" -w /app "vyre-app-$m" "$@" - <"$sc" 2>/dev/null | head -c 16384 >"$of" || brc=1
  rm -f "$ev" "$sc"
  if [ "$brc" != 0 ] || [ ! -s "$of" ]; then rm -f "$of"; MSG="setting the app up failed"; return 1; fi
  body="hook_token=$hook
"
  oldifs=$IFS; IFS=+
  for o in $A_OUTS; do
    IFS=$oldifs
    ov=$(grep -E -m 1 -- "^$o=[A-Za-z0-9_.@+=/:-]{1,300}\$" "$of" | head -n 1 || true)
    [ -n "$ov" ] || { rm -f "$of"; MSG="setting the app up gave no $o"; return 1; }
    body="$body$ov
"
    IFS=+
  done
  IFS=$oldifs
  rm -f "$of"
  sp_app_handoff "$m" "$body" || { MSG="the setup result could not be handed over"; return 1; }
  : >"$d/bootstrapped"
}
# sp_app_rewall MODULE: the walls of a running app put in again in a new vyre container and proved. The container has only just started, so a failed proof is looked at again twice, a few seconds
# apart, before the app is given up (a probe that runs while the namespace is still settling is not a hole). Each pass applies and proves the whole set again.
sp_app_rewall() {
  _m=$1; _i=0
  while :; do
    MSG=""
    if sp_app_load "$_m" && sp_attach_net "$_m" "vyre-app-${_m}_net" "$APP_ALIAS" && sp_fw_apply_net "$_m" "vyre-app-${_m}_net" "vyre-app:$_m" "app:$_m" && sp_in_apply "$_m" "$A_HOOK" \
        && sp_probe_to "$_m" "vyre-app-$_m" app "vyre-app-${_m}_net" "$A_PORT" "the app" && sp_in_probe "$_m" "$A_HOOK"; then return 0; fi
    _i=$((_i + 1)); [ "$_i" -lt "${SP_REWALL_TRIES:-3}" ] || return 1
    sleep "${SP_REWALL_WAIT:-4}"
  done
}
sp_app_up() {
  m=$1
  sp_app_load "$m" || { MSG="that app is not recorded on this server"; return 1; }
  sp_app_image_ok || return 1
  [ -s "$SP_PRIV/images" ] || { MSG="root has no recorded image for the helper; run sudo vyre space-helper install"; return 1; }
  # shellcheck disable=SC2015 # a failed mkdir or chmod both take the same exit
  mkdir -p "$SP_APPS/$m" && chmod 700 "$SP_APPS/$m" || { MSG="could not make the app's folder"; return 1; }
  # The pinned image, by digest, if it is not here yet: what is pulled is exactly what the recorded line names. Root pulls; the app's container never does.
  if ! hdock image inspect "$A_IMAGE" >/dev/null 2>&1; then
    timeout 1800 env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker pull -q "$A_IMAGE" >/dev/null 2>&1 || { MSG="the app's image could not be pulled"; return 1; }
  fi
  sp_app_gen "$m" || return 1
  sp_secrets_app "$m" || { MSG="could not make the app's secrets"; return 1; }
  sp_app_dc "$m" create >/dev/null 2>&1 || { MSG="the app's container could not be created"; return 1; }
  # Joined and walled BEFORE the app starts, so it never runs unwalled; proved after, and stopped again if the proof fails.
  sp_attach_net "$m" "vyre-app-${m}_net" "$APP_ALIAS" || return 1
  sp_fw_apply_net "$m" "vyre-app-${m}_net" "vyre-app:$m" "app:$m" || return 1
  sp_in_apply "$m" "$A_HOOK" || return 1
  sp_app_dc "$m" up -d >/dev/null 2>&1 || { MSG="the app did not start"; return 1; }
  if ! sp_app_wait "$m"; then sp_app_dc "$m" stop >/dev/null 2>&1 || true; MSG="the app did not become healthy"; return 1; fi
  if ! { sp_probe_to "$m" "vyre-app-$m" app "vyre-app-${m}_net" "$A_PORT" "the app" && sp_in_probe "$m" "$A_HOOK"; }; then sp_app_dc "$m" stop >/dev/null 2>&1 || true; return 1; fi
  if ! sp_app_bootstrap "$m"; then sp_app_dc "$m" stop >/dev/null 2>&1 || true; return 1; fi
  MSG="the app is up and walled off"
}
sp_app_stop() {
  [ -f "$SP_APPS/$1/compose.yml" ] || { MSG="that app was never started"; return 1; }
  sp_app_dc "$1" stop >/dev/null 2>&1 || { MSG="stop failed"; return 1; }
  MSG=stopped
}
# sp_app_fw_del MODULE: removes exactly the rules that carry vyre-app:<module>, in both chains, found by listing the chain; each line is matched against the strict shape root puts in, quotes stripped
# before -D. iptables prints the states as RELATED,ESTABLISHED and puts -s before -i (checked on a real iptables 1.8.10 in a network namespace); both orders of the states are read. Success is reported only after a second listing shows no line that names the app (a form this function does not know is a failure, never a silent success).
sp_app_fw_del() {
  m=$1; tg="vyre-app:$m"
  pid=$(sp_pid) || { sp_sub_del "app:$m"; return 0; }
  for fam in iptables ip6tables; do
    for ch in OUTPUT INPUT; do
      lines=$(timeout 20 nsenter -t "$pid" -n "$fam" -w -S "$ch" 2>/dev/null | grep -E -- "--comment \"?$tg([^a-z0-9-]|\$)" || true)
      [ -n "$lines" ] || continue
      printf '%s\n' "$lines" | while IFS= read -r l; do
        if [ "$ch" = OUTPUT ]; then pat="-A OUTPUT -d [0-9a-f:./]+ -m owner --uid-owner [0-9]+-[0-9]+ -m comment --comment \"?$tg\"? -j REJECT( --reject-with [a-z0-9-]+)?"
        else pat="-A INPUT (-s [0-9a-f:./]+ )?-i [a-z0-9]+ (-p tcp -m tcp --dport [0-9]+ |-m conntrack --ctstate (ESTABLISHED,RELATED|RELATED,ESTABLISHED) )?-m comment --comment \"?$tg\"? -j (ACCEPT|DROP)"; fi
        printf '%s\n' "$l" | grep -Eqx -- "$pat" || continue
        rest=$(printf '%s' "${l#-A "$ch" }" | tr -d '"')
        set -f
        # shellcheck disable=SC2086 # the words of a line that matched the strict pattern above, quotes removed
        timeout 20 nsenter -t "$pid" -n "$fam" -w -D "$ch" $rest >/dev/null 2>&1 || true
        set +f
      done
      if timeout 20 nsenter -t "$pid" -n "$fam" -w -S "$ch" 2>/dev/null | grep -qE -- "--comment \"?$tg([^a-z0-9-]|\$)"; then MSG="a firewall rule for this app is still there (removed none, or one in a form the helper does not know)"; return 1; fi
    done
  done
  sp_sub_del "app:$m"
  rm -f "$SP_APPS/$m/fw"
}
sp_app_down() {
  m=$1
  [ -f "$SP_APPS/$m/compose.yml" ] || { MSG="that app was never started"; return 1; }
  # The rules first: they name an interface of the vyre container, and a name that is free again may belong to another network by the time the app is gone.
  sp_app_fw_del "$m" || return 1
  hdock network disconnect -f "vyre-app-${m}_net" "$CTR_NAME" >/dev/null 2>&1 || true
  sp_app_dc "$m" down >/dev/null 2>&1 || { MSG="down failed"; return 1; }
  # The keys and the data stay; the setup runs again on the next install (the daemon's Vault no longer has what it made).
  rm -f "$SP_APPS/$m/bootstrapped"
  MSG="removed; the data is kept"
}
# ---------------------------------------------------------------------------------------------------------------------------------------------
# Published servers (team/contracts/builder.md, the container path on a server that runs apps through this helper): `pub-build|pub-up|pub-stop|pub-down dep_<16 hex>` and nothing wider. The daemon cannot run
# Docker here, so it writes what a site's server needs into a folder it owns (<home>/publish/<space>/servers/<deployment>/: `ctx/` the build context, `request` the settings, `secrets/NAME` the granted
# runtime secrets) and asks by deployment id alone. Root CLAIMS that folder by rename into its own (same disk), looks at what is in it as root, judges every setting with its own patterns and the daemon's rules
# (core/appmods/host-pub.js, run inside the recorded vyre image: no network, read-only, unprivileged), builds with the pinned rootless BuildKit (an unprivileged container, never a root process), records the image
# it made, and starts it the way an app is started: its compose file made by root from root's record (never from the daemon), linted, the app on an internal network of its own, walled in the vyre container's
# namespace with NO door in (only answers to what the daemon asked), proved, and healthy before it is called up. The data volume stays on stop and down. Nothing is built or run from a path or a flag the daemon named.
# ---------------------------------------------------------------------------------------------------------------------------------------------
SP_PUB=$SP_PRIV/pub
# The rootless BuildKit image, pinned by digest: the same one core/builder/container.js names (test/space-helper-pub.test.js keeps the two equal).
PUB_BUILDKIT="moby/buildkit:v0.17.3-rootless@sha256:5f1fad127999e9fedfb19edbdd8dbbd5849268b89ff3dc247322730832c25568"
SPACES_PUB_MAX_KB=${VYRE_PUB_MAX_KB:-61440}
SPACES_PUB_IMAGE_MAX=${VYRE_PUB_IMAGE_MAX:-2147483648}
sp_pub_dep_ok() { [ "${#1}" = 20 ] && printf '%s\n' "$1" | grep -Eqx 'dep_[0-9a-f]{16}'; }
# sp_pub_src DEP: SRC is the one folder <home>/publish/<space>/servers/<dep> the daemon made, every step of the way a real folder the daemon's uid owns.
sp_pub_src() {
  base=$(sp_lend_base) || { MSG="the daemon's home folder could not be found"; return 1; }
  SRC=""; cnt=0
  for p in "$base"/publish/spc_*/servers/"$1"; do
    [ -e "$p" ] || [ -L "$p" ] || continue
    sid=${p%/servers/*}; sid=${sid##*/}
    printf '%s\n' "$sid" | grep -Eqx 'spc_[a-z0-9]{12}' || continue
    d=$base
    for seg in publish "$sid" servers "$1"; do
      d=$d/$seg
      { [ -d "$d" ] && [ ! -L "$d" ] && [ "$(stat -c %u "$d" 2>/dev/null)" = "$DAEMON_UID" ]; } || { MSG="the server's folder is not where it should be"; return 1; }
    done
    SRC=$p; cnt=$((cnt + 1))
  done
  [ "$cnt" = 1 ] || { MSG="there is no such server folder"; return 1; }
}
# sp_pub_vet FOLDER: what was claimed holds only plain files and folders, none with a second link, within the size cap; made readable for the unprivileged containers that read it.
sp_pub_vet() {
  c=$1
  { [ -d "$c" ] && [ ! -L "$c" ]; } || { MSG="what was taken is not a folder"; return 1; }
  [ -z "$(find "$c" -mindepth 1 ! -type f ! -type d 2>/dev/null | head -n 1)" ] || { MSG="the folder holds something that is not a plain file or folder"; return 1; }
  [ -z "$(find "$c" -type f -links +1 2>/dev/null | head -n 1)" ] || { MSG="the folder holds a file with a second link"; return 1; }
  kb=$(du -sk "$c" 2>/dev/null | cut -f1)
  case "$kb" in ""|*[!0-9]*) MSG="the folder's size could not be read"; return 1 ;; esac
  [ "$kb" -le "$SPACES_PUB_MAX_KB" ] || { MSG="the folder is bigger than $((SPACES_PUB_MAX_KB / 1024)) MB"; return 1; }
  [ "$(find "$c" 2>/dev/null | wc -l)" -le 4000 ] || { MSG="the folder holds too many files"; return 1; }
  chmod -R u+rwX,go+rX -- "$c" 2>/dev/null || true
}
# sp_pub_claim DEP SUBDIR: SRC is taken by rename into root's own folder; CLAIM is where it is now. The daemon's path is never used again.
sp_pub_claim() {
  sp_pub_src "$1" || return 1
  pd=$SP_PUB/$1
  { mkdir -p "$pd" && chmod 700 "$pd"; } 2>/dev/null || { MSG="the helper's folder for it could not be made"; return 1; }
  CLAIM=$pd/$2
  rm -rf -- "$CLAIM"
  [ "$(stat -c %d "$SRC")" = "$(stat -c %d "$pd")" ] || { MSG="the server's folder is on another disk than the helper's folder"; return 1; }
  mv -T -- "$SRC" "$CLAIM" 2>/dev/null || { MSG="the server's folder could not be taken"; return 1; }
}
# sp_pub_request FILE: the settings, one `key=value` per line, every value from its own anchored pattern, no key twice and none unknown. They land in PB_*; nothing else is read from the file.
# Each "A && B || C" below means: if A and B do not both hold, take the refusal.
# shellcheck disable=SC2015
sp_pub_request() {
  f=$1; PB_NAME=""; PB_VERSION=""; PB_PORT=""; PB_MEM=""; PB_CPUS=""; PB_PIDS=""; PB_HPATH=""; PB_HOK=""; PB_HSTART=""; PB_SECRETS=""
  { [ -f "$f" ] && [ ! -L "$f" ]; } || { MSG="the settings are missing"; return 1; }
  [ "$(wc -c <"$f")" -le 2048 ] || { MSG="the settings are too long"; return 1; }
  [ "$(LC_ALL=C tr -d '\040-\176\n' <"$f" | wc -c)" = 0 ] || { MSG="the settings hold bytes outside printable ASCII"; return 1; }
  seen=" "
  while IFS= read -r l || [ -n "$l" ]; do
    [ -n "$l" ] || continue
    k=${l%%=*}; v=${l#*=}
    [ "$k" != "$l" ] || { MSG="a setting without a value"; return 1; }
    case "$seen" in *" $k "*) MSG="a setting is given twice"; return 1 ;; esac
    seen="$seen$k "
    case "$k" in
      name) sp_app_name_ok "$v" && PB_NAME=$v || { MSG="the name is not one"; return 1; } ;;
      version) sp_fld '[0-9]{1,6}' "$v" && PB_VERSION=$v || { MSG="the version is not a number"; return 1; } ;;
      port) sp_int_in "$v" 1 65535 && PB_PORT=$v || { MSG="the port is not one"; return 1; } ;;
      mem) sp_int_in "$v" 64 8192 && PB_MEM=$v || { MSG="the memory is not a size"; return 1; } ;;
      cpus) sp_fld '[0-9](\.[0-9]{1,2})?' "$v" && PB_CPUS=$v || { MSG="the cpus are not a number"; return 1; } ;;
      pids) sp_int_in "$v" 32 4096 && PB_PIDS=$v || { MSG="the process limit is not a number"; return 1; } ;;
      health_path) sp_fld '/[A-Za-z0-9_./-]{0,80}' "$v" && PB_HPATH=$v || { MSG="the health path is not a path"; return 1; } ;;
      health_ok) sp_fld '[0-9]{3}(\+[0-9]{3}){0,5}' "$v" && PB_HOK=$v || { MSG="the health codes are not codes"; return 1; } ;;
      health_start) sp_int_in "$v" 1 600 && PB_HSTART=$v || { MSG="the start time is not a number of seconds"; return 1; } ;;
      secrets) sp_fld '-|[A-Z][A-Z0-9_]{0,63}(\+[A-Z][A-Z0-9_]{0,63}){0,11}' "$v" && PB_SECRETS=$v || { MSG="the secrets are not names"; return 1; } ;;
      *) MSG="a setting this helper does not know"; return 1 ;;
    esac
  done <"$f"
  for x in "$PB_NAME" "$PB_VERSION" "$PB_PORT" "$PB_MEM" "$PB_CPUS" "$PB_PIDS" "$PB_HPATH" "$PB_HOK" "$PB_HSTART"; do [ -n "$x" ] || { MSG="a setting is missing"; return 1; }; done
  [ -n "$PB_SECRETS" ] || PB_SECRETS=-
  awk -v c="$PB_CPUS" 'BEGIN { exit !(c + 0 >= 0.1 && c + 0 <= 8) }' || { MSG="the cpus are out of range"; return 1; }
}
# sp_pub_plan OUT MOUNT ARGS: host-pub.js, in the recorded vyre image, as an unprivileged user with no network and a read-only filesystem; MOUNT (a folder, or empty) appears read-only at /ctx. stdout only, capped at 64 KB.
sp_pub_plan() {
  img=$(head -n 1 "$SP_PRIV/image" 2>/dev/null || true)
  printf '%s\n' "$img" | grep -Eqx 'sha256:[0-9a-f]{64}' || return 1
  out_=$1; mnt=$2; shift 2
  if [ -n "$mnt" ]; then
    # shellcheck disable=SC2016 # the script is node's, not the shell's
    { timeout 60 env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker run --rm --network none --read-only --cap-drop ALL --security-opt no-new-privileges --user 65534:65534 --pids-limit 64 --memory 128m \
        -v "$mnt:/ctx:ro" --entrypoint node "$img" -e 'import("/opt/vyre/core/appmods/host-pub.js").then(m=>process.stdout.write(m.run(process.argv.slice(1))))' "$@" 2>/dev/null || true; } | head -c 65536 >"$out_"
  else
    # shellcheck disable=SC2016 # the script is node's, not the shell's
    { timeout 60 env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker run --rm --network none --read-only --cap-drop ALL --security-opt no-new-privileges --user 65534:65534 --pids-limit 64 --memory 128m \
        --entrypoint node "$img" -e 'import("/opt/vyre/core/appmods/host-pub.js").then(m=>process.stdout.write(m.run(process.argv.slice(1))))' "$@" 2>/dev/null || true; } | head -c 65536 >"$out_"
  fi
  [ -s "$out_" ]
}
# sp_pub_rec_save DEP TAG ID: root's record of what it built, one line, 0600. It is what pub-up starts from; the daemon's settings only have to AGREE with it.
# Each "A && B || C" below means: if A and B do not both hold, take the refusal.
# shellcheck disable=SC2015
sp_pub_rec_save() {
  t=$(mktemp "$SP_PUB/$1/rec.XXXXXX") || return 1
  printf '%s %s %s %s %s %s %s %s %s %s %s %s\n' "$PB_NAME" "$2" "$3" "$PB_PORT" "$PB_MEM" "$PB_CPUS" "$PB_PIDS" "$PB_HPATH" "$PB_HOK" "$PB_HSTART" "$PB_VERSION" "$PB_SECRETS" >"$t"
  chmod 600 "$t" && rename_over "$t" "$SP_PUB/$1/rec" || { rm -f "$t"; return 1; }
}
# sp_pub_rec_load DEP: root's record back into PR_* (every field checked again) and A_* (what the app functions read). `A_HOOK=0`: a published server has no door in.
# Each "A && B || C" below means: if A and B do not both hold, take the refusal.
# shellcheck disable=SC2015
sp_pub_rec_load() {
  r=$SP_PUB/$1/rec
  { [ -f "$r" ] && [ ! -L "$r" ]; } || { MSG="that server was never built here"; return 1; }
  read -r PR_NAME PR_TAG PR_ID PR_PORT PR_MEM PR_CPUS PR_PIDS PR_HPATH PR_HOK PR_HSTART PR_VERSION PR_SECRETS <"$r" || { MSG="the record of that server could not be read"; return 1; }
  sp_app_name_ok "$PR_NAME" && sp_fld 'vyre-pub/[a-z0-9-]+:[0-9a-f]{16}' "$PR_TAG" && sp_fld 'sha256:[0-9a-f]{64}' "$PR_ID" && sp_int_in "$PR_PORT" 1 65535 && sp_int_in "$PR_MEM" 64 8192 \
    && sp_fld '[0-9](\.[0-9]{1,2})?' "$PR_CPUS" && sp_int_in "$PR_PIDS" 32 4096 && sp_fld '/[A-Za-z0-9_./-]{0,80}' "$PR_HPATH" && sp_fld '[0-9]{3}(\+[0-9]{3}){0,5}' "$PR_HOK" && sp_int_in "$PR_HSTART" 1 600 \
    && sp_fld '-|[A-Z][A-Z0-9_]{0,63}(\+[A-Z][A-Z0-9_]{0,63}){0,11}' "$PR_SECRETS" \
    || { MSG="the record of that server is not one this helper wrote"; return 1; }
  # shellcheck disable=SC2034 # the A_* variables are read by the app functions
  A_NAME=$PR_NAME; A_IMAGE=$PR_TAG; A_PORT=$PR_PORT; A_MEM=$PR_MEM; A_CPUS=$PR_CPUS; A_PIDS=$PR_PIDS; A_HOOK=0; A_SCRIPT=-; A_EXEC=-; A_OUTS=-; A_HPATH=$PR_HPATH; A_HOK=$PR_HOK; A_HSTART=$PR_HSTART
}
# sp_pub_build DEP: claim, vet, judge, build, load, record. MSG ends with the image id the daemon starts the server from.
# Each "A && B || C" below means: if A and B do not both hold, take the refusal.
# shellcheck disable=SC2015
sp_pub_build() {
  dep=$1
  sp_pub_claim "$dep" build || return 1
  bc=$CLAIM
  sp_pub_vet "$bc" || return 1
  [ -d "$bc/ctx" ] && [ ! -L "$bc/ctx" ] || { MSG="the folder has no build context"; return 1; }
  [ -z "$(find "$bc" -mindepth 1 -maxdepth 1 ! -name ctx ! -name request 2>/dev/null | head -n 1)" ] || { MSG="the folder holds more than a build context and its settings"; return 1; }
  sp_pub_request "$bc/request" || return 1
  [ -f "$bc/ctx/Dockerfile" ] && [ ! -L "$bc/ctx/Dockerfile" ] || { MSG="the folder has no Dockerfile at its top"; return 1; }
  # the same sentence the daemon would have said: the name, the limits and the Dockerfile judged by the daemon's own rules
  ck=$(mktemp "$SP_PUB/$dep/check.XXXXXX") || { MSG="the helper's folder could not be written"; return 1; }
  sp_pub_plan "$ck" "$bc/ctx" check "$PB_NAME" "$PB_PORT" "$PB_MEM" "$PB_CPUS" "$PB_PIDS" "$PB_HPATH" "$PB_HOK" "$PB_HSTART" || { rm -f "$ck"; MSG="the request could not be judged"; return 1; }
  verdict=$(head -n 1 "$ck"); rm -f "$ck"
  [ "$verdict" = ok ] || { MSG=$(printf '%s' "$verdict" | sed 's/^refused: //'); return 1; }
  # a server is named for its deployment: the tag is root's, a Dockerfile cannot choose it
  tag="vyre-pub/$PB_NAME:${dep#dep_}"
  out=$SP_PUB/$dep/out
  rm -rf -- "$out"; { mkdir -p "$out" && chmod 777 "$out"; } 2>/dev/null || { MSG="the helper's build folder could not be made"; return 1; }
  hdock rm -f vyre-pub-build >/dev/null 2>&1 || true
  sp_status "$ID" running "building"
  # rootless BuildKit as an unprivileged container: SETUID and SETGID kept only for its user namespace, the context read-only, nothing else mounted, bounded in memory, processes and time
  timeout 900 env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker run --rm --name vyre-pub-build --security-opt seccomp=unconfined --security-opt apparmor=unconfined \
    --cap-drop ALL --cap-add SETUID --cap-add SETGID --memory 2g --cpus 2 --pids-limit 1024 -e BUILDKITD_FLAGS=--oci-worker-no-process-sandbox -v "$bc/ctx:/ctx:ro" -v "$out:/out" \
    --entrypoint buildctl-daemonless.sh "$PUB_BUILDKIT" build --frontend dockerfile.v0 --local context=/ctx --local dockerfile=/ctx --output "type=docker,name=$tag,dest=/out/image.tar" >/dev/null 2>"$SP_PUB/$dep/build.log"
  brc=$?
  [ "$brc" != 124 ] || hdock rm -f vyre-pub-build >/dev/null 2>&1 || true
  if [ "$brc" != 0 ] || [ ! -s "$out/image.tar" ]; then
    # the last lines of the build's own log are the reason; they hold nothing of the server
    MSG="the build failed: $(tail -n 3 "$SP_PUB/$dep/build.log" 2>/dev/null | tr '\n' ' ' | cut -c1-90)"
    rm -rf -- "$out"; return 1
  fi
  sz=$(stat -c %s "$out/image.tar" 2>/dev/null || echo 0)
  case "$sz" in ""|*[!0-9]*) sz=0 ;; esac
  if [ "$sz" -gt "$SPACES_PUB_IMAGE_MAX" ]; then rm -rf -- "$out"; MSG="the image is bigger than $((SPACES_PUB_IMAGE_MAX / 1073741824)) GB"; return 1; fi
  hdock load -i "$out/image.tar" >/dev/null 2>&1 || { rm -rf -- "$out"; MSG="the image could not be loaded"; return 1; }
  rm -rf -- "$out"
  id=$(hdock image inspect "$tag" --format '{{.Id}}' 2>/dev/null || true)
  sp_fld 'sha256:[0-9a-f]{64}' "$id" || { MSG="the build finished but its image is not here"; return 1; }
  sp_pub_rec_save "$dep" "$tag" "$id" || { MSG="the record of the build could not be kept"; return 1; }
  MSG="built $id"
}
# sp_pub_up DEP: the server from root's record, with the secrets the daemon wrote read by root.
# Each "A && B || C" below means: if A and B do not both hold, take the refusal.
# shellcheck disable=SC2015
sp_pub_up() {
  dep=$1
  sp_pub_rec_load "$dep" || return 1
  cur=$(hdock image inspect "$PR_TAG" --format '{{.Id}}' 2>/dev/null || true)
  [ "$cur" = "$PR_ID" ] || { MSG="the image that was built is not here any more; publish it again"; return 1; }
  sp_pub_claim "$dep" up || return 1
  up=$CLAIM
  sp_pub_vet "$up" || return 1
  [ -z "$(find "$up" -mindepth 1 -maxdepth 1 ! -name request ! -name secrets 2>/dev/null | head -n 1)" ] || { MSG="the folder holds more than settings and secrets"; return 1; }
  sp_pub_request "$up/request" || return 1
  # what the daemon asks to start must be what was built: only the list of secrets may differ
  [ "$PB_NAME $PB_PORT $PB_MEM $PB_CPUS $PB_PIDS $PB_HPATH $PB_HOK $PB_HSTART $PB_VERSION" = "$PR_NAME $PR_PORT $PR_MEM $PR_CPUS $PR_PIDS $PR_HPATH $PR_HOK $PR_HSTART $PR_VERSION" ] || { MSG="the settings are not those of the build"; return 1; }
  m=$PR_NAME
  [ -z "$(sp_app_line "$m")" ] || { MSG="that name is an app that ships with Vyre"; return 1; }
  # shellcheck disable=SC2015 # a failed mkdir or chmod both take the same exit
  mkdir -p "$SP_APPS/$m" && chmod 700 "$SP_APPS/$m" || { MSG="could not make the server's folder"; return 1; }
  # the secrets: each named file is a plain file of one short printable line without a quote; they are written by root into root's env file and nowhere else
  envt=$(mktemp "$SP_APPS/$m/secrets.XXXXXX") || { MSG="could not make the server's secrets"; return 1; }
  oldifs=$IFS; IFS=+
  for s in $( [ "$PB_SECRETS" = - ] || printf '%s' "$PB_SECRETS" ); do
    IFS=$oldifs
    sf=$up/secrets/$s
    { [ -f "$sf" ] && [ ! -L "$sf" ]; } || { rm -f "$envt"; MSG="the secret $s was not given"; return 1; }
    [ "$(wc -c <"$sf")" -le 4096 ] || { rm -f "$envt"; MSG="the secret $s is longer than 4096 bytes"; return 1; }
    sv=$(cat -- "$sf")
    case "$sv" in *\'*|*"
"*) rm -f "$envt"; MSG="the secret $s holds a quote or a line break"; return 1 ;; esac
    [ -n "$sv" ] && [ "$(printf '%s' "$sv" | LC_ALL=C tr -d '\040-\176' | wc -c)" = 0 ] || { rm -f "$envt"; MSG="the secret $s is empty or holds bytes outside printable ASCII"; return 1; }
    printf "%s='%s'\n" "$s" "$sv" >>"$envt"
    IFS=+
  done
  IFS=$oldifs
  chmod 600 "$envt" && rename_over "$envt" "$SP_APPS/$m/secrets.env" || { rm -f "$envt"; MSG="could not keep the server's secrets"; return 1; }
  rm -rf -- "$up"
  # root's compose file, from root's record, linted
  t=$(mktemp "$SP_APPS/$m/compose.XXXXXX") || { MSG="could not make the server's compose file"; return 1; }
  if ! sp_pub_plan "$t" "" compose "$m" "$PR_TAG" "$PR_PORT" "$PR_MEM" "$PR_CPUS" "$PR_PIDS" "$PB_SECRETS" || ! head -n 1 "$t" | grep -q '^# Generated by Vyre'; then rm -f "$t"; MSG="the compose file could not be made"; return 1; fi
  if ! l=$(sp_app_lint "$t" "$m" 1); then rm -f "$t"; MSG="the compose file was refused: $(printf '%s' "$l" | head -n 1)"; return 1; fi
  chmod 600 "$t" && rename_over "$t" "$SP_APPS/$m/compose.yml"
  printf '%s\n' "$dep" >"$SP_APPS/$m/pubdep"
  sp_app_dc "$m" create >/dev/null 2>&1 || { MSG="the server's container could not be created"; return 1; }
  # joined and walled BEFORE it starts, so it never runs unwalled; proved after, and stopped again if the proof fails. No door in: the only packets it may send the vyre container are answers.
  sp_attach_net "$m" "vyre-app-${m}_net" "$APP_ALIAS" || return 1
  sp_fw_apply_net "$m" "vyre-app-${m}_net" "vyre-app:$m" "app:$m" || return 1
  sp_in_apply "$m" 0 || return 1
  sp_app_dc "$m" up -d >/dev/null 2>&1 || { MSG="the server did not start"; return 1; }
  if ! sp_app_wait "$m"; then sp_app_dc "$m" stop >/dev/null 2>&1 || true; MSG="the server did not become healthy"; return 1; fi
  if ! { sp_probe_to "$m" "vyre-app-$m" app "vyre-app-${m}_net" "$A_PORT" "the server" && sp_in_probe "$m" 0; }; then sp_app_dc "$m" stop >/dev/null 2>&1 || true; return 1; fi
  MSG="the server is up and walled off"
}
sp_pub_stop() {
  sp_pub_rec_load "$1" || return 1
  [ -f "$SP_APPS/$PR_NAME/compose.yml" ] || { MSG="that server was never started"; return 1; }
  sp_app_dc "$PR_NAME" stop >/dev/null 2>&1 || { MSG="stop failed"; return 1; }
  MSG=stopped
}
sp_pub_down() {
  sp_pub_rec_load "$1" || return 1
  [ "$(cat "$SP_APPS/$PR_NAME/pubdep" 2>/dev/null || true)" = "$1" ] || { MSG="that is not the server running under that name"; return 1; }
  sp_app_down "$PR_NAME" || return 1
  MSG="removed; the data is kept"
}
# sp_pub_do ID VERB DEP: one request, with its status before and after; builds one at a time.
sp_pub_do() {
  ID=$1; v=$2; dep=$3; MSG=""
  sp_pub_dep_ok "$dep" || { sp_status "$ID" failed "not a request the helper knows"; sp_log "refused $v: not a deployment"; return 0; }
  case "$v" in pub-build|pub-up|pub-stop|pub-down) ;; *) sp_status "$ID" failed "not a request the helper knows"; return 0 ;; esac
  # one lane per deployment, and a build holds the build lock so two images are never made at once
  lk=$SP_PRIV/lock-pub.$dep
  if [ -d "$lk" ] && [ -n "$(find "$lk" -maxdepth 0 -mmin +120 2>/dev/null)" ]; then rm -rf "${lk:?}" 2>/dev/null || true; fi
  if [ -d "$lk" ]; then lp=$(cat "$lk/pid" 2>/dev/null || true); case "$lp" in ""|*[!0-9]*) ;; *) kill -0 "$lp" 2>/dev/null || rm -rf "${lk:?}" 2>/dev/null ;; esac; fi
  mkdir "$lk" 2>/dev/null || { sp_status "$ID" busy "that server is busy"; sp_log "busy: $v"; return 0; }
  printf '%s\n' "$$" >"$lk/pid" 2>/dev/null || true
  bk=""
  if [ "$v" = pub-build ]; then
    bk=$SP_PRIV/lock-pub-build
    if [ -d "$bk" ] && [ -n "$(find "$bk" -maxdepth 0 -mmin +120 2>/dev/null)" ]; then rm -rf "${bk:?}" 2>/dev/null || true; fi
    if [ -d "$bk" ]; then lp=$(cat "$bk/pid" 2>/dev/null || true); case "$lp" in ""|*[!0-9]*) ;; *) kill -0 "$lp" 2>/dev/null || rm -rf "${bk:?}" 2>/dev/null ;; esac; fi
    mkdir "$bk" 2>/dev/null || { rm -rf "${lk:?}" 2>/dev/null; sp_status "$ID" busy "another server is being built"; sp_log "busy: build"; return 0; }
    printf '%s\n' "$$" >"$bk/pid" 2>/dev/null || true
  fi
  sp_status "$ID" running "$v"
  rc=0
  case "$v" in pub-build) sp_pub_build "$dep" || rc=1 ;; pub-up) sp_pub_up "$dep" || rc=1 ;; pub-stop) sp_pub_stop "$dep" || rc=1 ;; pub-down) sp_pub_down "$dep" || rc=1 ;; esac
  # nothing of the daemon's folder stays in root's: the claims are deleted, the daemon writes a new folder at every build and every start
  rm -rf -- "${SP_PUB:?}/$dep/build" "${SP_PUB:?}/$dep/up"
  [ -z "$bk" ] || rm -rf "${bk:?}" 2>/dev/null || true
  rm -rf "${lk:?}" 2>/dev/null || true
  if [ "$rc" = 0 ]; then sp_status "$ID" ok "${MSG:-done}"; sp_log "ok $v"; else sp_status "$ID" failed "${MSG:-failed}"; sp_log "failed $v: ${MSG:-}"; fi
}
# sp_name_ok NAME: the one test for a Space name, used before a name is turned into any path or any command: lowercase letters, digits and dashes, a letter first, at most 31
# characters, and one line (grep -x on a variable that holds a newline would accept a matching line anywhere in it, so the length and the absence of a newline are checked first).
sp_name_ok() {
  case "$1" in ""|*[!a-z0-9-]*) return 1 ;; esac
  [ "${#1}" -le 31 ] || return 1
  case "$1" in [a-z]*) return 0 ;; *) return 1 ;; esac
}
# sp_read_claimed FILE: LINE is the request, or nothing and a reason in MSG. stat of the claimed file first (it is in a folder only root can write, but its owner can still hold an
# open descriptor and write to it): then the file is read ONCE, at most 65 bytes, into a copy only root can reach, and every later check is on that copy. The original is never read again.
sp_read_claimed() {
  c=$1
  st=$(stat -c '%F|%u|%h|%s|%a|%Y' "$c" 2>/dev/null) || { MSG="unreadable"; return 1; }
  IFS='|' read -r ft uid nl sz mode mt <<STAT
$st
STAT
  case "$ft" in "regular file") ;; *) MSG="not a regular file"; return 1 ;; esac
  [ "$uid" = "$DAEMON_UID" ] || { MSG="not made by the daemon's uid"; return 1; }
  [ "$nl" = 1 ] || { MSG="more than one link"; return 1; }
  [ $((0$mode & 077)) -eq 0 ] || { MSG="mode allows group or others"; return 1; }
  [ $(($(date +%s) - mt)) -le 300 ] || { MSG="stale"; return 1; }
  cp_=$SP_PRIV/claim-read
  rm -f "$cp_"
  head -c 65 -- "$c" >"$cp_" 2>/dev/null || { MSG="unreadable"; return 1; }
  sz=$(wc -c <"$cp_")
  # shellcheck disable=SC2015 # A && B || C on purpose: C is the refusal
  [ "$sz" -ge 2 ] && [ "$sz" -le 64 ] || { rm -f "$cp_"; MSG="wrong size"; return 1; }
  [ "$(LC_ALL=C tr -d '\040-\176\n' <"$cp_" | wc -c)" = 0 ] || { rm -f "$cp_"; MSG="bytes outside printable ASCII"; return 1; }
  # Exactly one line: one newline, and it is the last byte. So LINE below can never hold a newline.
  # shellcheck disable=SC2015 # A && B || C on purpose: C is the refusal
  [ "$(wc -l <"$cp_")" = 1 ] && [ "$(tail -c 1 "$cp_" | od -An -tx1 | tr -d ' \n')" = 0a ] || { rm -f "$cp_"; MSG="not exactly one line"; return 1; }
  LINE=$(cat -- "$cp_")
  rm -f "$cp_"
  case "$LINE" in *"
"*) MSG="not exactly one line"; return 1 ;; esac
  v_=${LINE%% *}; n_=${LINE#* }
  # publish-fill takes a Space's id, a site folder and a deployment, never a path (team/archive/work-journals/space-helper.md, the publish-fill verb): three tokens, each from its own anchored pattern.
  if [ "$v_" = publish-fill ]; then
    printf '%s\n' "$n_" | grep -Eqx 'spc_[a-z0-9]{12} site-[A-Za-z0-9]{6} [0-9a-f]{16}' && return 0
    MSG="not a request the helper knows"; return 1
  fi
  # pub-build|pub-up|pub-stop|pub-down take a deployment id and nothing else (the daemon's folder for it is found and claimed by root, never named in the request)
  case "$v_" in pub-build|pub-up|pub-stop|pub-down) { [ "$LINE" = "$v_ $n_" ] && sp_pub_dep_ok "$n_"; } && return 0; MSG="not a request the helper knows"; return 1 ;; esac
  case "$v_" in up|stop|down|firewall-add|firewall-del|app-up|app-stop|app-down) ;; *) MSG="not a request the helper knows"; return 1 ;; esac
  # shellcheck disable=SC2015 # A && B || C on purpose: C is the refusal
  [ "$LINE" = "$v_ $n_" ] && sp_name_ok "$n_" || { MSG="not a request the helper knows"; return 1; }
}
# publish-fill: the root half of publishing a static site (reviewer-3's conditions, publish-edge.md). The daemon wrote the site's files into a folder it owns; copying them into the site's
# volume is done here, as root, so the daemon never names a path or a volume. The request is `publish-fill <space id> <site folder> <deployment>`: the volume name and the folder are rebuilt
# here from those tokens. The folder is CLAIMED by rename into root's own folder (same disk only), then walked as root: only plain files and folders, no file with a second link, a size cap.
# It is copied by a throwaway container (no network, the folder read-only, two capabilities), and a fixed check runs on the volume after; a volume that fails it is removed. The folder goes
# deleted after it, never moved back.
sp_publish_fill_do() {
  id=$1; req=$(printf '%s' "$2" | tr '+' ' '); MSG=""
  printf '%s\n' "$req" | grep -Eqx 'spc_[a-z0-9]{12} site-[A-Za-z0-9]{6} [0-9a-f]{16}' || { sp_status "$id" failed "not a request the helper knows"; sp_log "refused publish-fill: not the shape"; return 0; }
  # shellcheck disable=SC2086 # three validated tokens, split on purpose
  set -- $req
  lk=$SP_PRIV/lock-publish-fill
  if [ -d "$lk" ] && [ -n "$(find "$lk" -maxdepth 0 -mmin +120 2>/dev/null)" ]; then rmdir "$lk" 2>/dev/null || true; fi
  mkdir "$lk" 2>/dev/null || { sp_status "$id" busy "a site is being copied"; return 0; }
  sp_status "$id" running publish-fill
  rc=0; sp_publish_fill "$1" "$2" "$3" || rc=1
  rmdir "$lk" 2>/dev/null || true
  if [ "$rc" = 0 ]; then sp_status "$id" ok "${MSG:-done}"; sp_log "ok publish-fill"; else sp_status "$id" failed "${MSG:-failed}"; sp_log "failed publish-fill: ${MSG:-}"; fi
}
sp_publish_fill() {
  sid=$1; site=$2; slug=$3
  base=$(sp_lend_base) || { MSG="the daemon's home folder could not be found"; return 1; }
  d=$base
  for seg in publish "$sid" sites; do
    d=$d/$seg
    { [ -d "$d" ] && [ ! -L "$d" ] && [ "$(stat -c %u "$d" 2>/dev/null)" = "$DAEMON_UID" ]; } || { MSG="the site folder is not where it should be"; return 1; }
  done
  src=$d/$site
  { [ -d "$src" ] && [ ! -L "$src" ] && [ "$(stat -c %u "$src" 2>/dev/null)" = "$DAEMON_UID" ]; } || { MSG="there is no such site folder"; return 1; }
  pc=$SP_PRIV/publish-claim
  { mkdir -p "$pc" && chmod 700 "$pc"; } 2>/dev/null || { MSG="the helper's claim folder could not be made"; return 1; }
  claim=$pc/fill
  rm -rf -- "$claim"
  [ "$(stat -c %d "$src")" = "$(stat -c %d "$pc")" ] || { MSG="the site folder is on another disk than the helper's folder"; return 1; }
  mv -T -- "$src" "$claim" 2>/dev/null || { MSG="the site folder could not be taken"; return 1; }
  rc=0; sp_publish_fill_body "$sid" "$slug" || rc=1
  # PF-2: nothing goes back through the daemon's path (it could have been swapped for a link meanwhile): the claim is deleted, the daemon writes a new folder at every preview.
  rm -rf -- "$claim"
  return "$rc"
}
sp_publish_fill_body() {
  sid=$1; slug=$2; vol="vyre-publish-${sid}_site-${slug}"
  # What was taken must be a real folder (a link swapped in after the check is a link here), holding only plain files and folders, none with a second link.
  { [ -d "$claim" ] && [ ! -L "$claim" ]; } || { MSG="what was taken is not a folder"; return 1; }
  [ -z "$(find "$claim" -mindepth 1 ! -type f ! -type d 2>/dev/null | head -n 1)" ] || { MSG="the site holds something that is not a plain file or folder"; return 1; }
  [ -z "$(find "$claim" -type f -links +1 2>/dev/null | head -n 1)" ] || { MSG="the site holds a file with a second link"; return 1; }
  kb=$(du -sk "$claim" 2>/dev/null | cut -f1)
  case "$kb" in ""|*[!0-9]*) MSG="the site's size could not be read"; return 1 ;; esac
  [ "$kb" -le "$SPACES_PUBLISH_MAX_KB" ] || { MSG="the site is bigger than $((SPACES_PUBLISH_MAX_KB / 1024)) MB"; return 1; }
  img=$(hdock inspect -f '{{.Image}}' "$CTR_NAME" 2>/dev/null || true)
  case "$img" in sha256:[0-9a-f]*) ;; *) MSG="the vyre image could not be found"; return 1 ;; esac
  # PF-1: each container step has a time limit and a fixed name, so a stuck copy (a FIFO the daemon adds to the claimed folder) is removed and the helper's queue moves on.
  pf_run() {
    hdock rm -f vyre-publish-fill >/dev/null 2>&1 || true
    timeout "$SPACES_PUBLISH_TIMEOUT" env -i PATH="$PATH" HOME=/root DOCKER_CONFIG="$SP_PRIV/docker-config" docker run --rm --name vyre-publish-fill --network none --cap-drop ALL "$@"
    pf_rc=$?
    [ "$pf_rc" != 124 ] || hdock rm -f vyre-publish-fill >/dev/null 2>&1 || true
    return "$pf_rc"
  }
  have=$(pf_run --security-opt no-new-privileges --read-only --user 0 --entrypoint sh -v "$vol:/srv:ro" "$img" -c 'find /srv -mindepth 1 | head -n 1') || { MSG="the site's volume could not be looked at"; return 1; }
  if [ -z "$have" ]; then
    pf_run --cap-add CHOWN --cap-add DAC_OVERRIDE --security-opt no-new-privileges --read-only --user 0 --entrypoint sh -v "$claim:/in:ro" -v "$vol:/srv" "$img" \
      -c 'cp -R /in/. /srv/ && chmod -R a-w /srv && chown -R 65532:65532 /srv' >/dev/null 2>&1 || { hdock volume rm -f "$vol" >/dev/null 2>&1 || true; MSG="the files could not be copied into the site's volume"; return 1; }
  fi
  bad=$(pf_run --security-opt no-new-privileges --read-only --user 0 --entrypoint sh -v "$vol:/srv:ro" "$img" -c 'find /srv -mindepth 1 \( \( ! -type f ! -type d \) -o \( -type f -links +1 \) -o ! -user 65532 \) | head -n 1') || bad=unreadable
  [ -z "$bad" ] || { hdock volume rm -f "$vol" >/dev/null 2>&1 || true; MSG="the site's volume did not pass its check, so it was removed"; return 1; }
  MSG="the site is in its volume"
}
# sp_do ID VERB NAME: one request, with its status before and after, one Space at a time, and the up lane rate limited.
sp_do() {
  id=$1; v=$2; n=$3; MSG=""
  # Everything is checked again here, whatever put it in the queue: nothing below builds a path or a command from anything that has not passed.
  case "$id" in *[!0-9a-f]*|"") return 0 ;; esac
  [ "${#id}" = 32 ] || return 0
  if [ "$v" = publish-fill ]; then sp_publish_fill_do "$id" "$n"; return 0; fi
  case "$v" in pub-build|pub-up|pub-stop|pub-down) sp_pub_do "$id" "$v" "$n"; return 0 ;; esac
  case "$v" in up|stop|down|firewall-add|firewall-del|app-up|app-stop|app-down) ;; *) sp_status "$id" failed "not a request the helper knows"; return 0 ;; esac
  sp_name_ok "$n" || { sp_status "$id" failed "not a request the helper knows"; sp_log "refused $v: a name that is not one"; return 0; }
  # An app verb names a module in root's recorded catalog and nothing else; its lock is lock-app.<module> (a dot is not in a Space's name, so the two can never be the same lock).
  lkn=$n
  case "$v" in
    app-*)
      if ! { sp_app_name_ok "$n" && [ -n "$(sp_app_line "$n")" ]; }; then sp_status "$id" failed "no such app"; sp_log "refused $v: not a recorded app"; return 0; fi
      lkn=app.$n ;;
    *)
      case "$n" in *-twenty*) sp_status "$id" failed "that name is not allowed"; sp_log "refused $v: a name with -twenty"; return 0 ;; esac
      if [ "$v" != up ] && ! sp_known "$n"; then sp_status "$id" failed "no such Space"; sp_log "refused $v: unknown Space"; return 0; fi ;;
  esac
  if [ "$v" = up ] || [ "$v" = app-up ]; then
    mn=$(($(date +%s) / 60)); r=$SP_PRIV/rate-up; last=$(cat "$r" 2>/dev/null || true); cnt=0
    case "$last" in "$mn "*) cnt=${last#* } ;; esac
    case "$cnt" in ""|*[!0-9]*) cnt=0 ;; esac
    if [ "$cnt" -ge "$SPACES_UP_PER_MIN" ]; then sp_status "$id" busy "too many up requests this minute"; sp_log "busy: up rate"; return 0; fi
    printf '%s %s\n' "$mn" $((cnt + 1)) >"$r"
  fi
  lk=$SP_PRIV/lock-$lkn
  # A dead lock is taken by renaming it away first: of two runs that find the same dead lock only the one whose rename succeeds goes on, and neither can delete
  # the fresh lock the other has made since (a plain rm -rf by both could).
  sp_reap_lock() { _d="$1.dead.$$"; if mv "$1" "$_d" 2>/dev/null; then rm -rf "${_d:?}" 2>/dev/null || true; return 0; fi; return 1; }
  if [ -d "$lk" ] && [ -n "$(find "$lk" -maxdepth 0 -mmin +120 2>/dev/null)" ]; then sp_reap_lock "$lk" || true; fi
  # A lock names the run that took it. One whose run is gone (killed, a reboot, an earlier install) is not busy: it is taken over now, not after two hours.
  if [ -d "$lk" ]; then lp=$(cat "$lk/pid" 2>/dev/null || true); case "$lp" in ""|*[!0-9]*) ;; *) kill -0 "$lp" 2>/dev/null || { sp_reap_lock "$lk" && sp_log "took over a lock whose run was gone"; } ;; esac; fi
  mkdir "$lk" 2>/dev/null || { sp_status "$id" busy "that Space is busy"; sp_log "busy: $v"; return 0; }
  printf '%s\n' "$$" >"$lk/pid" 2>/dev/null || true
  sp_status "$id" running "$v"
  rc=0
  case "$v" in up) sp_up "$n" || rc=1 ;; stop) sp_stop "$n" || rc=1 ;; down) sp_down "$n" || rc=1 ;; firewall-add) sp_fw_add "$n" || rc=1 ;; firewall-del) sp_fw_del "$n" || rc=1 ;; app-up) sp_app_up "$n" || rc=1 ;; app-stop) sp_app_stop "$n" || rc=1 ;; app-down) sp_app_down "$n" || rc=1 ;; esac
  rm -rf "${lk:?}" 2>/dev/null || true
  if [ "$rc" = 0 ]; then sp_status "$id" ok "${MSG:-done}"; sp_log "ok $v"; else sp_status "$id" failed "${MSG:-failed}"; sp_log "failed $v: ${MSG:-}"; fi
}
# space_helper_run: what the path unit runs, as root.
space_helper_run() {
  umask 077; LC_ALL=C; export LC_ALL
  if ! sp_dirs_ok; then echo "vyre: $SPACES_ROOT (or a folder above it) is not as the Space helper needs it; nothing was done" >&2; exit 0; fi
  set_root_run
  find "$SP_STATE" -maxdepth 1 \( -name 'admin-*' -o -name 'app-*-secrets' \) -type f -mmin +10 -delete 2>/dev/null || true
  mkdir -p "$SP_PRIV/claim" "$SP_PRIV/docker-config" 2>/dev/null; chmod 700 "$SP_PRIV/claim" "$SP_PRIV/docker-config" 2>/dev/null || true
  # A request claimed by a run that did not finish is answered "interrupted", never replayed.
  for c in "$SP_PRIV"/claim/req-*; do
    [ -e "$c" ] || continue
    b=${c##*/}; h=${b#req-}
    case "$h" in *[!0-9a-f]*|"") ;; *) [ "${#h}" != 32 ] || sp_status "$h" failed "interrupted" ;; esac
    rm -rf -- "$c"
  done
  n=0; cleanup_q=""; other_q=""
  for f in "$SP_SPOOL"/* "$SP_SPOOL"/.[!.]*; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    b=${f##*/}; h=${b#req-}
    if [ "$h" = "$b" ] || [ "${#h}" != 32 ]; then rm -rf -- "$f" 2>/dev/null || true; sp_log "dropped an entry that is not a request"; continue; fi
    case "$h" in *[!0-9a-f]*) rm -rf -- "$f" 2>/dev/null || true; sp_log "dropped an entry that is not a request"; continue ;; esac
    n=$((n + 1))
    if [ "$n" -gt "$SPACES_SPOOL_CAP" ]; then rm -f -- "$f" 2>/dev/null || true; sp_log "dropped: spool over its cap"; continue; fi
    # Claimed by rename (which never follows a link at the last name) into a folder only root can use, then looked at there.
    # RH-9: only a plain file is claimed (a directory or a link named like a request is removed, never moved), the claim name is cleared first, and mv -T never moves into a directory.
    if [ ! -f "$f" ] || [ -L "$f" ]; then rm -rf -- "$f" 2>/dev/null || true; sp_status "$h" failed "refused: not a plain file"; sp_log "dropped an entry that is not a plain file"; continue; fi
    rm -rf -- "${SP_PRIV:?}/claim/$b" 2>/dev/null || true
    mv -T -- "$f" "$SP_PRIV/claim/$b" 2>/dev/null || continue
    if sp_read_claimed "$SP_PRIV/claim/$b"; then
      v=${LINE%% *}; nm=${LINE#* }
      # The queue is a list of words: publish-fill's three tokens travel joined by + (no token holds one) and are split again, and checked again, where it runs.
      [ "$v" != publish-fill ] || nm=$(printf '%s' "$nm" | tr ' ' '+')
      case "$v" in stop|down|firewall-del|app-stop|app-down|pub-stop|pub-down) cleanup_q="$cleanup_q $h:$v:$nm" ;; *) other_q="$other_q $h:$v:$nm" ;; esac
    else
      sp_status "$h" failed "refused: $MSG"; sp_log "refused: $MSG"; rm -rf -- "${SP_PRIV:?}/claim/$b"
    fi
  done
  # The cleanup lane first, so a flood of up never delays a stop, a down or a firewall-del.
  for q in $cleanup_q $other_q; do
    h=${q%%:*}; r=${q#*:}; v=${r%%:*}; nm=${r#*:}
    sp_do "$h" "$v" "$nm"
    rm -rf -- "${SP_PRIV:?}/claim/req-$h"
  done
  [ -z "$cleanup_q$other_q" ] || sleep 1
  exit 0
}
# sp_wall_ready: after the rules were put in and proved for this container, a read-only marker names THIS START of THIS container: `<first 12 characters of its id> <start time, epoch seconds>`.
# A `docker restart` keeps the id but starts a new process, so the entry (core/spawner/space-wall.sh) compares the start time with its own and an earlier start's marker never passes (SH-4).
sp_wall_ready() {
  id=$(hdock inspect -f '{{.Id}}' "$CTR_NAME" 2>/dev/null | cut -c1-12 || true)
  case "$id" in ""|*[!0-9a-f]*) return 0 ;; esac
  st=$(hdock inspect -f '{{.State.StartedAt}}' "$CTR_NAME" 2>/dev/null || true)
  ep=$(date -d "$st" +%s 2>/dev/null || true)
  case "$ep" in ""|*[!0-9]*) return 0 ;; esac
  # shellcheck disable=SC2015 # A && B || C on purpose: C is the refusal
  printf '%s %s\n' "$id" "$ep" >"$SP_STATE/wall-ready.new" && chmod 644 "$SP_STATE/wall-ready.new" && rename_over "$SP_STATE/wall-ready.new" "$SP_STATE/wall-ready" || return 1
}
# sp_wall_clear: the marker goes when the container dies or stops, so nothing is left for a later start to find.
sp_wall_clear() { rm -f "$SP_STATE/wall-ready" "$SP_STATE/wall-ready.new" 2>/dev/null || true; }
# sp_locked NAME: is a request running for this Space right now? Its lock folder counts only while it can: a lock that names a run (pid) counts while that run is alive, one that names none counts for two hours
# (the same age the request path clears a lock at). A lock left by a dead run is not "busy", so the Space is not left unwatched.
sp_locked() {
  lk=$SP_PRIV/lock-$1
  [ -d "$lk" ] || return 1
  lp=$(cat "$lk/pid" 2>/dev/null || true)
  case "$lp" in ""|*[!0-9]*) [ -z "$(find "$lk" -maxdepth 0 -mmin +120 2>/dev/null)" ]; return ;; esac
  kill -0 "$lp" 2>/dev/null
}
# space_helper_reattach: after an update the vyre container is a new one with no network joins and no rules: every recorded Space whose containers still run is
# joined and firewalled again and proved. A Space that fails is stopped (never left running unfirewalled) and said.
space_helper_reattach() {
  [ -s "$SP_PRIV/images" ] || return 0
  for r in "$SP_PRIV"/spaces/*/record; do
    [ -f "$r" ] || continue
    d=${r%/record}; n=${d##*/}
    printf '%s\n' "$n" | grep -Eqx "$SP_NAME_RE" || continue
    sp_running "$n" || continue
    # a Space that a request is bringing up right now joins, is firewalled and is proved by that request: its server may not be running yet (a restore comes first), and stopping it here would end the request
    sp_locked "$n" && continue
    MSG=""
    if ! { sp_attach "$n" && sp_probe "$n"; }; then
      sp_dc "$n" stop >/dev/null 2>&1 || true
      echo "vyre: the Space $n was stopped: ${MSG:-its firewall could not be proved} (ask for up again once the server is healthy)" >&2
      sp_log "stopped after update: ${MSG:-}"
    fi
  done
  # App modules: the same, for every app whose container still runs. An app that cannot be walled again is stopped.
  for ad in "$SP_APPS"/*/; do
    [ -f "${ad}compose.yml" ] || continue
    m=$(basename "$ad")
    sp_app_name_ok "$m" || continue
    sp_app_running "$m" || continue
    sp_locked "app.$m" && continue
    MSG=""
    if ! sp_app_rewall "$m"; then
      sp_app_dc "$m" stop >/dev/null 2>&1 || true
      echo "vyre: the app $m was stopped: ${MSG:-its firewall could not be proved} (ask for app-up again once the server is healthy)" >&2
      sp_log "stopped app after update: ${MSG:-}"
    fi
  done
  sp_wall_ready || echo "vyre: the helper could not write the firewall marker; the vyre container will not start its daemon until it can" >&2
}
# sp_reset_stale: what an earlier install left in the helper's own state must not break a new one. Run at every `space-helper install` (a fresh install and every update).
# With no helper run in flight (a run owns its locks, its claims and its rate window), the up-rate window, the locks, the claims and the answers nobody is still waiting for
# (a reader polls its own id for minutes) are cleared. Nothing of a Space is touched: its record, its data and a project that runs stay as they are, and a running Space
# is adopted by the reattach pass (`space-helper watch`/`reattach`), never stopped here. Nothing is refused silently: what was cleared is one line in the helper's log.
sp_reset_stale() {
  # The run is looked for by the wrapper it was started through (the unit's ExecStart is "<wrapper> space-helper-run"), so another copy of the helper on the same machine (a test, a second install
  # folder) is not mistaken for this one.
  if command -v pgrep >/dev/null 2>&1 && pgrep -f -- "$WRAPPER space-helper-run" >/dev/null 2>&1; then return 0; fi
  cleared=0
  [ ! -e "$SP_PRIV/rate-up" ] || { rm -f "$SP_PRIV/rate-up" 2>/dev/null || true; cleared=$((cleared + 1)); }
  for l in "$SP_PRIV"/lock-*; do [ -d "$l" ] || continue; rm -rf "${l:?}" 2>/dev/null || true; cleared=$((cleared + 1)); done
  for c in "$SP_PRIV"/claim/req-*; do [ -e "$c" ] || continue; rm -rf "${c:?}" 2>/dev/null || true; cleared=$((cleared + 1)); done
  for f in "$SP_STATE"/status-*; do [ -f "$f" ] || continue; [ -z "$(find "$f" -maxdepth 0 -mmin +10 2>/dev/null)" ] || { rm -f "$f" 2>/dev/null || true; cleared=$((cleared + 1)); }; done
  [ "$cleared" = 0 ] || sp_log "install: cleared $cleared stale entries left by an earlier install"
  return 0
}
# space_helper install|remove|status: the path unit, root's. DirectoryNotEmpty on the spool; trigger limits off, so a flood cannot disable the unit that does
# the cleanup (the helper itself throttles).
space_helper() {
  units=$SYSTEMD_DIR; un=$SPACES_UNIT
  case "$un" in *[!A-Za-z0-9._-]*|"") die "the helper unit name is a plain unit name" ;; esac
  case "${1:-status}" in
    install)
      # shellcheck disable=SC2015 # A && B || C on purpose: C is the refusal
      command -v systemctl >/dev/null 2>&1 && { [ -d /run/systemd/system ] || [ -n "$SYSTEMD_SEAM" ]; } || { echo "vyre: this server has no systemd, so the Space helper is not installed"; return 0; }
      if [ "$(id -u)" != 0 ] && [ -z "$SYSTEMD_SEAM" ]; then exec sudo -n "$WRAPPER" space-helper install; fi
      own_ok "$WRAPPER" "$ROOT_UID" strict || die "$WRAPPER must be owned by root and not writable by others: the helper runs it as root"
      sp_dirs; set_root_run
      mkdir -p "$SP_PRIV/docker-config" && chmod 700 "$SP_PRIV/docker-config"
      sp_reset_stale
      space_helper_record || die "the helper could not record the image it regenerates from; nothing was installed"
      { printf '[Unit]\nDescription=Vyre Space helper, asked for by vyred\nStartLimitIntervalSec=0\n\n[Service]\nType=oneshot\nExecStart=%s space-helper-run\nTimeoutStartSec=3600\n' "$WRAPPER"; } >"$units/$un.service.new" && mv "$units/$un.service.new" "$units/$un.service"
      { printf '[Unit]\nDescription=Vyre Space helper requests\nStartLimitIntervalSec=0\n\n[Path]\nDirectoryNotEmpty=%s\nUnit=%s.service\nTriggerLimitIntervalSec=0\n\n[Install]\nWantedBy=multi-user.target\n' "$SP_SPOOL" "$un"; } >"$units/$un.path.new" && mv "$units/$un.path.new" "$units/$un.path"
      { printf '[Unit]\nDescription=Vyre Space helper, firewall after every start of the vyre container\nAfter=docker.service\nStartLimitIntervalSec=0\n\n[Service]\nExecStart=%s space-helper watch\nRestart=always\nRestartSec=5\n\n[Install]\nWantedBy=multi-user.target\n' "$WRAPPER"; } >"$units/$un-watch.service.new" && mv "$units/$un-watch.service.new" "$units/$un-watch.service"
      systemctl daemon-reload
      systemctl enable --now "$un.path" >/dev/null 2>&1 || systemctl enable "$un.path"
      systemctl enable --now "$un-watch.service" >/dev/null 2>&1 || systemctl enable "$un-watch.service"
      # already running from an older install: it restarts so that it runs this wrapper's code
      systemctl try-restart "$un-watch.service" >/dev/null 2>&1 || true
      # The list of firewalled subnets exists from the start (empty), so a container entry that finds the helper installed and no list fails closed (SH-5).
      [ -f "$SP_STATE/subnets" ] || { : >"$SP_STATE/subnets" && chmod 644 "$SP_STATE/subnets"; }
      printf '1\n' >"$SP_STATE/ready"
      say "Spaces can be asked for from Vyre: $un.path watches $SP_SPOOL"
      ;;
    remove)
      [ "$(id -u)" = 0 ] || [ -n "$SYSTEMD_SEAM" ] || exec sudo -n "$WRAPPER" space-helper remove
      # Each Space's containers go with the helper (left running, nothing would firewall them again); their volumes and keys stay, and purging them is `vyre admin purge-space`.
      for sd in "$SP_PRIV"/spaces/*/; do
        n=$(basename "$sd"); sp_known "$n" || continue
        sp_dc "$n" down --remove-orphans >/dev/null 2>&1 || say "the Space $n's containers could not be removed: sudo docker compose -p vyre-$n-twenty down"
        sp_fw_del "$n" >/dev/null 2>&1 || true
      done
      for ad in "$SP_APPS"/*/; do
        m=$(basename "$ad"); [ -f "${ad}compose.yml" ] || continue; sp_app_name_ok "$m" || continue
        sp_app_dc "$m" down --remove-orphans >/dev/null 2>&1 || say "the app $m's containers could not be removed: sudo docker compose -p vyre-app-$m down"
        sp_app_fw_del "$m" >/dev/null 2>&1 || true
      done
      rm -f "$SP_STATE/ready"
      systemctl disable --now "$un.path" >/dev/null 2>&1 || true
      systemctl disable --now "$un-watch.service" >/dev/null 2>&1 || true
      rm -f "$units/$un.path" "$units/$un.service" "$units/$un-watch.service"
      systemctl daemon-reload 2>/dev/null || true
      say "the Space helper is removed and the Spaces are stopped (their data is kept)"
      ;;
    watch)
      # Event driven, not polling: every start of the vyre container (a restart outside the wrapper, a reboot, a Docker restart) gets its Spaces joined and firewalled
      # again, and a Space that cannot be proved is stopped (RH-7). The one pass at the top covers a boot where the container is already up.
      [ "$(id -u)" = 0 ] || [ -n "$SYSTEMD_SEAM" ] || exec sudo -n "$WRAPPER" space-helper watch
      sp_dirs_ok || die "$SPACES_ROOT is not as the Space helper needs it"
      set_root_run
      while :; do
        space_helper_reattach
        hdock events --filter "container=$CTR_NAME" --filter event=start --filter event=die --filter event=stop --filter event=kill --filter event=oom --format '{{.Action}}' 2>/dev/null | while IFS= read -r act; do
          case "$act" in
            start) sleep 2; space_helper_reattach ;;
            die|stop|kill|oom) sp_wall_clear ;;
          esac
        done
        [ "$SPACES_WATCH_ONCE" != 1 ] || break
        sleep 5
      done
      ;;
    reattach)
      # Root's: join and firewall again every Space that still runs, after the vyre container was recreated by something other than an update.
      [ "$(id -u)" = 0 ] || [ -n "$SYSTEMD_SEAM" ] || exec sudo -n "$WRAPPER" space-helper reattach
      sp_dirs_ok || die "$SPACES_ROOT is not as the Space helper needs it"
      set_root_run; space_helper_reattach
      ;;
    status)
      if [ -f "$units/$un.path" ]; then say "the Space helper is installed ($un.path)"; else say "the Space helper is not installed"; fi
      ;;
    *) die "vyre space-helper install|remove|status|reattach|watch" ;;
  esac
}
# admin ACTION [TARGET]: the ONE path for a destructive or irreversible act (RH-2). Root, on a terminal, with the plain consequence printed and an exact word typed.
# It is not a spool verb and the daemon cannot reach it. Actions are a closed list.
admin() {
  if [ "$(id -u)" != 0 ] && [ -z "$SYSTEMD_SEAM" ]; then own_ok "$WRAPPER" "$ROOT_UID" strict || die "$WRAPPER is not root's"; exec sudo "$WRAPPER" admin "$@"; fi
  [ "$ADMIN_NOTTY" = 1 ] || { [ -t 0 ] && [ -t 1 ]; } || die "vyre admin needs a terminal: it asks you to type a word, and a pipe cannot answer"
  umask 077
  act=${1:-}; tgt=${2:-}
  case "$act" in
    purge-space)
      printf '%s\n' "$tgt" | grep -Eqx "$SP_NAME_RE" || die "vyre admin purge-space SPACE"
      sp_known "$tgt" || die "this server has no Space named $tgt"
      word="purge-space $tgt"
      echo "This destroys the Space $tgt's records store: its database and files are deleted, and the keys that opened them. It cannot be undone."
      ;;
    purge-app)
      sp_app_name_ok "$tgt" || die "vyre admin purge-app APP"
      [ -d "$SP_APPS/$tgt" ] || die "this server has no app named $tgt"
      word="purge-app $tgt"
      echo "This destroys the app $tgt: its container, its data and the keys it was started with. It cannot be undone."
      ;;
    fscrypt-enable)
      word="fscrypt"
      echo "This turns on file encryption for this server's disk. It cannot be undone, and it changes nothing else."
      ;;
    wipe)
      word="wipe"
      echo "This destroys everything on this server: every Space's records store and its keys, the vault and its keys, the sealing key, the database backups and the previous release kept for a rollback, then starts a new, empty Vyre with no owner. It cannot be undone."
      ;;
    anchor-reset)
      word="anchor-reset"
      echo "This lets Vyre start after a restore from backup. The server keeps a note, outside its database, of how far its record log had got; a database put back from an older copy is shorter than that note, and Vyre refuses to start rather than run on a log that may have been rewritten. Resetting the note accepts the restored log as it is: entries made after the copy you restored are gone for good, and from now on nothing checks them. Your phone is asked to approve it, and the reset is written into the log."
      ;;
    *) die "vyre admin wipe | purge-space SPACE | purge-app APP | fscrypt-enable | anchor-reset" ;;
  esac
  printf 'To go on, type exactly: %s\n> ' "$word"
  IFS= read -r typed || die "nothing was typed; nothing was done"
  [ "$typed" = "$word" ] || die "that was not the word; nothing was done"
  [ -d "$SP_PRIV" ] || mkdir -p "$SP_PRIV"
  sp_log "admin $act ${tgt:-} by ${SUDO_USER:-root}"
  case "$act" in
    wipe)
      # The daemon is stopped, then vault's wipeHome runs from a one-off container of the SAME image (the home is a volume; wipeHome takes the home's lock and refuses while
      # vyred or the sealer runs), then a new Space identity is made offline and the daemon starts unowned. Nothing here is a daemon tool and nothing comes from the daemon.
      set_root_run; prepare_run
      compose run --rm --no-deps -T --entrypoint test vyre -f /opt/vyre/scripts/admin-wipe.mjs >/dev/null 2>&1 || die "this release has no admin-wipe step (scripts/admin-wipe.mjs in the image); nothing was changed"
      compose stop vyre >/dev/null 2>&1 || die "the daemon could not be stopped; nothing was changed"
      for r in "$SP_PRIV"/spaces/*/record; do
        [ -f "$r" ] || continue
        d=${r%/record}; nm=${d##*/}
        printf '%s\n' "$nm" | grep -Eqx "$SP_NAME_RE" || continue
        sp_dc "$nm" down -v --remove-orphans >/dev/null 2>&1 || die "the store of the Space $nm could not be removed; the daemon is stopped and nothing else was destroyed. Fix that and run this again."
        MSG=""; sp_fw_del "$nm" >/dev/null 2>&1 || true
        rm -rf -- "${d:?}"
      done
      for ad in "$SP_APPS"/*/; do
        nm=$(basename "$ad"); sp_app_name_ok "$nm" || continue
        MSG=""; sp_app_fw_del "$nm" >/dev/null 2>&1 || true
        if [ -f "${ad}compose.yml" ]; then sp_app_dc "$nm" down -v --remove-orphans >/dev/null 2>&1 || die "the app $nm could not be removed; the daemon is stopped and nothing else was destroyed. Fix that and run this again."; fi
        rm -rf -- "${ad:?}"
      done
      compose run --rm --no-deps -T -u vyre --entrypoint node vyre /opt/vyre/scripts/admin-wipe.mjs || die "the vault and sealing wipe failed; the daemon is stopped. Nothing was started. Fix the line above and run this again."
      # What the host kept: database backups (they hold keys) and the releases set aside for a rollback.
      for f in "$UPD_PRIV/backups" "$UPD_PRIV/release.prev" "$UPD_PRIV/release.bad" "$UPD_PRIV/src.prev" "$SRCDIR.prev" "$BOXPREV"; do
        [ -e "$f" ] || [ -L "$f" ] || continue
        find "$f" -type f -exec sh -c 'for x; do n=$(wc -c <"$x"); head -c "$((n > 32 ? n : 32))" /dev/urandom >"$x" 2>/dev/null || true; done' sh {} + 2>/dev/null || true
        rm -rf -- "$f"
      done
      compose up -d >/dev/null 2>&1 || die "the wipe is done but the daemon did not start; run: vyre up"
      say "wiped. Vyre is running again, new and empty, with no owner. Pair a device to claim it."
      ;;
    anchor-reset)
      # `-u vyre` on both one-off runs: the service runs as 0:0 with every capability dropped but SETUID/SETGID (its entrypoint drops to vyre), so a one-off `--entrypoint node` is root without DAC_OVERRIDE and
      # cannot read the vyre-owned home (0700): the script said "no Vyre home" (found on a real --from install, testbox6, 5 Oct).
      # Offline: the daemon is stopped, then scripts/admin-anchor-reset.mjs (kernel-2's) starts ONLY the sealing process from a one-off container of the same image and prints one request line.
      # The owner's device signs that request (a proof made after the line was printed: the sealing process takes none older, and one lives under a minute) and the signed proof comes back as
      # one line on this terminal's input. A refused, expired or replayed proof changes nothing; the script exits non-zero and the daemon is started again either way.
      set_root_run; prepare_run
      pf=$(compose run --rm --no-deps -T --entrypoint test vyre -f /opt/vyre/scripts/admin-anchor-reset.mjs </dev/null 2>&1) || die "this release has no anchor-reset step (scripts/admin-anchor-reset.mjs in the image), or the image could not be run: $pf; nothing was changed"
      compose stop vyre >/dev/null 2>&1 </dev/null || die "the daemon could not be stopped; nothing was changed"
      echo "Vyre will print one request line. Approve it on your device, then paste the proof your device gives back and press Enter. It is good for under a minute."
      if compose run --rm --no-deps -i -u vyre --entrypoint node vyre /opt/vyre/scripts/admin-anchor-reset.mjs --home /home/vyre/.vyre; then rs=0; else rs=1; fi
      compose up -d >/dev/null 2>&1 || die "the daemon did not start; run: vyre up"
      [ "$rs" = 0 ] || die "the anchor was not reset (see the line above); Vyre was started again"
      say "the anchor is reset and Vyre is running again."
      ;;
    purge-space)
      set_root_run
      sp_dc "$tgt" down -v --remove-orphans >/dev/null 2>&1 || die "the Space's containers and volumes could not be removed; nothing else was deleted"
      sp_fw_del "$tgt" || echo "vyre: the firewall rule for $tgt was left: ${MSG:-}" >&2
      rm -rf -- "${SP_PRIV:?}/spaces/$tgt"
      say "the Space $tgt is purged"
      ;;
    purge-app)
      set_root_run
      # The rules first (they name an interface of the vyre container), then the app, its network and its volumes, then root's folder for it.
      MSG=""; sp_app_fw_del "$tgt" || echo "vyre: a firewall rule for $tgt was left: ${MSG:-}" >&2
      hdock network disconnect -f "vyre-app-${tgt}_net" "$CTR_NAME" >/dev/null 2>&1 || true
      if [ -f "$SP_APPS/$tgt/compose.yml" ]; then sp_app_dc "$tgt" down -v --remove-orphans >/dev/null 2>&1 || die "the app's container and volumes could not be removed; nothing else was deleted"; fi
      img=""; sp_app_load "$tgt" && img=$A_IMAGE
      rm -rf -- "${SP_APPS:?}/$tgt"
      # The image goes with the app, unless another app that still has a folder here runs the same digest.
      if [ -n "$img" ]; then
        shared=0
        for od in "$SP_APPS"/*/; do
          on=$(basename "$od"); [ -f "${od}compose.yml" ] || continue; sp_app_name_ok "$on" || continue
          if [ "$(sp_app_line "$on" | awk '{print $2}')" = "$img" ]; then shared=1; fi
        done
        if [ "$shared" = 0 ]; then hdock image rm "$img" >/dev/null 2>&1 || echo "vyre: the image of $tgt could not be removed" >&2; fi
      fi
      say "the app $tgt is purged"
      ;;
    fscrypt-enable)
      base=$(sp_lend_base) || die "root could not find the folder Vyre keeps lent workspaces in (the vyre container is not running, or its home is not a mounted folder), so there is nothing to encrypt"
      fi=$(findmnt -no FSTYPE,SOURCE --target "$base" 2>/dev/null || true)
      ftype=${fi%% *}; dev=${fi#* }
      case "$ftype" in ext4) ;; *) die "this disk is $ftype, not ext4: Vyre uses its slower method by itself" ;; esac
      case "$dev" in /dev/*) ;; *) die "the disk is not a block device under /dev; nothing was done" ;; esac
      if tune2fs -l "$dev" 2>/dev/null | grep -q 'Filesystem features:.*encrypt'; then say "file encryption is already on"; return 0; fi
      tune2fs -O encrypt "$dev" || die "tune2fs did not turn it on"
      say "file encryption is on"
      ;;
  esac
}

case "${1:-}" in up|update) expire_code ;; esac
VYRE_VERB=${1:-}
case "${1:-}" in
  up)
    shift
    link=${VYRE_LINK_ONLY:-0}
    for a in "$@"; do [ "$a" != --print-link ] || link=1; done
    if [ "$link" = 1 ]; then
      # stdout is for the two lines only.
      { compose up -d; ready; } >&2
      print_link
    else
      compose up -d
      ready
      cli up "$@"
    fi
    ;;
  update)
    shift
    for a in "$@"; do if [ "$a" = --rollback ]; then rollback "$@"; fi; done
    for a in "$@"; do case "$a" in --restore-data|--yes|-y) die "$a goes with --rollback" ;; esac; done
    if [ "$(id -u)" = 0 ]; then set_root_run; prepare_run; fi
    update "$@"
    ;;
  uninstall)
    shift
    need_docker
    uninstall "$@"
    ;;
  update-from-request)
    update_from_request
    ;;
  space-helper-run)
    space_helper_run
    ;;
  space-helper)
    shift
    space_helper "$@"
    ;;
  admin)
    shift
    admin "$@"
    ;;
  updater)
    shift
    updater "$@"
    ;;
  publish-release)
    [ -d "${2:-}" ] || die "vyre publish-release DIR"
    publish_release "$2" || exit 1
    ;;
  logs)
    shift
    compose logs -f "$@" vyre
    ;;
  *)
    cli "$@"
    ;;
esac
