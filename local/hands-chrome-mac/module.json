{
  "name": "chrome",
  "version": "0.1.0",
  "description": "Deep control of your own Chrome through the Vyre extension: read a page in one call, fill and act on it, run a batch with no round trips, look at DevTools (DOM, styles, scripts, console, network) and learn an app's API. The agent posts its plan first, you can interject or press Esc, credentials are masked before any model sees them, and an outward act holds at the Gate.",
  "roles": ["local"],
  "requires": [],
  "does": { "tools": [{ "name": "chrome.tabs", "effect": "read", "reach": "anyone" }, { "name": "chrome.frames", "effect": "read", "reach": "anyone" }, { "name": "chrome.snapshot", "effect": "read", "reach": "anyone" }, { "name": "chrome.act", "effect": "write", "reach": "anyone" }, { "name": "chrome.fill", "effect": "write", "reach": "anyone" }, { "name": "chrome.eval", "effect": "write", "reach": "anyone" }, { "name": "chrome.wait", "effect": "read", "reach": "anyone" }, { "name": "chrome.screenshot", "effect": "read", "reach": "anyone" }, { "name": "chrome.point", "effect": "read", "reach": "anyone" }, { "name": "chrome.batch", "effect": "write", "reach": "anyone" }, { "name": "chrome.parallel", "effect": "write", "reach": "anyone" }, { "name": "chrome.inspect", "effect": "read", "reach": "anyone" }, { "name": "chrome.sources", "effect": "read", "reach": "anyone" }, { "name": "chrome.console", "effect": "read", "reach": "anyone" }, { "name": "chrome.net", "effect": "read", "reach": "anyone" }, { "name": "chrome.api", "effect": "write", "reach": "anyone" }, { "name": "chrome.op", "effect": "write", "reach": "anyone" }, { "name": "chrome.op.run", "effect": "write", "reach": "modules" }, { "name": "chrome.ghl", "effect": "write", "reach": "anyone" }, { "name": "chrome.login", "effect": "write", "reach": "anyone" }, { "name": "chrome.recipe", "effect": "write", "reach": "anyone" }, { "name": "chrome.site", "effect": "write", "reach": "anyone" }, { "name": "chrome.state", "effect": "read", "reach": "anyone" }, { "name": "chrome.click", "effect": "write", "reach": "anyone" }, { "name": "chrome.type", "effect": "write", "reach": "anyone" }, { "name": "chrome.open", "effect": "write", "reach": "anyone" }, { "name": "chrome.approve", "effect": "write", "reach": "anyone" }, { "name": "chrome.summary", "effect": "read", "reach": "anyone" }, { "name": "chrome.plan", "effect": "write", "reach": "anyone" }, { "name": "chrome.interject", "effect": "write", "reach": "person" }, { "name": "chrome.stop", "effect": "write", "reach": "anyone" }, { "name": "chrome.resume", "effect": "write", "reach": "person" }, { "name": "chrome.pause", "effect": "write", "reach": "person" }, { "name": "chrome.plan.edit", "effect": "write", "reach": "person" }, { "name": "chrome.voice", "effect": "write", "reach": "person" }, { "name": "chrome.release", "effect": "write", "reach": "modules" }, { "name": "chrome.plan.check", "effect": "write", "reach": "modules" }, { "name": "chrome.status", "effect": "read", "reach": "anyone" }, { "name": "chrome.install", "effect": "write", "reach": "person" }] },
  "watches": { "emits": ["chrome.acted", "chrome.plan", "chrome.step", "chrome.interjected", "chrome.stopped", "chrome.finished", "chrome.resumed", "chrome.paused", "chrome.voice", "chrome.waiting", "chrome.connected", "chrome.disconnected", "chrome.replaced", "chrome.signin-asked", "chrome.signin-done", "chrome.site-learned"] },
  "shows": {},
  "needs": {},
  "teaches": {
    "tips": [
      {"id": "install", "text": "To let Vyre work in your own Chrome, run the Chrome setup once, then load the extension in chrome://extensions with Developer mode on.", "surfaces": ["capsule", "cli"], "level": "discovery", "trigger": "never-used", "since": "0.2.0"},
      {"id": "stop", "text": "While Vyre works in Chrome a panel shows its plan. Press `Esc` to stop it at once; it waits for you before doing anything else.", "surfaces": ["capsule"], "level": "first-use", "trigger": "on-use", "since": "0.2.0", "key": "Esc"},
      {"id": "interject", "text": "You can tell Vyre something while it works in Chrome, by typing or by voice. It hears you on its next step and can change course.", "surfaces": ["capsule"], "level": "power", "trigger": "idle", "since": "0.2.0"},
      {"id": "bars", "text": "Chrome shows a bar saying it is being debugged while Vyre works in a tab. That is Chrome's own notice and it cannot be hidden.", "surfaces": ["capsule", "cli"], "level": "first-use", "trigger": "on-use", "since": "0.2.0"},
      {"id": "secrets", "text": "Vyre never reads your passwords or cookies in Chrome. Banks, password managers and sign-in pages are off limits: sign in yourself.", "surfaces": ["capsule"], "level": "power", "trigger": "idle", "since": "0.2.0"},
      {"id": "held", "text": "If a page's Send, Pay or Post button is pressed for you, Vyre holds it at the Gate and shows you the fields first.", "surfaces": ["capsule", "cli"], "level": "first-use", "trigger": "on-use", "since": "0.2.0"}
    ]
  }
}
