{
  "manifest_version": 3,
  "name": "Vyre for Chrome",
  "version": "0.2.0",
  "key": "",
  "description": "Lets Vyre work in your own Chrome, on the pages you allow, with you watching.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "storage",
    "alarms",
    "declarativeNetRequest"
  ],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Vyre for Chrome",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
