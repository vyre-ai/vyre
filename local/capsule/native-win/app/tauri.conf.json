{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vyre",
  "mainBinaryName": "Vyre",
  "version": "0.1.0",
  "identifier": "run.vyre.app",
  "build": { "frontendDist": "./ui" },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://relay.vyre.run wss://relay.vyre.run"
    }
  },
  "plugins": { "deep-link": { "desktop": { "schemes": ["vyre"] } } },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["app-web/**/*"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" }, "nsis": { "installMode": "currentUser" } }
  }
}
