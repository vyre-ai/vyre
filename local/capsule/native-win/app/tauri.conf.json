{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vyre",
  "version": "0.1.0",
  "identifier": "run.vyre.app",
  "build": { "frontendDist": "./ui" },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
