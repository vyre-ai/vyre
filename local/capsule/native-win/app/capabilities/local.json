{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-pages",
  "description": "Bundled first-run and settings pages only. The main panel has no capability.",
  "windows": ["first-run", "settings", "confirm"],
  "permissions": [
    "core:default",
    "allow-get-state",
    "allow-save-pairing",
    "allow-set-autostart",
    "allow-notify",
    "allow-mount-drive",
    "allow-unmount-drive",
    "allow-begin-pair",
    "allow-pending-pair",
    "allow-confirm-pair",
    "allow-cancel-pair"
  ]
}
