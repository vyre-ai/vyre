{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Bundled page only; the main panel has no capability.",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:default",
    "allow-get-state",
    "allow-set-autostart",
    "allow-notify",
    "allow-mount-drive",
    "allow-unmount-drive"
  ]
}
