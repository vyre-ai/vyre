{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.vyre.run/schema/module.json",
  "title": "Vyre module manifest (module API 1)",
  "description": "module.json: what a module does, watches, shows, needs and teaches. ADR 0033. Keys marked x-status planned are part of module API 1 but not read by the loader yet.",
  "type": "object",
  "required": ["name", "version"],
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "properties": {
    "$schema": { "type": "string" },
    "name": { "$ref": "#/$defs/moduleName" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+", "x-message": "must be semver, like 0.1.0" },
    "apiVersion": { "type": "integer", "minimum": 1, "maximum": 1, "description": "The module API major this module is written for. Vyre 0.x supports 1." },
    "description": { "type": "string" },
    "main": { "type": "string", "description": "The entry file, relative to the module folder. Default index.js." },
    "roles": { "type": "array", "items": { "enum": ["box", "local"] }, "uniqueItems": true, "description": "Where it runs by default: on the box, on the person's own machine, or both." },
    "requires": {
      "description": "Modules that must be running first: a list of names, or names with a semver range.",
      "anyOf": [
        { "type": "array", "items": { "$ref": "#/$defs/moduleName" } },
        { "type": "object", "propertyNames": { "$ref": "#/$defs/moduleName" }, "additionalProperties": { "type": "string", "minLength": 1 }, "x-status": "planned" }
      ]
    },
    "replaces": { "$ref": "#/$defs/moduleName", "x-status": "planned", "description": "Set to this module's own name to stand in for the first-party module of that name. It must register every tool the original declares." },
    "does": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "properties": {
        "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" }, "uniqueItems": true },
        "providers": { "type": "array", "items": { "$ref": "#/$defs/moduleName" }, "uniqueItems": true, "description": "Session drivers (ADR 0030)." },
        "hooks": {
          "type": "object", "x-status": "planned",
          "description": "Harness points this module contributes to, each served by one of its tools. pretool may only tighten a verdict.",
          "additionalProperties": false,
          "properties": { "brief": { "$ref": "#/$defs/tool" }, "enrich": { "$ref": "#/$defs/tool" }, "pretool": { "$ref": "#/$defs/tool" }, "stop": { "$ref": "#/$defs/tool" } }
        },
        "senders": { "type": "object", "x-status": "planned", "description": "Gate sender types: type name to the tool that sends after the Gate approved.", "propertyNames": { "$ref": "#/$defs/moduleName" }, "additionalProperties": { "$ref": "#/$defs/tool" } },
        "apps": {
          "type": "object", "x-status": "planned", "description": "@App adapters: app id to its actions, each served by a tool.",
          "propertyNames": { "$ref": "#/$defs/moduleName" },
          "additionalProperties": {
            "type": "object", "required": ["app", "actions"], "additionalProperties": false,
            "properties": {
              "app": { "type": "string", "minLength": 1 },
              "bundleIds": { "type": "array", "items": { "type": "string" } },
              "actions": { "type": "object", "propertyNames": { "$ref": "#/$defs/moduleName" }, "additionalProperties": { "$ref": "#/$defs/tool" } }
            }
          }
        },
        "commands": {
          "type": "array", "x-status": "planned", "description": "CLI verbs: vyre <module> <verb> runs this tool, with positional args taken as these input keys in order.",
          "items": {
            "type": "object", "required": ["verb", "tool", "summary"], "additionalProperties": false,
            "properties": {
              "verb": { "$ref": "#/$defs/word" },
              "tool": { "$ref": "#/$defs/tool" },
              "summary": { "type": "string", "pattern": "^[^A-Z].*[^.]$", "x-message": "must be one lowercase line with no final period" },
              "args": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
            }
          }
        }
      }
    },
    "watches": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "properties": {
        "emits": { "type": "array", "items": { "$ref": "#/$defs/event" }, "uniqueItems": true },
        "on": { "type": "array", "items": { "$ref": "#/$defs/eventPattern" }, "uniqueItems": true, "x-status": "planned", "description": "Event patterns it subscribes to: a type, noun.* or *." }
      }
    },
    "shows": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "properties": {
        "deck": { "type": "array", "items": { "$ref": "#/$defs/slot" }, "uniqueItems": true },
        "capsule": {
          "anyOf": [
            { "type": "array", "items": { "type": "string", "minLength": 1 } },
            {
              "type": "object",
              "additionalProperties": {
                "type": "object", "additionalProperties": false,
                "properties": { "title": { "type": "string" }, "input": { "type": "object" }, "hide": { "type": "boolean" } }
              }
            }
          ]
        },
        "cli": { "type": "array", "items": { "$ref": "#/$defs/word" }, "uniqueItems": true },
        "streams": { "type": "array", "items": { "$ref": "#/$defs/word" }, "uniqueItems": true }
      }
    },
    "settings": {
      "type": "array", "x-status": "planned",
      "description": "Settings in the settings registry's shape. Each key starts with the module's name and a dot.",
      "items": { "$ref": "#/$defs/setting" }
    },
    "needs": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "properties": {
        "vault": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "x-message": "must be a vault item name, or per-<thing>" }, "uniqueItems": true },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/toolPattern" }, "uniqueItems": true, "x-status": "planned", "description": "Tools it calls through ctx.call, or module.* for all of one module's." },
        "network": { "type": "array", "items": { "type": "string", "pattern": "^(\\*\\.)?[a-z0-9.-]+(:\\d+)?$", "x-message": "must be a host name, optionally *.domain or with a port" }, "uniqueItems": true, "x-status": "planned" },
        "slots": { "type": "array", "items": { "$ref": "#/$defs/slot" }, "uniqueItems": true, "x-status": "planned" }
      }
    },
    "teaches": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "properties": {
        "memory": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" }, "uniqueItems": true },
        "prompt": {
          "type": "array", "x-status": "planned", "description": "Prompt layers: markdown files in the module, at account, project or agent level.",
          "items": {
            "type": "object", "required": ["level", "file"], "additionalProperties": false,
            "properties": { "level": { "enum": ["account", "project", "agent"] }, "file": { "type": "string", "pattern": "^[^/].*\\.md$", "x-message": "must be a relative path to a .md file" } }
          }
        }
      }
    }
  },
  "$defs": {
    "moduleName": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$", "x-message": "must be lowercase letters, digits and dashes" },
    "word": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "x-message": "must be lowercase letters, digits and dashes" },
    "tool": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9.-]*$", "x-message": "must look like module.verb" },
    "toolPattern": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.(\\*|[a-z][a-z0-9.-]*)$", "x-message": "must look like module.verb or module.*" },
    "event": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$", "x-message": "must look like noun.past-verb" },
    "eventPattern": { "type": "string", "pattern": "^(\\*|[a-z][a-z0-9-]*\\.(\\*|[a-z][a-z0-9-]*))$", "x-message": "must be an event type, noun.* or *" },
    "slot": { "type": "string", "pattern": "^(panel|settings|route|view|now|renderer|slash)(:.+)?$", "x-message": "must be a slot: panel, settings, route, view, now, renderer or slash, optionally :<name>" },
    "setting": {
      "type": "object",
      "required": ["key", "label", "type", "levels", "apply"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9_.-]+$", "x-message": "must look like module.key" },
        "group": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "help": { "type": "string" },
        "type": { "enum": ["enum", "bool", "int", "number", "string", "list", "object", "model"] },
        "enum": { "type": "array", "items": { "type": "string" } },
        "choices": { "type": "array", "items": { "type": "number" } },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "default": {},
        "levels": { "type": "array", "items": { "enum": ["account", "project"] }, "minItems": 1, "uniqueItems": true },
        "apply": { "enum": ["live", "session", "restart"] },
        "advanced": { "type": "boolean" }
      }
    }
  }
}
