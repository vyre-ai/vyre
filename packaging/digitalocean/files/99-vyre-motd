#!/bin/sh
# What a person sees on first login to a Vyre droplet.
S=/var/lib/vyre/firstboot.status
st=$(cat "$S" 2>/dev/null || echo "not started")
printf '\n  Vyre\n  ----\n'
case "$st" in
  ok*) printf '  Vyre is running on this server (%s).\n  Get your setup link:   vyre up\n  Open the link it prints and finish in your browser.\n' "${st#ok }" ;;
  installing*) printf '  Vyre is installing itself now (about a minute). Watch it: tail -f /var/log/vyre-firstboot.log\n' ;;
  failed*) printf '  Vyre did not finish installing: %s\n  Try again: sudo vyre-firstboot\n' "${st#failed: }" ;;
  *) printf '  Vyre installs itself on the first boot. If this stays empty, run: sudo vyre-firstboot\n' ;;
esac
printf '  Your data is on this droplet, in /srv/vyre.\n  Docs: https://github.com/vyre-ai/vyre/tree/main/docs   This image is not built or supported by DigitalOcean.\n\n'
