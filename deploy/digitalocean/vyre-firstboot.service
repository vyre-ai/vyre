[Unit]
Description=Install Vyre on first boot
After=network-online.target cloud-final.service docker.service
Wants=network-online.target
ConditionPathExists=!/var/lib/vyre-firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vyre-firstboot.sh
RemainAfterExit=yes
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
