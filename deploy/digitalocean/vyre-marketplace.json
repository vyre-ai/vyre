{
  "variables": {
    "token": "{{env `DIGITALOCEAN_API_TOKEN`}}",
    "image_name": "vyre-1click-snapshot-{{timestamp}}",
    "apt_packages": "ca-certificates curl",
    "application_name": "Vyre",
    "application_version": "install-at-first-boot"
  },
  "sensitive-variables": [
    "token"
  ],
  "builders": [
    {
      "type": "digitalocean",
      "api_token": "{{user `token`}}",
      "image": "ubuntu-24-04-x64",
      "region": "nyc3",
      "size": "s-1vcpu-1gb",
      "ssh_username": "root",
      "snapshot_name": "{{user `image_name`}}",
      "tags": [
        "vyre-test"
      ]
    }
  ],
  "provisioners": [
    {
      "type": "shell",
      "inline": [
        "cloud-init status --wait",
        "apt-get -qqy update",
        "DEBIAN_FRONTEND=noninteractive apt-get -qqy install {{user `apt_packages`}}",
        "curl -fsSL https://get.docker.com | sh",
        "systemctl enable docker"
      ]
    },
    {
      "type": "file",
      "source": "vyre-firstboot.sh",
      "destination": "/usr/local/sbin/vyre-firstboot.sh"
    },
    {
      "type": "file",
      "source": "vyre-firstboot.service",
      "destination": "/etc/systemd/system/vyre-firstboot.service"
    },
    {
      "type": "file",
      "source": "99-vyre-motd",
      "destination": "/etc/update-motd.d/99-vyre"
    },
    {
      "type": "shell",
      "inline": [
        "chmod 0755 /usr/local/sbin/vyre-firstboot.sh /etc/update-motd.d/99-vyre",
        "systemctl enable vyre-firstboot.service"
      ]
    },
    {
      "type": "shell",
      "script": "marketplace-partners/scripts/cleanup.sh"
    },
    {
      "type": "shell",
      "script": "marketplace-partners/scripts/img_check.sh"
    }
  ]
}
