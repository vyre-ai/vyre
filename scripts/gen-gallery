#!/usr/bin/env node
// @ts-check
// gen-gallery: the living gallery's source files, generated from the block registry (lib/views/blocks.js), never hand written.
//   docs/design/gallery/catalogue.json   every block: props, data, content, sample, compact and glance forms. What @Engineer and the Design MCP read.
//   docs/design/gallery/index.html       the same as a page: each block's contract and its three forms as data. (The drawn gallery, with pictures, is rendered by the picture harness.)
//
//   node scripts/gen-gallery           write both files
//   node scripts/gen-gallery --check   exit 1 if a file is stale, write nothing (CI runs this)
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { fixtures } from "../lib/views/fixtures.js";
import { BLOCKS, LAYOUT_KINDS, GAPS, TONES, SCREEN_LIMITS, FORM_OF, catalogue, reduceBlock } from "../lib/views/blocks.js";

const REPO = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const OUT = path.join(REPO, "docs/design/gallery");

/** @param {string} s */
const esc = s => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

/** @param {any} t */
const propText = t => (t.t === "enum" ? t.v.join(" | ") : t.t === "str" ? `text, up to ${t.max}` : t.t === "num" ? `number ${t.min} to ${t.max}` : t.t === "icon" ? "icon name" : "true or false");

export function build() {
  const blocks = Object.entries(BLOCKS).map(([type, s]) => {
    const full = { type, content: s.sample };
    return { type, about: s.about, tier: s.tier, data: s.data, props: Object.fromEntries(Object.entries(s.props).map(([k, p]) => [k, propText(p)])), content: s.content, forms: s.forms, sample: s.sample,
      compact: reduceBlock(full, "compact"), glance: reduceBlock(full, "glance") };
  });
  const json = JSON.stringify({ note: "Generated by scripts/gen-gallery from lib/views/blocks.js. Do not edit.", layouts: { kinds: LAYOUT_KINDS, gaps: GAPS, tones: TONES, limits: SCREEN_LIMITS, formOf: FORM_OF }, index: catalogue("index").split("\n"), blocks }, null, 1) + "\n";
  const card = (/** @type {any} */ b) => `<section id="${b.type}"><h2>${b.type}<small>tier ${b.tier}</small></h2><p>${esc(b.about)}</p>
<dl><dt>Data</dt><dd>${esc(b.data.join(", "))}</dd><dt>Props</dt><dd>${Object.keys(b.props).length ? Object.entries(b.props).map(([k, v]) => `<code>${k}</code> ${esc(String(v))}`).join("<br>") : "none"}</dd>
<dt>Content</dt><dd>${esc(b.content.join(", ") || "none")}</dd><dt>Phone</dt><dd>${esc(b.forms.compact)}</dd><dt>Chat and Lumen</dt><dd>${esc(b.forms.glance)}</dd></dl>
<details><summary>Sample, and its phone and chat forms as data</summary><pre>${esc(JSON.stringify({ full: b.sample, phone: b.compact && b.compact.content, chat: b.glance === null ? "left out" : b.glance && b.glance.content }, null, 1))}</pre></details></section>`;
  const html = `<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Vyre design language: blocks</title>
<style>:root{color-scheme:light dark;--bg:#fff;--fg:#16161a;--mut:#62626b;--line:#e4e4ea}@media(prefers-color-scheme:dark){:root{--bg:#101014;--fg:#ececf1;--mut:#9a9aa6;--line:#26262e}}
body{margin:0 auto;max-width:880px;padding:32px 16px;background:var(--bg);color:var(--fg);font:15px/1.5 system-ui,sans-serif}h1{font-size:28px}h2{font-size:20px;margin:0}small{font-size:12px;color:var(--mut);margin-left:8px;font-weight:400}
section{border-top:1px solid var(--line);padding:20px 0}dl{display:grid;grid-template-columns:140px 1fr;gap:4px 12px;margin:12px 0}dt{color:var(--mut)}dd{margin:0}code,pre{font:12px/1.5 ui-monospace,monospace}pre{overflow:auto;padding:12px;border:1px solid var(--line);border-radius:8px}
summary{cursor:pointer;color:var(--mut)}nav{display:flex;flex-wrap:wrap;gap:4px 14px}</style></head><body>
<h1>Blocks</h1><p>Generated from <code>lib/views/blocks.js</code>. Layouts: ${LAYOUT_KINDS.join(", ")}. Up to ${SCREEN_LIMITS.blocks} blocks per screen, ${SCREEN_LIMITS.depth} levels deep.</p>
<nav>${blocks.map(b => `<a href="#${b.type}">${b.type}</a>`).join("")}</nav>
${blocks.map(card).join("\n")}
</body></html>
`;
  return { "catalogue.json": json, "index.html": html, "@app:fixtures.generated.json": JSON.stringify({ note: "Generated by scripts/gen-gallery from lib/views/fixtures.js. Do not edit.", fixtures: fixtures() }, null, 1) + "\n" };
}

if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  const check = process.argv.includes("--check");
  let stale = 0;
  for (const [name, content] of Object.entries(build())) {
    const app = name.startsWith("@app:");
    const f = app ? path.join(REPO, "apps/app/ui/blocks", name.slice(5)) : path.join(OUT, name);
    const shown = path.relative(REPO, f);
    const have = fs.existsSync(f) ? fs.readFileSync(f, "utf8") : null;
    if (have === content) continue;
    if (check) { console.error(`stale: ${shown} (run: node scripts/gen-gallery)`); stale++; }
    else { fs.mkdirSync(path.dirname(f), { recursive: true }); fs.writeFileSync(f, content); console.log(`wrote ${shown}`); }
  }
  process.exit(stale ? 1 : 0);
}
