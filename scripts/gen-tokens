#!/usr/bin/env node
// @ts-check
// gen-tokens: writes the app's theme from docs/design/one-app/tokens.json, the one token source
// (ADR 0027). It writes apps/app/src/theme/tokens.ts for the Expo app and
// local/capsule/native/Sources/UI/Tokens.generated.swift for the Capsule (its Theme.swift reads
// colours, status, radius, space and motion from there); the Deck's tokens.css joins when its
// owner moves to it. Never edit the output by hand.
//
//   node scripts/gen-tokens           write the files
//   node scripts/gen-tokens --check   exit 1 if a file is stale, write nothing

import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const REPO = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
export const SOURCE = "docs/design/one-app/tokens.json";

/**
 * The TypeScript module for the Expo app: the JSON as a frozen `as const` object, minus the note,
 * plus `attention(scheme, alt)` so the violet/teal choice stays one key.
 * @param {any} t the parsed tokens.json
 */
export function tokensTs(t) {
  const { $schema, note, ...rest } = t;
  void $schema; void note;
  return `// Generated by scripts/gen-tokens from ${SOURCE}. Do not edit; change the JSON and run it.

export const tokens = ${JSON.stringify(rest, null, 2)} as const;

export type Scheme = "dark" | "paper";
export type Colors = typeof tokens.color.dark;

/** The attention colour: beacon (violet) by default, or an alternative such as teal. */
export function attention(scheme: Scheme, alt?: keyof typeof tokens.color.attentionAlt): string {
  return alt ? tokens.color.attentionAlt[alt][scheme] : tokens.color[scheme].beacon;
}
`;
}

/** "#RRGGBB" or "rgba(r,g,b,a)" as a SwiftUI Color in sRGB, each component exact (n / 255). */
export function swiftColor(v) {
  let m = /^#([0-9a-f]{6})$/i.exec(v);
  if (m) {
    const i = parseInt(m[1], 16);
    return `Color(.sRGB, red: ${i >> 16 & 255} / 255, green: ${i >> 8 & 255} / 255, blue: ${i & 255} / 255, opacity: 1)`;
  }
  m = /^rgba\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*,\s*([\d.]+)\s*\)$/i.exec(v);
  if (m) return `Color(.sRGB, red: ${+m[1]} / 255, green: ${+m[2]} / 255, blue: ${+m[3]} / 255, opacity: ${+m[4]})`;
  throw new Error(`not a colour tokens.json may hold: ${v}`);
}

/**
 * The Swift file for the native Capsule: `enum Tokens` with both schemes' colours, the status
 * rows (mark, colour key, word, in order), radius, space, control heights and motion. Keys keep
 * their JSON names so a search finds them in every surface.
 * @param {any} t the parsed tokens.json
 */
export function tokensSwift(t) {
  const L = [];
  L.push(`// Generated by scripts/gen-tokens from ${SOURCE}. Do not edit; change the JSON and run it.`);
  L.push("// The Capsule reads these through Theme.swift; the app and the Deck read the same JSON.", "");
  L.push("import SwiftUI", "");
  L.push("public enum Tokens {");
  L.push("    public struct Colors: Sendable {");
  const keys = Object.keys(t.color.dark);
  for (const k of keys) L.push(`        public let ${k}: Color`);
  L.push("    }", "");
  for (const scheme of ["dark", "paper"]) {
    const c = t.color[scheme];
    for (const k of keys) if (!(k in c)) throw new Error(`color.${scheme} has no ${k}`);
    L.push(`    public static let ${scheme} = Colors(`);
    L.push(keys.map(k => `        ${k}: ${swiftColor(c[k])}`).join(",\n"));
    L.push("    )", "");
  }
  L.push("    /// The attention colour when the person picks another than beacon (violet).");
  L.push("    public static let attentionAlt: [String: (dark: Color, paper: Color)] = [");
  L.push(Object.entries(t.color.attentionAlt).map(([k, v]) => `        ${JSON.stringify(k)}: (${swiftColor(v.dark)}, ${swiftColor(v.paper)})`).join(",\n"));
  L.push("    ]", "");
  L.push("    public struct Status: Equatable, Sendable {");
  L.push("        public let key: String, mark: String, color: String, word: String");
  L.push("    }");
  L.push("    /// Most urgent first: a row shows the first that applies.");
  L.push("    public static let status: [Status] = [");
  L.push(t.status.order.map(k => { const s = t.status[k]; return `        Status(key: ${JSON.stringify(k)}, mark: ${JSON.stringify(s.mark)}, color: ${JSON.stringify(s.color)}, word: ${JSON.stringify(s.word)})`; }).join(",\n"));
  L.push("    ]", "");
  const nums = (name, o) => {
    L.push(`    public enum ${name} {`);
    for (const [k, v] of Object.entries(o)) if (typeof v === "number") L.push(`        public static let ${k}: CGFloat = ${v}`);
    L.push("    }", "");
  };
  nums("Radius", t.radius);
  nums("Control", t.control);
  L.push(`    public static let space: [CGFloat] = [${t.space.join(", ")}]`, "");
  L.push("    /// Durations in milliseconds, and the easing curve's control points.");
  L.push("    public enum Motion {");
  for (const [k, v] of Object.entries(t.motion)) {
    if (typeof v === "number") L.push(`        public static let ${k}: Double = ${v}`);
    else if (Array.isArray(v)) L.push(`        public static let ${k}: [Double] = [${v.join(", ")}]`);
  }
  L.push("    }", "");
  L.push("    /// [size, line height] in points, desktop.");
  L.push("    public enum TypeScale {");
  for (const [k, v] of Object.entries(t.type.desktop)) L.push(`        public static let ${k}: (size: CGFloat, line: CGFloat) = (${v[0]}, ${v[1]})`);
  L.push(`        public static let mono: (size: CGFloat, line: CGFloat) = (${t.type.mono[0]}, ${t.type.mono[1]})`);
  L.push("    }");
  L.push("}", "");
  return L.join("\n");
}

export const SWIFT_OUT = "local/capsule/native/Sources/UI/Tokens.generated.swift";

/** @returns {Record<string, string>} repo path to contents */
export function generate() {
  const t = JSON.parse(fs.readFileSync(path.join(REPO, SOURCE), "utf8"));
  return { "apps/app/src/theme/tokens.ts": tokensTs(t), [SWIFT_OUT]: tokensSwift(t) };
}

if (process.argv[1] && fileURLToPath(import.meta.url) === path.resolve(process.argv[1])) {
  const check = process.argv.includes("--check");
  let stale = 0;
  for (const [rel, body] of Object.entries(generate())) {
    const file = path.join(REPO, rel);
    const now = fs.existsSync(file) ? fs.readFileSync(file, "utf8") : null;
    if (now === body) continue;
    if (check) { console.error(`${rel} is stale; run node scripts/gen-tokens`); stale++; continue; }
    fs.mkdirSync(path.dirname(file), { recursive: true });
    fs.writeFileSync(file, body);
    console.log(`wrote ${rel}`);
  }
  process.exit(stale ? 1 : 0);
}
