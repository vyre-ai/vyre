#!/usr/bin/env node
// A stand-in for `claude setup-token` (rc-smoke): prints a sign-in link the way Claude Code does,
// reads the pasted code with the terminal in raw mode (Enter alone submits), and prints a fake
// long-lived token. The code it accepts is good-code#rc1. Nothing here is a real credential.
if (process.argv[2] === "--version") { console.log("2.1.283 (Claude Code)"); process.exit(0); }
if (process.argv[2] !== "setup-token") { console.error("rc-smoke fake claude: only setup-token"); process.exit(2); }
const token = "sk-ant-oat01-" + "Rc5m".repeat(12);
process.stdout.write("\x1b]8;id=a1;https://claude.com/cai/oauth/authorize?code=true&client_id=rc1&state=rc1\x1b\\Sign in\x1b]8;;\x1b\\\n");
process.stdout.write("Paste code here if prompted > ");
if (process.stdin.isTTY) process.stdin.setRawMode(true);
let typed = "";
process.stdin.on("data", d => {
  const s = String(d);
  if (s !== "\r") { typed += s; return; }
  if (typed === "good-code#rc1") { process.stdout.write(`\nYour token: ${token}\n`); process.exit(0); }
  process.stdout.write("\r\nOAuth error: Request failed with status code 400\r\n Press Enter to retry.");
  typed = "";
});
