#!/usr/bin/env node
// @ts-check
// build-docs: docs.vyre.run from docs/, as static files for Cloudflare Pages.
//
//   scripts/build-docs [--out DIR]
//
//   --out DIR   where to write the site (default: docs-site/ at the repo root, gitignored). The
//               folder is emptied first.
//   --mount-site  build the docs to be served at https://vyre.run/docs/ instead (scripts/site/docs.mjs): every link carries /docs,
//               ARCHITECTURE.md, DEVELOPMENT-RULES.md and roadmap/ join the pages, the header links to the rest of vyre.run, and no
//               robots.txt or 404.html is written. scripts/assemble-site.sh does this into <site>/docs.
//
// Publishes the pages docs/nav.json lists, in its order, and nothing else: docs/proposals/ and docs/design/boards/
// never go out. Each page is written twice, as HTML at
// its pretty URL (docs/using/capsule.md is /using/capsule) and as its own Markdown at the same
// path with .md, for people who want the source and agents that read it. Pages that moved leave a
// stub (`redirect:` in front matter); those become 301s in _redirects.
//
// Also writes search-index.json, llms.txt and llms-full.txt, sitemap.xml, robots.txt, 404.html,
// _headers, and one CSS and one JS file under assets/ with a content hash in the name (plus the demo
// widgets' CSS and JS, which only pages with a `::: demo` load). The same input builds the same
// bytes. `<!-- colors: dark -->` in a page shows the palette from core/config/theme.js. The Markdown renderer and the loader live in scripts/lib/docs/, so
// scripts/docs-check and the tests use the same code.
//
// Deploy afterwards with:
//   npx wrangler pages deploy docs-site --project-name vyre-docs --branch main

import fs from "node:fs";
import path from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";
import { build } from "./lib/docs/build.js";

const REPO = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");

const args = process.argv.slice(2);
let out = path.join(REPO, "docs-site");
let mount = false;
for (let i = 0; i < args.length; i++) {
  const a = args[i];
  if (a === "--out") {
    const v = args[++i];
    if (!v) { console.error("build-docs: --out needs a folder"); process.exit(1); }
    out = path.resolve(v);
  } else if (a === "--mount-site") {
    mount = true;
  } else if (a === "-h" || a === "--help") {
    console.log("usage: scripts/build-docs [--out DIR] [--mount-site]\n\nBuilds docs.vyre.run from docs/ into DIR (default docs-site/).");
    process.exit(0);
  } else {
    console.error(`build-docs: unknown option ${a}`);
    process.exit(1);
  }
}
if (path.resolve(out) === REPO || REPO.startsWith(path.resolve(out) + path.sep) || path.resolve(out) === path.join(REPO, "docs")) {
  console.error(`build-docs: refusing to write the site over ${out}`);
  process.exit(1);
}

const started = process.hrtime.bigint();
const themeFile = path.join(REPO, "core", "config", "theme.js");
let palette = null;
if (fs.existsSync(themeFile)) {
  const m = await import(pathToFileURL(themeFile).href);
  if (m.THEME_COLORS) palette = { colors: m.THEME_COLORS, use: m.THEME_USE || {} };
}
const opts = mount ? (await import("./site/docs.mjs")).mountOptions(REPO) : {};
const result = build({ root: REPO, out, log: msg => console.error(msg), palette, ...opts });
const ms = Number((process.hrtime.bigint() - started) / 1_000_000n);
console.log(`build-docs: ${result.pages} pages, ${result.redirects} redirects, ${result.files.length} files in ${path.relative(process.cwd(), out) || "."} (${ms} ms)`);
