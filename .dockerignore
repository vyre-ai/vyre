# Keep the image to what vyred runs. See box/Dockerfile.
**/node_modules
.git
.github
.vyre
**/.vyre
*.log
**/*.log
.env
.env.*
**/.DS_Store
coverage
test
scripts
# Except what the npm package ships from scripts/: npm ci runs postinstall.mjs, and
# `vyre box` reads install-box.sh.
!scripts/postinstall.mjs
!scripts/install-box.sh
# Design mockups and working notes: not read at runtime.
docs/design/boards
# The box files themselves.
box
.dockerignore
